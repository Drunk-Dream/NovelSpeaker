<Application x:Class="NovelSpeaker.StyleGallery.GalleryApp"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="/NovelSpeaker.StyleGallery;component/Resources/ProviderStyleBridge.xaml" />
                <ResourceDictionary Source="/NovelSpeaker.StyleGallery;component/Resources/Palettes/Palette.Light.xaml" />
                <ResourceDictionary Source="/NovelSpeaker.StyleGallery;component/Resources/DesignTokens.xaml" />
                <ResourceDictionary Source="/NovelSpeaker.StyleGallery;component/Resources/ButtonStyles.xaml" />
                <ResourceDictionary Source="/NovelSpeaker.StyleGallery;component/Resources/MediaControlStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
