<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <AssemblyName>NovelSpeaker.StyleGallery</AssemblyName>
    <RootNamespace>NovelSpeaker.StyleGallery</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ApplicationDefinition Include="App.xaml" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="wpf-ui" />
  </ItemGroup>
  <ItemGroup>
    <Page Include="..\..\src\NovelSpeaker.App\Shared\Theming\Provider\ProviderStyleBridge.xaml"
          Link="Resources\ProviderStyleBridge.xaml" />
    <Page Include="..\..\src\NovelSpeaker.App\Shared\Theming\Palettes\Palette.Light.xaml"
          Link="Resources\Palettes\Palette.Light.xaml" />
    <Page Include="..\..\src\NovelSpeaker.App\Shared\Theming\Palettes\Palette.Dark.xaml"
          Link="Resources\Palettes\Palette.Dark.xaml" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\src\NovelSpeaker.App\Shared\Theming\SemanticPaletteRuntime.cs"
             Link="Theming\SemanticPaletteRuntime.cs" />
  </ItemGroup>
</Project>
