<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <AssemblyName>NovelSpeaker.StyleGallery</AssemblyName>
    <RootNamespace>NovelSpeaker.StyleGallery</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ApplicationDefinition Include="App.xaml" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\NovelSpeaker.App\NovelSpeaker.App.csproj" />
    <PackageReference Include="wpf-ui" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\src\NovelSpeaker.App\Shared\Theming\SemanticPaletteRuntime.cs"
             Link="Theming\SemanticPaletteRuntime.cs" />
  </ItemGroup>
</Project>
