<Window x:Class="NovelSpeaker.App.Desktop.MiniPlayer.MiniPlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:NovelSpeaker.App.Shared.Presentation.Behaviors"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="迷你播放器"
        Width="480"
        Height="150"
        MinWidth="440"
        MinHeight="150"
        MaxWidth="500"
        MaxHeight="150"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        Topmost="{Binding IsTopmost, Mode=TwoWay}"
        PreviewMouseLeftButtonDown="MiniPlayerWindow_OnPreviewMouseLeftButtonDown">
    <Border x:Name="MiniPlayerSurface"
            Padding="12,6"
            BorderThickness="2"
            CornerRadius="{StaticResource App.Radius.Large}"
            Effect="{x:Null}"
            Style="{StaticResource App.Surface.Raised}"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid x:Name="MiniPlayerHeader">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="MiniPlayerChapterTitle"
                           Style="{StaticResource App.Typography.ItemTitle}"
                           Text="{Binding ChapterTitle}"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding ChapterTitle}"
                           AutomationProperties.Name="{Binding ChapterTitle}" />
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal">
                    <ui:Button x:Name="MiniPlayerTopmostButton"
                               Margin="4,0,0,0"
                               CornerRadius="{StaticResource App.Radius.Small}"
                               Command="{Binding ToggleTopmostCommand}"
                               Icon="{ui:SymbolIcon Symbol=Pin24}"
                               ToolTip="{Binding TopmostActionText, FallbackValue=置顶}"
                               AutomationProperties.Name="{Binding TopmostActionText, FallbackValue=置顶}">
                        <ui:Button.Style>
                            <Style TargetType="{x:Type ui:Button}"
                                   BasedOn="{StaticResource App.Button.Icon}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTopmost}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource App.Brush.Accent.Subtle}" />
                                        <Setter Property="Foreground" Value="{DynamicResource App.Brush.Accent.Default}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.Accent.Default}" />
                                        <Setter Property="BorderThickness" Value="1" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                    </ui:Button>
                    <ui:Button x:Name="MiniPlayerRestoreButton"
                            Margin="4,0,0,0"
                            Style="{StaticResource App.Button.Icon}"
                            Command="{Binding RestoreMainWindowCommand}"
                            ToolTip="恢复主窗口"
                            AutomationProperties.Name="恢复主窗口"
                            Icon="{ui:SymbolIcon Symbol=ArrowMaximize24}" />
                    <ui:Button x:Name="MiniPlayerCloseButton"
                               Margin="4,0,0,0"
                               Style="{StaticResource App.Button.DangerIcon}"
                               Click="MiniPlayerCloseButton_OnClick"
                               ToolTip="退出应用"
                               AutomationProperties.Name="退出应用"
                               Icon="{ui:SymbolIcon Symbol=DismissSquare24}" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1"
                  MinHeight="20"
                  Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="MiniPlayerBookTitle"
                           Style="{StaticResource App.Typography.Secondary}"
                           Text="{Binding BookTitle}"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding BookTitle}"
                           AutomationProperties.Name="{Binding BookTitle}" />
                <TextBlock x:Name="MiniPlayerSegmentCounterText"
                           Grid.Column="1"
                           Margin="12,0,0,0"
                           Style="{StaticResource App.Typography.Secondary}"
                           Text="{Binding DisplayedSegmentCounterText}"
                           AutomationProperties.Name="段落进度" />
            </Grid>

            <Grid Grid.Row="2"
                  Margin="0,2,0,0">
                <ProgressBar x:Name="MiniPlayerProgressFillBar"
                             VerticalAlignment="Center"
                             IsHitTestVisible="False"
                             Style="{StaticResource App.Progress.MediaTrack}"
                             Minimum="0"
                             Maximum="{Binding SegmentProgressMaximum}"
                             Value="{Binding SegmentProgressPreviewValue, Mode=OneWay}" />
                <Slider x:Name="MiniPlayerProgressSlider"
                        Style="{StaticResource App.Media.ProgressSlider}"
                        Minimum="0"
                        Maximum="{Binding SegmentProgressMaximum}"
                        Value="{Binding SegmentProgressValue, Mode=OneWay}"
                        IsSnapToTickEnabled="True"
                        TickFrequency="1"
                        ToolTipService.IsEnabled="False"
                        ToolTipService.InitialShowDelay="0"
                        MouseEnter="MiniPlayerProgressSlider_OnMouseEnter"
                        MouseLeave="MiniPlayerProgressSlider_OnMouseLeave"
                        PreviewMouseLeftButtonDown="MiniPlayerProgressSlider_OnPreviewMouseLeftButtonDown"
                        PreviewMouseLeftButtonUp="MiniPlayerProgressSlider_OnPreviewMouseLeftButtonUp"
                        PreviewKeyDown="MiniPlayerProgressSlider_OnPreviewKeyDown"
                        PreviewKeyUp="MiniPlayerProgressSlider_OnPreviewKeyUp"
                        LostMouseCapture="MiniPlayerProgressSlider_OnLostMouseCapture"
                        ValueChanged="MiniPlayerProgressSlider_OnValueChanged"
                        AutomationProperties.Name="播放进度">
                    <Slider.ToolTip>
                        <ToolTip Content="{Binding PlacementTarget.DataContext.DisplayedSegmentCounterText, RelativeSource={RelativeSource Self}, FallbackValue=尚未定位段落}"
                                 StaysOpen="True" />
                    </Slider.ToolTip>
                </Slider>
            </Grid>

            <Border x:Name="MiniPlayerMediaSurface"
                    Grid.Row="3"
                    Margin="0,4,0,0"
                    Padding="4,0"
                    BorderThickness="1"
                    Style="{StaticResource App.Media.ControlSurface}"
                    ClipToBounds="True">
                <Grid x:Name="MiniPlayerControlBar">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="MiniPlayerMediaControls"
                                Grid.Column="1"
                                HorizontalAlignment="Center"
                                Orientation="Horizontal">
                        <ui:Button x:Name="MiniPlayerPreviousChapterButton"
                                Margin="2,0"
                                Style="{StaticResource App.Media.Button}"
                                IsEnabled="{Binding HasPlaybackContext}"
                                Command="{Binding PreviousChapterCommand}"
                                ToolTip="上一章"
                                AutomationProperties.Name="上一章"
                                Icon="{ui:SymbolIcon Symbol=ChevronDoubleLeft20}" />
                        <ui:Button x:Name="MiniPlayerPreviousSegmentButton"
                                Margin="2,0"
                                Style="{StaticResource App.Media.Button}"
                                IsEnabled="{Binding CanGoToPreviousSegment}"
                                Command="{Binding PreviousSegmentCommand}"
                                ToolTip="上一段"
                                AutomationProperties.Name="上一段"
                                Icon="{ui:SymbolIcon Symbol=ChevronLeft20}" />
                        <ui:Button x:Name="MiniPlayerPlaybackButton"
                                   Margin="2,0"
                                   Style="{StaticResource App.Media.Button}"
                                   IsEnabled="{Binding CanTogglePlayback}"
                                   Command="{Binding TogglePlaybackCommand}"
                                   ToolTip="{Binding PlaybackActionText}"
                                   AutomationProperties.Name="{Binding PlaybackActionText}">
                            <ui:Button.Icon>
                                <ui:SymbolIcon>
                                    <ui:SymbolIcon.Style>
                                    <Style TargetType="ui:SymbolIcon">
                                        <Setter Property="Symbol" Value="PlayCircle24" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PlaybackActionText}" Value="暂停">
                                                <Setter Property="Symbol" Value="PauseCircle24" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                    </ui:SymbolIcon.Style>
                                </ui:SymbolIcon>
                            </ui:Button.Icon>
                        </ui:Button>
                        <ui:Button x:Name="MiniPlayerNextSegmentButton"
                                Margin="2,0"
                                Style="{StaticResource App.Media.Button}"
                                IsEnabled="{Binding CanGoToNextSegment}"
                                Command="{Binding NextSegmentCommand}"
                                ToolTip="下一段"
                                AutomationProperties.Name="下一段"
                                Icon="{ui:SymbolIcon Symbol=ChevronRight20}" />
                        <ui:Button x:Name="MiniPlayerNextChapterButton"
                                Margin="2,0"
                                Style="{StaticResource App.Media.Button}"
                                IsEnabled="{Binding HasPlaybackContext}"
                                Command="{Binding NextChapterCommand}"
                                ToolTip="下一章"
                                AutomationProperties.Name="下一章"
                                Icon="{ui:SymbolIcon Symbol=ChevronDoubleRight20}" />
                    </StackPanel>
                    <ui:Button x:Name="MiniPlayerVolumeMenuButton"
                               Grid.Column="2"
                               Margin="4,0,2,0"
                               HorizontalAlignment="Right"
                               Style="{StaticResource App.Media.Button}"
                               Command="{Binding ToggleVolumeMenuCommand}"
                               ToolTip="播放音量"
                               AutomationProperties.Name="{Binding VolumeButtonAutomationName, FallbackValue=播放音量}">
                        <ui:Button.Icon>
                            <ui:SymbolIcon>
                                <ui:SymbolIcon.Style>
                                <Style TargetType="ui:SymbolIcon">
                                    <Setter Property="Symbol" Value="Speaker224" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Volume}" Value="0">
                                            <Setter Property="Symbol" Value="SpeakerMute24" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                                </ui:SymbolIcon.Style>
                            </ui:SymbolIcon>
                        </ui:Button.Icon>
                    </ui:Button>
                </Grid>
            </Border>

            <ui:Flyout x:Name="MiniPlayerVolumeFlyout"
                       Style="{StaticResource App.Feedback.FlyoutHost}"
                       Placement="Top"
                       behaviors:WpfUiFlyoutPlacement.PlacementTarget="{Binding ElementName=MiniPlayerVolumeMenuButton}"
                       behaviors:WpfUiFlyoutPlacement.HorizontalOffset="-24"
                       behaviors:WpfUiFlyoutPlacement.VerticalOffset="-8"
                       IsOpen="{Binding IsVolumeMenuOpen, Mode=TwoWay}">
                <Border Width="96"
                        Style="{StaticResource App.Feedback.PopupSurface}">
                    <StackPanel>
                        <TextBlock HorizontalAlignment="Center"
                                   Style="{StaticResource App.Typography.FormLabel}"
                                   Text="{Binding VolumePercentText}" />
                        <Grid Height="160"
                              Margin="0,8,0,0">
                            <Slider x:Name="MiniPlayerVolumeSlider"
                                    Style="{StaticResource App.Media.VolumeSlider}"
                                    Minimum="0"
                                    Maximum="1"
                                    Value="{Binding Volume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    ToolTip="播放音量"
                                    AutomationProperties.Name="播放音量" />
                        </Grid>
                    </StackPanel>
                </Border>
            </ui:Flyout>

            <Thumb x:Name="MiniPlayerWidthResizeThumb"
                   Width="8"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Stretch"
                   Background="Transparent"
                   BorderBrush="Transparent"
                   BorderThickness="0"
                   Cursor="SizeWE"
                   Focusable="False"
                   IsTabStop="False"
                   Opacity="0"
                   DragDelta="MiniPlayerWidthResizeThumb_OnDragDelta"
                   AutomationProperties.Name="调整窗口宽度" />
        </Grid>
    </Border>
</Window>
