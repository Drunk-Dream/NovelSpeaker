<Window x:Class="NovelSpeaker.App.Desktop.MiniPlayer.MiniPlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="迷你播放器"
        Width="480"
        Height="150"
        MinWidth="440"
        MinHeight="150"
        MaxWidth="500"
        MaxHeight="150"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        Topmost="{Binding IsTopmost, Mode=TwoWay}"
        PreviewMouseLeftButtonDown="MiniPlayerWindow_OnPreviewMouseLeftButtonDown">
    <Border x:Name="MiniPlayerSurface"
            Padding="12,6"
            Background="{DynamicResource RaisedSurfaceBrush}"
            BorderBrush="{DynamicResource StrongBorderBrush}"
            BorderThickness="2"
            CornerRadius="{StaticResource CornerRadiusLarge}"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid x:Name="MiniPlayerHeader">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="MiniPlayerChapterTitle"
                           Style="{StaticResource App.Typography.ItemTitle}"
                           Text="{Binding ChapterTitle}"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding ChapterTitle}"
                           AutomationProperties.Name="{Binding ChapterTitle}" />
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal">
                    <Button x:Name="MiniPlayerTopmostButton"
                            Margin="4,0,0,0"
                            Style="{StaticResource App.Button.Icon}"
                            Command="{Binding ToggleTopmostCommand}"
                            ToolTip="{Binding TopmostActionText, FallbackValue=置顶}"
                            AutomationProperties.Name="{Binding TopmostActionText, FallbackValue=置顶}">
                        <Border x:Name="MiniPlayerTopmostStateBorder"
                                Width="32"
                                Height="32"
                                CornerRadius="{StaticResource IconButtonCornerRadius}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTopmost}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                            <Setter Property="BorderThickness" Value="1" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <ui:SymbolIcon Width="20"
                                           Height="20"
                                           Symbol="Pin24">
                                <ui:SymbolIcon.Style>
                                    <Style TargetType="ui:SymbolIcon">
                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTopmost}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:SymbolIcon.Style>
                            </ui:SymbolIcon>
                        </Border>
                    </Button>
                    <Button x:Name="MiniPlayerRestoreButton"
                            Margin="4,0,0,0"
                            Style="{StaticResource App.Button.Icon}"
                            Command="{Binding RestoreMainWindowCommand}"
                            ToolTip="恢复主窗口"
                            AutomationProperties.Name="恢复主窗口">
                        <ui:SymbolIcon Width="20"
                                       Height="20"
                                       Symbol="ArrowMaximize24" />
                    </Button>
                    <ui:Button x:Name="MiniPlayerCloseButton"
                               Margin="4,0,0,0"
                               Style="{StaticResource App.Button.DangerIcon}"
                               Click="MiniPlayerCloseButton_OnClick"
                               ToolTip="退出应用"
                               AutomationProperties.Name="退出应用">
                        <ui:SymbolIcon Width="20"
                                       Height="20"
                                       Symbol="DismissSquare24" />
                    </ui:Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1"
                  MinHeight="20"
                  Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="MiniPlayerBookTitle"
                           Style="{StaticResource App.Typography.Secondary}"
                           Text="{Binding BookTitle}"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding BookTitle}"
                           AutomationProperties.Name="{Binding BookTitle}" />
                <TextBlock x:Name="MiniPlayerSegmentCounterText"
                           Grid.Column="1"
                           Margin="12,0,0,0"
                           Style="{StaticResource App.Typography.Secondary}"
                           Text="{Binding DisplayedSegmentCounterText}"
                           AutomationProperties.Name="段落进度" />
            </Grid>

            <Grid Grid.Row="2"
                  Margin="0,2,0,0">
                <Slider x:Name="MiniPlayerProgressSlider"
                        Style="{StaticResource App.Media.Slider}"
                        Minimum="0"
                        Maximum="{Binding SegmentProgressMaximum}"
                        Value="{Binding SegmentProgressValue, Mode=OneWay}"
                        IsSnapToTickEnabled="True"
                        TickFrequency="1"
                        ToolTipService.IsEnabled="False"
                        ToolTipService.InitialShowDelay="0"
                        MouseEnter="MiniPlayerProgressSlider_OnMouseEnter"
                        MouseLeave="MiniPlayerProgressSlider_OnMouseLeave"
                        PreviewMouseLeftButtonDown="MiniPlayerProgressSlider_OnPreviewMouseLeftButtonDown"
                        PreviewMouseLeftButtonUp="MiniPlayerProgressSlider_OnPreviewMouseLeftButtonUp"
                        PreviewKeyDown="MiniPlayerProgressSlider_OnPreviewKeyDown"
                        PreviewKeyUp="MiniPlayerProgressSlider_OnPreviewKeyUp"
                        LostMouseCapture="MiniPlayerProgressSlider_OnLostMouseCapture"
                        ValueChanged="MiniPlayerProgressSlider_OnValueChanged"
                        AutomationProperties.Name="播放进度">
                    <Slider.ToolTip>
                        <ToolTip Content="{Binding PlacementTarget.DataContext.DisplayedSegmentCounterText, RelativeSource={RelativeSource Self}, FallbackValue=尚未定位段落}"
                                 StaysOpen="True" />
                    </Slider.ToolTip>
                </Slider>
            </Grid>

            <Border x:Name="MiniPlayerMediaSurface"
                    Grid.Row="3"
                    Margin="0,4,0,0"
                    Padding="4,0"
                    Background="{DynamicResource SecondarySurfaceBrush}"
                    BorderBrush="{DynamicResource SubtleBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CornerRadiusMedium}"
                    ClipToBounds="True">
                <Grid x:Name="MiniPlayerControlBar">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="MiniPlayerMediaControls"
                                Grid.Column="1"
                                HorizontalAlignment="Center"
                                Orientation="Horizontal">
                        <Button x:Name="MiniPlayerPreviousChapterButton"
                                Margin="2,0"
                                Style="{StaticResource App.Media.Button}"
                                IsEnabled="{Binding HasPlaybackContext}"
                                Command="{Binding PreviousChapterCommand}"
                                ToolTip="上一章"
                                AutomationProperties.Name="上一章">
                            <ui:SymbolIcon Width="20"
                                           Height="20"
                                           Symbol="ChevronDoubleLeft20" />
                        </Button>
                        <Button x:Name="MiniPlayerPreviousSegmentButton"
                                Margin="2,0"
                                Style="{StaticResource App.Media.Button}"
                                IsEnabled="{Binding CanGoToPreviousSegment}"
                                Command="{Binding PreviousSegmentCommand}"
                                ToolTip="上一段"
                                AutomationProperties.Name="上一段">
                            <ui:SymbolIcon Width="20"
                                           Height="20"
                                           Symbol="ChevronLeft20" />
                        </Button>
                        <Button x:Name="MiniPlayerPlaybackButton"
                                Margin="2,0"
                                Style="{StaticResource App.Media.Button}"
                                IsEnabled="{Binding CanTogglePlayback}"
                                Command="{Binding TogglePlaybackCommand}"
                                ToolTip="{Binding PlaybackActionText}"
                                AutomationProperties.Name="{Binding PlaybackActionText}">
                            <ui:SymbolIcon Width="28"
                                           Height="28"
                                           Foreground="{DynamicResource PrimaryTextBrush}">
                                <ui:SymbolIcon.Style>
                                    <Style TargetType="ui:SymbolIcon">
                                        <Setter Property="Symbol" Value="PlayCircle24" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PlaybackActionText}" Value="暂停">
                                                <Setter Property="Symbol" Value="PauseCircle24" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:SymbolIcon.Style>
                            </ui:SymbolIcon>
                        </Button>
                        <Button x:Name="MiniPlayerNextSegmentButton"
                                Margin="2,0"
                                Style="{StaticResource App.Media.Button}"
                                IsEnabled="{Binding CanGoToNextSegment}"
                                Command="{Binding NextSegmentCommand}"
                                ToolTip="下一段"
                                AutomationProperties.Name="下一段">
                            <ui:SymbolIcon Width="20"
                                           Height="20"
                                           Symbol="ChevronRight20" />
                        </Button>
                        <Button x:Name="MiniPlayerNextChapterButton"
                                Margin="2,0"
                                Style="{StaticResource App.Media.Button}"
                                IsEnabled="{Binding HasPlaybackContext}"
                                Command="{Binding NextChapterCommand}"
                                ToolTip="下一章"
                                AutomationProperties.Name="下一章">
                            <ui:SymbolIcon Width="20"
                                           Height="20"
                                           Symbol="ChevronDoubleRight20" />
                        </Button>
                    </StackPanel>
                    <Button x:Name="MiniPlayerVolumeMenuButton"
                            Grid.Column="2"
                            Margin="4,0,2,0"
                            HorizontalAlignment="Right"
                            Style="{StaticResource App.Media.Button}"
                            Command="{Binding ToggleVolumeMenuCommand}"
                            ToolTip="播放音量"
                            AutomationProperties.Name="{Binding VolumeButtonAutomationName, FallbackValue=播放音量}">
                        <ui:SymbolIcon Width="20"
                                       Height="20">
                            <ui:SymbolIcon.Style>
                                <Style TargetType="ui:SymbolIcon">
                                    <Setter Property="Symbol" Value="Speaker224" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Volume}" Value="0">
                                            <Setter Property="Symbol" Value="SpeakerMute24" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:SymbolIcon.Style>
                        </ui:SymbolIcon>
                    </Button>
                </Grid>
            </Border>

            <Popup x:Name="MiniPlayerVolumeMenuPopup"
                   PlacementTarget="{Binding ElementName=MiniPlayerVolumeMenuButton}"
                   Placement="Top"
                   HorizontalOffset="0"
                   VerticalOffset="-8"
                   AllowsTransparency="True"
                   StaysOpen="False"
                   IsOpen="{Binding IsVolumeMenuOpen, Mode=TwoWay}">
                <Border Width="280"
                        Padding="{StaticResource CardPadding}"
                        Style="{StaticResource PopupSurfaceBorderStyle}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Style="{StaticResource SectionTitleTextBlockStyle}"
                                       Text="播放音量" />
                            <TextBlock HorizontalAlignment="Right"
                                       Style="{StaticResource StrongTextBlockStyle}"
                                       Text="{Binding VolumePercentText}" />
                        </Grid>
                        <Slider x:Name="MiniPlayerVolumeSlider"
                                Width="232"
                                MinWidth="0"
                                Margin="0,16,0,0"
                                HorizontalAlignment="Left"
                                Style="{StaticResource App.Media.Slider}"
                                Minimum="0"
                                Maximum="1"
                                Value="{Binding Volume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                ToolTip="播放音量"
                                AutomationProperties.Name="播放音量" />
                    </StackPanel>
                </Border>
            </Popup>

            <Thumb x:Name="MiniPlayerWidthResizeThumb"
                   Width="8"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Stretch"
                   Background="Transparent"
                   BorderBrush="Transparent"
                   BorderThickness="0"
                   Cursor="SizeWE"
                   Focusable="False"
                   IsTabStop="False"
                   Opacity="0"
                   DragDelta="MiniPlayerWidthResizeThumb_OnDragDelta"
                   AutomationProperties.Name="调整窗口宽度" />
        </Grid>
    </Border>
</Window>
