<Window x:Class="NovelSpeaker.App.Desktop.MiniPlayer.MiniPlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="迷你播放器"
        Width="420"
        Height="210"
        MinWidth="360"
        MinHeight="190"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        Topmost="{Binding IsTopmost, Mode=TwoWay}"
        PreviewMouseLeftButtonDown="MiniPlayerWindow_OnPreviewMouseLeftButtonDown">
    <Border Padding="{StaticResource CardPadding}"
            Background="{DynamicResource AppBackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="MiniPlayerBookTitle"
                               Style="{StaticResource SectionTitleTextBlockStyle}"
                               Text="{Binding BookTitle}"
                               TextTrimming="CharacterEllipsis"
                               AutomationProperties.Name="{Binding BookTitle}" />
                    <TextBlock x:Name="MiniPlayerChapterTitle"
                               Margin="{StaticResource TinySpacing}"
                               Style="{StaticResource SecondaryTextBlockStyle}"
                               Text="{Binding ChapterTitle}"
                               TextTrimming="CharacterEllipsis"
                               AutomationProperties.Name="{Binding ChapterTitle}" />
                </StackPanel>
                <Button x:Name="MiniPlayerTopmostButton"
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        Style="{StaticResource SecondaryIconButtonStyle}"
                        Command="{Binding ToggleTopmostCommand}"
                        ToolTip="{Binding TopmostActionText, FallbackValue=置顶}"
                        AutomationProperties.Name="{Binding TopmostActionText, FallbackValue=置顶}">
                    <Border x:Name="MiniPlayerTopmostStateBorder"
                            Width="{StaticResource SecondaryIconButtonSize}"
                            Height="{StaticResource SecondaryIconButtonSize}"
                            CornerRadius="{StaticResource IconButtonCornerRadius}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderBrush" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="{StaticResource NoBorderThickness}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTopmost}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                        <Setter Property="BorderThickness" Value="{StaticResource StandardBorderThickness}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <ui:SymbolIcon Symbol="Pin24">
                            <ui:SymbolIcon.Style>
                                <Style TargetType="ui:SymbolIcon">
                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTopmost}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:SymbolIcon.Style>
                        </ui:SymbolIcon>
                    </Border>
                </Button>
                <Button x:Name="MiniPlayerRestoreButton"
                        Grid.Column="2"
                        Margin="8,0,0,0"
                        Style="{StaticResource SecondaryIconButtonStyle}"
                        Command="{Binding RestoreMainWindowCommand}"
                        ToolTip="恢复主窗口"
                        AutomationProperties.Name="恢复主窗口">
                    <ui:SymbolIcon Symbol="ArrowMaximize24" />
                </Button>
            </Grid>

            <Grid Grid.Row="1"
                  Margin="{StaticResource ContentSpacing}">
                <ProgressBar x:Name="MiniPlayerProgressFillBar"
                             VerticalAlignment="Center"
                             IsHitTestVisible="False"
                             Style="{StaticResource PlaybackProgressBarStyle}"
                             Minimum="0"
                             Maximum="{Binding SegmentProgressMaximum}"
                             Value="{Binding SegmentProgressValue, Mode=OneWay}" />
                <Slider x:Name="MiniPlayerProgressSlider"
                        Style="{StaticResource PlaybackProgressSliderStyle}"
                        Minimum="0"
                        Maximum="{Binding SegmentProgressMaximum}"
                        Value="{Binding SegmentProgressValue, Mode=OneWay}"
                        IsSnapToTickEnabled="True"
                        TickFrequency="1"
                        ToolTipService.IsEnabled="False"
                        ToolTipService.InitialShowDelay="0"
                        MouseEnter="MiniPlayerProgressSlider_OnMouseEnter"
                        MouseLeave="MiniPlayerProgressSlider_OnMouseLeave"
                        PreviewMouseLeftButtonDown="MiniPlayerProgressSlider_OnPreviewMouseLeftButtonDown"
                        PreviewMouseLeftButtonUp="MiniPlayerProgressSlider_OnPreviewMouseLeftButtonUp"
                        PreviewKeyDown="MiniPlayerProgressSlider_OnPreviewKeyDown"
                        PreviewKeyUp="MiniPlayerProgressSlider_OnPreviewKeyUp"
                        LostMouseCapture="MiniPlayerProgressSlider_OnLostMouseCapture"
                        ValueChanged="MiniPlayerProgressSlider_OnValueChanged"
                        AutomationProperties.Name="播放进度">
                    <Slider.ToolTip>
                        <ToolTip Content="{Binding PlacementTarget.DataContext.DisplayedSegmentCounterText, RelativeSource={RelativeSource Self}, FallbackValue=尚未定位段落}"
                                 StaysOpen="True" />
                    </Slider.ToolTip>
                </Slider>
            </Grid>

            <Grid x:Name="MiniPlayerControlBar"
                  Grid.Row="3"
                  Margin="{StaticResource ContentSpacing}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="MiniPlayerMediaControls"
                            Grid.Column="1"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal">
                    <Button x:Name="MiniPlayerPreviousChapterButton"
                            Margin="{StaticResource ToolbarItemTrailingMargin}"
                            Style="{StaticResource MediaIconButtonStyle}"
                            IsEnabled="{Binding HasPlaybackContext}"
                            Command="{Binding PreviousChapterCommand}"
                            ToolTip="上一章"
                            AutomationProperties.Name="上一章">
                        <ui:SymbolIcon Symbol="ChevronDoubleLeft20" />
                    </Button>
                    <Button x:Name="MiniPlayerPreviousSegmentButton"
                            Margin="{StaticResource ToolbarItemTrailingMargin}"
                            Style="{StaticResource MediaIconButtonStyle}"
                            IsEnabled="{Binding CanGoToPreviousSegment}"
                            Command="{Binding PreviousSegmentCommand}"
                            ToolTip="上一段"
                            AutomationProperties.Name="上一段">
                        <ui:SymbolIcon Symbol="ArrowPrevious24" />
                    </Button>
                    <Button x:Name="MiniPlayerPlaybackButton"
                            Margin="{StaticResource ToolbarItemTrailingMargin}"
                            Style="{StaticResource PrimaryPlaybackIconButtonStyle}"
                            IsEnabled="{Binding CanTogglePlayback}"
                            Command="{Binding TogglePlaybackCommand}"
                            ToolTip="{Binding PlaybackActionText}"
                            AutomationProperties.Name="{Binding PlaybackActionText}">
                        <ui:SymbolIcon>
                            <ui:SymbolIcon.Style>
                                <Style TargetType="ui:SymbolIcon">
                                    <Setter Property="Symbol" Value="PlayCircle24" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PlaybackActionText}" Value="暂停">
                                            <Setter Property="Symbol" Value="PauseCircle24" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:SymbolIcon.Style>
                        </ui:SymbolIcon>
                    </Button>
                    <Button x:Name="MiniPlayerNextSegmentButton"
                            Margin="{StaticResource ToolbarItemTrailingMargin}"
                            Style="{StaticResource MediaIconButtonStyle}"
                            IsEnabled="{Binding CanGoToNextSegment}"
                            Command="{Binding NextSegmentCommand}"
                            ToolTip="下一段"
                            AutomationProperties.Name="下一段">
                        <ui:SymbolIcon Symbol="ArrowNext24" />
                    </Button>
                    <Button x:Name="MiniPlayerNextChapterButton"
                            Style="{StaticResource MediaIconButtonStyle}"
                            IsEnabled="{Binding HasPlaybackContext}"
                            Command="{Binding NextChapterCommand}"
                            ToolTip="下一章"
                            AutomationProperties.Name="下一章">
                        <ui:SymbolIcon Symbol="ChevronDoubleRight20" />
                    </Button>
                </StackPanel>
                <Button x:Name="MiniPlayerVolumeMenuButton"
                        Grid.Column="2"
                        Margin="8,0,0,0"
                        HorizontalAlignment="Right"
                        Style="{StaticResource MediaIconButtonStyle}"
                        Command="{Binding ToggleVolumeMenuCommand}"
                        ToolTip="播放音量"
                        AutomationProperties.Name="{Binding VolumeButtonAutomationName, FallbackValue=播放音量}">
                    <ui:SymbolIcon>
                        <ui:SymbolIcon.Style>
                            <Style TargetType="ui:SymbolIcon">
                                <Setter Property="Symbol" Value="Speaker224" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Volume}" Value="0">
                                        <Setter Property="Symbol" Value="SpeakerMute24" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:SymbolIcon.Style>
                    </ui:SymbolIcon>
                </Button>
            </Grid>

            <Popup x:Name="MiniPlayerVolumeMenuPopup"
                   PlacementTarget="{Binding ElementName=MiniPlayerVolumeMenuButton}"
                   Placement="Top"
                   HorizontalOffset="0"
                   VerticalOffset="-8"
                   AllowsTransparency="True"
                   StaysOpen="False"
                   IsOpen="{Binding IsVolumeMenuOpen, Mode=TwoWay}">
                <Border Width="280"
                        Padding="{StaticResource CardPadding}"
                        Style="{StaticResource PopupSurfaceBorderStyle}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Style="{StaticResource SectionTitleTextBlockStyle}"
                                       Text="播放音量" />
                            <TextBlock HorizontalAlignment="Right"
                                       Style="{StaticResource StrongTextBlockStyle}"
                                       Text="{Binding VolumePercentText}" />
                        </Grid>
                        <Slider x:Name="MiniPlayerVolumeSlider"
                                Width="232"
                                Margin="{StaticResource ContentSpacing}"
                                HorizontalAlignment="Left"
                                Style="{StaticResource PlaybackProgressSliderStyle}"
                                Minimum="0"
                                Maximum="1"
                                Value="{Binding Volume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                ToolTip="播放音量"
                                AutomationProperties.Name="播放音量" />
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
    </Border>
</Window>
