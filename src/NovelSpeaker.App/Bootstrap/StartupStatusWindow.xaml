<Window x:Class="NovelSpeaker.App.Bootstrap.StartupStatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:feedbackControls="clr-namespace:NovelSpeaker.App.Shared.Presentation.Controls.Feedback"
        Title="{Binding Title}"
        Width="420"
        Height="190"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="ToolWindow"
        ShowInTaskbar="False"
        Background="{DynamicResource App.Brush.Surface.Raised}">
    <Border x:Name="StartupBody"
            Padding="24,20"
            Background="Transparent"
            BorderThickness="0">
        <StackPanel VerticalAlignment="Center">
            <feedbackControls:AppStatusView x:Name="StartupStatusView"
                                            Title="{Binding StatusText}"
                                            Description="{Binding DetailText}"
                                            IsEmbedded="True"
                                            AutomationProperties.Name="{Binding StatusText}">
                <feedbackControls:AppStatusView.Style>
                    <Style TargetType="feedbackControls:AppStatusView"
                           BasedOn="{StaticResource {x:Type feedbackControls:AppStatusView}}">
                        <Setter Property="Status" Value="Loading" />
                        <Setter Property="Icon" Value="ArrowSync24" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                <Setter Property="Status" Value="Error" />
                                <Setter Property="Icon" Value="ErrorCircle24" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </feedbackControls:AppStatusView.Style>
            </feedbackControls:AppStatusView>
            <ProgressBar x:Name="StartupProgressBar"
                         Margin="0,16,0,0"
                         IsIndeterminate="True"
                         AutomationProperties.Name="启动进度">
                <ProgressBar.Style>
                    <Style TargetType="ProgressBar"
                           BasedOn="{StaticResource App.Progress.Standard}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ProgressBar.Style>
            </ProgressBar>
        </StackPanel>
    </Border>
</Window>
