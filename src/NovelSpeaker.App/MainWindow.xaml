<ui:FluentWindow x:Class="NovelSpeaker.App.MainWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  Title="NovelSpeaker"
                  Width="1280"
                  Height="820"
                  MinWidth="900"
                  MinHeight="640"
                  Background="{StaticResource ThemeWindowBackgroundBrush}">
    <ui:NavigationView x:Name="RootNavigationView"
                       PaneTitle="NovelSpeaker"
                       OpenPaneLength="{StaticResource NavigationPaneOpenWidth}"
                       CompactPaneLength="{StaticResource NavigationPaneCompactWidth}"
                       IsBackButtonVisible="Collapsed"
                       IsPaneToggleVisible="False"
                       IsFooterSeparatorVisible="False"
                       PaneDisplayMode="Left"
                       Background="{StaticResource ThemePageBackgroundBrush}">
        <ui:NavigationView.TitleBar>
            <ui:TitleBar Title="NovelSpeaker"
                         ShowMinimize="True"
                         ShowMaximize="True"
                         ShowClose="True" />
        </ui:NavigationView.TitleBar>

        <ui:NavigationView.MenuItems>
            <ui:NavigationViewItem x:Name="LibraryNavigationItem"
                                   Tag="Library"
                                   Content="书库"
                                   Click="PrimaryNavigationItem_OnClick">
                <ui:NavigationViewItem.Icon>
                    <ui:SymbolIcon Symbol="Book24" />
                </ui:NavigationViewItem.Icon>
            </ui:NavigationViewItem>
            <ui:NavigationViewItem x:Name="SettingsNavigationItem"
                                   Tag="Settings"
                                   Content="设置"
                                   Click="PrimaryNavigationItem_OnClick">
                <ui:NavigationViewItem.Icon>
                    <ui:SymbolIcon Symbol="Settings24" />
                </ui:NavigationViewItem.Icon>
            </ui:NavigationViewItem>
        </ui:NavigationView.MenuItems>

        <ui:NavigationView.FooterMenuItems>
            <ui:NavigationViewItem x:Name="PlaybackNavigationItem"
                                   Visibility="Collapsed"
                                   Content="正在播放">
                <ui:NavigationViewItem.Icon>
                    <ui:SymbolIcon Symbol="Headphones24" />
                </ui:NavigationViewItem.Icon>
            </ui:NavigationViewItem>
        </ui:NavigationView.FooterMenuItems>
    </ui:NavigationView>
</ui:FluentWindow>
