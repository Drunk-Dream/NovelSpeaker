<Page x:Class="NovelSpeaker.App.Features.ChapterRules.ChapterRulesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:commonControls="clr-namespace:NovelSpeaker.App.Shared.Presentation.Controls.Common"
      xmlns:feedbackControls="clr-namespace:NovelSpeaker.App.Shared.Presentation.Controls.Feedback"
      xmlns:formControls="clr-namespace:NovelSpeaker.App.Shared.Presentation.Controls.Forms"
      xmlns:navigation="clr-namespace:NovelSpeaker.App.Shell.Navigation"
      xmlns:rules="clr-namespace:NovelSpeaker.App.Shared.Presentation.Rules"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      MinHeight="0"
      Background="Transparent"
      ClipToBounds="True"
      navigation:NavigationViewportHeightBehavior.IsEnabled="True">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Page.Resources>

    <Grid Margin="24" MinHeight="0" ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <commonControls:AppPageHeader x:Name="PageHeader"
                                      Title="章节规则"
                                      BackCommand="{Binding BackCommand}">
            <commonControls:AppPageHeader.Actions>
                <WrapPanel x:Name="PageActions"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           ItemHeight="40">
                    <Button Margin="0,0,8,0"
                            Style="{StaticResource App.Button.Icon}"
                            Command="{Binding NewRuleCommand}"
                            ToolTip="新建规则"
                            AutomationProperties.Name="新建规则">
                        <ui:SymbolIcon Symbol="DocumentAdd24"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button Margin="0,0,8,0"
                            Style="{StaticResource App.Button.Icon}"
                            Click="ImportRuleFileButton_OnClick"
                            ToolTip="从文件导入"
                            AutomationProperties.Name="从文件导入">
                        <ui:SymbolIcon Symbol="ArrowImport24"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button Margin="0,0,8,0"
                            Style="{StaticResource App.Button.Icon}"
                            Click="ImportRulesFromClipboardButton_OnClick"
                            ToolTip="从剪切板导入"
                            AutomationProperties.Name="从剪切板导入">
                        <ui:SymbolIcon Symbol="ClipboardPaste24"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button Margin="0,0,8,0"
                            Style="{StaticResource App.Button.Icon}"
                            Command="{Binding ImportDefaultsCommand}"
                            ToolTip="导入默认规则"
                            AutomationProperties.Name="导入默认规则">
                        <ui:SymbolIcon Symbol="ArrowDownload24"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button Margin="0,0,8,0"
                            Style="{StaticResource App.Button.Icon}"
                            Command="{Binding RestoreDefaultsCommand}"
                            ToolTip="恢复默认规则"
                            AutomationProperties.Name="恢复默认规则">
                        <ui:SymbolIcon Symbol="ArrowReset24"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button Style="{StaticResource App.Button.Icon}"
                            Command="{Binding OpenHelpCommand}"
                            ToolTip="章节规则帮助"
                            AutomationProperties.Name="章节规则帮助">
                        <ui:SymbolIcon Symbol="QuestionCircle24"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                </WrapPanel>
            </commonControls:AppPageHeader.Actions>
        </commonControls:AppPageHeader>

        <Grid Grid.Row="1" Margin="0,20,0,0" MinHeight="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="280" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="3*" MinWidth="420" />
            </Grid.ColumnDefinitions>

            <commonControls:AppSectionSurface x:Name="RulesSurface"
                                              Grid.Column="0"
                                              Header="规则列表"
                                              Description="{Binding Rules.Count, StringFormat=共 {0} 条规则}">
                <Grid MinHeight="0">
                    <Border VerticalAlignment="Top">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource App.Feedback.InlineMessage}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Rules.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Style="{StaticResource App.Typography.Secondary}"
                                   Text="还没有章节规则，请使用页首操作新建或导入。"
                                   TextWrapping="Wrap" />
                    </Border>

                    <ListBox x:Name="RulesList"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemsSource="{Binding Rules}"
                             ScrollViewer.CanContentScroll="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <rules:RuleListItemView Title="{Binding Name}"
                                                        Summary="{Binding PatternSummary}"
                                                        IsRuleEnabled="{Binding IsEnabled}"
                                                        IsSelected="{Binding IsSelected}"
                                                        IsSortable="True"
                                                        SelectCommand="{Binding DataContext.SelectRuleCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                        ToggleEnabledCommand="{Binding DataContext.ToggleRuleEnabledCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                        ExportCommand="{Binding DataContext.ExportRuleCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                        CopyCommand="{Binding DataContext.CopyRuleCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                        MoveUpCommand="{Binding DataContext.MoveRuleUpCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                        MoveDownCommand="{Binding DataContext.MoveRuleDownCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                        DeleteCommand="{Binding DataContext.DeleteRuleCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                        ReorderCommand="{Binding DataContext.ReorderRuleCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                        CommandParameter="{Binding}"
                                                        CanExport="{Binding CanQuickActions}"
                                                        CanCopy="{Binding CanQuickActions}"
                                                        CanDelete="{Binding CanDeleteAction}"
                                                        CanMoveUp="{Binding CanMoveUp}"
                                                        CanMoveDown="{Binding CanMoveDown}"
                                                        AutomationProperties.Name="{Binding AutomationName}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </commonControls:AppSectionSurface>

            <commonControls:AppSectionSurface x:Name="EditorSurface"
                                              Grid.Column="2"
                                              Header="规则编辑">
                <Grid MinHeight="0">
                    <feedbackControls:AppStatusView HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Center"
                                                    Status="Empty"
                                                    Icon="DocumentEdit24"
                                                    Title="选择一条规则"
                                                    Description="从左侧单击规则打开编辑器，或使用页首操作新建规则。">
                        <feedbackControls:AppStatusView.Style>
                            <Style TargetType="feedbackControls:AppStatusView"
                                   BasedOn="{StaticResource {x:Type feedbackControls:AppStatusView}}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasEditor}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </feedbackControls:AppStatusView.Style>
                    </feedbackControls:AppStatusView>

                    <ScrollViewer x:Name="RuleEditorScrollViewer"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasEditor}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <StackPanel>
                            <formControls:AppFormField Label="名称"
                                                       Required="True"
                                                       Error="{Binding NameValidationMessage}">
                                <TextBox Style="{StaticResource App.Input.TextBox.Standard}"
                                         Text="{Binding DraftName, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="规则名称" />
                            </formControls:AppFormField>

                            <formControls:AppFormField Margin="0,16,0,0"
                                                       Label="正则表达式"
                                                       Required="True"
                                                       Error="{Binding PatternValidationMessage}">
                                <TextBox MinHeight="112"
                                         Style="{StaticResource App.Input.TextBox.Standard}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         Text="{Binding DraftPattern, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="章节标题正则表达式" />
                            </formControls:AppFormField>

                            <WrapPanel Margin="0,20,0,0" HorizontalAlignment="Right">
                                <Button Margin="0,0,8,0"
                                        Style="{StaticResource App.Button.Subtle}"
                                        Command="{Binding CancelEditingCommand}"
                                        Content="取消"
                                        IsEnabled="{Binding CanCancelEditing}" />
                                <Button Style="{StaticResource App.Button.Primary}"
                                        Command="{Binding SaveDraftCommand}"
                                        Content="保存"
                                        IsEnabled="{Binding CanSaveDraft}" />
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </commonControls:AppSectionSurface>

            <Grid Grid.ColumnSpan="3"
                  Panel.ZIndex="10"
                  Visibility="{Binding IsHelpDrawerOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="380" />
                </Grid.ColumnDefinitions>
                <Button x:Name="HelpDrawerDismissOverlay"
                        Grid.Column="0"
                        Opacity="0.45"
                        Background="{DynamicResource App.Brush.Canvas}"
                        BorderThickness="0"
                        Command="{Binding CloseHelpCommand}"
                        ToolTip="关闭章节规则帮助"
                        AutomationProperties.Name="关闭章节规则帮助" />
                <Border x:Name="HelpDrawerBorder"
                        Grid.Column="1"
                        Padding="20"
                        Style="{StaticResource App.Feedback.PopupSurface}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource App.Typography.SectionTitle}"
                                       Text="章节规则帮助" />
                            <Button Grid.Column="1"
                                    Style="{StaticResource App.Button.Icon}"
                                    Command="{Binding CloseHelpCommand}"
                                    ToolTip="关闭帮助"
                                    AutomationProperties.Name="关闭帮助">
                                <ui:SymbolIcon Symbol="Dismiss24" />
                            </Button>
                        </Grid>
                        <ScrollViewer Grid.Row="1"
                                      Margin="0,16,0,0"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock Style="{StaticResource App.Typography.ItemTitle}" Text="规则如何生效" />
                                <TextBlock Margin="0,8,0,0"
                                           Style="{StaticResource App.Typography.Secondary}"
                                           Text="导入 TXT 时，应用会逐行检查标题。只使用已启用的规则，并按列表排序从前到后尝试；一行被第一个规则命中后，就会成为章节标题，该标题行不会进入章节正文。若完全没有识别到章节，会将整本书作为“全文”单章导入。"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,18,0,0"
                                           Style="{StaticResource App.Typography.ItemTitle}"
                                           Text="从一个规则开始" />
                                <TextBlock Margin="0,8,0,0"
                                           Style="{StaticResource App.Typography.Secondary}"
                                           Text="名称可写“中文章节”。正则可从下面的模式开始，再按小说标题调整："
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,8,0,0"
                                           FontFamily="Consolas"
                                           Style="{StaticResource App.Typography.Secondary}"
                                           Text="^\s*第[0-9一二三四五六七八九十百千零两]+章(?:\s+.+)?\s*$"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,18,0,0"
                                           Style="{StaticResource App.Typography.ItemTitle}"
                                           Text="正则小抄" />
                                <TextBlock Margin="0,8,0,0"
                                           Style="{StaticResource App.Typography.Secondary}"
                                           Text="^ 和 $ 分别限定行首、行尾，建议同时使用以免正文中的短语被误判；\s* 匹配可有可无的空白；(?:甲|乙) 表示匹配其中之一；(?:\s+.+)? 表示可选的标题副标题。保存时会按 CultureInvariant 规则校验正则是否有效。"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,18,0,0"
                                           Style="{StaticResource App.Typography.ItemTitle}"
                                           Text="内置规则覆盖什么" />
                                <TextBlock Margin="0,8,0,0"
                                           Style="{StaticResource App.Typography.Secondary}"
                                           Text="默认规则分别识别“第一章 初见”这类章节数字标题、“第十卷 风起”这类卷标，以及“序章”“楔子”“前言”“尾声”“后记”“番外 特别篇”等独立标题。它们可以编辑、启用和排序，但不能删除。"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,18,0,0"
                                           Style="{StaticResource App.Typography.ItemTitle}"
                                           Text="排序与误识别" />
                                <TextBlock Margin="0,8,0,0"
                                           Style="{StaticResource App.Typography.Secondary}"
                                           Text="越具体的规则应排在越前面，宽泛规则放在后面。若正文被误识别为标题，先加入 ^ 和 $，再收紧“第…章”等必要文字；若有标题漏掉，新建对应规则并上移到可能抢先命中的宽泛规则之前。"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,18,0,0"
                                           Style="{StaticResource App.Typography.ItemTitle}"
                                           Text="与正文正则替换的区别" />
                                <TextBlock Margin="0,8,0,0"
                                           Style="{StaticResource App.Typography.Secondary}"
                                           Text="章节规则只负责划分章节，不参与“正则替换”中的正文清理，也不会直接修改已导入的 content.txt。需要恢复初始内置配置时使用“恢复默认”；它不会删除你的自定义规则。"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
