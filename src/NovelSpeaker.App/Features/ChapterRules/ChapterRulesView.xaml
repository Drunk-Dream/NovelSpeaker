<UserControl x:Class="NovelSpeaker.App.Features.ChapterRules.ChapterRulesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

    </UserControl.Resources>

    <Grid Margin="{StaticResource PagePadding}"
          MinHeight="0"
          ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Style="{StaticResource BackIconButtonStyle}"
                        Command="{Binding BackCommand}"
                        ToolTip="返回"
                        AutomationProperties.Name="返回">
                    <ui:SymbolIcon Symbol="ChevronLeft24" />
                </Button>

                <TextBlock Grid.Column="1"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Style="{StaticResource PageTitleTextBlockStyle}"
                           Text="章节规则" />
            </Grid>

            <WrapPanel Grid.Column="1"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center">
                <Button Margin="0,0,12,0"
                        Padding="16,8"
                        Command="{Binding NewRuleCommand}"
                        Content="新建规则" />
                <Button Margin="0,0,12,0"
                        Padding="16,8"
                        Command="{Binding ImportDefaultsCommand}"
                        Content="导入默认" />
                <Button Margin="0,0,12,0"
                        Padding="16,8"
                        Command="{Binding RestoreDefaultsCommand}"
                        Content="恢复默认" />
                <Button Style="{StaticResource SecondaryIconButtonStyle}"
                        Command="{Binding OpenHelpCommand}"
                        ToolTip="章节规则帮助"
                        AutomationProperties.Name="章节规则帮助">
                    <ui:SymbolIcon Symbol="QuestionCircle24" />
                </Button>
            </WrapPanel>
        </Grid>

        <Grid Grid.Row="1"
              Margin="0,20,0,0"
              MinHeight="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource CardBorderStyle}">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top"
                                Margin="16,16,16,12">
                        <TextBlock Style="{StaticResource SectionTitleTextBlockStyle}"
                                   Text="规则列表" />
                        <TextBlock Margin="0,6,0,0"
                                   Style="{StaticResource SecondaryTextBlockStyle}"
                                   Text="{Binding Rules.Count, StringFormat=共 {0} 条规则}" />
                    </StackPanel>

                    <TextBlock Margin="16,0,16,16"
                               Text="还没有章节规则，先新建一条或导入默认规则。">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock"
                                   BasedOn="{StaticResource SecondaryTextBlockStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Rules.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ScrollViewer x:Name="RulesListScrollViewer"
                                  Margin="12,0,12,12"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Rules}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="0"
                                            Style="{StaticResource DropTargetListItemContainerStyle}"
                                            AllowDrop="True"
                                            DragEnter="RuleItem_OnDragEnter"
                                            DragLeave="RuleItem_OnDragLeave"
                                            DragOver="RuleItem_OnDragOver"
                                            Drop="RuleItem_OnDrop"
                                            AutomationProperties.Name="{Binding AutomationName}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Button Grid.RowSpan="2"
                                                    Padding="0"
                                                    Style="{StaticResource BorderlessListItemButtonStyle}"
                                                    Command="{Binding DataContext.SelectRuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    AutomationProperties.Name="{Binding AutomationName}"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Stretch"
                                                    Panel.ZIndex="0" />

                                            <StackPanel Grid.Row="0"
                                                        Margin="14,12,14,0"
                                                        IsHitTestVisible="False"
                                                        Panel.ZIndex="1">
                                                    <TextBlock Style="{StaticResource StrongTextBlockStyle}"
                                                               Text="{Binding Name}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Margin="0,8,0,0"
                                                               Style="{StaticResource SecondaryTextBlockStyle}"
                                                               Text="{Binding PatternSummary}"
                                                               TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <Grid Grid.Row="1"
                                                  Margin="14,12,14,12"
                                                  Panel.ZIndex="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <CheckBox Grid.Column="0"
                                                          VerticalAlignment="Center"
                                                          IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                                          IsEnabled="{Binding CanQuickActions}"
                                                          Command="{Binding DataContext.ToggleRuleEnabledCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="{Binding}"
                                                          Content="启用" />

                                                <Button Grid.Column="2"
                                                        Style="{StaticResource SecondaryIconButtonStyle}"
                                                        ToolTip="拖动排序"
                                                        AutomationProperties.Name="拖动排序"
                                                        IsEnabled="{Binding CanQuickActions}"
                                                        PreviewMouseLeftButtonDown="DragHandle_OnPreviewMouseLeftButtonDown"
                                                        PreviewMouseMove="DragHandle_OnPreviewMouseMove"
                                                        Tag="{Binding}">
                                                    <ui:SymbolIcon Symbol="ReOrder24" />
                                                </Button>

                                                <Button Grid.Column="4"
                                                        Style="{StaticResource SecondaryIconButtonStyle}"
                                                        Command="{Binding DataContext.MoveRuleUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        IsEnabled="{Binding CanMoveUp}"
                                                        ToolTip="上移"
                                                        AutomationProperties.Name="上移">
                                                    <ui:SymbolIcon Symbol="ArrowUp24" />
                                                </Button>

                                                <Button Grid.Column="6"
                                                        Style="{StaticResource SecondaryIconButtonStyle}"
                                                        Command="{Binding DataContext.MoveRuleDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        IsEnabled="{Binding CanMoveDown}"
                                                        ToolTip="下移"
                                                        AutomationProperties.Name="下移">
                                                    <ui:SymbolIcon Symbol="ArrowDown24" />
                                                </Button>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border Grid.Column="2"
                    Style="{StaticResource CardBorderStyle}">
                <Grid MinHeight="0">
                    <Border Margin="20"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            MaxWidth="420">
                        <Border.Style>
                            <Style TargetType="Border"
                                   BasedOn="{StaticResource CardBorderStyle}">
                                <Setter Property="Padding" Value="20" />
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasEditor}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock HorizontalAlignment="Center"
                                       Style="{StaticResource SectionTitleTextBlockStyle}"
                                       Text="选择一条规则" />
                            <TextBlock Margin="0,10,0,0"
                                       HorizontalAlignment="Center"
                                       Style="{StaticResource SecondaryTextBlockStyle}"
                                       Text="左侧选择已有规则，或使用顶部按钮新建规则、导入默认规则。"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <ScrollViewer x:Name="RuleEditorScrollViewer"
                                  Margin="20"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasEditor}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>

                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitleTextBlockStyle}"
                                       Text="规则编辑" />

                            <StackPanel Margin="0,20,0,0">
                                <TextBlock Style="{StaticResource StrongTextBlockStyle}"
                                           Text="名称" />
                                <TextBox Margin="0,6,0,0"
                                         Text="{Binding DraftName, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Margin="0,6,0,0"
                                           Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                           Text="{Binding NameValidationMessage}"
                                           TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock"
                                               BasedOn="{StaticResource SecondaryTextBlockStyle}">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding NameValidationMessage}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <TextBlock Margin="0,18,0,0"
                                       Style="{StaticResource StrongTextBlockStyle}"
                                       Text="正则表达式" />
                            <TextBox Margin="0,6,0,0"
                                     AcceptsReturn="True"
                                     MinHeight="88"
                                     TextWrapping="Wrap"
                                     Text="{Binding DraftPattern, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="0,6,0,0"
                                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                       Text="{Binding PatternValidationMessage}"
                                       TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock"
                                           BasedOn="{StaticResource SecondaryTextBlockStyle}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PatternValidationMessage}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBlock Margin="0,18,0,0"
                                       Style="{StaticResource SecondaryTextBlockStyle}"
                                       Text="{Binding DeleteRestrictionMessage}"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding ShowDeleteRestrictionMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />

                            <Grid Margin="0,24,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="1"
                                        Padding="16,8"
                                        Command="{Binding DeleteRuleCommand}"
                                        IsEnabled="{Binding CanDeleteCurrentRule}"
                                        Content="删除" />
                                <Button Grid.Column="3"
                                        Padding="16,8"
                                        Command="{Binding CancelEditingCommand}"
                                        IsEnabled="{Binding CanCancelEditing}"
                                        Content="取消" />
                                <Button Grid.Column="5"
                                        Padding="16,8"
                                        Command="{Binding SaveDraftCommand}"
                                        IsEnabled="{Binding CanSaveDraft}"
                                        Content="保存" />
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Grid Grid.ColumnSpan="3"
                  Panel.ZIndex="10"
                  Visibility="{Binding IsHelpDrawerOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="380" />
                </Grid.ColumnDefinitions>

                <Button x:Name="HelpDrawerDismissOverlay"
                        Grid.Column="0"
                        AutomationProperties.Name="关闭章节规则帮助"
                        ToolTip="关闭章节规则帮助"
                        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                        BorderThickness="0"
                        Command="{Binding CloseHelpCommand}" />

                <Border x:Name="HelpDrawerBorder"
                        Grid.Column="1"
                        Padding="20"
                        Style="{StaticResource PopupSurfaceBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource SectionTitleTextBlockStyle}"
                                       Text="章节规则帮助" />
                            <Button Grid.Column="1"
                                    Style="{StaticResource SecondaryIconButtonStyle}"
                                    Command="{Binding CloseHelpCommand}"
                                    ToolTip="关闭帮助"
                                    AutomationProperties.Name="关闭帮助">
                                <ui:SymbolIcon Symbol="Dismiss24" />
                            </Button>
                        </Grid>

                        <ScrollViewer Grid.Row="1"
                                      Margin="0,16,0,0"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock Style="{StaticResource StrongTextBlockStyle}" Text="规则如何生效" />
                                <TextBlock Margin="0,8,0,0"
                                           Style="{StaticResource SecondaryTextBlockStyle}"
                                           Text="导入 TXT 时，应用会逐行检查标题。只使用已启用的规则，并按列表排序从前到后尝试；一行被第一个规则命中后，就会成为章节标题，该标题行不会进入章节正文。若完全没有识别到章节，会将整本书作为“全文”单章导入。"
                                           TextWrapping="Wrap" />

                                <TextBlock Margin="0,18,0,0"
                                           Style="{StaticResource StrongTextBlockStyle}"
                                           Text="从一个规则开始" />
                                <TextBlock Margin="0,8,0,0"
                                           Style="{StaticResource SecondaryTextBlockStyle}"
                                           Text="名称可写“中文章节”。正则可从下面的模式开始，再按小说标题调整："
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,8,0,0"
                                           FontFamily="Consolas"
                                           Style="{StaticResource SecondaryTextBlockStyle}"
                                           Text="^\s*第[0-9一二三四五六七八九十百千零两]+章(?:\s+.+)?\s*$"
                                           TextWrapping="Wrap" />

                                <TextBlock Margin="0,18,0,0"
                                           Style="{StaticResource StrongTextBlockStyle}"
                                           Text="正则小抄" />
                                <TextBlock Margin="0,8,0,0"
                                           Style="{StaticResource SecondaryTextBlockStyle}"
                                           Text="^ 和 $ 分别限定行首、行尾，建议同时使用以免正文中的短语被误判；\s* 匹配可有可无的空白；(?:甲|乙) 表示匹配其中之一；(?:\s+.+)? 表示可选的标题副标题。保存时会按 CultureInvariant 规则校验正则是否有效。"
                                           TextWrapping="Wrap" />

                                <TextBlock Margin="0,18,0,0"
                                           Style="{StaticResource StrongTextBlockStyle}"
                                           Text="内置规则覆盖什么" />
                                <TextBlock Margin="0,8,0,0"
                                           Style="{StaticResource SecondaryTextBlockStyle}"
                                           Text="默认规则分别识别“第一章 初见”这类章节数字标题、“第十卷 风起”这类卷标，以及“序章”“楔子”“前言”“尾声”“后记”“番外 特别篇”等独立标题。它们可以编辑、启用和排序，但不能删除。"
                                           TextWrapping="Wrap" />

                                <TextBlock Margin="0,18,0,0"
                                           Style="{StaticResource StrongTextBlockStyle}"
                                           Text="排序与误识别" />
                                <TextBlock Margin="0,8,0,0"
                                           Style="{StaticResource SecondaryTextBlockStyle}"
                                           Text="越具体的规则应排在越前面，宽泛规则放在后面。若正文被误识别为标题，先加入 ^ 和 $，再收紧“第…章”等必要文字；若有标题漏掉，新建对应规则并上移到可能抢先命中的宽泛规则之前。"
                                           TextWrapping="Wrap" />

                                <TextBlock Margin="0,18,0,0"
                                           Style="{StaticResource StrongTextBlockStyle}"
                                           Text="与正文正则替换的区别" />
                                <TextBlock Margin="0,8,0,0"
                                           Style="{StaticResource SecondaryTextBlockStyle}"
                                           Text="章节规则只负责划分章节，不参与“正则替换”中的正文清理，也不会直接修改已导入的 content.txt。需要恢复初始内置配置时使用“恢复默认”；它不会删除你的自定义规则。"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
