<Page x:Class="NovelSpeaker.App.Features.Playback.PlayerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:views="clr-namespace:NovelSpeaker.App.Features.Playback.Components"
      Background="Transparent"
      Loaded="PlayerPage_OnLoaded"
      Unloaded="PlayerPage_OnUnloaded">
    <!-- Stay bounded until the navigation viewport is attached in Loaded. -->
    <Grid x:Name="RootViewport"
          Height="0"
          MinHeight="0">
        <views:PlayerView x:Name="PlayerView"
                          VerticalAlignment="Stretch"
                          HorizontalAlignment="Stretch" />
    </Grid>
</Page>
