<UserControl x:Class="NovelSpeaker.App.Features.Playback.Components.PlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:presentation="clr-namespace:NovelSpeaker.App.Features.Playback.Presentation"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             PreviewKeyDown="PlayerView_OnPreviewKeyDown">
    <Grid Margin="{StaticResource PagePadding}"
          MinHeight="0"
          ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="BackButton"
                        Style="{StaticResource BackIconButtonStyle}"
                        Command="{Binding BackCommand}"
                        ToolTip="返回"
                        AutomationProperties.Name="返回">
                    <ui:SymbolIcon Symbol="ChevronLeft24" />
                </Button>
                <TextBlock Grid.Column="1"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Style="{StaticResource SectionTitleTextBlockStyle}"
                           Text="{Binding CurrentTitle}"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap" />
            </Grid>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <Button x:Name="ActiveCacheToolButton"
                        Style="{StaticResource SecondaryIconButtonStyle}"
                        Command="{Binding EnterActiveCacheSelectionCommand}"
                        ToolTip="主动缓存章节"
                        AutomationProperties.Name="主动缓存章节">
                    <ui:SymbolIcon Symbol="ArrowDownload24" />
                </Button>
                <Button x:Name="MiniPlayerToolButton"
                        Margin="12,0,0,0"
                        Style="{StaticResource SecondaryIconButtonStyle}"
                        Command="{Binding OpenMiniPlayerCommand}"
                        ToolTip="迷你播放器"
                        AutomationProperties.Name="迷你播放器">
                    <ui:SymbolIcon Symbol="WindowNew24" />
                </Button>
                <Button x:Name="RuleMenuButton"
                        Margin="12,0,0,0"
                        Style="{StaticResource SecondaryIconButtonStyle}"
                        Command="{Binding ToggleRuleMenuCommand}"
                        ToolTip="切换规则"
                        AutomationProperties.Name="切换规则">
                    <ui:SymbolIcon Symbol="TextBulletListSquare24" />
                </Button>
                <Button x:Name="StopTimerToolButton"
                        Margin="12,0,0,0"
                        Style="{StaticResource ToolbarValueButtonStyle}"
                        Command="{Binding ToggleStopTimerMenuCommand}"
                        IsEnabled="{Binding CanScheduleStopTimer}"
                        ToolTip="定时停止"
                        AutomationProperties.Name="{Binding StopTimerButtonAutomationName, FallbackValue=定时停止}">
                    <Border x:Name="StopTimerPillBorder"
                            Width="80"
                            Height="{StaticResource TextControlHeight}"
                            Padding="12,0"
                            Background="{DynamicResource SecondarySurfaceBrush}"
                            BorderBrush="{DynamicResource SubtleBorderBrush}"
                            BorderThickness="{StaticResource StandardBorderThickness}"
                            CornerRadius="{StaticResource ToolbarPillCornerRadius}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Clock24" />
                            <TextBlock Margin="{StaticResource InlineGapMargin}"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource StrongTextBlockStyle}"
                                       Text="{Binding StopTimerRemainingText}" />
                        </StackPanel>
                    </Border>
                </Button>
                <Button x:Name="SpeedMenuButton"
                        Margin="12,0,0,0"
                        Style="{StaticResource ToolbarValueButtonStyle}"
                        Command="{Binding ToggleSpeedMenuCommand}"
                        ToolTip="调整语速"
                        AutomationProperties.Name="{Binding SpeakSpeedButtonText}">
                    <Border x:Name="SpeedMenuPillBorder"
                            Width="80"
                            Height="{StaticResource TextControlHeight}"
                            Padding="12,0"
                            Background="{DynamicResource SecondarySurfaceBrush}"
                            BorderBrush="{DynamicResource SubtleBorderBrush}"
                            BorderThickness="{StaticResource StandardBorderThickness}"
                            CornerRadius="{StaticResource ToolbarPillCornerRadius}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Speaker124" />
                            <TextBlock Margin="{StaticResource InlineGapMargin}"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource StrongTextBlockStyle}"
                                       Text="{Binding SpeakSpeed}" />
                        </StackPanel>
                    </Border>
                </Button>
            </StackPanel>

            <Popup x:Name="StopTimerPopup"
                   PlacementTarget="{Binding ElementName=StopTimerToolButton}"
                   Placement="Bottom"
                   HorizontalOffset="0"
                   VerticalOffset="8"
                   AllowsTransparency="True"
                   StaysOpen="False"
                   IsOpen="{Binding IsStopTimerMenuOpen, Mode=TwoWay}">
                <Border Width="320"
                        Padding="{StaticResource CardPadding}"
                        Style="{StaticResource PopupSurfaceBorderStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleTextBlockStyle}"
                                   Text="定时停止" />
                        <WrapPanel Margin="{StaticResource ContentSpacing}">
                            <Button Margin="{StaticResource ToolbarActionMargin}"
                                    Padding="{StaticResource CompactActionPadding}"
                                    Command="{Binding ScheduleStopAfter15MinutesCommand}"
                                    Content="15 分钟" />
                            <Button Margin="{StaticResource ToolbarActionMargin}"
                                    Padding="{StaticResource CompactActionPadding}"
                                    Command="{Binding ScheduleStopAfter30MinutesCommand}"
                                    Content="30 分钟" />
                            <Button Margin="{StaticResource ToolbarActionMargin}"
                                    Padding="{StaticResource CompactActionPadding}"
                                    Command="{Binding ScheduleStopAfter45MinutesCommand}"
                                    Content="45 分钟" />
                            <Button Margin="{StaticResource ToolbarActionMargin}"
                                    Padding="{StaticResource CompactActionPadding}"
                                    Command="{Binding ScheduleStopAfter60MinutesCommand}"
                                    Content="60 分钟" />
                            <Button Margin="{StaticResource ToolbarActionMargin}"
                                    Padding="{StaticResource CompactActionPadding}"
                                    Command="{Binding ScheduleStopAfter90MinutesCommand}"
                                    Content="90 分钟" />
                        </WrapPanel>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="CustomStopMinutesTextBox"
                                     Height="{StaticResource InputControlHeight}"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding CustomStopMinutesText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="自定义分钟数，范围 1 到 1440"
                                     AutomationProperties.Name="自定义定时停止分钟数" />
                            <Button x:Name="CancelStopTimerButton"
                                    Grid.Column="1"
                                    Margin="{StaticResource ToolbarItemMargin}"
                                    Padding="{StaticResource ToolbarActionPadding}"
                                    Command="{Binding CancelStopTimerCommand}"
                                    Content="取消"
                                    IsEnabled="{Binding HasActiveStopTimer}"
                                    ToolTip="取消定时停止"
                                    AutomationProperties.Name="取消" />
                            <Button x:Name="ApplyCustomStopTimerButton"
                                    Grid.Column="2"
                                    Margin="{StaticResource ToolbarItemMargin}"
                                    Padding="{StaticResource ToolbarActionPadding}"
                                    Command="{Binding ScheduleCustomStopTimerCommand}"
                                    Content="应用"
                                    ToolTip="应用自定义定时停止"
                                    AutomationProperties.Name="应用自定义定时停止" />
                        </Grid>
                        <TextBlock Margin="{StaticResource FieldControlSpacing}"
                                   Text="{Binding CustomStopTimerErrorText}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock"
                                       BasedOn="{StaticResource ErrorTextBlockStyle}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CustomStopTimerErrorText}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Popup>

            <Popup x:Name="RuleMenuPopup"
                   PlacementTarget="{Binding ElementName=RuleMenuButton}"
                   Placement="Bottom"
                   HorizontalOffset="0"
                   VerticalOffset="8"
                   AllowsTransparency="True"
                   StaysOpen="False"
                   IsOpen="{Binding IsRuleMenuOpen, Mode=TwoWay}">
                <Border Width="320"
                        Padding="{StaticResource CardPadding}"
                        Style="{StaticResource PopupSurfaceBorderStyle}">
                    <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitleTextBlockStyle}"
                                       Text="切换规则" />
                            <TextBlock Margin="0,8,0,0"
                                       Style="{StaticResource SecondaryTextBlockStyle}"
                                       Text="当前规则仅在菜单中显示勾选。" />
                            <ItemsControl Margin="{StaticResource ContentSpacing}"
                                          ItemsSource="{Binding Rules}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Margin="0,0,0,8"
                                                Padding="12,8"
                                                Style="{StaticResource BorderlessListItemButtonStyle}"
                                                HorizontalContentAlignment="Stretch"
                                                IsEnabled="{Binding IsEnabled}"
                                                Command="{Binding DataContext.SelectRuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource PrimaryTextBlockStyle}"
                                                           Text="{Binding Name}" />
                                                <TextBlock Grid.Column="1"
                                                           Margin="12,0,0,0"
                                                           Text="当前">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock"
                                                               BasedOn="{StaticResource SecondaryTextBlockStyle}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Margin="0,12,0,0"
                                       Text="尚无可用规则。">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock"
                                           BasedOn="{StaticResource SecondaryTextBlockStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasRules}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Button Margin="0,12,0,0"
                                    Padding="{StaticResource SecondaryActionPadding}"
                                    HorizontalAlignment="Left"
                                    Command="{Binding OpenRulesManagementCommand}"
                                    Content="前往规则管理" />
                    </StackPanel>
                </Border>
            </Popup>

            <Popup x:Name="SpeedMenuPopup"
                   PlacementTarget="{Binding ElementName=SpeedMenuButton}"
                   Placement="Bottom"
                   HorizontalOffset="0"
                   VerticalOffset="8"
                   AllowsTransparency="True"
                   StaysOpen="False"
                   IsOpen="{Binding IsSpeedMenuOpen, Mode=TwoWay}">
                <Border Width="280"
                        Padding="{StaticResource CardPadding}"
                        Style="{StaticResource PopupSurfaceBorderStyle}">
                    <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitleTextBlockStyle}"
                                       Text="调整语速" />
                            <TextBlock Margin="0,8,0,0"
                                       Style="{StaticResource SecondaryTextBlockStyle}"
                                       Text="输入后端实际使用的原始整数值。" />
                            <Grid Margin="{StaticResource ContentSpacing}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="DecreaseSpeedButton"
                                        Grid.Column="0"
                                        Width="{StaticResource TextControlHeight}"
                                        Height="{StaticResource InputControlHeight}"
                                        Margin="{StaticResource ToolbarItemTrailingMargin}"
                                        Command="{Binding DecreaseSpeakSpeedCommand}"
                                        Content="-"
                                        IsEnabled="{Binding CanDecreaseSpeakSpeed}"
                                        ToolTip="降低语速"
                                        AutomationProperties.Name="降低语速" />
                                <TextBox x:Name="SpeedEditorTextBox"
                                         Grid.Column="1"
                                         Height="{StaticResource InputControlHeight}"
                                         VerticalContentAlignment="Center"
                                         HorizontalContentAlignment="Center"
                                         PreviewKeyDown="SpeedEditorTextBox_OnPreviewKeyDown"
                                         LostKeyboardFocus="SpeedEditorTextBox_OnLostKeyboardFocus"
                                         Text="{Binding SpeedEditorText, UpdateSourceTrigger=PropertyChanged}" />
                                <Button x:Name="IncreaseSpeedButton"
                                        Grid.Column="2"
                                        Width="{StaticResource TextControlHeight}"
                                        Height="{StaticResource InputControlHeight}"
                                        Margin="{StaticResource ToolbarItemMargin}"
                                        Command="{Binding IncreaseSpeakSpeedCommand}"
                                        Content="+"
                                        IsEnabled="{Binding CanIncreaseSpeakSpeed}"
                                        ToolTip="提高语速"
                                        AutomationProperties.Name="提高语速" />
                            </Grid>
                            <TextBlock Margin="0,8,0,0"
                                       Text="{Binding SpeedEditorErrorText}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock"
                                           BasedOn="{StaticResource ErrorTextBlockStyle}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SpeedEditorErrorText}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>

        <Grid Grid.Row="1"
              Margin="{StaticResource PageSectionSpacing}"
              MinHeight="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="CatalogPanelBorder"
                    MinHeight="0"
                    Padding="{StaticResource CardPaddingLarge}"
                    Style="{StaticResource CardBorderStyle}">
                    <DockPanel LastChildFill="True"
                               MinHeight="0">
                    <Grid DockPanel.Dock="Top"
                          Margin="0,0,0,14">
                        <TextBlock Text="目录">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock"
                                       BasedOn="{StaticResource SectionTitleTextBlockStyle}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsActiveCacheSelectionMode}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <StackPanel x:Name="ActiveCacheSelectionToolbar">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsActiveCacheSelectionMode}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Style="{StaticResource StrongTextBlockStyle}"
                                       Text="{Binding ActiveCacheSelectionSummary}" />
                            <TextBlock Margin="0,4,0,0"
                                       Style="{StaticResource SecondaryTextBlockStyle}"
                                       Text="{Binding ActiveCacheStatusText}"
                                       TextWrapping="Wrap" />
                            <WrapPanel Margin="{StaticResource FieldDescriptionSpacing}">
                                <Button x:Name="CancelActiveCacheSelectionButton"
                                        Padding="{StaticResource CompactActionPadding}"
                                        Command="{Binding CancelActiveCacheSelectionCommand}"
                                        Content="取消选择"
                                        ToolTip="取消选择"
                                        AutomationProperties.Name="取消选择" />
                                <Button x:Name="StartActiveCacheButton"
                                        Margin="{StaticResource ToolbarItemMargin}"
                                        Padding="{StaticResource CompactActionPadding}"
                                        Command="{Binding StartActiveCacheCommand}"
                                        Content="开始缓存"
                                        IsEnabled="{Binding CanStartActiveCache}"
                                        ToolTip="开始缓存"
                                        AutomationProperties.Name="开始缓存" />
                            </WrapPanel>
                        </StackPanel>
                    </Grid>
                    <Grid>
                        <ListBox x:Name="WideChaptersListBox"
                             MinHeight="0"
                             ItemsSource="{Binding Chapters}"
                             SelectedItem="{Binding CurrentChapterItem, Mode=OneWay}"
                             BorderThickness="0"
                             Background="Transparent"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.CanContentScroll="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <StaticResource ResourceKey="PlaybackChapterListItemContainerStyle" />
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource BorderlessListItemButtonStyle}"
                                        ToolTip="{Binding Title}"
                                        AutomationProperties.Name="{Binding AutomationName}"
                                        Click="ChapterButton_OnClick">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Style="{StaticResource PlaybackChapterCurrentIndicatorStyle}" />

                                        <Border Grid.Column="1"
                                                Style="{StaticResource PlaybackChapterStateBorderStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource PrimaryTextBlockStyle}"
                                                           Text="{Binding Title}"
                                                           TextWrapping="NoWrap"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" />
                                                <Border Grid.Column="1"
                                                        Margin="10,0,0,0"
                                                        Padding="8,2"
                                                        CornerRadius="{StaticResource PillCornerRadius}"
                                                        Background="{DynamicResource SecondarySurfaceBrush}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCachePercentageVisible}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Style="{StaticResource SecondaryTextBlockStyle}"
                                                               FontWeight="SemiBold"
                                                               Text="{Binding CachePercentageText}" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        </ListBox>

                        <Button x:Name="LocateCurrentChapterButton"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Margin="0,0,12,12"
                                Panel.ZIndex="2"
                                Visibility="Collapsed"
                                Click="LocateCurrentChapterButton_OnClick"
                                Style="{StaticResource FloatingIconButtonStyle}"
                                ToolTip="定位到当前章节"
                                AutomationProperties.Name="定位到当前章节">
                            <Border Width="{StaticResource FloatingIconButtonSize}"
                                    Height="{StaticResource FloatingIconButtonSize}"
                                    Background="{DynamicResource PrimarySurfaceBrush}"
                                    BorderBrush="{DynamicResource SubtleBorderBrush}"
                                    BorderThickness="{StaticResource StandardBorderThickness}"
                                    CornerRadius="{StaticResource PillCornerRadius}">
                                <ui:SymbolIcon HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Symbol="TargetArrow24" />
                            </Border>
                        </Button>
                    </Grid>
                </DockPanel>
            </Border>

            <Grid Grid.Column="2"
                  MinHeight="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Padding="{StaticResource CardPadding}"
                        Background="{DynamicResource SecondarySurfaceBrush}"
                        BorderBrush="{DynamicResource SubtleBorderBrush}"
                        BorderThickness="{StaticResource StandardBorderThickness}"
                        CornerRadius="{StaticResource DialogCornerRadius}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowPlaybackErrorBar}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource ErrorTextBlockStyle}"
                                   Text="{Binding ErrorText}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                        <WrapPanel Grid.Column="1"
                                   Margin="16,0,0,0"
                                   VerticalAlignment="Center">
                            <Button Margin="{StaticResource ToolbarItemTrailingMargin}"
                                    Padding="{StaticResource SecondaryActionPadding}"
                                    Command="{Binding RetryCurrentSegmentCommand}"
                                    Content="再次尝试"
                                    ToolTip="再次尝试"
                                    AutomationProperties.Name="再次尝试" />
                            <Button x:Name="ErrorRuleMenuButton"
                                    Style="{StaticResource SecondaryIconButtonStyle}"
                                    Command="{Binding OpenRuleMenuCommand}"
                                    ToolTip="切换规则"
                                    AutomationProperties.Name="切换规则">
                                <ui:SymbolIcon Symbol="TextBulletListSquare24" />
                            </Button>
                        </WrapPanel>
                    </Grid>
                </Border>

                <Border x:Name="PreviewPanelBorder"
                        Grid.Row="1"
                        MinHeight="0"
                        Padding="{StaticResource CardPaddingLarge}">
                    <Border.Style>
                        <Style TargetType="Border"
                               BasedOn="{StaticResource CardBorderStyle}">
                            <Setter Property="Margin" Value="0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowPlaybackErrorBar}" Value="True">
                                    <Setter Property="Margin" Value="0,16,0,0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid MinHeight="0"
                          ClipToBounds="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource SectionTitleTextBlockStyle}"
                                       Text="{Binding CurrentChapterTitle}"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap" />

                            <TextBlock Grid.Column="1"
                                       Text="{Binding DisplayedSegmentCounterText}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock"
                                           BasedOn="{StaticResource SecondaryTextBlockStyle}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowInlineLoadingState}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowInlineLoadingState}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <ProgressBar Width="52"
                                             Height="{StaticResource ProgressTrackHeight}"
                                             Margin="0,0,10,0"
                                             VerticalAlignment="Center"
                                             IsIndeterminate="True" />
                                <TextBlock Style="{StaticResource SecondaryTextBlockStyle}"
                                           AutomationProperties.LiveSetting="Polite"
                                           AutomationProperties.Name="播放加载状态"
                                           Text="{Binding InlineLoadingText}" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1"
                              Margin="0,14,0,0"
                              MinHeight="0">
                            <ListBox x:Name="SegmentListBox"
                                     PreviewMouseWheel="SegmentListBox_OnPreviewMouseWheel"
                                     PreviewKeyDown="SegmentListBox_OnPreviewKeyDown"
                                     MinHeight="0"
                                     ItemsSource="{Binding Segments}"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     HorizontalContentAlignment="Stretch"
                                     ScrollViewer.CanContentScroll="True"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.ScrollUnit="Pixel"
                                     VirtualizingPanel.VirtualizationMode="Recycling">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <StaticResource ResourceKey="PlaybackSegmentListItemContainerStyle" />
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Button Padding="0"
                                                Style="{StaticResource BorderlessListItemButtonStyle}"
                                                Command="{Binding DataContext.SelectSegmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding IsInteractive}">
                                            <Border HorizontalAlignment="Stretch"
                                                    Style="{StaticResource PlaybackSegmentStateBorderStyle}">
                                                <TextBlock Text="{Binding Text}"
                                                           TextWrapping="Wrap"
                                                           Opacity="{Binding VisualOpacity}"
                                                           LineHeight="28">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock"
                                                               BasedOn="{StaticResource PrimaryTextBlockStyle}">
                                                            <Setter Property="FontWeight" Value="Normal" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Button x:Name="ReturnToCurrentSegmentButton"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Margin="0,0,12,12"
                                    Panel.ZIndex="2"
                                    Command="{Binding ReturnToCurrentSegmentCommand}"
                                    ToolTip="返回当前段落"
                                    AutomationProperties.Name="返回当前段落">
                                <Border Width="{StaticResource FloatingIconButtonSize}"
                                        Height="{StaticResource FloatingIconButtonSize}"
                                        Background="{DynamicResource PrimarySurfaceBrush}"
                                        BorderBrush="{DynamicResource SubtleBorderBrush}"
                                        BorderThickness="{StaticResource StandardBorderThickness}"
                                        CornerRadius="{StaticResource PillCornerRadius}">
                                    <ui:SymbolIcon HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Symbol="TargetArrow24" />
                                </Border>
                                <Button.Style>
                                    <Style TargetType="Button"
                                           BasedOn="{StaticResource FloatingIconButtonStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowReturnToCurrentSegment}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Grid Grid.Row="2"
              Margin="{StaticResource PageSectionSpacing}"
              MinHeight="0">
            <Border x:Name="PlaybackFooterBorder"
                    Padding="{StaticResource CardPadding}">
                <Border.Style>
                    <Style TargetType="Border"
                           BasedOn="{StaticResource CardBorderStyle}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowPlaybackControls}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <Grid x:Name="PlaybackControlBar">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <WrapPanel x:Name="PlaybackMediaControls"
                                   Grid.Column="1"
                                   HorizontalAlignment="Center">
                            <Button x:Name="PreviousChapterButton"
                                    Margin="{StaticResource ButtonGapMargin}"
                                    Style="{StaticResource PreviousChapterMediaButtonStyle}"
                                    IsEnabled="{Binding CanGoToPreviousChapter}"
                                    Command="{Binding PreviousChapterCommand}"
                                    ToolTip="上一章"
                                    AutomationProperties.Name="上一章">
                                <ui:SymbolIcon Symbol="ChevronDoubleLeft20" />
                            </Button>
                            <Button x:Name="PreviousSegmentButton"
                                    Margin="{StaticResource ButtonGapMargin}"
                                    Style="{StaticResource PreviousSegmentMediaButtonStyle}"
                                    IsEnabled="{Binding CanGoToPreviousSegment}"
                                    Command="{Binding PreviousSegmentCommand}"
                                    ToolTip="上一段"
                                    AutomationProperties.Name="上一段">
                                <ui:SymbolIcon Symbol="ArrowPrevious24" />
                            </Button>
                            <Button x:Name="PrimaryPlaybackButton"
                                    Margin="{StaticResource ButtonGapMargin}"
                                    Style="{StaticResource PlaybackMediaButtonStyle}"
                                    IsEnabled="{Binding CanTogglePlayPause}"
                                    Command="{Binding TogglePlayPauseCommand}"
                                    ToolTip="{Binding PrimaryActionText}"
                                    AutomationProperties.Name="{Binding PrimaryActionText}">
                                <Border Width="{StaticResource PrimaryMediaControlButtonSize}"
                                        Height="{StaticResource PrimaryMediaControlButtonSize}"
                                        Background="{DynamicResource AccentBrush}"
                                        CornerRadius="{StaticResource MediaControlCornerRadius}">
                                    <ui:SymbolIcon HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="{StaticResource IconSize24}"
                                                   Foreground="{DynamicResource AccentForegroundBrush}">
                                        <ui:SymbolIcon.Style>
                                            <Style TargetType="ui:SymbolIcon">
                                                <Setter Property="Symbol" Value="PlayCircle24" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.PrimaryAction, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                 Value="{x:Static presentation:PlaybackPrimaryAction.Pause}">
                                                        <Setter Property="Symbol" Value="PauseCircle24" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:SymbolIcon.Style>
                                    </ui:SymbolIcon>
                                </Border>
                            </Button>
                            <Button x:Name="NextSegmentButton"
                                    Margin="{StaticResource ButtonGapMargin}"
                                    Style="{StaticResource NextSegmentMediaButtonStyle}"
                                    IsEnabled="{Binding CanGoToNextSegment}"
                                    Command="{Binding NextSegmentCommand}"
                                    ToolTip="下一段"
                                    AutomationProperties.Name="下一段">
                                <ui:SymbolIcon Symbol="ArrowNext24" />
                            </Button>
                            <Button x:Name="NextChapterButton"
                                    Style="{StaticResource NextChapterMediaButtonStyle}"
                                    IsEnabled="{Binding CanGoToNextChapter}"
                                    Command="{Binding NextChapterCommand}"
                                    ToolTip="下一章"
                                    AutomationProperties.Name="下一章">
                                <ui:SymbolIcon Symbol="ChevronDoubleRight20" />
                            </Button>
                        </WrapPanel>
                        <Button x:Name="VolumeMenuButton"
                                Grid.Column="2"
                                Margin="12,0,0,0"
                                HorizontalAlignment="Right"
                                Style="{StaticResource MediaIconButtonStyle}"
                                Command="{Binding ToggleVolumeMenuCommand}"
                                ToolTip="播放音量"
                                AutomationProperties.Name="{Binding VolumeButtonAutomationName, FallbackValue=播放音量}">
                            <ui:SymbolIcon>
                                <ui:SymbolIcon.Style>
                                    <Style TargetType="ui:SymbolIcon">
                                        <Setter Property="Symbol" Value="Speaker224" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Volume}" Value="0">
                                                <Setter Property="Symbol" Value="SpeakerMute24" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:SymbolIcon.Style>
                            </ui:SymbolIcon>
                        </Button>
                    </Grid>

                    <Grid Margin="{StaticResource ContentSpacing}">
                        <ProgressBar x:Name="SegmentProgressFillBar"
                                     VerticalAlignment="Center"
                                     IsHitTestVisible="False"
                                     Style="{StaticResource PlaybackProgressBarStyle}"
                                     Minimum="0"
                                     Maximum="{Binding SegmentProgressMaximum}"
                                     Value="{Binding SegmentProgressValue, Mode=OneWay}" />
                        <Slider x:Name="SegmentProgressSlider"
                                Style="{StaticResource PlaybackProgressSliderStyle}"
                                Minimum="0"
                                Maximum="{Binding SegmentProgressMaximum}"
                                Value="{Binding SegmentProgressValue, Mode=OneWay}"
                                IsSnapToTickEnabled="True"
                                TickFrequency="1"
                                ToolTipService.IsEnabled="False"
                                ToolTipService.InitialShowDelay="0"
                                MouseEnter="SegmentProgressSlider_OnMouseEnter"
                                MouseLeave="SegmentProgressSlider_OnMouseLeave"
                                ValueChanged="SegmentProgressSlider_OnValueChanged"
                                PreviewMouseLeftButtonDown="SegmentProgressSlider_OnPreviewMouseLeftButtonDown"
                                PreviewMouseLeftButtonUp="SegmentProgressSlider_OnPreviewMouseLeftButtonUp"
                                PreviewKeyDown="SegmentProgressSlider_OnPreviewKeyDown"
                                PreviewKeyUp="SegmentProgressSlider_OnPreviewKeyUp"
                                LostMouseCapture="SegmentProgressSlider_OnLostMouseCapture">
                            <Slider.ToolTip>
                                <ToolTip Content="{Binding PlacementTarget.DataContext.DisplayedSegmentCounterText, RelativeSource={RelativeSource Self}, FallbackValue=尚未定位段落}"
                                         StaysOpen="True" />
                            </Slider.ToolTip>
                        </Slider>
                    </Grid>
                </StackPanel>
            </Border>

            <Popup x:Name="VolumeMenuPopup"
                   PlacementTarget="{Binding ElementName=VolumeMenuButton}"
                   Placement="Top"
                   HorizontalOffset="0"
                   VerticalOffset="-8"
                   AllowsTransparency="True"
                   StaysOpen="False"
                   IsOpen="{Binding IsVolumeMenuOpen, Mode=TwoWay}">
                <Border Width="280"
                        Padding="{StaticResource CardPadding}"
                        Style="{StaticResource PopupSurfaceBorderStyle}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Style="{StaticResource SectionTitleTextBlockStyle}"
                                       Text="播放音量" />
                            <TextBlock HorizontalAlignment="Right"
                                       Style="{StaticResource StrongTextBlockStyle}"
                                       Text="{Binding VolumePercentText}" />
                        </Grid>
                        <Slider x:Name="VolumeSlider"
                                Width="232"
                                Margin="{StaticResource ContentSpacing}"
                                HorizontalAlignment="Left"
                                Style="{StaticResource PlaybackProgressSliderStyle}"
                                Minimum="0"
                                Maximum="1"
                                Value="{Binding Volume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                ToolTip="播放音量"
                                AutomationProperties.Name="播放音量" />
                    </StackPanel>
                </Border>
            </Popup>

            <Border x:Name="NoRuleFooterBorder"
                    Padding="{StaticResource CardPaddingLarge}">
                <Border.Style>
                    <Style TargetType="Border"
                           BasedOn="{StaticResource CardBorderStyle}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowNoRuleState}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource SectionTitleTextBlockStyle}"
                               Text="尚无可用的朗读规则" />
                    <TextBlock Margin="0,8,0,0"
                               Style="{StaticResource SecondaryTextBlockStyle}"
                               Text="先前往 TTS 规则页选择或导入一条可用规则，再回到当前书籍位置继续准备播放。"
                               TextWrapping="Wrap" />
                    <Button Margin="{StaticResource ContentSpacing}"
                            Padding="{StaticResource SecondaryActionPadding}"
                            HorizontalAlignment="Left"
                            Command="{Binding OpenRulesManagementCommand}"
                            Content="前往 TTS 规则" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
