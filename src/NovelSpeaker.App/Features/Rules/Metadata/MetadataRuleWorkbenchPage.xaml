<Page x:Class="NovelSpeaker.App.Features.Rules.Metadata.MetadataRuleWorkbenchPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:common="clr-namespace:NovelSpeaker.App.Shared.Presentation.Controls.Common"
      xmlns:rules="clr-namespace:NovelSpeaker.App.Shared.Presentation.Rules"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Background="Transparent">
    <Page.Resources>
    </Page.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <common:AppPageHeader Title="{Binding PageTitle}" BackCommand="{Binding BackCommand}">
            <common:AppPageHeader.Actions>
                <StackPanel Orientation="Horizontal">
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsManagementMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Margin="0,0,12,0" VerticalAlignment="Center"
                            Style="{StaticResource App.Typography.Body}" TextWrapping="NoWrap"
                            Text="{Binding SelectedCount, StringFormat=已选择 {0} 项}" />
                        <ui:Button Margin="0,0,8,0" Style="{StaticResource App.Button.Icon}" Command="{Binding SelectAllCommand}"
                            ToolTip="全选" AutomationProperties.Name="全选" Icon="{ui:SymbolIcon Symbol=SelectAllOn24}" />
                        <ui:Button Margin="0,0,8,0" Style="{StaticResource App.Button.Icon}" Command="{Binding ExportRuleCommand}"
                            ToolTip="导出" AutomationProperties.Name="导出" Icon="{ui:SymbolIcon Symbol=ArrowExport24}" />
                        <ui:Button Margin="0,0,8,0" Style="{StaticResource App.Button.DangerIcon}" Command="{Binding DeleteSelectedRulesCommand}"
                            ToolTip="删除" AutomationProperties.Name="删除" Icon="{ui:SymbolIcon Symbol=Delete24}" />
                        <ui:Button Margin="0" Style="{StaticResource App.Button.Icon}" Command="{Binding CancelManagementCommand}"
                            ToolTip="退出批量管理" AutomationProperties.Name="退出批量管理" Icon="{ui:SymbolIcon Symbol=Dismiss24}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsManagementMode}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <StackPanel Orientation="Horizontal">
                            <ui:Button Margin="0,0,8,0" Style="{StaticResource App.Button.Icon}" Command="{Binding NewRuleCommand}"
                                ToolTip="新建规则" AutomationProperties.Name="新建规则" Icon="{ui:SymbolIcon Symbol=DocumentAdd24}" />
                            <ui:Button Margin="0,0,8,0" Style="{StaticResource App.Button.Icon}" Command="{Binding ImportFileCommand}"
                                ToolTip="从文件导入" AutomationProperties.Name="从文件导入" Icon="{ui:SymbolIcon Symbol=ArrowImport24}" />
                            <ui:Button Margin="0" Style="{StaticResource App.Button.Icon}" Command="{Binding ImportClipboardCommand}"
                                ToolTip="从剪贴板导入" AutomationProperties.Name="从剪贴板导入" Icon="{ui:SymbolIcon Symbol=ClipboardPaste24}" />
                            <ui:Button Margin="12,0,0,0" Command="{Binding EnterManagementCommand}"
                                ToolTip="批量管理" AutomationProperties.Name="批量管理" Icon="{ui:SymbolIcon Symbol=MultiselectLtr24}">
                                <ui:Button.Style>
                                    <Style TargetType="{x:Type ui:Button}" BasedOn="{StaticResource App.Button.Icon}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsManagementMode}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                            </ui:Button>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </common:AppPageHeader.Actions>
        </common:AppPageHeader>

        <Grid Grid.Row="1" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="280" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="3*" MinWidth="360" />
            </Grid.ColumnDefinitions>
            <common:AppSectionSurface Grid.Column="0" Header="规则列表">
                <ListBox ItemsSource="{Binding Rules}"
                         Background="Transparent"
                         BorderThickness="0"
                         rules:RuleListDragBehavior.ReorderCommand="{Binding ReorderRuleCommand}"
                         ScrollViewer.CanContentScroll="True"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource App.Selection.ChromeFreeItemContainer}">
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <rules:RuleListItemView PreviewMouseRightButtonDown="ManagementItem_OnPreviewMouseRightButtonDown"
                                                    PreviewKeyDown="ManagementItem_OnPreviewKeyDown" Title="{Binding Name}"
                                                    Summary="{Binding PatternSummary}"
                                                    IsRuleEnabled="{Binding IsEnabled}"
                                                    IsSelected="{Binding IsSelected}"
                                                    IsSortable="{Binding DataContext.CanReorder, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CanToggle="{Binding DataContext.CanReorder, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CanExport="True"
                                                    CanCopy="True"
                                                    CanDelete="True"
                                                    CanMoveUp="True"
                                                    CanMoveDown="True"
                                                    SelectCommand="{Binding SelectionCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    ToggleEnabledCommand="{Binding DataContext.ToggleRuleEnabledCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    ExportCommand="{Binding DataContext.ExportRuleCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CopyCommand="{Binding DataContext.CopyRuleCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    MoveUpCommand="{Binding DataContext.MoveRuleUpCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    MoveDownCommand="{Binding DataContext.MoveRuleDownCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    DeleteCommand="{Binding DataContext.DeleteRuleCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </common:AppSectionSurface>

            <common:AppSectionSurface Grid.Column="2" Header="规则编辑">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding HasEditor, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Margin="16">
                        <TextBlock Text="名称" Margin="0,0,0,6" Style="{StaticResource App.Typography.FormLabel}" />
                        <TextBox Style="{StaticResource App.Input.TextBox.Standard}"
                                 Text="{Binding DraftName, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="规则名称" />
                        <TextBlock Text="正则表达式" Margin="0,18,0,6" Style="{StaticResource App.Typography.FormLabel}" />
                        <TextBox Style="{StaticResource App.Input.TextBox.Standard}"
                                 Text="{Binding DraftPattern, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="正则表达式" />
                        <TextBlock Text="{Binding ValidationMessage}" TextWrapping="Wrap" Margin="0,8,0,0"
                            Style="{StaticResource App.Typography.Validation}" />
                        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                            <ui:Button Content="保存" Command="{Binding SaveRuleCommand}" Margin="0,0,8,0" />
                            <ui:Button Content="取消" Command="{Binding CancelEditingCommand}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </common:AppSectionSurface>
        </Grid>
    </Grid>
</Page>
