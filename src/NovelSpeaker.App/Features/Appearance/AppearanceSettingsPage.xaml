<Page x:Class="NovelSpeaker.App.Features.Appearance.AppearanceSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Button Style="{StaticResource BackIconButtonStyle}"
                Command="{Binding BackCommand}"
                ToolTip="返回"
                AutomationProperties.Name="返回">
            <ui:SymbolIcon Symbol="ChevronLeft24" />
        </Button>

        <ScrollViewer Grid.Row="1"
                      Margin="{StaticResource PageSectionSpacing}"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitleTextBlockStyle}"
                           Text="外观" />

                <Border Margin="{StaticResource SectionSpacing}"
                        Style="{StaticResource SettingsRowsGroupBorderStyle}">
                    <Border x:Name="ThemeItemBorder"
                            Style="{StaticResource SettingsLastRowBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource SettingsRowTitleTextBlockStyle}"
                                           Text="应用主题" />
                                <TextBlock Style="{StaticResource SettingsRowDescriptionTextBlockStyle}"
                                           Text="跟随系统，或固定使用浅色、深色主题。" />
                            </StackPanel>
                            <ComboBox Grid.Column="1"
                                      Margin="{StaticResource SettingsRowControlMargin}"
                                      Width="{StaticResource SettingsRowControlWidth}"
                                      VerticalAlignment="Center"
                                      ItemsSource="{Binding AvailableThemes}"
                                      SelectedItem="{Binding SelectedTheme}"
                                      AutomationProperties.Name="应用主题" />
                        </Grid>
                    </Border>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
