<Page x:Class="NovelSpeaker.App.Features.Appearance.AppearanceSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:NovelSpeaker.App.Shared.Presentation.Controls.Settings"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Background="{DynamicResource AppBackgroundBrush}">
    <Grid Margin="{StaticResource PagePadding}"
          Background="{DynamicResource CanvasSurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Button x:Name="BackButton"
                Style="{StaticResource App.Button.Icon}"
                Command="{Binding BackCommand}"
                ToolTip="返回"
                AutomationProperties.Name="返回">
            <ui:SymbolIcon Symbol="ChevronLeft24" />
        </Button>

        <ScrollViewer Grid.Row="1"
                      Margin="0,20,0,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock x:Name="PageTitle"
                           Style="{StaticResource App.Typography.PageTitle}"
                           Text="外观" />

                <controls:AppSettingsRow x:Name="ThemeSettingRow"
                                         Margin="{StaticResource SectionSpacing}"
                                         Title="应用主题"
                                         Description="跟随系统，或固定使用浅色、深色主题。"
                                         Focusable="False"
                                         IsTabStop="False"
                                         AutomationProperties.Name="应用主题设置">
                    <ComboBox x:Name="ThemeComboBox"
                              MinWidth="180"
                              VerticalAlignment="Center"
                              Style="{StaticResource App.Input.ComboBox.Standard}"
                              ItemsSource="{Binding AvailableThemes, Mode=OneWay}"
                              SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                              AutomationProperties.Name="应用主题" />
                </controls:AppSettingsRow>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
