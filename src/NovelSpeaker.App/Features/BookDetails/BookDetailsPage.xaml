<Page x:Class="NovelSpeaker.App.Features.BookDetails.BookDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:navigation="clr-namespace:NovelSpeaker.App.Shell.Navigation"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:views="clr-namespace:NovelSpeaker.App.Shared.Presentation.Books">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

    </Page.Resources>

    <Border x:Name="RootViewport"
            Padding="{StaticResource PagePadding}"
            MinHeight="0"
            navigation:NavigationViewportHeightBehavior.IsEnabled="True"
            ClipToBounds="True">
        <Grid x:Name="RootLayout"
              MinHeight="0"
              ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Style="{StaticResource BackIconButtonStyle}"
                            Command="{Binding BackCommand}"
                            ToolTip="返回"
                            AutomationProperties.Name="返回">
                        <ui:SymbolIcon Symbol="ChevronLeft24" />
                    </Button>

                    <TextBlock Grid.Column="1"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               Style="{StaticResource PageTitleTextBlockStyle}"
                               Text="书籍详情" />
                </Grid>

                <WrapPanel Grid.Column="1"
                           Style="{StaticResource ToolbarPanelStyle}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center">
                    <Button Margin="{StaticResource ButtonGapMargin}"
                            Padding="{StaticResource ButtonPadding}"
                            Command="{Binding DeleteBookCommand}"
                            Content="删除" />
                    <Button Margin="{StaticResource ButtonGapMargin}"
                            Padding="{StaticResource ButtonPadding}"
                            Command="{Binding ClearCacheCommand}"
                            Content="清理" />
                    <Button Margin="{StaticResource ButtonGapMargin}"
                            Padding="{StaticResource ButtonPadding}"
                            Command="{Binding CancelEditCommand}"
                            Content="取消" />
                    <Button Padding="{StaticResource ButtonPadding}"
                            Command="{Binding SaveCommand}"
                            Content="保存" />
                </WrapPanel>
            </Grid>

            <Grid Grid.Row="1"
                  Margin="{StaticResource PageSectionSpacing}"
                  MinHeight="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="380" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        MinHeight="0"
                        Style="{StaticResource CardBorderStyle}">
                    <Grid Margin="{StaticResource CardContentPadding}"
                          MinHeight="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                    <views:BookCoverView Width="168"
                                         Height="224"
                                         HorizontalAlignment="Left"
                                         Cover="{Binding Cover}" />

                    <TextBlock Grid.Row="1"
                               Margin="{StaticResource ContentSpacing}"
                               Text="{Binding StatusMessage}"
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock"
                                   BasedOn="{StaticResource SecondaryTextBlockStyle}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusMessage}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                        <StackPanel Grid.Row="2"
                                    Margin="{StaticResource ContentSpacing}">
                        <TextBlock Style="{StaticResource SectionTitleTextBlockStyle}"
                                   Text="书籍信息" />

                        <TextBlock Margin="{StaticResource ContentSpacing}"
                                   Style="{StaticResource SecondaryTextBlockStyle}"
                                   Text="书名" />
                        <TextBox Margin="{StaticResource FieldControlSpacing}"
                                 Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Margin="{StaticResource ContentSpacing}"
                                   Style="{StaticResource SecondaryTextBlockStyle}"
                                   Text="作者" />
                        <TextBox Margin="{StaticResource FieldControlSpacing}"
                                 Text="{Binding EditAuthor, UpdateSourceTrigger=PropertyChanged}" />

                        <Grid Margin="{StaticResource ContentSpacing}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Style="{StaticResource SecondaryTextBlockStyle}"
                                       Text="章节总数" />
                            <TextBlock Grid.Column="1"
                                       HorizontalAlignment="Right"
                                       Style="{StaticResource StrongTextBlockStyle}"
                                       Text="{Binding TotalChapterCountText}"
                                       TextAlignment="Right" />

                            <TextBlock Grid.Row="1"
                                       Margin="{StaticResource ContentSpacing}"
                                       Style="{StaticResource SecondaryTextBlockStyle}"
                                       Text="当前章节" />
                            <TextBlock Grid.Row="1"
                                       Grid.Column="1"
                                       Margin="{StaticResource ContentSpacing}"
                                       HorizontalAlignment="Right"
                                       Style="{StaticResource StrongTextBlockStyle}"
                                       Text="{Binding CurrentChapterText}"
                                       TextAlignment="Right"
                                       TextTrimming="CharacterEllipsis" />

                            <TextBlock Grid.Row="2"
                                       Margin="{StaticResource ContentSpacing}"
                                       Style="{StaticResource SecondaryTextBlockStyle}"
                                       Text="阅读进度" />
                            <StackPanel Grid.Row="2"
                                        Grid.Column="1"
                                        Margin="{StaticResource ContentSpacing}"
                                        HorizontalAlignment="Right">
                                <ProgressBar Width="140"
                                             Style="{StaticResource PlaybackProgressBarStyle}"
                                             Maximum="1"
                                             Value="{Binding ProgressRatio}" />
                                <TextBlock Margin="{StaticResource FieldControlSpacing}"
                                           HorizontalAlignment="Right"
                                           Style="{StaticResource SecondaryTextBlockStyle}"
                                           Text="{Binding ProgressText}" />
                            </StackPanel>

                            <TextBlock Grid.Row="3"
                                       Margin="{StaticResource ContentSpacing}"
                                       Style="{StaticResource SecondaryTextBlockStyle}"
                                       Text="缓存占用" />
                            <TextBlock Grid.Row="3"
                                       Grid.Column="1"
                                       Margin="{StaticResource ContentSpacing}"
                                       HorizontalAlignment="Right"
                                       Style="{StaticResource StrongTextBlockStyle}"
                                       Text="{Binding CacheSizeText}"
                                       TextAlignment="Right" />
                        </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="2"
                        MinHeight="0"
                        Style="{StaticResource CardBorderStyle}">
                    <DockPanel LastChildFill="True"
                               Margin="{StaticResource CardContentPadding}"
                               MinHeight="0">
                        <StackPanel DockPanel.Dock="Top"
                                    Margin="0,0,0,16">
                            <TextBlock Style="{StaticResource SectionTitleTextBlockStyle}"
                                       Text="章节目录" />
                            <TextBlock Margin="{StaticResource FieldControlSpacing}"
                                       Style="{StaticResource SecondaryTextBlockStyle}"
                                       Text="{Binding ChapterCatalogSummaryText}" />
                        </StackPanel>

                        <Grid>
                            <ListBox x:Name="ChaptersListBox"
                                 MinHeight="0"
                                 ItemsSource="{Binding Chapters}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.CanContentScroll="True"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.ScrollUnit="Pixel"
                                 VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <StaticResource ResourceKey="VirtualizedListItemContainerStyle" />
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="0"
                                            Style="{StaticResource CurrentListItemContainerStyle}">
                                        <Button Style="{StaticResource BorderlessListItemButtonStyle}"
                                                Padding="{StaticResource ListRowPadding}"
                                                ToolTip="{Binding TitleToolTip}"
                                                AutomationProperties.Name="{Binding AutomationName}"
                                                Command="{Binding DataContext.SelectChapterCommand, ElementName=RootLayout}"
                                                CommandParameter="{Binding}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock VerticalAlignment="Center"
                                                           Style="{StaticResource SecondaryTextBlockStyle}"
                                                           Text="{Binding IndexText}" />

                                                <TextBlock Grid.Column="2"
                                                           VerticalAlignment="Center"
                                                           Style="{StaticResource StrongTextBlockStyle}"
                                                           Text="{Binding Title}"
                                                           TextTrimming="CharacterEllipsis"
                                                           TextWrapping="NoWrap" />

                                                <TextBlock Grid.Column="3"
                                                           Margin="12,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Text="{Binding CachePercentageText}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock"
                                                               BasedOn="{StaticResource SecondaryTextBlockStyle}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCachePercentageVisible}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </Button>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            </ListBox>

                            <Button x:Name="LocateCurrentChapterButton"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Margin="0,0,12,12"
                                    Panel.ZIndex="2"
                                    Visibility="Collapsed"
                                    Click="LocateCurrentChapterButton_OnClick"
                                    Style="{StaticResource FloatingIconButtonStyle}"
                                    ToolTip="定位到当前章节"
                                    AutomationProperties.Name="定位到当前章节">
                                <Border Width="{StaticResource FloatingIconButtonSize}"
                                        Height="{StaticResource FloatingIconButtonSize}"
                                        Background="{DynamicResource PrimarySurfaceBrush}"
                                        BorderBrush="{DynamicResource SubtleBorderBrush}"
                                        BorderThickness="{StaticResource StandardBorderThickness}"
                                        CornerRadius="{StaticResource PillCornerRadius}">
                                    <ui:SymbolIcon HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Symbol="TargetArrow24" />
                                </Border>
                            </Button>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Page>
