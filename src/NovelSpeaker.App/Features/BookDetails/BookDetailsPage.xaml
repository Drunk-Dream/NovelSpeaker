<Page x:Class="NovelSpeaker.App.Features.BookDetails.BookDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:commonControls="clr-namespace:NovelSpeaker.App.Shared.Presentation.Controls.Common"
      xmlns:feedbackControls="clr-namespace:NovelSpeaker.App.Shared.Presentation.Controls.Feedback"
      xmlns:navigation="clr-namespace:NovelSpeaker.App.Shell.Navigation"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:views="clr-namespace:NovelSpeaker.App.Shared.Presentation.Books"
      Background="Transparent">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Page.Resources>

    <Border x:Name="RootViewport"
            Padding="24"
            MinHeight="0"
            navigation:NavigationViewportHeightBehavior.IsEnabled="True"
            ClipToBounds="True">
        <Grid x:Name="RootLayout"
              MinHeight="0"
              ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <commonControls:AppPageHeader x:Name="PageHeader"
                                          Title="书籍详情"
                                          BackCommand="{Binding BackCommand}">
                <commonControls:AppPageHeader.Actions>
                    <WrapPanel HorizontalAlignment="Right">
                        <Button x:Name="DeleteBookButton"
                                Margin="0,0,8,0"
                                Style="{StaticResource App.Button.Danger}"
                                Command="{Binding DeleteBookCommand}"
                                Content="删除"
                                AutomationProperties.Name="删除书籍" />
                        <Button x:Name="ClearCacheButton"
                                Margin="0,0,8,0"
                                Style="{StaticResource App.Button.Secondary}"
                                Command="{Binding ClearCacheCommand}"
                                Content="清理"
                                AutomationProperties.Name="清理书籍缓存" />
                        <Button x:Name="CancelEditButton"
                                Margin="0,0,8,0"
                                Style="{StaticResource App.Button.Secondary}"
                                Command="{Binding CancelEditCommand}"
                                Content="取消"
                                AutomationProperties.Name="取消编辑" />
                        <Button x:Name="SaveBookButton"
                                Style="{StaticResource App.Button.Primary}"
                                Command="{Binding SaveCommand}"
                                Content="保存"
                                AutomationProperties.Name="保存书籍信息" />
                    </WrapPanel>
                </commonControls:AppPageHeader.Actions>
            </commonControls:AppPageHeader>

            <Grid Grid.Row="1"
                  Margin="0,20,0,0"
                  MinHeight="0">
                <Grid x:Name="BookWorkspace"
                      MinHeight="0">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasBook}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <commonControls:AppSectionSurface x:Name="BookInformationSurface"
                                                      Grid.Column="0"
                                                      MinHeight="0"
                                                      Header="书籍信息">
                        <ScrollViewer x:Name="BookInformationScrollViewer"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                            <views:BookCoverView Width="168"
                                                 Height="224"
                                                 HorizontalAlignment="Left"
                                                 Cover="{Binding Cover}" />

                            <Border x:Name="BookInlineStatusMessage"
                                    Margin="0,16,0,0">
                                <Border.Style>
                                    <Style TargetType="Border"
                                           BasedOn="{StaticResource App.Feedback.InlineMessage}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StatusMessage}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Style="{StaticResource App.Typography.Secondary}"
                                           Text="{Binding StatusMessage}" />
                            </Border>

                            <TextBlock Margin="0,16,0,0"
                                       Style="{StaticResource App.Typography.FormLabel}"
                                       Text="书名" />
                            <TextBox x:Name="TitleTextBox"
                                     Margin="0,6,0,0"
                                     Style="{StaticResource App.Input.TextBox.Standard}"
                                     Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="书名" />

                            <TextBlock Margin="0,16,0,0"
                                       Style="{StaticResource App.Typography.FormLabel}"
                                       Text="作者" />
                            <TextBox x:Name="AuthorTextBox"
                                     Margin="0,6,0,0"
                                     Style="{StaticResource App.Input.TextBox.Standard}"
                                     Text="{Binding EditAuthor, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="作者" />

                            <Grid Margin="0,20,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Style="{StaticResource App.Typography.Secondary}"
                                           Text="章节总数" />
                                <TextBlock Grid.Column="1"
                                           HorizontalAlignment="Right"
                                           Style="{StaticResource App.Typography.ItemTitle}"
                                           Text="{Binding TotalChapterCountText}"
                                           TextAlignment="Right" />

                                <TextBlock Grid.Row="1"
                                           Margin="0,14,0,0"
                                           Style="{StaticResource App.Typography.Secondary}"
                                           Text="当前章节" />
                                <TextBlock Grid.Row="1"
                                           Grid.Column="1"
                                           Margin="0,14,0,0"
                                           HorizontalAlignment="Right"
                                           Style="{StaticResource App.Typography.ItemTitle}"
                                           Text="{Binding CurrentChapterText}"
                                           ToolTip="{Binding CurrentChapterText}"
                                           TextAlignment="Right"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap" />

                                <TextBlock Grid.Row="2"
                                           Margin="0,14,0,0"
                                           Style="{StaticResource App.Typography.Secondary}"
                                           Text="阅读进度" />
                                <StackPanel Grid.Row="2"
                                            Grid.Column="1"
                                            Margin="0,14,0,0"
                                            HorizontalAlignment="Right">
                                    <ProgressBar x:Name="ReadingProgressBar"
                                                 Width="140"
                                                 Style="{StaticResource App.Progress.Compact}"
                                                 Maximum="1"
                                                 Value="{Binding ProgressRatio}"
                                                 AutomationProperties.Name="{Binding ProgressText, StringFormat=阅读进度 {0}}" />
                                    <TextBlock Margin="0,8,0,0"
                                               HorizontalAlignment="Right"
                                               Style="{StaticResource App.Typography.Secondary}"
                                               Text="{Binding ProgressText}" />
                                </StackPanel>

                                <TextBlock Grid.Row="3"
                                           Margin="0,14,0,0"
                                           Style="{StaticResource App.Typography.Secondary}"
                                           Text="缓存占用" />
                                <TextBlock Grid.Row="3"
                                           Grid.Column="1"
                                           Margin="0,14,0,0"
                                           HorizontalAlignment="Right"
                                           Style="{StaticResource App.Typography.ItemTitle}"
                                           Text="{Binding CacheSizeText}"
                                           TextAlignment="Right" />
                            </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </commonControls:AppSectionSurface>

                    <commonControls:AppSectionSurface x:Name="ChapterCatalogSurface"
                                                      Grid.Column="2"
                                                      MinHeight="0"
                                                      Header="章节目录"
                                                      Description="{Binding ChapterCatalogSummaryText}">
                        <Grid MinHeight="0">
                            <ListBox x:Name="ChaptersListBox"
                                     MinHeight="0"
                                     ItemsSource="{Binding Chapters}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ScrollViewer.CanContentScroll="True"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.ScrollUnit="Pixel"
                                     VirtualizingPanel.VirtualizationMode="Recycling">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem"
                                           BasedOn="{StaticResource App.Selection.ChromeFreeItemContainer}">
                                        <Setter Property="Margin" Value="0" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                        <Setter Property="Focusable" Value="False" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border MinHeight="0"
                                                Padding="0"
                                                Style="{StaticResource App.Selection.CurrentItem}">
                                            <Grid>
                                                <Button Margin="0"
                                                        Padding="0"
                                                        HorizontalAlignment="Stretch"
                                                        VerticalAlignment="Stretch"
                                                        Style="{StaticResource App.Button.InteractionHost}"
                                                        ToolTip="{Binding TitleToolTip}"
                                                        AutomationProperties.Name="{Binding AutomationName}"
                                                        Command="{Binding DataContext.SelectChapterCommand, ElementName=RootLayout}"
                                                        CommandParameter="{Binding}" />

                                                <Grid Margin="14,12"
                                                      IsHitTestVisible="False">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="12" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock VerticalAlignment="Center"
                                                               Style="{StaticResource App.Selection.Content.Secondary}"
                                                               Text="{Binding IndexText}" />

                                                    <TextBlock Grid.Column="2"
                                                               VerticalAlignment="Center"
                                                               Style="{StaticResource App.Selection.Content.Title}"
                                                               Text="{Binding Title}"
                                                               TextTrimming="CharacterEllipsis"
                                                               TextWrapping="NoWrap" />

                                                    <TextBlock Grid.Column="3"
                                                               Margin="12,0,0,0"
                                                               VerticalAlignment="Center"
                                                               FontWeight="SemiBold"
                                                               Style="{StaticResource App.Selection.Content.AccentSecondary}"
                                                               Text="{Binding CachePercentageText}"
                                                               Visibility="{Binding IsCachePercentageVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <ui:Button x:Name="LocateCurrentChapterButton"
                                    Margin="0,0,12,12"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Panel.ZIndex="2"
                                    Visibility="Collapsed"
                                    Click="LocateCurrentChapterButton_OnClick"
                                    Style="{StaticResource App.Button.FloatingIcon}"
                                    ToolTip="定位到当前章节"
                                    AutomationProperties.Name="定位到当前章节"
                                    Icon="{ui:SymbolIcon Symbol=TargetArrow24}" />
                        </Grid>
                    </commonControls:AppSectionSurface>
                </Grid>

                <feedbackControls:AppStatusView x:Name="BookStatusView"
                                                MaxWidth="560"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Status="Error"
                                                Icon="ErrorCircle24"
                                                Title="无法显示书籍"
                                                Description="{Binding StatusMessage}">
                    <feedbackControls:AppStatusView.Style>
                        <Style TargetType="feedbackControls:AppStatusView"
                               BasedOn="{StaticResource {x:Type feedbackControls:AppStatusView}}">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasBook}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusMessage}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </feedbackControls:AppStatusView.Style>
                </feedbackControls:AppStatusView>
            </Grid>
        </Grid>
    </Border>
</Page>
