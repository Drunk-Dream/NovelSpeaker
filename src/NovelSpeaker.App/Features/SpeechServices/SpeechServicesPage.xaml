<Page x:Class="NovelSpeaker.App.Features.SpeechServices.SpeechServicesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:commonControls="clr-namespace:NovelSpeaker.App.Shared.Presentation.Controls.Common"
      xmlns:feedbackControls="clr-namespace:NovelSpeaker.App.Shared.Presentation.Controls.Feedback"
      xmlns:formControls="clr-namespace:NovelSpeaker.App.Shared.Presentation.Controls.Forms"
      xmlns:navigation="clr-namespace:NovelSpeaker.App.Shell.Navigation"
      xmlns:speech="clr-namespace:NovelSpeaker.App.Features.SpeechServices"
      xmlns:rules="clr-namespace:NovelSpeaker.App.Shared.Presentation.Rules"
      xmlns:selection="clr-namespace:NovelSpeaker.App.Shared.Presentation.Selection"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      MinHeight="0"
      Background="Transparent"
      ClipToBounds="True"
      navigation:NavigationViewportHeightBehavior.IsEnabled="True">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="ProviderTitle" TargetType="TextBlock" BasedOn="{StaticResource App.Typography.ItemTitle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource App.Brush.Interaction.Foreground.Selected}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ProviderSurface" TargetType="selection:SelectionSurface" BasedOn="{StaticResource App.Selection.CardItem}">
            <Setter Property="MinHeight" Value="72" />
            <Setter Property="Padding" Value="14,12" />
        </Style>
        <Style x:Key="ProviderCard" TargetType="speech:SpeechProviderListItemView">
            <Setter Property="MinHeight" Value="72" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="speech:SpeechProviderListItemView">
                        <Grid Margin="0,4,0,4" Background="Transparent">
                            <selection:SelectionSurface x:Name="Surface" Style="{StaticResource ProviderSurface}">
                                <Grid>
                                    <Button Margin="-14,-12" Padding="0"
                                            Style="{StaticResource App.Button.InteractionHost}"
                                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                            Command="{Binding Tag.SelectProviderCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                            CommandParameter="{TemplateBinding CommandParameter}"
                                            AutomationProperties.Name="{Binding Name}" />
                                    <StackPanel IsHitTestVisible="False" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                                   Style="{StaticResource ProviderTitle}" />
                                        <TextBlock Text="{Binding TypeDisplayName}" Margin="0,4,0,0"
                                                   Style="{StaticResource App.Selection.Content.Secondary}" />
                                    </StackPanel>
                                </Grid>
                            </selection:SelectionSurface>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.72" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource App.Brush.Focus}" />
                                <Setter Property="Cursor" Value="SizeAll" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="24"
          MinHeight="0"
          ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <commonControls:AppPageHeader x:Name="PageHeader"
                                      Title="语音服务"
                                      BackCommand="{Binding BackCommand}">
            <commonControls:AppPageHeader.Actions>
                <WrapPanel x:Name="PageActions"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           ItemHeight="40">
                    <ui:Button Margin="0,0,8,0"
                            Style="{StaticResource App.Button.Icon}"
                            Command="{Binding NewProviderCommand}"
                            ToolTip="新建"
                            AutomationProperties.Name="新建"
                            Icon="{ui:SymbolIcon Symbol=DocumentAdd24}" />
                    <ui:Button Style="{StaticResource App.Button.Icon}"
                               Command="{Binding ImportProvidersCommand}"
                               ToolTip="导入"
                               AutomationProperties.Name="导入"
                               Icon="{ui:SymbolIcon Symbol=ArrowImport24}" />
                </WrapPanel>
            </commonControls:AppPageHeader.Actions>
        </commonControls:AppPageHeader>

        <Grid Grid.Row="1"
              Margin="0,20,0,0"
              MinHeight="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="280" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="3*" MinWidth="420" />
            </Grid.ColumnDefinitions>

            <commonControls:AppSectionSurface x:Name="RulesSurface"
                                              Grid.Column="0"
                                              Header="语音服务列表"
                                              Description="{Binding Providers.Count, StringFormat=共 {0} 项}">
                <Grid MinHeight="0">
                    <Border VerticalAlignment="Top">
                        <Border.Style>
                            <Style TargetType="Border"
                                   BasedOn="{StaticResource App.Feedback.InlineMessage}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Providers.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Style="{StaticResource App.Typography.Secondary}"
                                   Text="还没有语音服务，请新建或导入。"
                                   TextWrapping="Wrap" />
                    </Border>

                    <ListBox x:Name="RulesList"
                             Background="Transparent"
                             BorderThickness="0"
                             rules:RuleListDragBehavior.ReorderCommand="{Binding ReorderProviderCommand}"
                             ItemsSource="{Binding Providers}"
                             ScrollViewer.CanContentScroll="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem"
                                   BasedOn="{StaticResource App.Selection.ChromeFreeItemContainer}">
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <speech:SpeechProviderListItemView
                                    Style="{StaticResource ProviderCard}"
                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Page}}"
                                    CommandParameter="{Binding}"
                                    IsSortable="{Binding DataContext.CanManage, RelativeSource={RelativeSource AncestorType=Page}}"
                                    AutomationProperties.Name="{Binding Name}">
                                    <speech:SpeechProviderListItemView.ContextMenu>
                                        <ContextMenu Style="{StaticResource App.Menu.ContextSurface}"
                                                     DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                            <MenuItem Header="复制服务" Style="{StaticResource App.Menu.Item}"
                                                      Command="{Binding CopyProviderCommand}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      Visibility="{Binding PlacementTarget.DataContext.CanShare, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <MenuItem Header="导出到文件" Style="{StaticResource App.Menu.Item}"
                                                      Command="{Binding ExportProviderCommand}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      Visibility="{Binding PlacementTarget.DataContext.CanShare, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <MenuItem Header="导出到剪贴板" Style="{StaticResource App.Menu.Item}"
                                                      Command="{Binding ExportProviderToClipboardCommand}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      Visibility="{Binding PlacementTarget.DataContext.CanShare, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <Separator Style="{StaticResource App.Menu.Separator}"
                                                       Visibility="{Binding PlacementTarget.DataContext.CanShare, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <MenuItem Header="上移" Style="{StaticResource App.Menu.Item}"
                                                      Command="{Binding MoveProviderUpCommand}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      IsEnabled="{Binding PlacementTarget.DataContext.CanMoveUp, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <MenuItem Header="下移" Style="{StaticResource App.Menu.Item}"
                                                      Command="{Binding MoveProviderDownCommand}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      IsEnabled="{Binding PlacementTarget.DataContext.CanMoveDown, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <Separator Style="{StaticResource App.Menu.Separator}"
                                                       Visibility="{Binding PlacementTarget.DataContext.CanDelete, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <MenuItem Header="删除" Style="{StaticResource App.Menu.DangerItem}"
                                                      Command="{Binding DeleteProviderCommand}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      Visibility="{Binding PlacementTarget.DataContext.CanDelete, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </ContextMenu>
                                    </speech:SpeechProviderListItemView.ContextMenu>
                                </speech:SpeechProviderListItemView>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </commonControls:AppSectionSurface>

            <commonControls:AppSectionSurface x:Name="EditorSurface"
                                              Grid.Column="2">
                <Grid MinHeight="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="语音服务配置" VerticalAlignment="Center"
                                   Style="{StaticResource App.Typography.SectionTitle}" />
                        <ui:Button Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                                   Style="{StaticResource App.Button.Icon}" Command="{Binding OpenHelpCommand}"
                                   IsEnabled="{Binding CanManage}"
                                   Visibility="{Binding IsHttpEditor, Converter={StaticResource BooleanToVisibilityConverter}}"
                                   ToolTip="HTTP 模板帮助" AutomationProperties.Name="HTTP 模板帮助"
                                   Icon="{ui:SymbolIcon Symbol=QuestionCircle24}" />
                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="0,4,0,0"
                                   Text="修改配置后可直接试听编辑副本，再保存更改。"
                                   Style="{StaticResource App.Typography.Secondary}" />
                    </Grid>
                    <feedbackControls:AppStatusView Grid.Row="1" HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Center"
                                                    Status="Empty"
                                                    Icon="DocumentEdit24"
                                                    Title="选择语音服务"
                                                    Description="从左侧选择要编辑的语音服务，或新建 HTTP 服务。">
                        <feedbackControls:AppStatusView.Style>
                            <Style TargetType="feedbackControls:AppStatusView"
                                   BasedOn="{StaticResource {x:Type feedbackControls:AppStatusView}}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasEditor}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </feedbackControls:AppStatusView.Style>
                    </feedbackControls:AppStatusView>

                    <ScrollViewer x:Name="RuleEditorScrollViewer"
                                  Grid.Row="1" Margin="0,16,0,0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHttpEditor}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>

                        <StackPanel IsEnabled="{Binding CanManage}">
                            <formControls:AppFormField Label="名称" Required="True">
                                <TextBox Style="{StaticResource App.Input.TextBox.Standard}"
                                         Text="{Binding DraftName, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="语音服务名称" />
                            </formControls:AppFormField>

                            <formControls:AppFormField Margin="0,16,0,0"
                                                       Label="请求 URL / 模板"
                                                       Required="True">
                                <TextBox MinHeight="74"
                                         Style="{StaticResource App.Input.TextBox.Standard}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         Text="{Binding DraftUrl, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="请求 URL 或模板" />
                            </formControls:AppFormField>

                            <formControls:AppFormField Margin="0,16,0,0" Label="请求方法">
                                <ComboBox Style="{StaticResource App.Input.ComboBox.Standard}"
                                          SelectedValue="{Binding DraftRequestMethod}" SelectedValuePath="Content"
                                          AutomationProperties.Name="请求方法">
                                    <ComboBoxItem Content="GET" />
                                    <ComboBoxItem Content="POST" />
                                </ComboBox>
                            </formControls:AppFormField>

                            <formControls:AppFormField Margin="0,16,0,0"
                                                       Label="Header"
                                                       Description="Content-Type 等请求头均在这里配置。">
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding HeaderEntries}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="2*" MinWidth="112" />
                                                        <ColumnDefinition Width="8" />
                                                        <ColumnDefinition Width="3*" MinWidth="144" />
                                                        <ColumnDefinition Width="8" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Grid.Column="0"
                                                             Style="{StaticResource App.Input.TextBox.Standard}"
                                                             Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}"
                                                             AutomationProperties.Name="Header 名称" />
                                                    <TextBox Grid.Column="2"
                                                             Style="{StaticResource App.Input.TextBox.Standard}"
                                                             Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                             AutomationProperties.Name="Header 值" />
                                                    <ui:Button Grid.Column="4"
                                                            Style="{StaticResource App.Button.Icon}"
                                                            Command="{Binding DataContext.RemoveHeaderEntryCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="删除 Header"
                                                            AutomationProperties.Name="删除 Header"
                                                            Icon="{ui:SymbolIcon Symbol=Delete24}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button HorizontalAlignment="Left"
                                            Style="{StaticResource App.Button.Subtle}"
                                            Command="{Binding AddHeaderEntryCommand}"
                                            Content="添加 Header" />
                                </StackPanel>
                            </formControls:AppFormField>

                            <formControls:AppFormField Margin="0,16,0,0" Label="请求频率限制"
                                                       Description="次数和时间同时留空表示不限频率。">
                                <WrapPanel VerticalAlignment="Center">
                                    <TextBlock Text="最多" VerticalAlignment="Center" Style="{StaticResource App.Typography.Body}" />
                                    <TextBox Width="80" Margin="8,0" Style="{StaticResource App.Input.TextBox.Standard}"
                                             Text="{Binding DraftMaxRequests, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="最多请求次数" />
                                    <TextBlock Text="次 /" VerticalAlignment="Center" Style="{StaticResource App.Typography.Body}" />
                                    <TextBox Width="100" Margin="8,0" Style="{StaticResource App.Input.TextBox.Standard}"
                                             Text="{Binding DraftWindowMilliseconds, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="请求时间窗口毫秒" />
                                    <TextBlock Text="毫秒" VerticalAlignment="Center" Style="{StaticResource App.Typography.Body}" />
                                </WrapPanel>
                            </formControls:AppFormField>

                            <formControls:AppFormField Margin="0,16,0,0"
                                                       Label="请求体"
                                                       Description="仅 POST 请求使用。"
                                                       Visibility="{Binding IsPostMethod, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBox MinHeight="90"
                                         Style="{StaticResource App.Input.TextBox.Standard}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         Text="{Binding DraftRequestBody, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="请求体" />
                            </formControls:AppFormField>

                            <WrapPanel Margin="0,20,0,0"
                                       HorizontalAlignment="Right">
                                <Button Margin="0,0,8,0"
                                        Style="{StaticResource App.Button.Secondary}"
                                        Command="{Binding TestDraftCommand}"
                                        Content="试听"
                                        IsEnabled="{Binding CanTestDraft}" />
                                <Button Margin="0,0,8,0"
                                        Style="{StaticResource App.Button.Subtle}"
                                        Command="{Binding CancelEditingCommand}"
                                        Content="取消"
                                        IsEnabled="{Binding CanCancelEditing}" />
                                <ui:Button Style="{StaticResource App.Button.Primary}"
                                        Command="{Binding SaveDraftCommand}"
                                        Content="保存"
                                        IsEnabled="{Binding CanSaveDraft}" />
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                    <ScrollViewer Grid.Row="1" Margin="0,16,0,0"
                                  Visibility="{Binding IsEdgeEditor, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel IsEnabled="{Binding CanManage}" Margin="0,0,20,0">
                            <formControls:AppFormField Label="名称">
                                <TextBlock Text="Microsoft Edge" Style="{StaticResource App.Typography.Body}" />
                            </formControls:AppFormField>
                            <formControls:AppFormField Label="当前 Voice" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding VoiceDisplayName}" TextWrapping="Wrap"
                                               Style="{StaticResource App.Typography.ItemTitle}" />
                                    <TextBlock Text="{Binding VoiceLocaleAndGender}" Margin="0,4,0,0"
                                               Style="{StaticResource App.Typography.Secondary}" />
                                    <TextBlock Text="{Binding VoiceId}" Margin="0,4,0,0" TextWrapping="Wrap"
                                               Style="{StaticResource App.Typography.Secondary}" />
                                    <TextBlock Text="{Binding VoiceCatalogMessage}" Margin="0,8,0,0" TextWrapping="Wrap"
                                               Style="{StaticResource App.Typography.Secondary}" />
                                </StackPanel>
                            </formControls:AppFormField>
                            <WrapPanel Margin="0,16,0,0">
                                <Button Content="更换 Voice" Command="{Binding ChangeVoiceCommand}"
                                        Margin="0,0,8,0" Style="{StaticResource App.Button.Secondary}" />
                                <Button Content="刷新列表" Command="{Binding RefreshVoiceCatalogCommand}"
                                        Style="{StaticResource App.Button.Subtle}" />
                            </WrapPanel>
                            <TextBlock Text="正在加载 Voice 列表…" Margin="0,8,0,0"
                                       Style="{StaticResource App.Typography.Secondary}"
                                       Visibility="{Binding IsVoiceCatalogLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <StackPanel Margin="0,16,0,0"
                                        Visibility="{Binding IsVoicePickerOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <formControls:AppFormField Label="搜索 Voice">
                                    <TextBox Text="{Binding VoiceSearch, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource App.Input.TextBox.Standard}"
                                             AutomationProperties.Name="搜索 Voice 名称、语言或 ID" />
                                </formControls:AppFormField>
                                <ListBox ItemsSource="{Binding Voices}" Height="280" Margin="0,8,0,0"
                                         Background="Transparent" BorderThickness="0"
                                         ScrollViewer.CanContentScroll="True"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.ScrollUnit="Pixel"
                                         VirtualizingPanel.VirtualizationMode="Recycling"
                                         AutomationProperties.Name="可选 Voice">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource App.Selection.ChromeFreeItemContainer}">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Focusable" Value="False" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource App.Button.Subtle}" HorizontalContentAlignment="Left"
                                                    Command="{Binding DataContext.SelectVoiceCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}" AutomationProperties.Name="{Binding FriendlyName}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding FriendlyName}" TextWrapping="Wrap"
                                                               Style="{StaticResource App.Typography.Body}" />
                                                    <TextBlock Text="{Binding Locale}" Style="{StaticResource App.Typography.Secondary}" />
                                                    <TextBlock Text="{Binding VoiceId}" TextTrimming="CharacterEllipsis"
                                                               Style="{StaticResource App.Typography.Secondary}" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                            <WrapPanel Margin="0,20,0,0">
                                <Button Content="试听" Command="{Binding TestDraftCommand}" IsEnabled="{Binding CanTestDraft}"
                                        Margin="0,0,8,0" Style="{StaticResource App.Button.Secondary}" />
                                <Button Content="取消" Command="{Binding CancelEditingCommand}" IsEnabled="{Binding CanCancelEditing}"
                                        Margin="0,0,8,0" Style="{StaticResource App.Button.Subtle}" />
                                <ui:Button Content="保存" Command="{Binding SaveDraftCommand}" IsEnabled="{Binding CanSaveDraft}"
                                           Style="{StaticResource App.Button.Primary}" />
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </commonControls:AppSectionSurface>

            <Grid Grid.Column="2"
                  Panel.ZIndex="10"
                  Visibility="{Binding IsHelpDrawerOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="380" />
                </Grid.ColumnDefinitions>
                <Button x:Name="HelpDrawerDismissOverlay"
                        Grid.Column="0"
                        Opacity="0.45"
                        BorderThickness="0"
                        Style="{StaticResource App.Button.InteractionHost}"
                        Command="{Binding CloseHelpCommand}"
                        ToolTip="关闭HTTP 模板帮助"
                        AutomationProperties.Name="关闭HTTP 模板帮助">
                    <Border Background="{DynamicResource App.Brush.Canvas}" />
                </Button>
                <Border x:Name="HelpDrawerBorder"
                        Grid.Column="1"
                        Padding="20"
                        Style="{StaticResource App.Feedback.PopupSurface}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource App.Typography.SectionTitle}"
                                       Text="HTTP 模板帮助" />
                            <ui:Button Grid.Column="1"
                                    Style="{StaticResource App.Button.Icon}"
                                    Command="{Binding CloseHelpCommand}"
                                    ToolTip="关闭帮助"
                                    AutomationProperties.Name="关闭帮助"
                                    Icon="{ui:SymbolIcon Symbol=Dismiss24}" />
                        </Grid>
                        <ScrollViewer Grid.Row="1"
                                      Margin="0,16,0,0"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock Style="{StaticResource App.Typography.ItemTitle}" Text="从零开始" />
                                <TextBlock Margin="0,8,0,0"
                                           Style="{StaticResource App.Typography.Secondary}"
                                           Text="新建 HTTP 服务后填写服务商提供的完整 HTTP/HTTPS 地址，选择 GET 或 POST 并设置必要参数。试听使用当前编辑副本，不要求先保存。"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,18,0,0"
                                           Style="{StaticResource App.Typography.ItemTitle}"
                                           Text="GET 示例" />
                                <TextBlock Margin="0,8,0,0"
                                           FontFamily="Consolas"
                                           Style="{StaticResource App.Typography.Secondary}"
                                           TextWrapping="Wrap">https://example.com/tts?text={{encodeURIComponent(speakText)}}&amp;speed={{speakSpeed}}</TextBlock>
                                <TextBlock Margin="0,18,0,0"
                                           Style="{StaticResource App.Typography.ItemTitle}"
                                           Text="POST JSON 示例" />
                                <TextBlock Margin="0,8,0,0"
                                           Style="{StaticResource App.Typography.Secondary}"
                                           Text="请求方法选择 POST，Header 添加 Content-Type: application/json，请求体可使用下面的模板。"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,8,0,0"
                                           FontFamily="Consolas"
                                           Style="{StaticResource App.Typography.Secondary}"
                                           TextWrapping="Wrap" Text="{}{&quot;text&quot;:{{JSON.stringify(speakText)}},&quot;speed&quot;:{{speakSpeed}}}" />
                                <TextBlock Margin="0,18,0,0"
                                           Style="{StaticResource App.Typography.ItemTitle}"
                                           Text="字段怎么填" />
                                <TextBlock Margin="0,8,0,0"
                                           Style="{StaticResource App.Typography.Secondary}"
                                           Text="HTTP Provider 的 URL 必须是绝对 HTTP/HTTPS 地址；请求体只用于 POST。JSON 与表单请求体由 Content-Type Header 决定，响应音频格式会自动识别。"
                                           TextWrapping="Wrap" />
