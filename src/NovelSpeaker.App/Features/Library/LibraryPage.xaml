<Page x:Class="NovelSpeaker.App.Features.Library.LibraryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:library="clr-namespace:NovelSpeaker.App.Features.Library"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:views="clr-namespace:NovelSpeaker.App.Features.Library">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Page.Resources>

    <Grid Margin="{StaticResource PagePadding}"
          AllowDrop="True"
          DragEnter="RootGrid_OnDragEnter"
          Drop="RootGrid_OnDrop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock VerticalAlignment="Center"
                       Style="{StaticResource PageTitleTextBlockStyle}"
                       Text="书库"/>

            <WrapPanel Grid.Column="1"
                       Style="{StaticResource ToolbarPanelStyle}"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       ItemHeight="{StaticResource TextControlHeight}">
                <Grid Width="260"
                      Margin="{StaticResource ButtonGapMargin}">
                    <TextBox Padding="12,0,36,0"
                             VerticalContentAlignment="Center"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Width="{StaticResource CompactIconButtonSize}"
                            Height="{StaticResource CompactIconButtonSize}"
                            Margin="0,0,6,0"
                            Style="{StaticResource BorderlessIconButtonStyle}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="清空搜索"
                            Command="{Binding ClearSearchCommand}"
                            ToolTip="清空搜索"
                            Visibility="{Binding HasSearchText, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ui:SymbolIcon Symbol="Dismiss24"/>
                    </Button>
                </Grid>
                <ComboBox Width="140"
                          Margin="{StaticResource ButtonGapMargin}"
                          DisplayMemberPath="DisplayName"
                          ItemsSource="{Binding AvailableSortOptions}"
                          SelectedValue="{Binding SelectedSortMode}"
                          SelectedValuePath="Mode"/>
                <Button x:Name="ToolbarImportButton"
                        Style="{StaticResource BorderlessIconButtonStyle}"
                        Click="ImportButton_OnClick"
                        ToolTip="导入小说"
                        AutomationProperties.Name="导入小说">
                    <ui:SymbolIcon Symbol="ArrowImport24"/>
                </Button>
            </WrapPanel>
        </Grid>

        <StackPanel Grid.Row="1"
                    Margin="{StaticResource ControlSpacing}">
            <TextBlock Style="{StaticResource SecondaryTextBlockStyle}"
                       Text="{Binding LibrarySummaryText}"/>
            <TextBlock Margin="{StaticResource FieldControlSpacing}"
                       Text="{Binding ImportStatusMessage}"
                       TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock"
                           BasedOn="{StaticResource SecondaryTextBlockStyle}">
                        <Setter Property="Visibility"
                                Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ImportStatusMessage}"
                                         Value="">
                                <Setter Property="Visibility"
                                        Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Margin="{StaticResource FieldControlSpacing}"
                       Text="{Binding StatusMessage}"
                       TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock"
                           BasedOn="{StaticResource SecondaryTextBlockStyle}">
                        <Setter Property="Visibility"
                                Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusMessage}"
                                         Value="">
                                <Setter Property="Visibility"
                                        Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <Grid Grid.Row="2"
              Margin="{StaticResource PageSectionSpacing}">
            <ScrollViewer x:Name="BooksScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False"
                          Visibility="{Binding HasVisibleBooks, Converter={StaticResource BooleanToVisibilityConverter}}"
                          library:LibraryScrollViewerStateBehavior.ItemsControl="{Binding ElementName=BooksItemsControl}"
                          library:LibraryScrollViewerStateBehavior.State="{Binding ScrollState}">
                <ItemsControl x:Name="BooksItemsControl"
                              ItemsSource="{Binding Books}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel ItemWidth="360"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Margin"
                                    Value="0,0,16,16"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <views:BookCardView Item="{Binding}"
                                                DeleteBookCommand="{Binding DataContext.DeleteBookCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                OpenBookCommand="{Binding DataContext.OpenBookCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                OpenBookDetailsCommand="{Binding DataContext.OpenBookDetailsCommand, RelativeSource={RelativeSource AncestorType=Page}}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility"
                                Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasBooks}"
                                         Value="False">
                                <Setter Property="Visibility"
                                        Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <ui:SymbolIcon HorizontalAlignment="Center"
                               FontSize="48"
                               Symbol="BookOpen24"/>
                <TextBlock Margin="0,12,0,0"
                           HorizontalAlignment="Center"
                           Style="{StaticResource StrongTextBlockStyle}"
                           Text="尚未导入小说"/>
                <TextBlock Margin="0,8,0,0"
                           HorizontalAlignment="Center"
                           Style="{StaticResource SecondaryTextBlockStyle}"
                           Text="将 TXT 拖到这里，或选择文件导入。"/>
                <Button x:Name="EmptyStateImportButton"
                        Margin="{StaticResource ContentSpacing}"
                        HorizontalAlignment="Center"
                        Style="{StaticResource BorderlessIconButtonStyle}"
                        Click="ImportButton_OnClick"
                        ToolTip="导入小说"
                        AutomationProperties.Name="导入小说">
                    <ui:SymbolIcon Symbol="ArrowImport24"/>
                </Button>
            </StackPanel>

            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility"
                                Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding HasBooks}"
                                               Value="True"/>
                                    <Condition Binding="{Binding HasVisibleBooks}"
                                               Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility"
                                        Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock HorizontalAlignment="Center"
                           Style="{StaticResource StrongTextBlockStyle}"
                           Text="没有找到匹配的书籍"/>
                <TextBlock Margin="0,8,0,0"
                           HorizontalAlignment="Center"
                           Style="{StaticResource SecondaryTextBlockStyle}"
                           Text="试试修改关键词，或清空搜索条件。"/>
                <Button Margin="{StaticResource ContentSpacing}"
                        HorizontalAlignment="Center"
                        Command="{Binding ClearSearchCommand}"
                        Content="清空搜索"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
