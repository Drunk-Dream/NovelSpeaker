<Page x:Class="NovelSpeaker.App.Features.Library.LibraryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:commonControls="clr-namespace:NovelSpeaker.App.Shared.Presentation.Controls.Common"
      xmlns:feedbackControls="clr-namespace:NovelSpeaker.App.Shared.Presentation.Controls.Feedback"
      xmlns:library="clr-namespace:NovelSpeaker.App.Features.Library"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:views="clr-namespace:NovelSpeaker.App.Features.Library"
      Background="Transparent">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Page.Resources>

    <Grid x:Name="RootGrid"
          Margin="24"
          AllowDrop="True"
          DragEnter="RootGrid_OnDragEnter"
          Drop="RootGrid_OnDrop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <commonControls:AppPageHeader x:Name="PageHeader"
                                      Title="书库">
            <commonControls:AppPageHeader.Actions>
                <WrapPanel x:Name="LibraryToolbar"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           ItemHeight="40">
                    <Grid Width="260"
                          Margin="0,0,12,0">
                        <TextBox x:Name="SearchTextBox"
                                 Padding="12,8,36,8"
                                 Style="{StaticResource App.Input.TextBox.Standard}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="搜索书库" />
                        <ui:Button x:Name="ClearSearchButton"
                                Margin="0,0,6,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Style="{StaticResource App.Button.Icon}"
                                AutomationProperties.Name="清空搜索"
                                Command="{Binding ClearSearchCommand}"
                                ToolTip="清空搜索"
                                Visibility="{Binding HasSearchText, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Icon="{ui:SymbolIcon Symbol=Dismiss24}" />
                    </Grid>
                    <ComboBox x:Name="SortComboBox"
                              Width="160"
                              Margin="0,0,12,0"
                              Style="{StaticResource App.Input.ComboBox.Standard}"
                              DisplayMemberPath="DisplayName"
                              ItemsSource="{Binding AvailableSortOptions}"
                              SelectedValue="{Binding SelectedSortMode}"
                              SelectedValuePath="Mode"
                              AutomationProperties.Name="书库排序" />
                    <ui:Button x:Name="ToolbarImportButton"
                            Style="{StaticResource App.Button.Icon}"
                            Click="ImportButton_OnClick"
                            ToolTip="导入小说"
                            AutomationProperties.Name="导入小说"
                            Icon="{ui:SymbolIcon Symbol=ArrowImport24}" />
                </WrapPanel>
            </commonControls:AppPageHeader.Actions>
        </commonControls:AppPageHeader>

        <StackPanel Grid.Row="1"
                    Margin="0,20,0,0">
            <TextBlock Style="{StaticResource App.Typography.Secondary}"
                       Text="{Binding LibrarySummaryText}" />
            <Border Margin="0,6,0,0">
                <Border.Style>
                    <Style TargetType="Border"
                           BasedOn="{StaticResource App.Feedback.InlineMessage}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ImportStatusMessage}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Style="{StaticResource App.Typography.Secondary}"
                           Text="{Binding ImportStatusMessage}" />
            </Border>
            <Border Margin="0,6,0,0">
                <Border.Style>
                    <Style TargetType="Border"
                           BasedOn="{StaticResource App.Feedback.InlineMessage}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusMessage}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Style="{StaticResource App.Typography.Secondary}"
                           Text="{Binding StatusMessage}" />
            </Border>
        </StackPanel>

        <Grid Grid.Row="2"
              Margin="0,12,0,0">
            <ScrollViewer x:Name="BooksScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False"
                          Visibility="{Binding HasVisibleBooks, Converter={StaticResource BooleanToVisibilityConverter}}"
                          library:LibraryScrollViewerStateBehavior.ItemsControl="{Binding ElementName=BooksItemsControl}"
                          library:LibraryScrollViewerStateBehavior.State="{Binding ScrollState}">
                <ItemsControl x:Name="BooksItemsControl"
                              ItemsSource="{Binding Books}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <library:LibraryResponsivePanel MinItemWidth="300"
                                                            MaxItemWidth="360"
                                                            HorizontalSpacing="16"
                                                            VerticalSpacing="16" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <views:BookCardView Item="{Binding}"
                                                DeleteBookCommand="{Binding DataContext.DeleteBookCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                OpenBookCommand="{Binding DataContext.OpenBookCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                OpenBookDetailsCommand="{Binding DataContext.OpenBookDetailsCommand, RelativeSource={RelativeSource AncestorType=Page}}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <feedbackControls:AppStatusView x:Name="EmptyLibraryStatusView"
                                            MaxWidth="560"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Status="Empty"
                                            Icon="BookOpen24"
                                            Title="尚未导入小说"
                                            Description="将 TXT 拖到这里，或选择文件导入。">
                <feedbackControls:AppStatusView.Style>
                    <Style TargetType="feedbackControls:AppStatusView"
                           BasedOn="{StaticResource {x:Type feedbackControls:AppStatusView}}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasBooks}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </feedbackControls:AppStatusView.Style>
                <feedbackControls:AppStatusView.PrimaryAction>
                    <Button x:Name="EmptyStateImportButton"
                            Style="{StaticResource App.Button.Primary}"
                            Click="ImportButton_OnClick"
                            Content="导入小说"
                            ToolTip="导入小说"
                            AutomationProperties.Name="导入小说" />
                </feedbackControls:AppStatusView.PrimaryAction>
            </feedbackControls:AppStatusView>

            <feedbackControls:AppStatusView x:Name="NoResultsStatusView"
                                            MaxWidth="560"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Status="NoResult"
                                            Icon="Search24"
                                            Title="没有找到匹配的书籍"
                                            Description="试试修改关键词，或清空搜索条件。">
                <feedbackControls:AppStatusView.Style>
                    <Style TargetType="feedbackControls:AppStatusView"
                           BasedOn="{StaticResource {x:Type feedbackControls:AppStatusView}}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding HasBooks}" Value="True" />
                                    <Condition Binding="{Binding HasVisibleBooks}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </feedbackControls:AppStatusView.Style>
                <feedbackControls:AppStatusView.PrimaryAction>
                    <Button x:Name="NoResultsClearSearchButton"
                            Style="{StaticResource App.Button.Secondary}"
                            Command="{Binding ClearSearchCommand}"
                            Content="清空搜索"
                            AutomationProperties.Name="清空搜索" />
                </feedbackControls:AppStatusView.PrimaryAction>
            </feedbackControls:AppStatusView>
        </Grid>
    </Grid>
</Page>
