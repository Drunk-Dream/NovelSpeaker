<Page x:Class="NovelSpeaker.App.Features.Cache.CacheAndDataPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:theming="clr-namespace:NovelSpeaker.App.Shared.Theming"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Page.Resources>

    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Button Style="{StaticResource BackIconButtonStyle}"
                Command="{Binding BackCommand}"
                ToolTip="返回"
                AutomationProperties.Name="返回">
            <ui:SymbolIcon Symbol="ChevronLeft24" />
        </Button>

        <ScrollViewer Grid.Row="1"
                      Margin="0,20,0,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitleTextBlockStyle}"
                           Text="缓存与数据" />

                <Border Margin="{StaticResource SectionSpacing}"
                        Style="{StaticResource SettingsSubpageItemBorderStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SettingsSubpageItemTitleTextBlockStyle}"
                                   Text="缓存总览" />

                        <StackPanel Margin="0,10,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasLoadError}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <TextBlock Style="{StaticResource StrongTextBlockStyle}"
                                       FontSize="22"
                                       Text="{Binding TotalCacheSizeText}" />
                            <TextBlock Margin="0,6,0,0"
                                       Style="{StaticResource SecondaryTextBlockStyle}"
                                       Text="{Binding CacheEntryCountText}" />
                            <ProgressBar Margin="0,12,0,0"
                                         Height="8"
                                         Maximum="100"
                                         Value="{Binding UsagePercentage}" />
                            <TextBlock Margin="0,8,0,0"
                                       Style="{StaticResource SecondaryTextBlockStyle}"
                                       Text="{Binding UsageText}" />
                        </StackPanel>

                        <StackPanel Margin="0,10,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasLoadError}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <TextBlock Style="{StaticResource SecondaryTextBlockStyle}"
                                       Text="{Binding LoadErrorMessage}" />
                            <Button Margin="0,10,0,0"
                                    Width="120"
                                    HorizontalAlignment="Left"
                                    Command="{Binding RetryCommand}"
                                    Content="重试" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingsSubpageItemBorderStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SettingsSubpageItemTitleTextBlockStyle}"
                                   Text="缓存上限" />
                        <StackPanel Margin="0,10,0,0"
                                    Orientation="Horizontal">
                            <TextBox x:Name="CacheLimitValueTextBox"
                                     Width="160"
                                     HorizontalAlignment="Left"
                                     PreviewKeyDown="CacheLimitValueTextBox_OnPreviewKeyDown"
                                     LostKeyboardFocus="CacheLimitValueTextBox_OnLostKeyboardFocus"
                                     Text="{Binding CacheLimitValueText, UpdateSourceTrigger=PropertyChanged}" />
                            <ComboBox x:Name="CacheLimitUnitComboBox"
                                      Width="100"
                                      Margin="12,0,0,0"
                                      HorizontalAlignment="Left"
                                      SelectionChanged="CacheLimitUnitComboBox_OnSelectionChanged"
                                      ItemsSource="{Binding CacheLimitUnits}"
                                      SelectedItem="{Binding SelectedCacheLimitUnit}" />
                        </StackPanel>
                        <TextBlock Margin="0,6,0,0"
                                   Style="{StaticResource SecondaryTextBlockStyle}"
                                   Text="仅支持整数输入，最低为 256 MB。" />
                        <TextBlock Margin="0,6,0,0"
                                   Text="{Binding CacheLimitErrorText}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock"
                                       BasedOn="{StaticResource ErrorTextBlockStyle}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CacheLimitErrorText}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingsSubpageItemBorderStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SettingsSubpageItemTitleTextBlockStyle}"
                                   Text="缓存策略" />
                        <TextBlock Margin="0,10,0,0"
                                   Style="{StaticResource SecondaryTextBlockStyle}"
                                   Text="缓存按最近最少使用顺序清理。正在播放或仍受保护的音频会暂时保留，停止播放后可继续清理。"
                                   TextWrapping="Wrap" />
                        <Button x:Name="OpenCacheManagementButton"
                                Margin="0,8,0,0"
                                Style="{StaticResource SettingsEntryButtonStyle}"
                                Command="{Binding OpenCacheManagementCommand}"
                                Content="缓存管理"
                                Tag="{x:Static theming:SettingsNavigationIcon.CacheManagement}"
                                ToolTip="缓存管理"
                                AutomationProperties.Name="缓存管理" />
                        <Button Margin="0,8,0,0"
                                HorizontalAlignment="Left"
                                Command="{Binding OpenAppDataDirectoryCommand}"
                                Content="打开应用数据目录" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
