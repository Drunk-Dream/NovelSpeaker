<Page x:Class="NovelSpeaker.App.Features.Cache.CacheManagementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:commonControls="clr-namespace:NovelSpeaker.App.Shared.Presentation.Controls.Common"
      xmlns:feedbackControls="clr-namespace:NovelSpeaker.App.Shared.Presentation.Controls.Feedback"
      xmlns:navigation="clr-namespace:NovelSpeaker.App.Shell.Navigation"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      MinHeight="0"
      Background="Transparent"
      ClipToBounds="True"
      navigation:NavigationViewportHeightBehavior.IsEnabled="True"
      PreviewKeyDown="Page_OnPreviewKeyDown">
    <Border x:Name="RootViewport"
            Background="Transparent"
            MinHeight="0"
            navigation:NavigationViewportHeightBehavior.IsEnabled="True"
            ClipToBounds="True">
        <Grid Margin="24"
              MinHeight="0"
              ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <commonControls:AppPageHeader x:Name="PageHeader"
                                          Title="缓存管理"
                                          BackCommand="{Binding BackCommand}">
                <commonControls:AppPageHeader.Actions>
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock Margin="0,0,12,0"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource App.Typography.Secondary}"
                                   Text="{Binding ChapterSelectionSummary}" />
                        <ui:Button x:Name="ClearSelectedChaptersButton"
                                   Margin="0,0,6,0"
                                   Style="{StaticResource App.Button.DangerIcon}"
                                   Command="{Binding ClearSelectedChaptersCommand}"
                                   ToolTip="清理所选章节缓存"
                                   AutomationProperties.Name="清理所选章节缓存"
                                   Icon="{ui:SymbolIcon Symbol=Delete24}" />
                        <ui:Button x:Name="ExportSelectedChaptersButton"
                                Style="{StaticResource App.Button.Icon}"
                                Command="{Binding ExportSelectedChaptersCommand}"
                                ToolTip="{Binding ExportCommandToolTip}"
                                AutomationProperties.Name="导出所选章节"
                                Icon="{ui:SymbolIcon Symbol=ArrowDownload24}" />
                    </StackPanel>
                </commonControls:AppPageHeader.Actions>
            </commonControls:AppPageHeader>

            <Grid Grid.Row="1"
                  Margin="0,20,0,0"
                  MinHeight="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"
                                      MinWidth="280" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="3*"
                                      MinWidth="420" />
                </Grid.ColumnDefinitions>

                <commonControls:AppSectionSurface x:Name="BooksSurface"
                                                  Grid.Column="0"
                                                  Header="书籍"
                                                  Description="{Binding Books.Count, StringFormat=共 {0} 本}">
                    <Grid MinHeight="0">
                        <feedbackControls:AppStatusView x:Name="BooksLoadingStatusView"
                                                        MaxWidth="520"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Status="Loading"
                                                        Icon="ArrowSync24"
                                                        Title="正在加载缓存书籍"
                                                        Description="正在读取可管理的缓存索引。">
                            <feedbackControls:AppStatusView.Style>
                                <Style TargetType="feedbackControls:AppStatusView"
                                       BasedOn="{StaticResource {x:Type feedbackControls:AppStatusView}}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLoadingBooks}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </feedbackControls:AppStatusView.Style>
                        </feedbackControls:AppStatusView>

                        <feedbackControls:AppStatusView x:Name="BooksEmptyStatusView"
                                                        MaxWidth="520"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Status="Empty"
                                                        Icon="FolderOpen24"
                                                        Title="暂无可管理的缓存"
                                                        Description="缓存书籍会在音频生成后出现在这里。">
                            <feedbackControls:AppStatusView.Style>
                                <Style TargetType="feedbackControls:AppStatusView"
                                       BasedOn="{StaticResource {x:Type feedbackControls:AppStatusView}}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Books.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsLoadingBooks}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </feedbackControls:AppStatusView.Style>
                        </feedbackControls:AppStatusView>

                        <ScrollViewer x:Name="BooksScrollViewer"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ScrollViewer.Style>
                                <Style TargetType="ScrollViewer">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Books.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsLoadingBooks}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Style>
                            <ItemsControl ItemsSource="{Binding Books}"
                                          HorizontalContentAlignment="Stretch">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,8"
                                                Padding="0"
                                                Style="{StaticResource App.Selection.CardItem}"
                                                AutomationProperties.Name="{Binding AutomationName}">
                                            <Button Padding="14,12"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Stretch"
                                                    Style="{StaticResource App.Button.Subtle}"
                                                    AutomationProperties.Name="{Binding AutomationName}"
                                                    Command="{Binding DataContext.SelectBookCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource App.Typography.ItemTitle}"
                                                               Text="{Binding Title}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Margin="0,8,0,0"
                                                               Style="{StaticResource App.Typography.Secondary}"
                                                               Text="{Binding Author}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <DockPanel Margin="0,10,0,0">
                                                        <TextBlock DockPanel.Dock="Left"
                                                                   Style="{StaticResource App.Typography.Secondary}"
                                                                   Text="{Binding ChapterCountText}" />
                                                        <TextBlock HorizontalAlignment="Right"
                                                                   Style="{StaticResource App.Typography.ItemTitle}"
                                                                   Text="{Binding CacheSizeText}" />
                                                    </DockPanel>
                                                </StackPanel>
                                            </Button>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </commonControls:AppSectionSurface>

                <commonControls:AppSectionSurface x:Name="ChaptersSurface"
                                                  Grid.Column="2">
                    <Grid MinHeight="0">
                        <feedbackControls:AppStatusView x:Name="SelectionPromptStatusView"
                                                        MaxWidth="520"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Status="Empty"
                                                        Icon="BookOpen24"
                                                        Title="请选择一本书"
                                                        Description="从左侧选择书籍后，可以查看章节完整度并选择章节清理或导出。">
                            <feedbackControls:AppStatusView.Style>
                                <Style TargetType="feedbackControls:AppStatusView"
                                       BasedOn="{StaticResource {x:Type feedbackControls:AppStatusView}}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowSelectionPrompt}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </feedbackControls:AppStatusView.Style>
                        </feedbackControls:AppStatusView>

                        <feedbackControls:AppStatusView x:Name="ChaptersLoadingStatusView"
                                                        MaxWidth="520"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Status="Loading"
                                                        Icon="ArrowSync24"
                                                        Title="正在加载章节缓存"
                                                        Description="正在读取章节缓存索引和当前配置完整度。">
                            <feedbackControls:AppStatusView.Style>
                                <Style TargetType="feedbackControls:AppStatusView"
                                       BasedOn="{StaticResource {x:Type feedbackControls:AppStatusView}}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLoadingChapters}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </feedbackControls:AppStatusView.Style>
                        </feedbackControls:AppStatusView>

                        <feedbackControls:AppStatusView x:Name="ChaptersEmptyStatusView"
                                                        MaxWidth="520"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Status="Empty"
                                                        Icon="MusicNote224"
                                                        Title="该书暂无缓存"
                                                        Description="如果继续播放并重新产生缓存，章节会再次出现在这里。">
                            <feedbackControls:AppStatusView.Style>
                                <Style TargetType="feedbackControls:AppStatusView"
                                       BasedOn="{StaticResource {x:Type feedbackControls:AppStatusView}}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowSelectedBookEmptyState}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </feedbackControls:AppStatusView.Style>
                        </feedbackControls:AppStatusView>

                        <Grid x:Name="SelectedBookWorkspace">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowSelectedBookContent}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsLoadingChapters}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <TextBlock Style="{StaticResource App.Typography.SectionTitle}"
                                           Text="{Binding SelectedBookTitle}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Margin="0,6,0,0"
                                           Style="{StaticResource App.Typography.Secondary}"
                                           Text="{Binding SelectedBookAuthor}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Margin="0,6,0,0"
                                           Style="{StaticResource App.Typography.Secondary}"
                                           Text="{Binding SelectedBookChapterCountText}" />
                                <TextBlock Margin="0,6,0,0"
                                           Style="{StaticResource App.Typography.ItemTitle}"
                                           Text="{Binding SelectedBookCacheSizeText}" />
                            </StackPanel>

                            <ListBox x:Name="ChaptersListBox"
                                     Grid.Row="1"
                                     Margin="0,20,0,0"
                                     Padding="0"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ScrollViewer.CanContentScroll="True"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                                     VirtualizingPanel.ScrollUnit="Pixel"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     ItemsSource="{Binding Chapters}"
                                     SelectionMode="Extended">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="IsTabStop" Value="False" />
                                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=OneWay}" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                                      Content="{TemplateBinding Content}"
                                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Button Margin="0,0,0,12"
                                                Padding="0"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                Style="{StaticResource App.Button.Subtle}"
                                                Click="ChapterCard_OnClick"
                                                ContextMenuOpening="ChapterCard_OnContextMenuOpening"
                                                ToolTip="{Binding ExportToolTip}"
                                                AutomationProperties.Name="{Binding AutomationName}">
                                            <Button.ContextMenu>
                                                <ContextMenu Style="{StaticResource App.Menu.ContextSurface}">
                                                    <MenuItem Style="{StaticResource App.Menu.Item}"
                                                              Command="{Binding ClearSelectedChaptersCommand}"
                                                              Header="清理所选章节" />
                                                    <MenuItem Style="{StaticResource App.Menu.Item}"
                                                              Command="{Binding ExportSelectedChaptersCommand}"
                                                              Header="导出所选章节" />
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                            <Border Padding="16"
                                                    Style="{StaticResource App.Selection.CardItem}">
                                                <StackPanel>
                                                    <DockPanel LastChildFill="True">
                                                        <TextBlock DockPanel.Dock="Left"
                                                                   Margin="0,0,12,0"
                                                                   Style="{StaticResource App.Typography.ItemTitle}"
                                                                   Text="{Binding OrderText}" />
                                                        <TextBlock Style="{StaticResource App.Typography.Body}"
                                                                   Text="{Binding Title}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </DockPanel>
                                                    <WrapPanel Margin="0,10,0,0">
                                                        <TextBlock Margin="0,0,12,0"
                                                                   Style="{StaticResource App.Typography.Secondary}"
                                                                   Text="{Binding CacheSizeText}" />
                                                        <TextBlock Margin="0,0,12,0"
                                                                   Style="{StaticResource App.Typography.Secondary}"
                                                                   Text="{Binding EntryCountText}" />
                                                        <TextBlock Style="{StaticResource App.Typography.Secondary}"
                                                                   Text="{Binding CompletenessText}" />
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Grid>
                </commonControls:AppSectionSurface>
            </Grid>
        </Grid>
    </Border>
</Page>
