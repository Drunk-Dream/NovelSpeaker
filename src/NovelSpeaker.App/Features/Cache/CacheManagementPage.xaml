<Page x:Class="NovelSpeaker.App.Features.Cache.CacheManagementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:navigation="clr-namespace:NovelSpeaker.App.Shell.Navigation"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      PreviewKeyDown="Page_OnPreviewKeyDown">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

    </Page.Resources>

    <Border x:Name="RootViewport"
            Padding="{StaticResource PagePadding}"
            MinHeight="0"
            navigation:NavigationViewportHeightBehavior.IsEnabled="True"
            ClipToBounds="True">
        <Grid MinHeight="0"
              ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Style="{StaticResource BackIconButtonStyle}"
                    Command="{Binding BackCommand}"
                    ToolTip="返回"
                    AutomationProperties.Name="返回">
                <ui:SymbolIcon Symbol="ChevronLeft24" />
            </Button>

            <TextBlock Grid.Column="1"
                       Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       Style="{StaticResource PageTitleTextBlockStyle}"
                       Text="缓存管理" />
        </Grid>

        <Grid Grid.Row="1"
              Margin="0,20,0,0"
              MinHeight="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource CardBorderStyle}">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top"
                                Margin="16,16,16,12">
                        <TextBlock Style="{StaticResource SectionTitleTextBlockStyle}"
                                   Text="书籍" />
                        <TextBlock Margin="0,6,0,0"
                                   Style="{StaticResource SecondaryTextBlockStyle}"
                                   Text="{Binding Books.Count, StringFormat=共 {0} 本}" />
                    </StackPanel>

                    <TextBlock Margin="16,0,16,16"
                               Text="当前没有可管理的缓存。">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock"
                                   BasedOn="{StaticResource SecondaryTextBlockStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Books.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ScrollViewer x:Name="BooksScrollViewer"
                                  Margin="12,0,12,12"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Books}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="0"
                                            Style="{StaticResource SelectableListItemContainerStyle}"
                                            AutomationProperties.Name="{Binding AutomationName}">
                                        <Button Style="{StaticResource BorderlessListItemButtonStyle}"
                                                Padding="14,12"
                                                AutomationProperties.Name="{Binding AutomationName}"
                                                Command="{Binding DataContext.SelectBookCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                CommandParameter="{Binding}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource StrongTextBlockStyle}"
                                                           Text="{Binding Title}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Margin="0,8,0,0"
                                                           Style="{StaticResource SecondaryTextBlockStyle}"
                                                           Text="{Binding Author}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <DockPanel Margin="0,10,0,0">
                                                    <TextBlock DockPanel.Dock="Left"
                                                               Style="{StaticResource SecondaryTextBlockStyle}"
                                                               Text="{Binding ChapterCountText}" />
                                                    <TextBlock HorizontalAlignment="Right"
                                                               Style="{StaticResource StrongTextBlockStyle}"
                                                               Text="{Binding CacheSizeText}" />
                                                </DockPanel>
                                            </StackPanel>
                                        </Button>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border Grid.Column="2"
                    Style="{StaticResource CardBorderStyle}">
                <Grid Margin="20"
                      MinHeight="0">
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                MaxWidth="360">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowSelectionPrompt}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock HorizontalAlignment="Center"
                                   Style="{StaticResource SectionTitleTextBlockStyle}"
                                   Text="请选择左侧书籍" />
                        <TextBlock Margin="0,10,0,0"
                                   HorizontalAlignment="Center"
                                   Style="{StaticResource SecondaryTextBlockStyle}"
                                   Text="选中后可查看当前配置下的章节缓存完整度，并选择一个或多个章节清理。"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Grid MinHeight="0">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowSelectionPrompt}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitleTextBlockStyle}"
                                           Text="{Binding SelectedBookTitle}" />
                                <TextBlock Margin="0,6,0,0"
                                           Style="{StaticResource SecondaryTextBlockStyle}"
                                           Text="{Binding SelectedBookAuthor}" />
                                <TextBlock Margin="0,6,0,0"
                                           Style="{StaticResource SecondaryTextBlockStyle}"
                                           Text="{Binding SelectedBookChapterCountText}" />
                                <TextBlock Margin="0,6,0,0"
                                           Style="{StaticResource StrongTextBlockStyle}"
                                           Text="{Binding SelectedBookCacheSizeText}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Margin="16,0,0,0"
                                        VerticalAlignment="Top">
                                <TextBlock HorizontalAlignment="Right"
                                           Margin="0,0,0,8"
                                           Style="{StaticResource SecondaryTextBlockStyle}"
                                           Text="{Binding ChapterSelectionSummary}" />
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="ClearSelectedChaptersButton"
                                            Padding="16,8"
                                            Command="{Binding ClearSelectedChaptersCommand}"
                                            Content="清理"
                                            ToolTip="清理所选章节缓存"
                                            AutomationProperties.Name="清理所选章节缓存" />
                                    <Button x:Name="ExportSelectedChaptersButton"
                                            Margin="8,0,0,0"
                                            Padding="16,8"
                                            Content="导出"
                                            IsEnabled="{Binding CanExportSelectedChapters}"
                                            ToolTip="章节导出尚未接入"
                                            AutomationProperties.Name="导出所选章节" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Row="1"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    MaxWidth="360">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowSelectedBookEmptyState}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock HorizontalAlignment="Center"
                                       Style="{StaticResource SectionTitleTextBlockStyle}"
                                       Text="该书暂无缓存" />
                            <TextBlock Margin="0,10,0,0"
                                       HorizontalAlignment="Center"
                                       Style="{StaticResource SecondaryTextBlockStyle}"
                                       Text="左侧列表已移除这本书；如果继续播放，它会在重新产生缓存后再次出现。"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <ScrollViewer x:Name="ChaptersScrollViewer"
                                      Grid.Row="1"
                                      Margin="0,20,0,0"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Chapters}">
                                <ItemsControl.Style>
                                    <Style TargetType="ItemsControl">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowSelectedBookContent}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.Style>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Margin="0,0,0,12"
                                                Padding="0"
                                                HorizontalContentAlignment="Stretch"
                                                Style="{StaticResource BorderlessListItemButtonStyle}"
                                                Click="ChapterCard_OnClick"
                                                AutomationProperties.Name="{Binding AutomationName}">
                                            <Border Padding="16">
                                                <Border.Style>
                                                    <Style TargetType="Border"
                                                           BasedOn="{StaticResource CardBorderStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource AccentFillColorSecondaryBrush}" />
                                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel>
                                                        <TextBlock Style="{StaticResource StrongTextBlockStyle}"
                                                                   Text="{Binding OrderText}" />
                                                        <TextBlock Margin="0,6,0,0"
                                                                   Style="{StaticResource PrimaryTextBlockStyle}"
                                                                   Text="{Binding Title}"
                                                                   TextWrapping="Wrap" />
                                                        <WrapPanel Margin="0,10,0,0">
                                                            <TextBlock Margin="0,0,12,0"
                                                                       Style="{StaticResource SecondaryTextBlockStyle}"
                                                                       Text="{Binding CacheSizeText}" />
                                                            <TextBlock Margin="0,0,12,0"
                                                                       Style="{StaticResource SecondaryTextBlockStyle}"
                                                                       Text="{Binding EntryCountText}" />
                                                            <TextBlock Style="{StaticResource SecondaryTextBlockStyle}"
                                                                       Text="{Binding CompletenessText}" />
                                                        </WrapPanel>
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="1"
                                                               Margin="16,0,0,0"
                                                               VerticalAlignment="Top"
                                                               Text="已选择">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock"
                                                                   BasedOn="{StaticResource StrongTextBlockStyle}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        </Grid>
    </Border>
</Page>
