<Page x:Class="NovelSpeaker.App.Features.RegexReplacementRules.RegexReplacementRulesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:navigation="clr-namespace:NovelSpeaker.App.Shell.Navigation"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      MinHeight="0"
      navigation:NavigationViewportHeightBehavior.IsEnabled="True"
      ClipToBounds="True">
    <Grid Margin="{StaticResource PagePadding}"
          MinHeight="0"
          ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource BackIconButtonStyle}"
                        Command="{Binding BackCommand}"
                        ToolTip="返回"
                        AutomationProperties.Name="返回">
                    <ui:SymbolIcon Symbol="ChevronLeft24" />
                </Button>
                <TextBlock Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Style="{StaticResource PageTitleTextBlockStyle}"
                           Text="正则替换" />
            </StackPanel>

            <Button Grid.Column="1"
                    Style="{StaticResource SecondaryIconButtonStyle}"
                    Command="{Binding NewRuleCommand}"
                    ToolTip="新建规则"
                    AutomationProperties.Name="新建规则">
                <ui:SymbolIcon Symbol="DocumentAdd24" />
            </Button>
        </Grid>

        <Grid Grid.Row="1"
              Margin="0,20,0,0"
              MinHeight="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource CardBorderStyle}">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top"
                                Margin="16,16,16,12">
                        <TextBlock Style="{StaticResource SectionTitleTextBlockStyle}"
                                   Text="规则列表" />
                        <TextBlock Margin="0,6,0,0"
                                   Style="{StaticResource SecondaryTextBlockStyle}"
                                   Text="{Binding Rules.Count, StringFormat=共 {0} 条规则}" />
                    </StackPanel>

                    <TextBlock Margin="16,0,16,16"
                               Text="还没有替换规则，请先新建一条。">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock"
                                   BasedOn="{StaticResource SecondaryTextBlockStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Rules.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ListBox Margin="12,0,12,12"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemsSource="{Binding Rules}"
                             ScrollViewer.CanContentScroll="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource SelectableListItemContainerStyle}"
                                            AllowDrop="True"
                                            DragEnter="RuleItem_OnDragEnter"
                                            DragLeave="RuleItem_OnDragLeave"
                                            DragOver="RuleItem_OnDragOver"
                                            Drop="RuleItem_OnDrop"
                                            AutomationProperties.Name="{Binding AutomationName}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Button Style="{StaticResource BorderlessListItemButtonStyle}"
                                                    Command="{Binding DataContext.SelectRuleCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource StrongTextBlockStyle}"
                                                               Text="{Binding Name}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Margin="0,8,0,0"
                                                               Style="{StaticResource SecondaryTextBlockStyle}"
                                                               Text="{Binding PatternSummary}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Button>

                                            <Grid Grid.Row="1"
                                                  Margin="0,12,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <CheckBox Grid.Column="0"
                                                          VerticalAlignment="Center"
                                                          IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                                          Command="{Binding DataContext.ToggleEnabledCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                          CommandParameter="{Binding}"
                                                          Content="{Binding EnabledStateText}"
                                                          ToolTip="切换规则启用状态"
                                                          AutomationProperties.Name="{Binding EnabledStateText, StringFormat=规则状态：{0}}" />

                                                <Button Grid.Column="2"
                                                        Style="{StaticResource SecondaryIconButtonStyle}"
                                                        Tag="{Binding}"
                                                        PreviewMouseLeftButtonDown="DragHandle_OnPreviewMouseLeftButtonDown"
                                                        PreviewMouseMove="DragHandle_OnPreviewMouseMove"
                                                        ToolTip="拖动排序"
                                                        AutomationProperties.Name="拖动排序">
                                                    <ui:SymbolIcon Symbol="ReOrder24" />
                                                </Button>

                                                <Button Grid.Column="3"
                                                        Style="{StaticResource SecondaryIconButtonStyle}"
                                                        Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="上移"
                                                        AutomationProperties.Name="上移">
                                                    <ui:SymbolIcon Symbol="ArrowUp24" />
                                                </Button>

                                                <Button Grid.Column="5"
                                                        Style="{StaticResource SecondaryIconButtonStyle}"
                                                        Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="下移"
                                                        AutomationProperties.Name="下移">
                                                    <ui:SymbolIcon Symbol="ArrowDown24" />
                                                </Button>
                                            </Grid>

                                            <TextBlock Grid.Row="2"
                                                       Margin="0,10,0,0"
                                                       AutomationProperties.LiveSetting="Assertive"
                                                       AutomationProperties.Name="规则错误"
                                                       Text="{Binding ErrorMessage}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock"
                                                           BasedOn="{StaticResource ErrorTextBlockStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="2"
                    Style="{StaticResource CardBorderStyle}">
                <ScrollViewer Margin="24"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleTextBlockStyle}"
                                   Text="规则编辑" />

                        <TextBlock Margin="0,20,0,0"
                                   Style="{StaticResource FormLabelTextBlockStyle}"
                                   Text="名称" />
                        <TextBox Text="{Binding DraftName, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Margin="0,16,0,0"
                                   Style="{StaticResource FormLabelTextBlockStyle}"
                                   Text="正则表达式" />
                        <TextBox AcceptsReturn="True"
                                 MinHeight="72"
                                 Text="{Binding DraftPattern, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Margin="0,16,0,0"
                                   Style="{StaticResource FormLabelTextBlockStyle}"
                                   Text="替换文本" />
                        <TextBox AcceptsReturn="True"
                                 MinHeight="72"
                                 Text="{Binding DraftReplacement, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Margin="0,16,0,0"
                                   Style="{StaticResource FormLabelTextBlockStyle}"
                                   Text="作用范围" />
                        <ComboBox ItemsSource="{Binding Scopes}"
                                  SelectedItem="{Binding DraftScope}" />

                        <TextBlock Margin="0,8,0,0"
                                   Style="{StaticResource ErrorTextBlockStyle}"
                                   Text="{Binding ValidationMessage}" />

                        <StackPanel Margin="0,24,0,0"
                                    Orientation="Horizontal">
                            <Button Margin="0,0,8,0"
                                    Command="{Binding DeleteCommand}"
                                    IsEnabled="{Binding CanDelete}"
                                    Content="删除" />
                            <Button Margin="0,0,8,0"
                                    Command="{Binding CancelCommand}"
                                    IsEnabled="{Binding HasEditor}"
                                    Content="取消" />
                            <Button Command="{Binding SaveCommand}"
                                    IsEnabled="{Binding CanSave}"
                                    Content="保存" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
