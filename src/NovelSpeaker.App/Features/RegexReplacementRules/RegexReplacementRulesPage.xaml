<Page x:Class="NovelSpeaker.App.Features.RegexReplacementRules.RegexReplacementRulesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:commonControls="clr-namespace:NovelSpeaker.App.Shared.Presentation.Controls.Common"
      xmlns:feedbackControls="clr-namespace:NovelSpeaker.App.Shared.Presentation.Controls.Feedback"
      xmlns:formControls="clr-namespace:NovelSpeaker.App.Shared.Presentation.Controls.Forms"
      xmlns:navigation="clr-namespace:NovelSpeaker.App.Shell.Navigation"
      xmlns:rules="clr-namespace:NovelSpeaker.App.Shared.Presentation.Rules"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      MinHeight="0"
      Background="Transparent"
      ClipToBounds="True"
      navigation:NavigationViewportHeightBehavior.IsEnabled="True">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Page.Resources>

    <Grid Margin="24" MinHeight="0" ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <commonControls:AppPageHeader x:Name="PageHeader"
                                      Title="正则替换"
                                      BackCommand="{Binding BackCommand}">
            <commonControls:AppPageHeader.Actions>
                <WrapPanel x:Name="PageActions"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           ItemHeight="40">
                    <ui:Button Margin="0,0,8,0"
                            Style="{StaticResource App.Button.Icon}"
                            Command="{Binding NewRuleCommand}"
                            ToolTip="新建规则"
                            AutomationProperties.Name="新建规则"
                            Icon="{ui:SymbolIcon Symbol=DocumentAdd24}" />
                    <ui:Button Margin="0,0,8,0"
                            Style="{StaticResource App.Button.Icon}"
                            Click="ImportRuleFileButton_OnClick"
                            ToolTip="从文件导入"
                            AutomationProperties.Name="从文件导入"
                            Icon="{ui:SymbolIcon Symbol=ArrowImport24}" />
                    <ui:Button Margin="0,0,8,0"
                            Style="{StaticResource App.Button.Icon}"
                            Click="ImportRulesFromClipboardButton_OnClick"
                            ToolTip="从剪切板导入"
                            AutomationProperties.Name="从剪切板导入"
                            Icon="{ui:SymbolIcon Symbol=ClipboardPaste24}" />
                    <ui:Button Style="{StaticResource App.Button.Icon}"
                            Command="{Binding OpenHelpCommand}"
                            ToolTip="正则替换帮助"
                            AutomationProperties.Name="正则替换帮助"
                            Icon="{ui:SymbolIcon Symbol=QuestionCircle24}" />
                </WrapPanel>
            </commonControls:AppPageHeader.Actions>
        </commonControls:AppPageHeader>

        <Grid Grid.Row="1" Margin="0,20,0,0" MinHeight="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="280" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="3*" MinWidth="420" />
            </Grid.ColumnDefinitions>

            <commonControls:AppSectionSurface x:Name="RulesSurface"
                                              Grid.Column="0"
                                              Header="规则列表"
                                              Description="{Binding Rules.Count, StringFormat=共 {0} 条规则}">
                <Grid MinHeight="0">
                    <Border VerticalAlignment="Top">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource App.Feedback.InlineMessage}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Rules.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Style="{StaticResource App.Typography.Secondary}"
                                   Text="还没有替换规则，请使用页首操作新建或导入。"
                                   TextWrapping="Wrap" />
                    </Border>

                    <ListBox x:Name="RulesList"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemsSource="{Binding Rules}"
                             ScrollViewer.CanContentScroll="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <rules:RuleListItemView Title="{Binding Name}"
                                                        Summary="{Binding PatternSummary}"
                                                        IsRuleEnabled="{Binding IsEnabled}"
                                                        IsSelected="{Binding IsSelected}"
                                                        IsSortable="{Binding CanQuickActions}"
                                                        CanToggle="{Binding CanQuickActions}"
                                                        HasError="{Binding HasError}"
                                                        ErrorMessage="{Binding ErrorMessage}"
                                                        SelectCommand="{Binding DataContext.SelectRuleCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                        ToggleEnabledCommand="{Binding DataContext.ToggleEnabledCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                        ExportCommand="{Binding DataContext.ExportRuleCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                        CopyCommand="{Binding DataContext.CopyRuleCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                        MoveUpCommand="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                        MoveDownCommand="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                        DeleteCommand="{Binding DataContext.DeleteRuleCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                        ReorderCommand="{Binding DataContext.ReorderRuleCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                        CommandParameter="{Binding}"
                                                        CanExport="{Binding CanQuickActions}"
                                                        CanCopy="{Binding CanQuickActions}"
                                                        CanDelete="{Binding CanDeleteAction}"
                                                        CanMoveUp="{Binding CanMoveUp}"
                                                        CanMoveDown="{Binding CanMoveDown}"
                                                        AutomationProperties.Name="{Binding AutomationName}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </commonControls:AppSectionSurface>

            <commonControls:AppSectionSurface x:Name="EditorSurface"
                                              Grid.Column="2"
                                              Header="规则编辑">
                <Grid MinHeight="0">
                    <feedbackControls:AppStatusView HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Center"
                                                    Status="Empty"
                                                    Icon="DocumentEdit24"
                                                    Title="选择一条规则"
                                                    Description="从左侧单击规则打开编辑器，或使用页首操作新建规则。">
                        <feedbackControls:AppStatusView.Style>
                            <Style TargetType="feedbackControls:AppStatusView"
                                   BasedOn="{StaticResource {x:Type feedbackControls:AppStatusView}}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasEditor}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </feedbackControls:AppStatusView.Style>
                    </feedbackControls:AppStatusView>

                    <ScrollViewer x:Name="RuleEditorScrollViewer"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasEditor}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <StackPanel>
                            <formControls:AppFormField Label="名称"
                                                       Required="True"
                                                       Error="{Binding NameValidationMessage}">
                                <TextBox Style="{StaticResource App.Input.TextBox.Standard}"
                                         Text="{Binding DraftName, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="规则名称" />
                            </formControls:AppFormField>

                            <formControls:AppFormField Margin="0,16,0,0"
                                                       Label="正则表达式"
                                                       Required="True"
                                                       Error="{Binding PatternValidationMessage}">
                                <TextBox MinHeight="96"
                                         Style="{StaticResource App.Input.TextBox.Standard}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         Text="{Binding DraftPattern, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="正则表达式" />
                            </formControls:AppFormField>

                            <formControls:AppFormField Margin="0,16,0,0"
                                                       Label="替换文本"
                                                       Description="可以留空；捕获组可使用 $1、$2 等引用。">
                                <TextBox MinHeight="88"
                                         Style="{StaticResource App.Input.TextBox.Standard}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         Text="{Binding DraftReplacement, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="替换文本" />
                            </formControls:AppFormField>

                            <formControls:AppFormField Margin="0,16,0,0"
                                                       Label="作用目标"
                                                       Description="选择仅显示、仅朗读或同时作用于显示与朗读。">
                                <ComboBox Style="{StaticResource App.Input.ComboBox.Standard}"
                                          ItemsSource="{Binding Scopes}"
                                          SelectedItem="{Binding DraftScope}"
                                          AutomationProperties.Name="作用目标" />
                            </formControls:AppFormField>

                            <WrapPanel Margin="0,20,0,0" HorizontalAlignment="Right">
                                <Button Margin="0,0,8,0"
                                        Style="{StaticResource App.Button.Subtle}"
                                        Command="{Binding CancelCommand}"
                                        Content="取消"
                                        IsEnabled="{Binding CanCancel}" />
                                <Button Style="{StaticResource App.Button.Primary}"
                                        Command="{Binding SaveCommand}"
                                        Content="保存"
                                        IsEnabled="{Binding CanSave}" />
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </commonControls:AppSectionSurface>

            <Grid Grid.ColumnSpan="3"
                  Panel.ZIndex="10"
                  Visibility="{Binding IsHelpDrawerOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="380" />
                </Grid.ColumnDefinitions>
                <Button x:Name="HelpDrawerDismissOverlay"
                        Grid.Column="0"
                        Opacity="0.45"
                        Background="{DynamicResource App.Brush.Canvas}"
                        BorderThickness="0"
                        Style="{StaticResource App.Button.Floating}"
                        Command="{Binding CloseHelpCommand}"
                        ToolTip="关闭正则替换帮助"
                        AutomationProperties.Name="关闭正则替换帮助" />
                <Border x:Name="HelpDrawerBorder"
                        Grid.Column="1"
                        Padding="20"
                        Style="{StaticResource App.Feedback.PopupSurface}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource App.Typography.SectionTitle}"
                                       Text="正则替换帮助" />
                            <ui:Button Grid.Column="1"
                                    Style="{StaticResource App.Button.Icon}"
                                    Command="{Binding CloseHelpCommand}"
                                    ToolTip="关闭帮助"
                                    AutomationProperties.Name="关闭帮助"
                                    Icon="{ui:SymbolIcon Symbol=Dismiss24}" />
                        </Grid>
                        <ScrollViewer Grid.Row="1"
                                      Margin="0,16,0,0"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock Style="{StaticResource App.Typography.ItemTitle}" Text="作用范围" />
                                <TextBlock Margin="0,8,0,0"
                                           Style="{StaticResource App.Typography.Secondary}"
                                           Text="“仅显示”只改变页面正文，“仅朗读”只改变送往 TTS 的文本，“显示与朗读”同时作用于两者。规则不会修改导入后的原始正文。"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,18,0,0"
                                           Style="{StaticResource App.Typography.ItemTitle}"
                                           Text="执行顺序" />
                                <TextBlock Margin="0,8,0,0"
                                           Style="{StaticResource App.Typography.Secondary}"
                                           Text="只执行已启用的规则，并按左侧顺序从前到后替换。可整卡长按后拖动排序，也可在右键菜单中使用上移或下移。"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,18,0,0"
                                           Style="{StaticResource App.Typography.ItemTitle}"
                                           Text="空输出" />
                                <TextBlock Margin="0,8,0,0"
                                           Style="{StaticResource App.Typography.Secondary}"
                                           Text="替换文本可以留空。显示结果为空时该段不显示；朗读结果为空时会安全跳过 TTS。"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,18,0,0"
                                           Style="{StaticResource App.Typography.ItemTitle}"
                                           Text="正则小抄" />
                                <TextBlock Margin="0,8,0,0"
                                           Style="{StaticResource App.Typography.Secondary}"
                                           Text="^ 和 $ 限定开头与结尾；\s+ 匹配一个或多个空白；(甲|乙) 匹配其中之一；$1 在替换文本中引用第一个捕获组。保存前会检查表达式是否有效。"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
