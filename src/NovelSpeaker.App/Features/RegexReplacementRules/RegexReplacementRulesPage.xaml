<Page x:Class="NovelSpeaker.App.Features.RegexReplacementRules.RegexReplacementRulesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:navigation="clr-namespace:NovelSpeaker.App.Shell.Navigation"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      MinHeight="0"
      navigation:NavigationViewportHeightBehavior.IsEnabled="True"
      ClipToBounds="True">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Page.Resources>

    <Grid Margin="{StaticResource PagePadding}"
          MinHeight="0"
          ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource BackIconButtonStyle}"
                        Command="{Binding BackCommand}"
                        ToolTip="返回"
                        AutomationProperties.Name="返回">
                    <ui:SymbolIcon Symbol="ChevronLeft24" />
                </Button>
                <TextBlock Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Style="{StaticResource PageTitleTextBlockStyle}"
                           Text="正则替换" />
            </StackPanel>

            <Button Grid.Column="1"
                    Style="{StaticResource SecondaryIconButtonStyle}"
                    Command="{Binding NewRuleCommand}"
                    ToolTip="新建规则"
                    AutomationProperties.Name="新建规则">
                <ui:SymbolIcon Symbol="DocumentAdd24" />
            </Button>
        </Grid>

        <Grid Grid.Row="1"
              Margin="{StaticResource PageSectionSpacing}"
              MinHeight="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource CardBorderStyle}">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top"
                                Margin="{StaticResource ListHeaderMargin}">
                        <TextBlock Style="{StaticResource SectionTitleTextBlockStyle}"
                                   Text="规则列表" />
                        <TextBlock Margin="{StaticResource FieldControlSpacing}"
                                   Style="{StaticResource SecondaryTextBlockStyle}"
                                   Text="{Binding Rules.Count, StringFormat=共 {0} 条规则}" />
                    </StackPanel>

                    <TextBlock Margin="{StaticResource EmptyListMessageMargin}"
                               Text="还没有替换规则，请先新建一条。">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock"
                                   BasedOn="{StaticResource SecondaryTextBlockStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Rules.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ListBox Margin="{StaticResource ListViewportMargin}"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemsSource="{Binding Rules}"
                             ScrollViewer.CanContentScroll="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <StaticResource ResourceKey="RuleWorkbenchListItemContainerStyle" />
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="0"
                                            Style="{StaticResource DropTargetListItemContainerStyle}"
                                            AllowDrop="True"
                                            DragEnter="RuleItem_OnDragEnter"
                                            DragLeave="RuleItem_OnDragLeave"
                                            DragOver="RuleItem_OnDragOver"
                                            Drop="RuleItem_OnDrop"
                                            AutomationProperties.Name="{Binding AutomationName}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Button Grid.RowSpan="3"
                                                    Padding="0"
                                                    Style="{StaticResource BorderlessListItemButtonStyle}"
                                                    Command="{Binding DataContext.SelectRuleCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}"
                                                    AutomationProperties.Name="{Binding AutomationName}"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Stretch"
                                                    Panel.ZIndex="0" />

                                            <StackPanel Grid.Row="0"
                                                        Margin="{StaticResource ListItemHeaderMargin}"
                                                        IsHitTestVisible="False"
                                                        Panel.ZIndex="1">
                                                    <TextBlock Style="{StaticResource StrongTextBlockStyle}"
                                                               Text="{Binding Name}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Margin="0,8,0,0"
                                                               Style="{StaticResource SecondaryTextBlockStyle}"
                                                               Text="{Binding PatternSummary}"
                                                               TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <Grid Grid.Row="1"
                                                  Margin="{StaticResource ListItemContentMargin}"
                                                  Panel.ZIndex="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <CheckBox Grid.Column="0"
                                                          VerticalAlignment="Center"
                                                          IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                                          IsEnabled="{Binding CanQuickActions}"
                                                          Command="{Binding DataContext.ToggleEnabledCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                          CommandParameter="{Binding}"
                                                          Content="启用"
                                                          ToolTip="切换规则启用状态"
                                                          AutomationProperties.Name="{Binding Name, StringFormat=切换规则启用状态：{0}}" />

                                                <Button Grid.Column="2"
                                                        Style="{StaticResource BorderlessIconButtonStyle}"
                                                        Tag="{Binding}"
                                                        IsEnabled="{Binding CanQuickActions}"
                                                        PreviewMouseLeftButtonDown="DragHandle_OnPreviewMouseLeftButtonDown"
                                                        PreviewMouseMove="DragHandle_OnPreviewMouseMove"
                                                        ToolTip="拖动排序"
                                                        AutomationProperties.Name="{Binding Name, StringFormat=拖动排序：{0}}">
                                                    <ui:SymbolIcon Symbol="ReOrder24" />
                                                </Button>

                                                <Button Grid.Column="4"
                                                        Style="{StaticResource BorderlessIconButtonStyle}"
                                                        Click="RuleMoreButton_OnClick"
                                                        IsEnabled="{Binding CanQuickActions}"
                                                        ToolTip="更多操作"
                                                        AutomationProperties.Name="{Binding Name, StringFormat=更多操作：{0}}">
                                                    <ui:SymbolIcon Symbol="MoreHorizontal24" />
                                                    <Button.ContextMenu>
                                                        <ContextMenu Style="{StaticResource AppContextMenuStyle}">
                                                            <MenuItem Header="上移"
                                                                      IsEnabled="{Binding CanMoveUp}"
                                                                      Click="MoveRuleUpMenuItem_OnClick" />
                                                            <MenuItem Header="下移"
                                                                      IsEnabled="{Binding CanMoveDown}"
                                                                      Click="MoveRuleDownMenuItem_OnClick" />
                                                            <Separator />
                                                            <MenuItem Header="删除"
                                                                      IsEnabled="{Binding CanDeleteAction}"
                                                                      Click="DeleteRuleMenuItem_OnClick" />
                                                        </ContextMenu>
                                                    </Button.ContextMenu>
                                                </Button>
                                            </Grid>

                                            <TextBlock Grid.Row="2"
                                                       Margin="14,0,14,12"
                                                       Panel.ZIndex="1"
                                                       AutomationProperties.LiveSetting="Assertive"
                                                       AutomationProperties.Name="规则错误"
                                                       Text="{Binding ErrorMessage}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock"
                                                           BasedOn="{StaticResource ErrorTextBlockStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="2"
                    Style="{StaticResource CardBorderStyle}">
                <Grid MinHeight="0">
                    <Border Margin="{StaticResource CardContentPadding}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            MaxWidth="420">
                        <Border.Style>
                            <Style TargetType="Border"
                                   BasedOn="{StaticResource CardBorderStyle}">
                                <Setter Property="Padding" Value="20" />
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasEditor}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock HorizontalAlignment="Center"
                                       Style="{StaticResource SectionTitleTextBlockStyle}"
                                       Text="选择一条规则" />
                            <TextBlock Margin="{StaticResource FieldDescriptionSpacing}"
                                       HorizontalAlignment="Center"
                                       Style="{StaticResource SecondaryTextBlockStyle}"
                                       Text="左侧选择已有规则，或使用顶部按钮新建规则。"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                <ScrollViewer Margin="24"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasEditor}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center"
                                       Style="{StaticResource SectionTitleTextBlockStyle}"
                                       Text="规则编辑" />
                            <Button Grid.Column="1"
                                    Style="{StaticResource SecondaryIconButtonStyle}"
                                    Command="{Binding OpenHelpCommand}"
                                    ToolTip="正则替换帮助"
                                    AutomationProperties.Name="正则替换帮助">
                                <ui:SymbolIcon Symbol="QuestionCircle24" />
                            </Button>
                        </Grid>

                        <TextBlock Margin="{StaticResource PageSectionSpacing}"
                                   Style="{StaticResource FormLabelTextBlockStyle}"
                                   Text="名称" />
                        <TextBox Text="{Binding DraftName, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Margin="{StaticResource ContentSpacing}"
                                   Style="{StaticResource FormLabelTextBlockStyle}"
                                   Text="正则表达式" />
                        <TextBox AcceptsReturn="True"
                                 MinHeight="72"
                                 Text="{Binding DraftPattern, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Margin="{StaticResource ContentSpacing}"
                                   Style="{StaticResource FormLabelTextBlockStyle}"
                                   Text="替换文本" />
                        <TextBox AcceptsReturn="True"
                                 MinHeight="72"
                                 Text="{Binding DraftReplacement, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Margin="{StaticResource ContentSpacing}"
                                   Style="{StaticResource FormLabelTextBlockStyle}"
                                   Text="作用范围" />
                        <ComboBox ItemsSource="{Binding Scopes}"
                                  SelectedItem="{Binding DraftScope}" />

                        <TextBlock Margin="0,8,0,0"
                                   Style="{StaticResource ErrorTextBlockStyle}"
                                   Text="{Binding ValidationMessage}" />

                        <Grid Margin="0,24,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="1"
                                    Padding="{StaticResource ButtonPadding}"
                                    Command="{Binding CancelCommand}"
                                    IsEnabled="{Binding CanCancel}"
                                    Content="取消" />
                            <Button Grid.Column="3"
                                    Padding="{StaticResource ButtonPadding}"
                                    Command="{Binding SaveCommand}"
                                    IsEnabled="{Binding CanSave}"
                                    Content="保存" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
                </Grid>
            </Border>

            <Grid Grid.ColumnSpan="3"
                  Panel.ZIndex="10"
                  Visibility="{Binding IsHelpDrawerOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="380" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        AutomationProperties.Name="关闭正则替换帮助"
                        ToolTip="关闭正则替换帮助"
                        Background="{DynamicResource RaisedSurfaceBrush}"
                        BorderThickness="0"
                        Command="{Binding CloseHelpCommand}" />

                <Border Grid.Column="1"
                        Padding="{StaticResource CardContentPadding}"
                        Style="{StaticResource PopupSurfaceBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource SectionTitleTextBlockStyle}"
                                       Text="正则替换帮助" />
                            <Button Grid.Column="1"
                                    Style="{StaticResource SecondaryIconButtonStyle}"
                                    Command="{Binding CloseHelpCommand}"
                                    ToolTip="关闭帮助"
                                    AutomationProperties.Name="关闭帮助">
                                <ui:SymbolIcon Symbol="Dismiss24" />
                            </Button>
                        </Grid>

                        <ScrollViewer Grid.Row="1"
                                      Margin="{StaticResource ContentSpacing}"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock Style="{StaticResource StrongTextBlockStyle}"
                                           Text="作用范围" />
                                <TextBlock Margin="0,8,0,0"
                                           Style="{StaticResource SecondaryTextBlockStyle}"
                                           Text="“仅显示”只改变页面正文，“仅朗读”只改变送往 TTS 的文本，“显示与朗读”同时作用于两者。规则不会修改导入后的原始正文。"
                                           TextWrapping="Wrap" />

                                <TextBlock Margin="{StaticResource SectionHeadingSpacing}"
                                           Style="{StaticResource StrongTextBlockStyle}"
                                           Text="执行顺序" />
                                <TextBlock Margin="0,8,0,0"
                                           Style="{StaticResource SecondaryTextBlockStyle}"
                                           Text="只执行已启用的规则，并按左侧顺序从前到后替换。可拖动排序，也可在更多菜单中使用上移或下移。"
                                           TextWrapping="Wrap" />

                                <TextBlock Margin="{StaticResource SectionHeadingSpacing}"
                                           Style="{StaticResource StrongTextBlockStyle}"
                                           Text="空输出" />
                                <TextBlock Margin="0,8,0,0"
                                           Style="{StaticResource SecondaryTextBlockStyle}"
                                           Text="替换文本可以留空。显示结果为空时该段不显示；朗读结果为空时会安全跳过 TTS。"
                                           TextWrapping="Wrap" />

                                <TextBlock Margin="{StaticResource SectionHeadingSpacing}"
                                           Style="{StaticResource StrongTextBlockStyle}"
                                           Text="正则小抄" />
                                <TextBlock Margin="0,8,0,0"
                                           Style="{StaticResource SecondaryTextBlockStyle}"
                                           Text="^ 和 $ 限定开头与结尾；\s+ 匹配一个或多个空白；(甲|乙) 匹配其中之一；$1 在替换文本中引用第一个捕获组。保存前会检查表达式是否有效。"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
