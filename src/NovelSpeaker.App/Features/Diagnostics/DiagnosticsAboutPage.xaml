<Page x:Class="NovelSpeaker.App.Features.Diagnostics.DiagnosticsAboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Button Style="{StaticResource BackIconButtonStyle}"
                Command="{Binding BackCommand}"
                ToolTip="返回"
                AutomationProperties.Name="返回">
            <ui:SymbolIcon Symbol="ChevronLeft24" />
        </Button>

        <ScrollViewer Grid.Row="1"
                      Margin="0,20,0,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitleTextBlockStyle}"
                           Text="诊断与关于" />

                <StackPanel Margin="{StaticResource SectionSpacing}">
                    <Border x:Name="AppNameItemBorder"
                            Style="{StaticResource SettingsSubpageItemBorderStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SettingsSubpageItemTitleTextBlockStyle}"
                                       Text="应用名称" />
                            <TextBlock Margin="0,10,0,0"
                                       Style="{StaticResource PrimaryTextBlockStyle}"
                                       Text="{Binding AppName}" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="AppVersionItemBorder"
                            Style="{StaticResource SettingsSubpageItemBorderStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SettingsSubpageItemTitleTextBlockStyle}"
                                       Text="应用版本" />
                            <TextBlock Margin="0,10,0,0"
                                       Style="{StaticResource PrimaryTextBlockStyle}"
                                       Text="{Binding AppVersion}" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="DescriptionItemBorder"
                            Style="{StaticResource SettingsSubpageItemBorderStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SettingsSubpageItemTitleTextBlockStyle}"
                                       Text="项目说明" />
                            <TextBlock Margin="0,10,0,0"
                                       Style="{StaticResource PrimaryTextBlockStyle}"
                                       Text="{Binding Description}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="DatabaseSchemaVersionItemBorder"
                            Style="{StaticResource SettingsSubpageItemBorderStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SettingsSubpageItemTitleTextBlockStyle}"
                                       Text="数据库版本" />
                            <TextBlock Margin="0,10,0,0"
                                       Style="{StaticResource PrimaryTextBlockStyle}"
                                       Text="{Binding DatabaseSchemaVersionText}" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="AppDataDirectoryItemBorder"
                            Style="{StaticResource SettingsSubpageItemBorderStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SettingsSubpageItemTitleTextBlockStyle}"
                                       Text="应用数据目录" />
                            <TextBlock Margin="0,10,0,0"
                                       Style="{StaticResource PrimaryTextBlockStyle}"
                                       Text="{Binding AppDataDirectoryPath}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="LogsDirectoryItemBorder"
                            Style="{StaticResource SettingsSubpageItemBorderStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SettingsSubpageItemTitleTextBlockStyle}"
                                       Text="日志目录" />
                            <TextBlock Margin="0,10,0,0"
                                       Style="{StaticResource PrimaryTextBlockStyle}"
                                       Text="{Binding LogsDirectoryPath}"
                                       TextWrapping="Wrap" />
                            <Button Margin="0,10,0,0"
                                    Width="180"
                                    HorizontalAlignment="Left"
                                    Command="{Binding OpenLogsDirectoryCommand}"
                                    Content="打开日志目录" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="LogLevelItemBorder"
                            Style="{StaticResource SettingsSubpageItemBorderStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SettingsSubpageItemTitleTextBlockStyle}"
                                       Text="日志级别" />
                            <ComboBox Margin="0,10,0,0"
                                      Width="220"
                                      HorizontalAlignment="Left"
                                      ItemsSource="{Binding AvailableLogLevels}"
                                      SelectedItem="{Binding SelectedLogLevel}" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="DiagnosticsSummaryItemBorder"
                            Style="{StaticResource SettingsSubpageItemBorderStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SettingsSubpageItemTitleTextBlockStyle}"
                                       Text="脱敏诊断摘要" />
                            <TextBlock Margin="0,10,0,0"
                                       Style="{StaticResource SecondaryTextBlockStyle}"
                                       Text="仅包含版本、运行环境和目录信息，不包含小说正文、规则或凭据。"
                                       TextWrapping="Wrap" />
                            <Button Margin="0,10,0,0"
                                    Width="180"
                                    HorizontalAlignment="Left"
                                    Command="{Binding CopyRedactedSummaryCommand}"
                                    Content="复制脱敏诊断摘要" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="ThirdPartyNoticesItemBorder"
                            Style="{StaticResource SettingsSubpageItemBorderStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SettingsSubpageItemTitleTextBlockStyle}"
                                       Text="第三方许可证" />
                            <Button Margin="0,10,0,0"
                                    Width="180"
                                    HorizontalAlignment="Left"
                                    Command="{Binding OpenThirdPartyNoticesCommand}"
                                    Content="打开第三方许可证" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
