<Page x:Class="NovelSpeaker.App.Features.Diagnostics.DiagnosticsAboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Button Style="{StaticResource BackIconButtonStyle}"
                Command="{Binding BackCommand}"
                ToolTip="返回"
                AutomationProperties.Name="返回">
            <ui:SymbolIcon Symbol="ChevronLeft24" />
        </Button>

        <ScrollViewer Grid.Row="1"
                      Margin="0,20,0,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitleTextBlockStyle}"
                           Text="诊断与关于" />

                <Border Margin="{StaticResource SectionSpacing}"
                        Style="{StaticResource SettingsRowsGroupBorderStyle}">
                    <StackPanel>
                        <Border x:Name="AppNameItemBorder"
                                Style="{StaticResource SettingsRowBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource SettingsRowTitleTextBlockStyle}"
                                           Text="应用名称" />
                                <TextBlock Grid.Column="1"
                                           Margin="{StaticResource SettingsRowControlMargin}"
                                           HorizontalAlignment="Right"
                                           Style="{StaticResource SettingsRowValueTextBlockStyle}"
                                           Text="{Binding AppName}"
                                           AutomationProperties.Name="应用名称" />
                            </Grid>
                        </Border>

                        <Border x:Name="AppVersionItemBorder"
                                Style="{StaticResource SettingsRowBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource SettingsRowTitleTextBlockStyle}"
                                           Text="应用版本" />
                                <TextBlock Grid.Column="1"
                                           Margin="{StaticResource SettingsRowControlMargin}"
                                           HorizontalAlignment="Right"
                                           Style="{StaticResource SettingsRowValueTextBlockStyle}"
                                           Text="{Binding AppVersion}"
                                           AutomationProperties.Name="应用版本" />
                            </Grid>
                        </Border>

                        <Border x:Name="DescriptionItemBorder"
                                Style="{StaticResource SettingsRowBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource SettingsRowTitleTextBlockStyle}"
                                           Text="项目说明" />
                                <TextBlock Grid.Column="1"
                                           Margin="{StaticResource SettingsRowControlMargin}"
                                           HorizontalAlignment="Right"
                                           Style="{StaticResource SettingsRowValueTextBlockStyle}"
                                           Text="{Binding Description}"
                                           AutomationProperties.Name="项目说明" />
                            </Grid>
                        </Border>

                        <Border x:Name="DatabaseSchemaVersionItemBorder"
                                Style="{StaticResource SettingsRowBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource SettingsRowTitleTextBlockStyle}"
                                           Text="数据库版本" />
                                <TextBlock Grid.Column="1"
                                           Margin="{StaticResource SettingsRowControlMargin}"
                                           HorizontalAlignment="Right"
                                           Style="{StaticResource SettingsRowValueTextBlockStyle}"
                                           Text="{Binding DatabaseSchemaVersionText}"
                                           AutomationProperties.Name="数据库版本" />
                            </Grid>
                        </Border>

                        <Border x:Name="AppDataDirectoryItemBorder"
                                Style="{StaticResource SettingsRowBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource SettingsRowTitleTextBlockStyle}"
                                           Text="应用数据目录" />
                                <TextBlock Grid.Column="1"
                                           Margin="{StaticResource SettingsRowControlMargin}"
                                           HorizontalAlignment="Right"
                                           Style="{StaticResource SettingsRowValueTextBlockStyle}"
                                           Text="{Binding AppDataDirectoryPath}"
                                           AutomationProperties.Name="应用数据目录" />
                            </Grid>
                        </Border>

                        <Border x:Name="LogsDirectoryItemBorder"
                                Style="{StaticResource SettingsRowBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource SettingsRowTitleTextBlockStyle}"
                                               Text="日志目录" />
                                    <TextBlock Style="{StaticResource SettingsRowDescriptionTextBlockStyle}"
                                               Text="{Binding LogsDirectoryPath}" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Margin="{StaticResource SettingsRowControlMargin}"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource SecondaryIconButtonStyle}"
                                        Command="{Binding OpenLogsDirectoryCommand}"
                                        ToolTip="打开日志目录"
                                        AutomationProperties.Name="打开日志目录">
                                    <ui:SymbolIcon Symbol="FolderOpen24" />
                                </Button>
                            </Grid>
                        </Border>

                        <Border x:Name="LogLevelItemBorder"
                                Style="{StaticResource SettingsRowBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource SettingsRowTitleTextBlockStyle}"
                                               Text="日志级别" />
                                    <TextBlock Style="{StaticResource SettingsRowDescriptionTextBlockStyle}"
                                               Text="控制写入日志的最低详细程度。" />
                                </StackPanel>
                                <ComboBox Grid.Column="1"
                                          Margin="{StaticResource SettingsRowControlMargin}"
                                          Width="{StaticResource SettingsRowControlWidth}"
                                          VerticalAlignment="Center"
                                          ItemsSource="{Binding AvailableLogLevels}"
                                          SelectedItem="{Binding SelectedLogLevel}"
                                          AutomationProperties.Name="日志级别" />
                            </Grid>
                        </Border>

                        <Border x:Name="DiagnosticsSummaryItemBorder"
                                Style="{StaticResource SettingsRowBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource SettingsRowTitleTextBlockStyle}"
                                               Text="脱敏诊断摘要" />
                                    <TextBlock Style="{StaticResource SettingsRowDescriptionTextBlockStyle}"
                                               Text="仅包含版本、运行环境和目录信息，不包含小说正文、规则或凭据。" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Margin="{StaticResource SettingsRowControlMargin}"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource SecondaryIconButtonStyle}"
                                        Command="{Binding CopyRedactedSummaryCommand}"
                                        ToolTip="复制脱敏诊断摘要"
                                        AutomationProperties.Name="复制脱敏诊断摘要">
                                    <ui:SymbolIcon Symbol="DocumentCopy24" />
                                </Button>
                            </Grid>
                        </Border>

                        <Border x:Name="ThirdPartyNoticesItemBorder"
                                Style="{StaticResource SettingsLastRowBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource SettingsRowTitleTextBlockStyle}"
                                           Text="第三方许可证" />
                                <Button Grid.Column="1"
                                        Margin="{StaticResource SettingsRowControlMargin}"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource SecondaryIconButtonStyle}"
                                        Command="{Binding OpenThirdPartyNoticesCommand}"
                                        ToolTip="打开第三方许可证"
                                        AutomationProperties.Name="打开第三方许可证">
                                    <ui:SymbolIcon Symbol="DocumentText24" />
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
