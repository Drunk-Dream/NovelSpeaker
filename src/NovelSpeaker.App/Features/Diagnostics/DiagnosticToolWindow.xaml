<Window x:Class="NovelSpeaker.App.Features.Diagnostics.DiagnosticToolWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="诊断录制"
        SizeToContent="WidthAndHeight"
        MinWidth="300"
        MaxWidth="1040"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource App.Brush.Surface.Primary}"
        AutomationProperties.Name="诊断录制控制条">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>
    <Border x:Name="ToolbarSurface"
            Padding="12,10"
            BorderThickness="1"
            BorderBrush="{DynamicResource App.Brush.Border.Subtle}"
            Background="{DynamicResource App.Brush.Surface.Raised}"
            PreviewMouseLeftButtonDown="OnToolbarMouseLeftButtonDown">
        <StackPanel>
            <StackPanel x:Name="PreparingActions"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsPreparing, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ui:Button Content="开始诊断"
                        Height="34"
                        Style="{StaticResource App.Button.Primary}"
                        Command="{Binding StartCommand}"
                        AutomationProperties.Name="开始诊断" />
                <ComboBox Margin="10,0,0,0"
                          Width="112"
                          Height="34"
                          Style="{StaticResource App.Input.ComboBox.Standard}"
                          ItemsSource="{Binding CapacityOptions}"
                          DisplayMemberPath="DisplayText"
                          SelectedItem="{Binding SelectedCapacity, Mode=TwoWay}"
                          AutomationProperties.Name="诊断容量上限" />
                <Button Margin="10,0,0,0"
                        Content="关闭"
                        Height="34"
                        Style="{StaticResource App.Button.Secondary}"
                        Command="{Binding CloseCommand}"
                        AutomationProperties.Name="关闭诊断工具" />
            </StackPanel>

            <StackPanel x:Name="CapturingActions"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsCapturing, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel MinWidth="138" VerticalAlignment="Center">
                    <TextBlock Text="● 诊断中"
                               Style="{StaticResource App.Typography.GroupTitle}" />
                    <TextBlock Margin="0,2,0,0"
                               Text="{Binding DurationText}"
                               Style="{StaticResource App.Typography.Secondary}"
                               AutomationProperties.Name="诊断持续时间" />
                </StackPanel>
                <StackPanel Margin="8,0,10,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SessionStorageText}"
                               Style="{StaticResource App.Typography.Secondary}"
                               AutomationProperties.Name="诊断容量使用情况" />
                    <TextBlock Margin="0,2,0,0"
                               Text="{Binding DroppedRecordText}"
                               Style="{StaticResource App.Typography.Secondary}"
                               AutomationProperties.Name="诊断跳过记录数" />
                    <TextBlock Margin="0,2,0,0"
                               Text="{Binding StateText}"
                               Style="{StaticResource App.Typography.Secondary}"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="240" />
                </StackPanel>
                <Button Content="标记问题"
                        Height="34"
                        Style="{StaticResource App.Button.Secondary}"
                        Command="{Binding MarkProblemCommand}"
                        AutomationProperties.Name="标记问题" />
                <Button Margin="8,0,0,0"
                        Content="截取当前窗口"
                        Height="34"
                        Style="{StaticResource App.Button.Secondary}"
                        Command="{Binding CaptureWindowCommand}"
                        AutomationProperties.Name="截取当前窗口" />
                <ui:Button Margin="8,0,0,0"
                        Content="结束"
                        Height="34"
                        Style="{StaticResource App.Button.Primary}"
                        Command="{Binding EndCommand}"
                        AutomationProperties.Name="结束诊断" />
            </StackPanel>

            <StackPanel x:Name="CompletedActions"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsCompleted, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel MinWidth="168" VerticalAlignment="Center">
                    <TextBlock Text="✓ 诊断已保存"
                               Style="{StaticResource App.Typography.GroupTitle}" />
                    <TextBlock Margin="0,2,0,0"
                               Text="{Binding SessionStorageText}"
                               Style="{StaticResource App.Typography.Secondary}" />
                    <TextBlock Margin="0,2,0,0"
                               Text="{Binding DroppedRecordText}"
                               Style="{StaticResource App.Typography.Secondary}"
                               AutomationProperties.Name="诊断跳过记录数" />
                </StackPanel>
                <ui:Button Content="重新开始"
                        Height="34"
                        Style="{StaticResource App.Button.Primary}"
                        Command="{Binding RestartCommand}"
                        AutomationProperties.Name="重新开始诊断" />
                <ui:Button Margin="8,0,0,0"
                        Content="导出"
                        Height="34"
                        Style="{StaticResource App.Button.Primary}"
                        Command="{Binding ExportCommand}"
                        AutomationProperties.Name="导出问题诊断" />
                <Button Margin="8,0,0,0"
                        Content="完成"
                        Height="34"
                        Style="{StaticResource App.Button.Secondary}"
                        Command="{Binding CloseCommand}"
                        AutomationProperties.Name="完成诊断" />
            </StackPanel>

            <TextBlock Margin="0,8,0,0"
                       Text="{Binding ErrorText}"
                       TextWrapping="Wrap"
                       MaxWidth="960">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource App.Typography.Validation}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ErrorText}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
    </Border>
</Window>
