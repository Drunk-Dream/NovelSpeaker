<Page x:Class="NovelSpeaker.App.Features.PlaybackSettings.PlaybackSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:theming="clr-namespace:NovelSpeaker.App.Shared.Theming"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Button Style="{StaticResource BackIconButtonStyle}"
                Command="{Binding BackCommand}"
                ToolTip="返回"
                AutomationProperties.Name="返回">
            <ui:SymbolIcon Symbol="ChevronLeft24" />
        </Button>

        <ScrollViewer Grid.Row="1"
                      Margin="0,20,0,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitleTextBlockStyle}"
                           Text="播放设置" />

                <Border Margin="{StaticResource SectionSpacing}"
                        Style="{StaticResource SettingsRowsGroupBorderStyle}">
                    <StackPanel>
                        <Border x:Name="DefaultSpeakSpeedItemBorder"
                                Style="{StaticResource SettingsRowBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource SettingsRowTitleTextBlockStyle}"
                                               Text="默认语速" />
                                    <TextBlock Style="{StaticResource SettingsRowDescriptionTextBlockStyle}"
                                               Text="用于后续朗读；当前播放按既有刷新规则应用。" />
                                    <TextBlock Text="{Binding DefaultSpeakSpeedErrorText}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock"
                                                   BasedOn="{StaticResource ErrorTextBlockStyle}">
                                                <Setter Property="Margin" Value="0,4,0,0" />
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DefaultSpeakSpeedErrorText}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <TextBox x:Name="DefaultSpeakSpeedTextBox"
                                         Grid.Column="1"
                                         Margin="{StaticResource SettingsRowControlMargin}"
                                         Width="{StaticResource SettingsRowControlWidth}"
                                         VerticalAlignment="Center"
                                         PreviewKeyDown="DefaultSpeakSpeedTextBox_OnPreviewKeyDown"
                                         LostKeyboardFocus="DefaultSpeakSpeedTextBox_OnLostKeyboardFocus"
                                         Text="{Binding DefaultSpeakSpeedText, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="默认语速" />
                            </Grid>
                        </Border>

                        <Border x:Name="PrefetchCountItemBorder"
                                Style="{StaticResource SettingsRowBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource SettingsRowTitleTextBlockStyle}"
                                               Text="播放预取数量" />
                                    <TextBlock Style="{StaticResource SettingsRowDescriptionTextBlockStyle}"
                                               Text="提前准备的朗读段落数量。" />
                                    <TextBlock Text="{Binding PrefetchCountErrorText}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock"
                                                   BasedOn="{StaticResource ErrorTextBlockStyle}">
                                                <Setter Property="Margin" Value="0,4,0,0" />
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PrefetchCountErrorText}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <TextBox x:Name="PrefetchCountTextBox"
                                         Grid.Column="1"
                                         Margin="{StaticResource SettingsRowControlMargin}"
                                         Width="{StaticResource SettingsRowControlWidth}"
                                         VerticalAlignment="Center"
                                         PreviewKeyDown="PrefetchCountTextBox_OnPreviewKeyDown"
                                         LostKeyboardFocus="PrefetchCountTextBox_OnLostKeyboardFocus"
                                         Text="{Binding PrefetchCountText, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="播放预取数量" />
                            </Grid>
                        </Border>

                        <Button x:Name="OpenTtsRulesButton"
                                Style="{StaticResource SettingsNavigationRowButtonStyle}"
                                Command="{Binding OpenTtsRulesCommand}"
                                Content="TTS 规则"
                                Tag="{x:Static theming:SettingsNavigationIcon.TtsRules}"
                                ToolTip="TTS 规则"
                                AutomationProperties.Name="TTS 规则" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
