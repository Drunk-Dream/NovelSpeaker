<Page x:Class="NovelSpeaker.App.Features.PlaybackSettings.PlaybackSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:commonControls="clr-namespace:NovelSpeaker.App.Shared.Presentation.Controls.Common"
      xmlns:settingsControls="clr-namespace:NovelSpeaker.App.Shared.Presentation.Controls.Settings"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Background="Transparent">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <commonControls:AppPageHeader x:Name="PageHeader"
                                      Title="播放设置"
                                      BackCommand="{Binding BackCommand}" />

        <ScrollViewer Grid.Row="1"
                      Margin="0,20,0,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <settingsControls:AppSettingsList x:Name="SettingsList"
                                              AutomationProperties.Name="播放设置">
                <settingsControls:AppSettingsRow x:Name="DefaultSpeakSpeedRow"
                                                 Title="默认语速"
                                                 Description="用于后续朗读；当前播放按既有刷新规则应用。"
                                                 AutomationProperties.Name="默认语速">
                    <StackPanel Width="180">
                        <TextBox x:Name="DefaultSpeakSpeedTextBox"
                                 Style="{StaticResource App.Input.TextBox.Standard}"
                                 PreviewKeyDown="DefaultSpeakSpeedTextBox_OnPreviewKeyDown"
                                 LostKeyboardFocus="DefaultSpeakSpeedTextBox_OnLostKeyboardFocus"
                                 Text="{Binding DefaultSpeakSpeedText, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="默认语速" />
                        <TextBlock Margin="0,4,0,0"
                                   Text="{Binding DefaultSpeakSpeedErrorText}"
                                   TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock"
                                       BasedOn="{StaticResource App.Feedback.ValidationText}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DefaultSpeakSpeedErrorText}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </settingsControls:AppSettingsRow>

                <settingsControls:AppSettingsRow x:Name="PrefetchCountRow"
                                                 Title="播放预取数量"
                                                 Description="提前准备的朗读段落数量。"
                                                 AutomationProperties.Name="播放预取数量">
                    <StackPanel Width="180">
                        <TextBox x:Name="PrefetchCountTextBox"
                                 Style="{StaticResource App.Input.TextBox.Standard}"
                                 PreviewKeyDown="PrefetchCountTextBox_OnPreviewKeyDown"
                                 LostKeyboardFocus="PrefetchCountTextBox_OnLostKeyboardFocus"
                                 Text="{Binding PrefetchCountText, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="播放预取数量" />
                        <TextBlock Margin="0,4,0,0"
                                   Text="{Binding PrefetchCountErrorText}"
                                   TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock"
                                       BasedOn="{StaticResource App.Feedback.ValidationText}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PrefetchCountErrorText}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </settingsControls:AppSettingsRow>

                <settingsControls:AppSettingsRow x:Name="ReadChapterTitleRow"
                                                 Title="朗读章节标题"
                                                 Description="播放每章正文前先朗读章节标题。"
                                                 AutomationProperties.Name="朗读标题">
                    <ui:ToggleSwitch x:Name="ReadChapterTitleToggleSwitch"
                                     Style="{StaticResource App.Input.ToggleSwitch.Standard}"
                                     IsChecked="{Binding ReadChapterTitle, Mode=TwoWay}"
                                     AutomationProperties.Name="朗读标题" />
                </settingsControls:AppSettingsRow>
            </settingsControls:AppSettingsList>
        </ScrollViewer>
    </Grid>
</Page>
