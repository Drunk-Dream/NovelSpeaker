<Page x:Class="NovelSpeaker.App.Features.TtsRules.TtsRulesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:commonControls="clr-namespace:NovelSpeaker.App.Shared.Presentation.Controls.Common"
      xmlns:feedbackControls="clr-namespace:NovelSpeaker.App.Shared.Presentation.Controls.Feedback"
      xmlns:formControls="clr-namespace:NovelSpeaker.App.Shared.Presentation.Controls.Forms"
      xmlns:navigation="clr-namespace:NovelSpeaker.App.Shell.Navigation"
      xmlns:rules="clr-namespace:NovelSpeaker.App.Shared.Presentation.Rules"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      MinHeight="0"
      Background="Transparent"
      ClipToBounds="True"
      navigation:NavigationViewportHeightBehavior.IsEnabled="True">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Page.Resources>

    <Grid Margin="24"
          MinHeight="0"
          ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <commonControls:AppPageHeader x:Name="PageHeader"
                                      Title="TTS 规则"
                                      Description="管理 HTTP TTS 服务规则；当前播放规则在播放页选择。"
                                      BackCommand="{Binding BackCommand}">
            <commonControls:AppPageHeader.Actions>
                <WrapPanel x:Name="PageActions"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           ItemHeight="40">
                    <Button Margin="0,0,8,0"
                            Style="{StaticResource App.Button.Icon}"
                            Command="{Binding NewRuleCommand}"
                            ToolTip="新建规则"
                            AutomationProperties.Name="新建规则">
                        <ui:SymbolIcon Symbol="DocumentAdd24" />
                    </Button>
                    <Button Margin="0,0,8,0"
                            Style="{StaticResource App.Button.Icon}"
                            Click="ImportRuleFileButton_OnClick"
                            ToolTip="从文件导入"
                            AutomationProperties.Name="从文件导入">
                        <ui:SymbolIcon Symbol="ArrowImport24" />
                    </Button>
                    <Button Margin="0,0,8,0"
                            Style="{StaticResource App.Button.Icon}"
                            Click="ImportRulesFromClipboardButton_OnClick"
                            ToolTip="从剪切板导入"
                            AutomationProperties.Name="从剪切板导入">
                        <ui:SymbolIcon Symbol="ClipboardPaste24" />
                    </Button>
                    <Button Style="{StaticResource App.Button.Icon}"
                            Command="{Binding OpenHelpCommand}"
                            ToolTip="规则编写帮助"
                            AutomationProperties.Name="规则编写帮助">
                        <ui:SymbolIcon Symbol="QuestionCircle24" />
                    </Button>
                </WrapPanel>
            </commonControls:AppPageHeader.Actions>
        </commonControls:AppPageHeader>

        <Grid Grid.Row="1"
              Margin="0,20,0,0"
              MinHeight="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="280" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="3*" MinWidth="420" />
            </Grid.ColumnDefinitions>

            <commonControls:AppSectionSurface x:Name="RulesSurface"
                                              Grid.Column="0"
                                              Header="规则列表"
                                              Description="{Binding Rules.Count, StringFormat=共 {0} 条规则}">
                <Grid MinHeight="0">
                    <Border VerticalAlignment="Top">
                        <Border.Style>
                            <Style TargetType="Border"
                                   BasedOn="{StaticResource App.Feedback.InlineMessage}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Rules.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Style="{StaticResource App.Typography.Secondary}"
                                   Text="还没有规则，请使用页首操作新建或导入。"
                                   TextWrapping="Wrap" />
                    </Border>

                    <ListBox x:Name="RulesList"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemsSource="{Binding Rules}"
                             ScrollViewer.CanContentScroll="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <rules:RuleListItemView Title="{Binding Name}"
                                                        Summary="{Binding RequestSummary}"
                                                        IsRuleEnabled="{Binding IsEnabled}"
                                                        IsSelected="{Binding IsSelected}"
                                                        SelectCommand="{Binding DataContext.SelectRuleCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                        ToggleEnabledCommand="{Binding DataContext.ToggleRuleEnabledCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                        ExportCommand="{Binding DataContext.ExportRuleCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                        CopyCommand="{Binding DataContext.CopyRuleCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                        DeleteCommand="{Binding DataContext.DeleteRuleCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                        CommandParameter="{Binding}"
                                                        AutomationProperties.Name="{Binding AutomationName}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </commonControls:AppSectionSurface>

            <commonControls:AppSectionSurface x:Name="EditorSurface"
                                              Grid.Column="2"
                                              Header="规则编辑"
                                              Description="修改请求字段后可直接试听编辑副本，再保存更改。">
                <Grid MinHeight="0">
                    <feedbackControls:AppStatusView HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Center"
                                                    Status="Empty"
                                                    Icon="DocumentEdit24"
                                                    Title="选择一条规则"
                                                    Description="从左侧单击规则打开编辑器，或使用页首操作新建规则。">
                        <feedbackControls:AppStatusView.Style>
                            <Style TargetType="feedbackControls:AppStatusView"
                                   BasedOn="{StaticResource {x:Type feedbackControls:AppStatusView}}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasEditor}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </feedbackControls:AppStatusView.Style>
                    </feedbackControls:AppStatusView>

                    <ScrollViewer x:Name="RuleEditorScrollViewer"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasEditor}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>

                        <StackPanel>
                            <formControls:AppFormField Label="名称" Required="True">
                                <TextBox Style="{StaticResource App.Input.TextBox.Standard}"
                                         Text="{Binding DraftName, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="规则名称" />
                            </formControls:AppFormField>

                            <formControls:AppFormField Margin="0,16,0,0"
                                                       Label="请求 URL / 模板"
                                                       Required="True">
                                <TextBox MinHeight="74"
                                         Style="{StaticResource App.Input.TextBox.Standard}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         Text="{Binding DraftUrl, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="请求 URL 或模板" />
                            </formControls:AppFormField>

                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" MinWidth="128" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="3*" MinWidth="160" />
                                </Grid.ColumnDefinitions>
                                <formControls:AppFormField Grid.Column="0" Label="请求方法">
                                    <ComboBox Style="{StaticResource App.Input.ComboBox.Standard}"
                                              SelectedValue="{Binding DraftRequestMethod}"
                                              SelectedValuePath="Content"
                                              AutomationProperties.Name="请求方法">
                                        <ComboBoxItem Content="GET" />
                                        <ComboBoxItem Content="POST" />
                                    </ComboBox>
                                </formControls:AppFormField>
                                <formControls:AppFormField Grid.Column="2" Label="Content-Type">
                                    <TextBox Style="{StaticResource App.Input.TextBox.Standard}"
                                             Text="{Binding DraftContentType, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Content-Type" />
                                </formControls:AppFormField>
                            </Grid>

                            <formControls:AppFormField Margin="0,16,0,0"
                                                       Label="Header"
                                                       Description="按需添加请求头；导出、截图和日志中请勿泄露凭据。">
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding HeaderEntries}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="2*" MinWidth="112" />
                                                        <ColumnDefinition Width="8" />
                                                        <ColumnDefinition Width="3*" MinWidth="144" />
                                                        <ColumnDefinition Width="8" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Grid.Column="0"
                                                             Style="{StaticResource App.Input.TextBox.Standard}"
                                                             Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}"
                                                             AutomationProperties.Name="Header 名称" />
                                                    <TextBox Grid.Column="2"
                                                             Style="{StaticResource App.Input.TextBox.Standard}"
                                                             Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                             AutomationProperties.Name="Header 值" />
                                                    <Button Grid.Column="4"
                                                            Style="{StaticResource App.Button.Icon}"
                                                            Command="{Binding DataContext.RemoveHeaderEntryCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="删除 Header"
                                                            AutomationProperties.Name="删除 Header">
                                                        <ui:SymbolIcon Symbol="Delete24" />
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button HorizontalAlignment="Left"
                                            Style="{StaticResource App.Button.Subtle}"
                                            Command="{Binding AddHeaderEntryCommand}"
                                            Content="添加 Header" />
                                </StackPanel>
                            </formControls:AppFormField>

                            <formControls:AppFormField Margin="0,16,0,0"
                                                       Label="并发限制"
                                                       Description="格式为次数/毫秒，例如 2/1000。">
                                <TextBox Style="{StaticResource App.Input.TextBox.Standard}"
                                         Text="{Binding DraftConcurrentRate, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="格式：次数/毫秒，例如 2/1000"
                                         AutomationProperties.Name="并发限制" />
                            </formControls:AppFormField>

                            <formControls:AppFormField Margin="0,16,0,0"
                                                       Label="请求体"
                                                       Description="仅 POST 请求使用。"
                                                       Visibility="{Binding IsPostMethod, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBox MinHeight="90"
                                         Style="{StaticResource App.Input.TextBox.Standard}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         Text="{Binding DraftRequestBody, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="请求体" />
                            </formControls:AppFormField>

                            <WrapPanel Margin="0,20,0,0"
                                       HorizontalAlignment="Right">
                                <Button Margin="0,0,8,0"
                                        Style="{StaticResource App.Button.Secondary}"
                                        Command="{Binding TestDraftCommand}"
                                        Content="试听"
                                        IsEnabled="{Binding CanTestDraft}" />
                                <Button Margin="0,0,8,0"
                                        Style="{StaticResource App.Button.Subtle}"
                                        Command="{Binding CancelEditingCommand}"
                                        Content="取消"
                                        IsEnabled="{Binding CanCancelEditing}" />
                                <Button Style="{StaticResource App.Button.Primary}"
                                        Command="{Binding SaveDraftCommand}"
                                        Content="保存"
                                        IsEnabled="{Binding CanSaveDraft}" />
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </commonControls:AppSectionSurface>

            <Grid Grid.ColumnSpan="3"
                  Panel.ZIndex="10"
                  Visibility="{Binding IsHelpDrawerOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="380" />
                </Grid.ColumnDefinitions>
                <Button x:Name="HelpDrawerDismissOverlay"
                        Grid.Column="0"
                        Opacity="0.45"
                        Background="{DynamicResource App.Brush.Canvas}"
                        BorderThickness="0"
                        Command="{Binding CloseHelpCommand}"
                        ToolTip="关闭规则帮助"
                        AutomationProperties.Name="关闭规则帮助" />
                <Border x:Name="HelpDrawerBorder"
                        Grid.Column="1"
                        Padding="20"
                        Style="{StaticResource App.Feedback.PopupSurface}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource App.Typography.SectionTitle}"
                                       Text="规则编写帮助" />
                            <Button Grid.Column="1"
                                    Style="{StaticResource App.Button.Icon}"
                                    Command="{Binding CloseHelpCommand}"
                                    ToolTip="关闭帮助"
                                    AutomationProperties.Name="关闭帮助">
                                <ui:SymbolIcon Symbol="Dismiss24" />
                            </Button>
                        </Grid>
                        <ScrollViewer Grid.Row="1"
                                      Margin="0,16,0,0"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock Style="{StaticResource App.Typography.ItemTitle}" Text="从零开始" />
                                <TextBlock Margin="0,8,0,0"
                                           Style="{StaticResource App.Typography.Secondary}"
                                           Text="新建规则后填写服务商提供的完整 HTTP/HTTPS 地址，选择 GET 或 POST 并设置必要参数。试听使用当前编辑副本，不要求先保存。"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,18,0,0"
                                           Style="{StaticResource App.Typography.ItemTitle}"
                                           Text="GET 示例" />
                                <TextBlock Margin="0,8,0,0"
                                           FontFamily="Consolas"
                                           Style="{StaticResource App.Typography.Secondary}"
                                           TextWrapping="Wrap">https://example.com/tts?text={{encodeURIComponent(speakText)}}&amp;speed={{speakSpeed}}</TextBlock>
                                <TextBlock Margin="0,18,0,0"
                                           Style="{StaticResource App.Typography.ItemTitle}"
                                           Text="POST JSON 示例" />
                                <TextBlock Margin="0,8,0,0"
                                           Style="{StaticResource App.Typography.Secondary}"
                                           Text="请求方法选择 POST，Header 添加 Content-Type: application/json，请求体可使用下面的模板。"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,8,0,0"
                                           FontFamily="Consolas"
                                           Style="{StaticResource App.Typography.Secondary}"
                                           TextWrapping="Wrap">{{&quot;text&quot;:{{JSON.stringify(speakText)}},&quot;speed&quot;:{{speakSpeed}}}}</TextBlock>
                                <TextBlock Margin="0,18,0,0"
                                           Style="{StaticResource App.Typography.ItemTitle}"
                                           Text="字段怎么填" />
                                <TextBlock Margin="0,8,0,0"
                                           Style="{StaticResource App.Typography.Secondary}"
                                           Text="名称和 URL 必填，URL 必须是绝对地址。Content-Type 声明期望返回的音频类型；请求体只用于 POST。"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,18,0,0"
                                           Style="{StaticResource App.Typography.ItemTitle}"
                                           Text="Header、请求体与限流" />
                                <TextBlock Margin="0,8,0,0"
                                           Style="{StaticResource App.Typography.Secondary}"
                                           Text="Header 可填写鉴权信息，但不要将密钥放入日志或反馈。并发限制支持 1000 或 2/1000 这类格式。"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,18,0,0"
                                           Style="{StaticResource App.Typography.ItemTitle}"
                                           Text="失败时按这个顺序检查" />
                                <TextBlock Margin="0,8,0,0"
                                           Style="{StaticResource App.Typography.Secondary}"
                                           Text="先确认 URL 和请求方法，再检查模板括号、Header 名称、GET 请求体及并发限制；鉴权失败时只核对本地配置，不要复制凭据到诊断信息。"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
