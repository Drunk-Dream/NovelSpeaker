<Page x:Class="NovelSpeaker.App.Features.GeneralSettings.GeneralSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:commonControls="clr-namespace:NovelSpeaker.App.Shared.Presentation.Controls.Common"
      xmlns:settingsControls="clr-namespace:NovelSpeaker.App.Shared.Presentation.Controls.Settings"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Background="Transparent">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <commonControls:AppPageHeader x:Name="PageHeader"
                                      Title="常规"
                                      BackCommand="{Binding BackCommand}" />

        <ScrollViewer Grid.Row="1"
                      Margin="0,20,0,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <settingsControls:AppSettingsList x:Name="SettingsList"
                                              AutomationProperties.Name="常规设置">
                <settingsControls:AppSettingsRow x:Name="CloseBehaviorRow"
                                                 Title="关闭行为"
                                                 Description="选择隐藏到托盘、退出应用或每次询问。"
                                                 AutomationProperties.Name="关闭主窗口时">
                    <ComboBox x:Name="CloseBehaviorComboBox"
                              MinWidth="180"
                              Style="{StaticResource App.Input.ComboBox.Standard}"
                              ItemsSource="{Binding CloseBehaviorOptions, Mode=OneWay}"
                              SelectedItem="{Binding SelectedCloseBehavior, Mode=TwoWay}"
                              DisplayMemberPath="DisplayName"
                              AutomationProperties.Name="关闭主窗口时" />
                </settingsControls:AppSettingsRow>

                <settingsControls:AppSettingsRow x:Name="StartMinimizedRow"
                                                 Title="启动后最小化到托盘"
                                                 Description="应用仍会完成初始化和后台任务启动。"
                                                 AutomationProperties.Name="启动后最小化到托盘">
                    <ui:ToggleSwitch x:Name="StartMinimizedToggleSwitch"
                                     Style="{StaticResource App.Input.ToggleSwitch.Standard}"
                                     IsChecked="{Binding StartMinimizedToTray, Mode=TwoWay}"
                                     AutomationProperties.Name="启动后最小化到托盘" />
                </settingsControls:AppSettingsRow>
            </settingsControls:AppSettingsList>
        </ScrollViewer>
    </Grid>
</Page>
