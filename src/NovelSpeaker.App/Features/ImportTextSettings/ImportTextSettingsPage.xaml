<Page x:Class="NovelSpeaker.App.Features.ImportTextSettings.ImportTextSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:theming="clr-namespace:NovelSpeaker.App.Shared.Theming"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Button Style="{StaticResource BackIconButtonStyle}"
                Command="{Binding BackCommand}"
                ToolTip="返回"
                AutomationProperties.Name="返回">
            <ui:SymbolIcon Symbol="ChevronLeft24" />
        </Button>

        <ScrollViewer Grid.Row="1"
                      Margin="0,20,0,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitleTextBlockStyle}"
                           Text="导入与文本" />

                <Border Margin="{StaticResource SectionSpacing}"
                        Style="{StaticResource SettingsRowsGroupBorderStyle}">
                    <StackPanel>
                        <Border x:Name="BookFileNameTemplateItemBorder"
                                Style="{StaticResource SettingsRowBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource SettingsRowTitleTextBlockStyle}"
                                               Text="文件名模板" />
                                    <TextBlock Style="{StaticResource SettingsRowDescriptionTextBlockStyle}"
                                               Text="示例：{{name}} 作者：{{author}}；留空则不从文件名解析。" />
                                </StackPanel>
                                <TextBox x:Name="BookFileNameTemplateTextBox"
                                         Grid.Column="1"
                                         Margin="{StaticResource SettingsRowControlMargin}"
                                         Width="{StaticResource SettingsRowControlWidth}"
                                         VerticalAlignment="Center"
                                         PreviewKeyDown="BookFileNameTemplateTextBox_OnPreviewKeyDown"
                                         LostKeyboardFocus="BookFileNameTemplateTextBox_OnLostKeyboardFocus"
                                         Text="{Binding BookFileNameTemplateText, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="文件名模板" />
                            </Grid>
                        </Border>

                        <Border x:Name="EnableLongParagraphSplittingItemBorder"
                                Style="{StaticResource SettingsRowBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource SettingsRowTitleTextBlockStyle}"
                                               Text="拆分长段落" />
                                    <TextBlock Style="{StaticResource SettingsRowDescriptionTextBlockStyle}"
                                               Text="导入时将超过阈值的段落拆分为较短段落。" />
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="1"
                                                 Margin="{StaticResource SettingsRowControlMargin}"
                                                 VerticalAlignment="Center"
                                                 OffContent="关闭"
                                                 OnContent="开启"
                                                 IsChecked="{Binding EnableLongParagraphSplitting}"
                                                 AutomationProperties.Name="拆分长段落" />
                            </Grid>
                        </Border>

                        <Border x:Name="LongParagraphThresholdItemBorder"
                                Style="{StaticResource SettingsRowBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource SettingsRowTitleTextBlockStyle}"
                                               Text="长段落阈值" />
                                    <TextBlock Style="{StaticResource SettingsRowDescriptionTextBlockStyle}"
                                               Text="达到该字符数时执行拆分。" />
                                    <TextBlock Text="{Binding LongParagraphThresholdErrorText}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock"
                                                   BasedOn="{StaticResource ErrorTextBlockStyle}">
                                                <Setter Property="Margin" Value="0,4,0,0" />
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding LongParagraphThresholdErrorText}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <TextBox x:Name="LongParagraphThresholdTextBox"
                                         Grid.Column="1"
                                         Margin="{StaticResource SettingsRowControlMargin}"
                                         Width="{StaticResource SettingsRowControlWidth}"
                                         VerticalAlignment="Center"
                                         PreviewKeyDown="LongParagraphThresholdTextBox_OnPreviewKeyDown"
                                         LostKeyboardFocus="LongParagraphThresholdTextBox_OnLostKeyboardFocus"
                                         Text="{Binding LongParagraphThresholdText, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="长段落阈值" />
                            </Grid>
                        </Border>

                        <Button x:Name="OpenRegexReplacementRulesButton"
                                Style="{StaticResource SettingsNavigationRowButtonStyle}"
                                Command="{Binding OpenRegexReplacementRulesCommand}"
                                Content="正则替换"
                                Tag="{x:Static theming:SettingsNavigationIcon.RegexReplacement}"
                                ToolTip="正则替换"
                                AutomationProperties.Name="正则替换" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
