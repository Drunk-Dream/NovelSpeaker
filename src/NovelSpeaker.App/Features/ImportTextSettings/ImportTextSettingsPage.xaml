<Page x:Class="NovelSpeaker.App.Features.ImportTextSettings.ImportTextSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:commonControls="clr-namespace:NovelSpeaker.App.Shared.Presentation.Controls.Common"
      xmlns:settingsControls="clr-namespace:NovelSpeaker.App.Shared.Presentation.Controls.Settings"
      xmlns:theming="clr-namespace:NovelSpeaker.App.Shared.Theming"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Background="Transparent">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <commonControls:AppPageHeader x:Name="PageHeader"
                                      Title="导入与文本"
                                      BackCommand="{Binding BackCommand}" />

        <ScrollViewer Grid.Row="1"
                      Margin="0,20,0,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <settingsControls:AppSettingsList x:Name="SettingsList"
                                              AutomationProperties.Name="导入与文本设置">
                <settingsControls:AppSettingsRow x:Name="EnableLongParagraphSplittingRow"
                                                 Title="拆分长段落"
                                                 Description="导入时将超过阈值的段落拆分为较短段落。"
                                                 AutomationProperties.Name="拆分长段落">
                    <ui:ToggleSwitch x:Name="EnableLongParagraphSplittingToggleSwitch"
                                     Style="{StaticResource App.Input.ToggleSwitch.Standard}"
                                     IsChecked="{Binding EnableLongParagraphSplitting, Mode=TwoWay}"
                                     AutomationProperties.Name="拆分长段落" />
                </settingsControls:AppSettingsRow>

                <settingsControls:AppSettingsRow x:Name="LongParagraphThresholdRow"
                                                 Title="长段落阈值"
                                                 Description="达到该字符数时执行拆分。"
                                                 AutomationProperties.Name="长段落阈值">
                    <StackPanel Width="180">
                        <TextBox x:Name="LongParagraphThresholdTextBox"
                                 Style="{StaticResource App.Input.TextBox.Standard}"
                                 PreviewKeyDown="LongParagraphThresholdTextBox_OnPreviewKeyDown"
                                 LostKeyboardFocus="LongParagraphThresholdTextBox_OnLostKeyboardFocus"
                                 Text="{Binding LongParagraphThresholdText, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="长段落阈值" />
                        <TextBlock Margin="0,4,0,0"
                                   Text="{Binding LongParagraphThresholdErrorText}"
                                   TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock"
                                       BasedOn="{StaticResource App.Feedback.ValidationText}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LongParagraphThresholdErrorText}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </settingsControls:AppSettingsRow>

                <settingsControls:AppSettingsRow x:Name="BookFileNameTemplateRow"
                                                 Title="文件名提取模板"
                                                 Description="示例：{{name}} 作者：{{author}}；留空则不从文件名解析。"
                                                 AutomationProperties.Name="文件名模板">
                    <TextBox x:Name="BookFileNameTemplateTextBox"
                             Width="240"
                             Style="{StaticResource App.Input.TextBox.Standard}"
                             PreviewKeyDown="BookFileNameTemplateTextBox_OnPreviewKeyDown"
                             LostKeyboardFocus="BookFileNameTemplateTextBox_OnLostKeyboardFocus"
                             Text="{Binding BookFileNameTemplateText, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="文件名模板" />
                </settingsControls:AppSettingsRow>

                <settingsControls:AppSettingsNavigationRow
                    x:Name="OpenRegexReplacementRulesRow"
                    Icon="{x:Static theming:SettingsNavigationIcon.RegexReplacement}"
                    Title="正则替换"
                    Command="{Binding OpenRegexReplacementRulesCommand}"
                    ToolTip="正则替换" />
            </settingsControls:AppSettingsList>
        </ScrollViewer>
    </Grid>
</Page>
