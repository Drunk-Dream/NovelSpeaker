<Page x:Class="NovelSpeaker.App.Features.ImportTextSettings.ImportTextSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:commonControls="clr-namespace:NovelSpeaker.App.Shared.Presentation.Controls.Common"
      xmlns:settingsControls="clr-namespace:NovelSpeaker.App.Shared.Presentation.Controls.Settings"
      xmlns:theming="clr-namespace:NovelSpeaker.App.Shared.Theming"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Background="Transparent">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <commonControls:AppPageHeader x:Name="PageHeader"
                                      Title="导入"
                                      BackCommand="{Binding BackCommand}" />

        <ScrollViewer Grid.Row="1"
                      Margin="0,20,0,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <settingsControls:AppSettingsList x:Name="SettingsList"
                                              AutomationProperties.Name="导入设置">
                <TextBlock Text="文本处理" Style="{StaticResource App.Typography.ItemTitle}" Margin="12,8,0,8" />
                <settingsControls:AppSettingsRow x:Name="EnableLongParagraphSplittingRow"
                                                 Title="拆分长段落"
                                                 Description="导入时将超过阈值的段落拆分为较短段落。"
                                                 AutomationProperties.Name="拆分长段落">
                    <ui:ToggleSwitch x:Name="EnableLongParagraphSplittingToggleSwitch"
                                     Style="{StaticResource App.Input.ToggleSwitch.Standard}"
                                     IsChecked="{Binding EnableLongParagraphSplitting, Mode=TwoWay}"
                                     AutomationProperties.Name="拆分长段落" />
                </settingsControls:AppSettingsRow>

                <settingsControls:AppSettingsRow x:Name="LongParagraphThresholdRow"
                                                 Title="长段落阈值"
                                                 Description="达到该字符数时执行拆分。"
                                                 AutomationProperties.Name="长段落阈值">
                    <StackPanel Width="180">
                        <TextBox x:Name="LongParagraphThresholdTextBox"
                                 Style="{StaticResource App.Input.TextBox.Standard}"
                                 PreviewKeyDown="LongParagraphThresholdTextBox_OnPreviewKeyDown"
                                 LostKeyboardFocus="LongParagraphThresholdTextBox_OnLostKeyboardFocus"
                                 Text="{Binding LongParagraphThresholdText, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="长段落阈值" />
                        <TextBlock Margin="0,4,0,0"
                                   Text="{Binding LongParagraphThresholdErrorText}"
                                   TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock"
                                       BasedOn="{StaticResource App.Feedback.ValidationText}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LongParagraphThresholdErrorText}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </settingsControls:AppSettingsRow>

                <TextBlock Text="元数据识别" Style="{StaticResource App.Typography.ItemTitle}" Margin="12,16,0,8" />
                <settingsControls:AppSettingsNavigationRow
                    x:Name="OpenFileNameMetadataRulesRow"
                    Icon="{x:Static theming:SettingsNavigationIcon.ImportText}"
                    Title="文件名元数据规则"
                    Command="{Binding OpenFileNameMetadataRulesCommand}"
                    ToolTip="文件名元数据规则" />
                <settingsControls:AppSettingsNavigationRow
                    x:Name="OpenTextHeaderMetadataRulesRow"
                    Icon="{x:Static theming:SettingsNavigationIcon.ImportText}"
                    Title="正文头部元数据规则"
                    Command="{Binding OpenTextHeaderMetadataRulesCommand}"
                    ToolTip="正文头部元数据规则" />

                <TextBlock Text="章节识别" Style="{StaticResource App.Typography.ItemTitle}" Margin="12,16,0,8" />
                <settingsControls:AppSettingsRow x:Name="SplitChaptersOnBlankLinesRow"
                                                 Title="空行分章"
                                                 Description="在章节规则之外，按正文块之间的空行补充分章。"
                                                 AutomationProperties.Name="空行分章">
                    <ui:ToggleSwitch x:Name="SplitChaptersOnBlankLinesToggleSwitch"
                                     Style="{StaticResource App.Input.ToggleSwitch.Standard}"
                                     IsChecked="{Binding SplitChaptersOnBlankLines, Mode=TwoWay}"
                                     AutomationProperties.Name="空行分章" />
                </settingsControls:AppSettingsRow>

                <settingsControls:AppSettingsNavigationRow
                    x:Name="OpenChapterRulesRow"
                    Icon="{x:Static theming:SettingsNavigationIcon.ChapterRules}"
                    Title="章节规则"
                    Command="{Binding OpenChapterRulesCommand}"
                    ToolTip="章节规则" />
            </settingsControls:AppSettingsList>
        </ScrollViewer>
    </Grid>
</Page>
