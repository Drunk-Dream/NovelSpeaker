<ui:FluentWindow x:Class="NovelSpeaker.App.Shell.MainWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:behaviors="clr-namespace:NovelSpeaker.App.Shared.Presentation.Behaviors"
                  xmlns:shell="clr-namespace:NovelSpeaker.App.Shell"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  Title="NovelSpeaker"
                  Icon="pack://application:,,,/NovelSpeaker;component/Assets/Branding/app.ico"
                  Width="1280"
                  Height="820"
                  MinWidth="900"
                  MinHeight="640"
                  WindowCornerPreference="Round"
                  ExtendsContentIntoTitleBar="True"
                  Background="{DynamicResource App.Brush.Window.Background}">
    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="NovelSpeaker"
                     Icon="{ui:ImageIcon 'pack://application:,,,/NovelSpeaker;component/Assets/Branding/app.ico'}"
                     ShowMinimize="True"
                     ShowMaximize="True"
                     ShowClose="True" />

        <ui:NavigationView x:Name="RootNavigationView"
                           Grid.Row="1"
                           PaneTitle=""
                           OpenPaneLength="220"
                           CompactPaneLength="64"
                           IsBackButtonVisible="Collapsed"
                           IsPaneToggleVisible="True"
                           IsFooterSeparatorVisible="False"
                           PaneDisplayMode="Left"
                           Background="{DynamicResource App.Brush.Window.Background}">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem x:Name="LibraryNavigationItem"
                                       Style="{StaticResource App.Navigation.Entry}"
                                       Content="书库">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Book24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem x:Name="SettingsNavigationItem"
                                       Style="{StaticResource App.Navigation.Entry}"
                                       Content="设置">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Settings24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>

            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem x:Name="ActiveCacheNavigationItem"
                                       Style="{StaticResource App.Navigation.Entry}"
                                       Content="{Binding ActiveCache.CompactStatusText}"
                                       Click="ActiveCacheNavigationItem_OnClick"
                                       ToolTip="查看主动缓存进度"
                                       AutomationProperties.Name="{Binding ActiveCache.CompactStatusText}"
                                       Visibility="{Binding ActiveCache.IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="ArrowDownload24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem x:Name="ChapterExportNavigationItem"
                                       Style="{StaticResource App.Navigation.Entry}"
                                       Content="{Binding ChapterExport.CompactStatusText}"
                                       Click="ChapterExportNavigationItem_OnClick"
                                       ToolTip="查看章节导出进度"
                                       AutomationProperties.Name="{Binding ChapterExport.CompactStatusText}"
                                       Visibility="{Binding ChapterExport.IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="DocumentText24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem x:Name="PlaybackNavigationItem"
                                       Style="{StaticResource App.Navigation.Entry}"
                                       Click="PlaybackNavigationItem_OnClick"
                                       Visibility="{Binding IsNowPlayingVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon>
                            <ui:SymbolIcon.Style>
                                <Style TargetType="ui:SymbolIcon">
                                    <Setter Property="Symbol" Value="Headphones24" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NowPlayingVisualState}" Value="{x:Static shell:NowPlayingVisualState.Playing}">
                                            <Setter Property="Symbol" Value="PlayCircle24" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding NowPlayingVisualState}" Value="{x:Static shell:NowPlayingVisualState.Paused}">
                                            <Setter Property="Symbol" Value="PauseCircle24" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding NowPlayingVisualState}" Value="{x:Static shell:NowPlayingVisualState.Faulted}">
                                            <Setter Property="Symbol" Value="ErrorCircle24" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:SymbolIcon.Style>
                        </ui:SymbolIcon>
                    </ui:NavigationViewItem.Icon>
                    <StackPanel>
                        <TextBlock Style="{StaticResource App.Typography.ItemTitle}"
                                   Text="{Binding NowPlayingTitle}" />
                        <TextBlock FontSize="12"
                                   Style="{StaticResource App.Typography.Caption}"
                                   Text="{Binding NowPlayingStatus}" />
                    </StackPanel>
                </ui:NavigationViewItem>
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>

        <ui:Flyout x:Name="ActiveCacheFlyout"
                   Style="{StaticResource App.Feedback.FlyoutHost}"
                   Placement="Right"
                   behaviors:WpfUiFlyoutPlacement.PlacementTarget="{Binding ElementName=ActiveCacheNavigationItem}"
                   behaviors:WpfUiFlyoutPlacement.HorizontalOffset="8"
                   IsOpen="{Binding ActiveCache.IsFlyoutOpen, Mode=TwoWay}">
            <Border x:Name="ActiveCacheFlyoutSurface"
                    Width="360"
                    Style="{StaticResource App.Feedback.PopupSurface}">
                <StackPanel>
                    <TextBlock Style="{StaticResource App.Typography.SectionTitle}"
                               Text="{Binding ActiveCache.BatchStatusText}" />
                    <TextBlock Margin="0,4,0,0"
                               Style="{StaticResource App.Typography.Secondary}"
                               Text="{Binding ActiveCache.BookTitle}"
                               TextTrimming="CharacterEllipsis" />

                    <ListBox x:Name="ActiveCacheChapterList"
                             MaxHeight="300"
                             Margin="0,16,0,0"
                             ItemsSource="{Binding ActiveCache.Chapters}"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="IsHitTestVisible" Value="False" />
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,4" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10,8"
                                        CornerRadius="8">
                                    <Border.Style>
                                        <Style TargetType="Border"
                                               BasedOn="{StaticResource App.Selection.ListItem}">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource App.Brush.Surface.Secondary}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource App.Brush.Danger.Subtle}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource App.Selection.Content.Primary}"
                                                   Text="{Binding Title}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1"
                                                   Margin="12,0,0,0"
                                                   Style="{StaticResource App.Selection.Content.Secondary}"
                                                   Text="{Binding StatusText}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Margin="0,12,0,0"
                               Style="{StaticResource App.Typography.Secondary}"
                               Text="{Binding ActiveCache.TotalSegmentProgressText}" />
                    <Button x:Name="CancelActiveCacheButton"
                            Margin="0,16,0,0"
                            HorizontalAlignment="Right"
                            Padding="12,7"
                            Style="{StaticResource App.Button.Secondary}"
                            Command="{Binding ActiveCache.CancelCommand}"
                            Content="取消任务"
                            ToolTip="取消主动缓存任务"
                            AutomationProperties.Name="取消主动缓存任务" />
                </StackPanel>
            </Border>
        </ui:Flyout>

        <ui:Flyout x:Name="ChapterExportFlyout"
                   Style="{StaticResource App.Feedback.FlyoutHost}"
                   Placement="Right"
                   behaviors:WpfUiFlyoutPlacement.PlacementTarget="{Binding ElementName=ChapterExportNavigationItem}"
                   behaviors:WpfUiFlyoutPlacement.HorizontalOffset="8"
                   IsOpen="{Binding ChapterExport.IsFlyoutOpen, Mode=TwoWay}">
            <Border x:Name="ChapterExportFlyoutSurface"
                    Width="360"
                    Style="{StaticResource App.Feedback.PopupSurface}">
                <StackPanel>
                    <TextBlock Style="{StaticResource App.Typography.SectionTitle}"
                               Text="{Binding ChapterExport.BatchStatusText}" />
                    <TextBlock Margin="0,4,0,0"
                               Style="{StaticResource App.Typography.Secondary}"
                               Text="{Binding ChapterExport.BookTitle}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Margin="0,16,0,0"
                               Style="{StaticResource App.Typography.Body}"
                               Text="{Binding ChapterExport.CurrentChapterText}"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Margin="0,8,0,0"
                               Style="{StaticResource App.Typography.Secondary}"
                               Text="{Binding ChapterExport.ProgressText}" />

                    <Button x:Name="CancelChapterExportButton"
                            Margin="0,16,0,0"
                            HorizontalAlignment="Right"
                            Padding="12,7"
                            Style="{StaticResource App.Button.Secondary}"
                            Command="{Binding ChapterExport.CancelCommand}"
                            Content="取消任务"
                            ToolTip="取消章节导出任务"
                            AutomationProperties.Name="取消章节导出任务"
                            Visibility="{Binding ChapterExport.CanCancel, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <StackPanel Margin="0,16,0,0"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal"
                                Visibility="{Binding ChapterExport.CanDismiss, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Button x:Name="OpenChapterExportDirectoryButton"
                                Margin="0,0,8,0"
                                Padding="12,7"
                                Style="{StaticResource App.Button.Secondary}"
                                Command="{Binding ChapterExport.OpenDirectoryCommand}"
                                Content="打开目录"
                                ToolTip="打开导出目录"
                                AutomationProperties.Name="打开章节导出目录" />
                        <Button x:Name="DismissChapterExportButton"
                                Padding="12,7"
                                Style="{StaticResource App.Button.Subtle}"
                                Command="{Binding ChapterExport.DismissCommand}"
                                Content="关闭"
                                ToolTip="关闭导出完成状态"
                                AutomationProperties.Name="关闭章节导出状态" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </ui:Flyout>

        <ui:ContentDialogHost x:Name="RootContentDialogHost"
                              Grid.RowSpan="2"
                              Panel.ZIndex="20" />
        <ui:SnackbarPresenter x:Name="RootSnackbarPresenter"
                              Grid.RowSpan="2"
                              Margin="16,48,16,16"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Top"
                              Panel.ZIndex="10">
            <ui:SnackbarPresenter.Resources>
                <Style TargetType="{x:Type ui:Snackbar}"
                       BasedOn="{StaticResource App.Feedback.Snackbar}" />
            </ui:SnackbarPresenter.Resources>
        </ui:SnackbarPresenter>
    </Grid>
</ui:FluentWindow>
