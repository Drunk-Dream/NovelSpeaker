<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        High Contrast is a system projection, not a third brand theme. Every
        interaction state therefore uses a system color resource instead of
        opacity or a fixed accent so selection, focus and disabled content stay
        distinguishable when Windows changes the active contrast scheme.
    -->
    <SolidColorBrush x:Key="App.Brush.Window.Background"
                     Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <SolidColorBrush x:Key="App.Brush.Canvas"
                     Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <SolidColorBrush x:Key="App.Brush.Surface.Primary"
                     Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <SolidColorBrush x:Key="App.Brush.Surface.Secondary"
                     Color="{DynamicResource {x:Static SystemColors.ControlColorKey}}" />
    <SolidColorBrush x:Key="App.Brush.Surface.Raised"
                     Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />

    <SolidColorBrush x:Key="App.Brush.Text.Primary"
                     Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <SolidColorBrush x:Key="App.Brush.Text.Secondary"
                     Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <SolidColorBrush x:Key="App.Brush.Text.Tertiary"
                     Color="{DynamicResource {x:Static SystemColors.GrayTextColorKey}}" />
    <SolidColorBrush x:Key="App.Brush.Border.Subtle"
                     Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <SolidColorBrush x:Key="App.Brush.Border.Strong"
                     Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />

    <SolidColorBrush x:Key="App.Brush.Interaction.Surface.Hover"
                     Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}" />
    <SolidColorBrush x:Key="App.Brush.Interaction.Surface.Pressed"
                     Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}" />
    <SolidColorBrush x:Key="App.Brush.Interaction.Border.Hover"
                     Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}" />
    <SolidColorBrush x:Key="App.Brush.Interaction.Border.Pressed"
                     Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}" />
    <SolidColorBrush x:Key="App.Brush.Interaction.Foreground.Hover"
                     Color="{DynamicResource {x:Static SystemColors.HighlightTextColorKey}}" />
    <SolidColorBrush x:Key="App.Brush.Interaction.Foreground.Pressed"
                     Color="{DynamicResource {x:Static SystemColors.HighlightTextColorKey}}" />
    <SolidColorBrush x:Key="App.Brush.Interaction.Foreground.Selected"
                     Color="{DynamicResource {x:Static SystemColors.HighlightTextColorKey}}" />
    <SolidColorBrush x:Key="App.Brush.Interaction.Foreground.Disabled"
                     Color="{DynamicResource {x:Static SystemColors.GrayTextColorKey}}" />

    <SolidColorBrush x:Key="App.Brush.Accent"
                     Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}" />
    <SolidColorBrush x:Key="App.Brush.Accent.Default"
                     Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}" />
    <SolidColorBrush x:Key="App.Brush.Accent.Hover"
                     Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}" />
    <SolidColorBrush x:Key="App.Brush.Accent.Pressed"
                     Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}" />
    <SolidColorBrush x:Key="App.Brush.Accent.Subtle"
                     Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}" />
    <SolidColorBrush x:Key="App.Brush.Accent.Subtle.Hover"
                     Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}" />
    <SolidColorBrush x:Key="App.Brush.Accent.Text"
                     Color="{DynamicResource {x:Static SystemColors.HighlightTextColorKey}}" />
    <SolidColorBrush x:Key="App.Brush.Focus"
                     Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}" />

    <SolidColorBrush x:Key="App.Brush.Danger"
                     Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}" />
    <SolidColorBrush x:Key="App.Brush.Danger.Subtle"
                     Color="{DynamicResource {x:Static SystemColors.ControlColorKey}}" />
    <SolidColorBrush x:Key="App.Brush.Danger.Text"
                     Color="{DynamicResource {x:Static SystemColors.HighlightTextColorKey}}" />
    <SolidColorBrush x:Key="App.Brush.Danger.Pressed"
                     Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}" />
    <SolidColorBrush x:Key="App.Brush.Danger.Pressed.Text"
                     Color="{DynamicResource {x:Static SystemColors.HighlightTextColorKey}}" />
    <SolidColorBrush x:Key="App.Brush.Warning"
                     Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}" />
    <SolidColorBrush x:Key="App.Brush.Warning.Subtle"
                     Color="{DynamicResource {x:Static SystemColors.ControlColorKey}}" />
    <SolidColorBrush x:Key="App.Brush.Warning.Text"
                     Color="{DynamicResource {x:Static SystemColors.HighlightTextColorKey}}" />
    <SolidColorBrush x:Key="App.Brush.Success"
                     Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}" />
    <SolidColorBrush x:Key="App.Brush.Success.Subtle"
                     Color="{DynamicResource {x:Static SystemColors.ControlColorKey}}" />
    <SolidColorBrush x:Key="App.Brush.Success.Text"
                     Color="{DynamicResource {x:Static SystemColors.HighlightTextColorKey}}" />

    <SolidColorBrush x:Key="NavigationViewContentBackground"
                     Color="{Binding Color, Source={StaticResource App.Brush.Canvas}}" />
    <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush"
                     Color="{Binding Color, Source={StaticResource App.Brush.Border.Subtle}}" />
</ResourceDictionary>
