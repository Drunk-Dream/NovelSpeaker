<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Canonical semantic palette. Formal styles and new components reference only
         these App.Brush.* keys; the palette is the single theme-switching surface. -->
    <SolidColorBrush x:Key="App.Brush.Window.Background" Color="#F4F5F9" />
    <SolidColorBrush x:Key="App.Brush.Canvas" Color="#F8F9FC" />
    <SolidColorBrush x:Key="App.Brush.Surface.Primary" Color="#FFFFFF" />
    <SolidColorBrush x:Key="App.Brush.Surface.Secondary" Color="#F1F3F8" />
    <SolidColorBrush x:Key="App.Brush.Surface.Raised" Color="#FFFFFF" />

    <SolidColorBrush x:Key="App.Brush.Text.Primary" Color="#20242C" />
    <SolidColorBrush x:Key="App.Brush.Text.Secondary" Color="#626A77" />
    <SolidColorBrush x:Key="App.Brush.Text.Tertiary" Color="#8A919D" />
    <SolidColorBrush x:Key="App.Brush.Border.Subtle" Color="#D9DDE6" />
    <SolidColorBrush x:Key="App.Brush.Border.Strong" Color="#B9C0CC" />

    <SolidColorBrush x:Key="App.Brush.Interaction.Surface.Hover" Color="#EEF0F6" />
    <SolidColorBrush x:Key="App.Brush.Interaction.Surface.Pressed" Color="#E4E7F1" />
    <SolidColorBrush x:Key="App.Brush.Interaction.Border.Hover" Color="#9EA7B5" />
    <SolidColorBrush x:Key="App.Brush.Interaction.Border.Pressed" Color="#7D8798" />
    <SolidColorBrush x:Key="App.Brush.Interaction.Foreground.Hover" Color="#3F4FAF" />
    <SolidColorBrush x:Key="App.Brush.Interaction.Foreground.Pressed" Color="#334298" />
    <SolidColorBrush x:Key="App.Brush.Interaction.Foreground.Selected" Color="#20242C" />
    <SolidColorBrush x:Key="App.Brush.Interaction.Foreground.Disabled" Color="#8A919D" />

    <SolidColorBrush x:Key="App.Brush.Accent" Color="#5B6FD8" />
    <SolidColorBrush x:Key="App.Brush.Accent.Default" Color="#5B6FD8" />
    <SolidColorBrush x:Key="App.Brush.Accent.Hover" Color="#4B5FC8" />
    <SolidColorBrush x:Key="App.Brush.Accent.Pressed" Color="#4052AF" />
    <SolidColorBrush x:Key="App.Brush.Accent.Subtle" Color="#E8EBFA" />
    <SolidColorBrush x:Key="App.Brush.Accent.Subtle.Hover" Color="#DDE2F8" />
    <SolidColorBrush x:Key="App.Brush.Accent.Text" Color="#FFFFFF" />
    <SolidColorBrush x:Key="App.Brush.Focus" Color="#5B6FD8" />

    <SolidColorBrush x:Key="App.Brush.Danger" Color="#C83C4A" />
    <SolidColorBrush x:Key="App.Brush.Danger.Subtle" Color="#FBE6E9" />
    <SolidColorBrush x:Key="App.Brush.Danger.Text" Color="#FFFFFF" />
    <SolidColorBrush x:Key="App.Brush.Danger.Pressed" Color="#A82F3D" />
    <SolidColorBrush x:Key="App.Brush.Danger.Pressed.Text" Color="#FFFFFF" />
    <SolidColorBrush x:Key="App.Brush.Warning" Color="#A06000" />
    <SolidColorBrush x:Key="App.Brush.Warning.Subtle" Color="#FFF2D6" />
    <SolidColorBrush x:Key="App.Brush.Warning.Text" Color="#FFFFFF" />
    <SolidColorBrush x:Key="App.Brush.Success" Color="#2E7D5B" />
    <SolidColorBrush x:Key="App.Brush.Success.Subtle" Color="#E2F3EC" />
    <SolidColorBrush x:Key="App.Brush.Success.Text" Color="#FFFFFF" />

    <!-- Provider projection keys are required by Wpf.Ui's NavigationView
         template, but deliberately reuse the canonical semantic brushes. -->
    <SolidColorBrush x:Key="NavigationViewContentBackground"
                     Color="{Binding Color, Source={StaticResource App.Brush.Canvas}}" />
    <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush"
                     Color="{Binding Color, Source={StaticResource App.Brush.Border.Subtle}}" />

</ResourceDictionary>
