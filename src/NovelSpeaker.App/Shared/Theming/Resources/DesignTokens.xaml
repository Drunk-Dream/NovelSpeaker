                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <Thickness x:Key="PagePadding">24</Thickness>
    <Thickness x:Key="SectionSpacing">0,20,0,0</Thickness>
    <Thickness x:Key="ItemSpacing">0,12,0,0</Thickness>
    <Thickness x:Key="CardPadding">16</Thickness>
    <Thickness x:Key="CardPaddingLarge">24</Thickness>
    <Thickness x:Key="DialogPadding">24</Thickness>
    <CornerRadius x:Key="CardCornerRadius">12</CornerRadius>
