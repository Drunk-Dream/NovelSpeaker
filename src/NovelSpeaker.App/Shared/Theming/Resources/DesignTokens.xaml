<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- The base spacing scale is intentionally finite so page-local layout does not grow
         another collection of nearly identical magic numbers. -->
    <sys:Double x:Key="Spacing4">4</sys:Double>
    <sys:Double x:Key="Spacing8">8</sys:Double>
    <sys:Double x:Key="Spacing12">12</sys:Double>
    <sys:Double x:Key="Spacing16">16</sys:Double>
    <sys:Double x:Key="Spacing20">20</sys:Double>
    <sys:Double x:Key="Spacing24">24</sys:Double>
    <sys:Double x:Key="Spacing32">32</sys:Double>
    <sys:Double x:Key="Spacing40">40</sys:Double>
    <sys:Double x:Key="Spacing48">48</sys:Double>

    <Thickness x:Key="PagePadding">24</Thickness>
    <Thickness x:Key="PageSectionSpacing">0,24,0,0</Thickness>
    <Thickness x:Key="SectionSpacing">0,24,0,0</Thickness>
    <Thickness x:Key="ContentSpacing">0,16,0,0</Thickness>
    <Thickness x:Key="FieldSpacing">0,12,0,0</Thickness>
    <Thickness x:Key="ControlSpacing">0,8,0,0</Thickness>
    <Thickness x:Key="SectionHeadingSpacing">0,24,0,0</Thickness>
    <Thickness x:Key="FieldControlSpacing">0,8,0,0</Thickness>
    <Thickness x:Key="FieldDescriptionSpacing">0,8,0,0</Thickness>
    <Thickness x:Key="TinySpacing">0,4,0,0</Thickness>
    <Thickness x:Key="ButtonGapMargin">0,0,12,0</Thickness>
    <Thickness x:Key="InlineGapMargin">8,0,0,0</Thickness>
    <Thickness x:Key="ToolbarActionMargin">0,0,8,8</Thickness>
    <Thickness x:Key="ToolbarItemMargin">8,0,0,0</Thickness>
    <Thickness x:Key="ToolbarItemTrailingMargin">0,0,8,0</Thickness>
    <Thickness x:Key="ListHeaderMargin">16,16,16,12</Thickness>
    <Thickness x:Key="EmptyListMessageMargin">16,0,16,16</Thickness>
    <Thickness x:Key="ListViewportMargin">12,0,12,12</Thickness>
    <Thickness x:Key="ListItemHeaderMargin">12,12,12,0</Thickness>
    <Thickness x:Key="ListItemContentMargin">12,12,12,12</Thickness>
    <Thickness x:Key="ListItemSpacing">0,0,0,8</Thickness>
    <Thickness x:Key="CardPadding">16</Thickness>
    <Thickness x:Key="CardPaddingLarge">24</Thickness>
    <Thickness x:Key="CardContentPadding">20</Thickness>
    <Thickness x:Key="DialogPadding">24</Thickness>
    <Thickness x:Key="SettingsGroupPadding">16</Thickness>
    <Thickness x:Key="SettingsRowPadding">12,8</Thickness>
    <Thickness x:Key="SettingsRowControlMargin">24,0,0,0</Thickness>
    <Thickness x:Key="ListRowPadding">12,8</Thickness>
    <Thickness x:Key="ListRowSpacing">0,0,0,8</Thickness>
    <Thickness x:Key="ButtonPadding">16,8</Thickness>
    <Thickness x:Key="CompactButtonPadding">12,4</Thickness>
    <Thickness x:Key="CompactActionPadding">12,4</Thickness>
    <Thickness x:Key="ToolbarActionPadding">12,4</Thickness>
    <Thickness x:Key="SecondaryActionPadding">16,8</Thickness>
    <Thickness x:Key="SmallActionPadding">12,4</Thickness>
    <Thickness x:Key="FormSectionSpacing">0,24,0,0</Thickness>
    <Thickness x:Key="IconToTextMargin">0,0,8,0</Thickness>
    <Thickness x:Key="TrailingIconMargin">8,0,0,0</Thickness>

    <CornerRadius x:Key="PageCornerRadius">16</CornerRadius>
    <CornerRadius x:Key="ContentCornerRadius">14</CornerRadius>
    <CornerRadius x:Key="CardCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="DialogCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="ListRowCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="SmallControlCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="InputCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="InteractiveSurfaceCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="IconButtonCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="ToolbarPillCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="PillCornerRadius">999</CornerRadius>
    <CornerRadius x:Key="MediaControlCornerRadius">999</CornerRadius>

    <Thickness x:Key="StandardBorderThickness">1</Thickness>
    <Thickness x:Key="SeparatorBorderThickness">0,0,0,1</Thickness>
    <Thickness x:Key="KeyboardFocusRingThickness">1</Thickness>
    <Thickness x:Key="SelectedIndicatorThickness">0,0,0,2</Thickness>
    <Thickness x:Key="NoBorderThickness">0</Thickness>
    <sys:Double x:Key="DisabledControlOpacity">0.5</sys:Double>

    <sys:Double x:Key="CompactIconButtonSize">32</sys:Double>
    <sys:Double x:Key="IconButtonSize">36</sys:Double>
    <sys:Double x:Key="SecondaryIconButtonSize">44</sys:Double>
    <sys:Double x:Key="InputControlHeight">36</sys:Double>
    <sys:Double x:Key="TextControlHeight">40</sys:Double>
    <sys:Double x:Key="ListRowMinHeight">48</sys:Double>
    <sys:Double x:Key="SettingsRowMinHeight">52</sys:Double>
    <sys:Double x:Key="SettingsRowControlWidth">260</sys:Double>
    <sys:Double x:Key="MediaControlButtonSize">44</sys:Double>
    <sys:Double x:Key="PrimaryMediaControlButtonSize">48</sys:Double>
    <sys:Double x:Key="FloatingIconButtonSize">40</sys:Double>
    <sys:Double x:Key="ProgressTrackHeight">4</sys:Double>
    <sys:Double x:Key="ProgressSliderHeight">20</sys:Double>
    <sys:Double x:Key="ProgressThumbSize">18</sys:Double>
    <sys:Double x:Key="ProgressThumbBorderThickness">2</sys:Double>
    <sys:Double x:Key="IconSize16">16</sys:Double>
    <sys:Double x:Key="IconSize18">18</sys:Double>
    <sys:Double x:Key="IconSize20">20</sys:Double>
    <sys:Double x:Key="IconSize24">24</sys:Double>
    <sys:Double x:Key="CoverSmallWidth">72</sys:Double>
    <sys:Double x:Key="CoverSmallHeight">96</sys:Double>
    <sys:Double x:Key="CoverMediumWidth">96</sys:Double>
    <sys:Double x:Key="CoverMediumHeight">128</sys:Double>

    <FontFamily x:Key="AppFontFamily">Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI, sans-serif</FontFamily>
    <sys:Double x:Key="WindowTitleFontSize">24</sys:Double>
    <sys:Double x:Key="PageTitleFontSize">24</sys:Double>
    <sys:Double x:Key="SectionTitleFontSize">18</sys:Double>
    <sys:Double x:Key="CardTitleFontSize">16</sys:Double>
    <sys:Double x:Key="ItemTitleFontSize">15</sys:Double>
    <sys:Double x:Key="BodyFontSize">14</sys:Double>
    <sys:Double x:Key="SecondaryFontSize">13</sys:Double>
    <sys:Double x:Key="CaptionFontSize">12</sys:Double>
    <sys:Double x:Key="DialogTitleFontSize">22</sys:Double>

    <DropShadowEffect x:Key="ElevationLow"
                      BlurRadius="10"
                      Direction="270"
                      ShadowDepth="2"
                      Opacity="0.12"
                      Color="Black" />
    <DropShadowEffect x:Key="ElevationMedium"
                      BlurRadius="18"
                      Direction="270"
                      ShadowDepth="4"
                      Opacity="0.16"
                      Color="Black" />
    <DropShadowEffect x:Key="ElevationHigh"
                      BlurRadius="24"
                      Direction="270"
                      ShadowDepth="6"
                      Opacity="0.20"
                      Color="Black" />

    <!-- Three semantic motion tiers: 100 ms, 160 ms and 220 ms. -->
    <Duration x:Key="AnimFast">0:0:0.1</Duration>
    <Duration x:Key="AnimNormal">0:0:0.16</Duration>
    <Duration x:Key="AnimSlow">0:0:0.22</Duration>
    <Duration x:Key="AnimReducedMotion">0:0:0</Duration>
    <sys:Double x:Key="ReducedMotionOffset">0</sys:Double>
    <sys:Double x:Key="ReducedMotionScale">1</sys:Double>

    <sys:Double x:Key="NavigationPaneOpenWidth">220</sys:Double>
    <sys:Double x:Key="NavigationPaneCompactWidth">64</sys:Double>
</ResourceDictionary>
