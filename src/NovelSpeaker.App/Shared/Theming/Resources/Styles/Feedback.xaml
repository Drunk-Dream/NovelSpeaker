<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <!-- Feedback styles format content; Wpf.Ui remains the owner of each host lifecycle. -->
    <Style x:Key="App.Feedback.PopupSurface"
           TargetType="{x:Type Border}"
           BasedOn="{StaticResource App.Surface.Popup}">
        <Setter Property="KeyboardNavigation.TabNavigation" Value="Cycle" />
        <Setter Property="KeyboardNavigation.ControlTabNavigation" Value="Cycle" />
        <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Contained" />
    </Style>

    <Style x:Key="App.Feedback.FlyoutHost"
           TargetType="{x:Type ui:Flyout}"
           BasedOn="{StaticResource Provider.Flyout}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <!-- The content surface owns the only flyout boundary; the Popup host
             contributes no additional chrome. -->
        <Setter Property="Effect" Value="{x:Null}" />
    </Style>

    <Style x:Key="App.Feedback.PopupHost"
           TargetType="{x:Type Popup}">
        <Setter Property="AllowsTransparency" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="App.Feedback.DialogBody"
           TargetType="{x:Type Border}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Effect" Value="{x:Null}" />
        <Setter Property="MinWidth" Value="320" />
        <Setter Property="MaxWidth" Value="560" />
    </Style>

    <Style x:Key="App.Feedback.DialogTitle"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource App.Typography.ItemTitle}" />

    <Style x:Key="App.Feedback.DialogMessage"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource App.Typography.Body}">
        <Setter Property="Margin" Value="0,8,0,0" />
    </Style>

    <Style x:Key="App.Feedback.ValidationText"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource App.Typography.Validation}" />

    <Style x:Key="App.Feedback.InlineMessage"
           TargetType="{x:Type Border}"
           BasedOn="{StaticResource App.Surface.Secondary}">
        <Setter Property="Padding" Value="12,8" />
    </Style>

    <Style x:Key="App.Feedback.SnackbarBody"
           TargetType="{x:Type Border}"
           BasedOn="{StaticResource App.Surface.Raised}">
        <Setter Property="Padding" Value="12,8" />
    </Style>

    <DataTemplate x:Key="App.Feedback.SnackbarTitleTemplate">
        <TextBlock Style="{StaticResource App.Typography.ItemTitle}"
                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ui:Snackbar}}}"
                   Text="{Binding}"
                   TextWrapping="Wrap" />
    </DataTemplate>

    <DataTemplate x:Key="App.Feedback.SnackbarMessageTemplate">
        <TextBlock Style="{StaticResource App.Typography.Body}"
                   Foreground="{Binding ContentForeground, RelativeSource={RelativeSource AncestorType={x:Type ui:Snackbar}}}"
                   Text="{Binding}"
                   TextWrapping="Wrap" />
    </DataTemplate>

    <Style x:Key="App.Feedback.Snackbar"
           TargetType="{x:Type ui:Snackbar}"
           BasedOn="{StaticResource Provider.Snackbar}">
        <Setter Property="MaxWidth" Value="480" />
        <Setter Property="TitleTemplate" Value="{StaticResource App.Feedback.SnackbarTitleTemplate}" />
        <Setter Property="ContentTemplate" Value="{StaticResource App.Feedback.SnackbarMessageTemplate}" />
    </Style>
</ResourceDictionary>
