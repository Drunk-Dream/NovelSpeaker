<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Feedback styles format content; Wpf.Ui remains the owner of each host lifecycle. -->
    <Style x:Key="App.Feedback.PopupSurface"
           TargetType="{x:Type Border}"
           BasedOn="{StaticResource App.Surface.Popup}" />

    <Style x:Key="App.Feedback.DialogContent"
           TargetType="{x:Type Border}"
           BasedOn="{StaticResource App.Surface.DialogContent}">
        <Setter Property="MinWidth" Value="320" />
        <Setter Property="MaxWidth" Value="560" />
    </Style>

    <Style x:Key="App.Feedback.DialogTitle"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource App.Typography.ItemTitle}" />

    <Style x:Key="App.Feedback.DialogMessage"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource App.Typography.Body}">
        <Setter Property="Margin" Value="0,8,0,0" />
    </Style>

    <Style x:Key="App.Feedback.ValidationText"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource App.Typography.Validation}" />

    <Style x:Key="App.Feedback.InlineMessage"
           TargetType="{x:Type Border}"
           BasedOn="{StaticResource App.Surface.Secondary}">
        <Setter Property="Padding" Value="12,8" />
    </Style>

    <Style x:Key="App.Feedback.SnackbarBody"
           TargetType="{x:Type Border}"
           BasedOn="{StaticResource App.Surface.Raised}">
        <Setter Property="Padding" Value="12,8" />
    </Style>
</ResourceDictionary>
