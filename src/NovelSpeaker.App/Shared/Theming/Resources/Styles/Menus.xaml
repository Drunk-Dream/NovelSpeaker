<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Menu styles own the menu and context-menu surfaces plus the ordinary,
        danger and group-header items. Provider.MenuItem supplies the stable
        WPF MenuItem base through the Provider Style Bridge.
    -->
    <Style x:Key="App.Menu.Surface" TargetType="{x:Type Menu}">
        <Setter Property="Background" Value="{DynamicResource App.Brush.Surface.Raised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.Border.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Effect" Value="{DynamicResource App.Elevation.Medium}" />
    </Style>

    <Style x:Key="App.Menu.ContextSurface" TargetType="{x:Type ContextMenu}">
        <Setter Property="Background" Value="{DynamicResource App.Brush.Surface.Raised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.Border.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Effect" Value="{DynamicResource App.Elevation.Medium}" />
    </Style>

    <Style x:Key="App.Menu.Item"
           TargetType="{x:Type MenuItem}"
           BasedOn="{StaticResource Provider.MenuItem}">
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="Foreground" Value="{DynamicResource App.Brush.Text.Primary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>

    <Style x:Key="App.Menu.DangerItem"
           TargetType="{x:Type MenuItem}"
           BasedOn="{StaticResource App.Menu.Item}">
        <Setter Property="Foreground" Value="{DynamicResource App.Brush.Danger}" />
        <Setter Property="Tag" Value="Danger" />
    </Style>

    <Style x:Key="App.Menu.GroupHeader"
           TargetType="{x:Type MenuItem}"
           BasedOn="{StaticResource App.Menu.Item}">
        <Setter Property="IsEnabled" Value="False" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource App.Brush.Text.Secondary}" />
    </Style>
</ResourceDictionary>
