<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The ProgressBar owns the filled track; editable positions belong to the paired media Slider. -->
    <Style x:Key="App.Progress.Standard"
           TargetType="{x:Type ProgressBar}"
           BasedOn="{StaticResource Provider.ProgressBar}">
        <Setter Property="Height" Value="6" />
        <Setter Property="MinHeight" Value="6" />
        <Setter Property="MinWidth" Value="280" />
        <Setter Property="Foreground" Value="{DynamicResource App.Brush.Accent}" />
        <Setter Property="Background" Value="{DynamicResource App.Brush.Surface.Secondary}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style x:Key="App.Progress.Compact"
           TargetType="{x:Type ProgressBar}"
           BasedOn="{StaticResource App.Progress.Standard}">
        <Setter Property="Height" Value="4" />
        <Setter Property="MinHeight" Value="4" />
        <Setter Property="MinWidth" Value="0" />
    </Style>

    <Style x:Key="App.Progress.MediaTrack"
           TargetType="{x:Type ProgressBar}"
           BasedOn="{StaticResource App.Progress.Standard}">
        <!-- Keep the unplayed portion visible against both media control surfaces. -->
        <Setter Property="Background" Value="{DynamicResource App.Brush.Border.Subtle}" />
    </Style>
</ResourceDictionary>
