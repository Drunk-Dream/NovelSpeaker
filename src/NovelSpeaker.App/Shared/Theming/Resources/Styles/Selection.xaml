<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:rules="clr-namespace:NovelSpeaker.App.Shared.Presentation.Rules">
    <!--
        Selection styles express container state for list rows: default,
        hover, keyboard focus, disabled, selected, current, multi-select and
        drop target. Chrome-free item containers are the deliberate exception:
        they remove provider pointer-over chrome while retaining the content,
        layout and automation contract. Selection surfaces never store business
        facts on container instances; pages bind the item state contracts
        (IsSelected / IsCurrent / IsSelectedForActiveCache / IsDropTarget) to
        their data items so recycled containers keep reflecting the current data.
    -->
    <Style x:Key="App.Selection.ChromeFreeItemContainer"
           TargetType="{x:Type ListBoxItem}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                      ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="App.Selection.ListItem"
           TargetType="{x:Type Border}">
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="CornerRadius" Value="{StaticResource App.Radius.Small}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter Property="Background" Value="{DynamicResource App.Brush.Accent.Subtle}" />
                <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.Accent.Default}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource App.Brush.Interaction.Foreground.Selected}" />
            </DataTrigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource App.Brush.Interaction.Surface.Hover}" />
            </Trigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsSelected}" Value="True" />
                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource App.Brush.Accent.Subtle.Hover}" />
                <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.Accent.Hover}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource App.Brush.Interaction.Foreground.Selected}" />
            </MultiDataTrigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.Focus}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource App.Brush.Surface.Secondary}" />
                <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.Border.Subtle}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource App.Brush.Interaction.Foreground.Disabled}" />
                <Setter Property="Opacity" Value="{StaticResource App.Opacity.Disabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="App.Selection.CardItem"
           TargetType="{x:Type Border}"
           BasedOn="{StaticResource App.Selection.ListItem}">
        <Setter Property="MinHeight" Value="56" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="CornerRadius" Value="{StaticResource App.Radius.Medium}" />
        <Setter Property="Background" Value="{DynamicResource App.Brush.Surface.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.Border.Subtle}" />
    </Style>

    <Style x:Key="App.Selection.RuleCard"
           TargetType="{x:Type Border}"
           BasedOn="{StaticResource App.Selection.CardItem}">
        <Setter Property="MinHeight" Value="72" />
        <Setter Property="Padding" Value="14,12" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type rules:RuleListItemView}}}"
                         Value="True">
                <Setter Property="Background" Value="{DynamicResource App.Brush.Accent.Subtle}" />
                <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.Accent.Default}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource App.Brush.Interaction.Foreground.Selected}" />
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type rules:RuleListItemView}}}"
                               Value="True" />
                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}"
                               Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource App.Brush.Accent.Subtle.Hover}" />
                <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.Accent.Hover}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource App.Brush.Interaction.Foreground.Selected}" />
            </MultiDataTrigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource App.Brush.Surface.Secondary}" />
                <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.Border.Subtle}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource App.Brush.Interaction.Foreground.Disabled}" />
                <Setter Property="Opacity" Value="{StaticResource App.Opacity.Disabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="App.Selection.CurrentItem"
           TargetType="{x:Type Border}"
           BasedOn="{StaticResource App.Selection.ListItem}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                <Setter Property="Background" Value="{DynamicResource App.Brush.Accent.Subtle}" />
                <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.Accent.Default}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource App.Brush.Interaction.Foreground.Selected}" />
            </DataTrigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource App.Brush.Interaction.Surface.Hover}" />
            </Trigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsCurrent}" Value="True" />
                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource App.Brush.Accent.Subtle.Hover}" />
                <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.Accent.Hover}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource App.Brush.Interaction.Foreground.Selected}" />
            </MultiDataTrigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource App.Brush.Surface.Secondary}" />
                <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.Border.Subtle}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource App.Brush.Interaction.Foreground.Disabled}" />
                <Setter Property="Opacity" Value="{StaticResource App.Opacity.Disabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="App.Selection.DropTarget"
           TargetType="{x:Type Border}"
           BasedOn="{StaticResource App.Selection.ListItem}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                <Setter Property="Background" Value="{DynamicResource App.Brush.Accent.Subtle}" />
                <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.Focus}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource App.Brush.Interaction.Foreground.Selected}" />
            </DataTrigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource App.Brush.Interaction.Surface.Hover}" />
            </Trigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsDropTarget}" Value="True" />
                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource App.Brush.Accent.Subtle.Hover}" />
                <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.Focus}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource App.Brush.Interaction.Foreground.Selected}" />
            </MultiDataTrigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource App.Brush.Surface.Secondary}" />
                <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.Border.Subtle}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource App.Brush.Interaction.Foreground.Disabled}" />
                <Setter Property="Opacity" Value="{StaticResource App.Opacity.Disabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="App.Selection.MultiSelectItem"
           TargetType="{x:Type Border}"
           BasedOn="{StaticResource App.Selection.ListItem}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelectedForActiveCache}" Value="True">
                <Setter Property="Background" Value="{DynamicResource App.Brush.Accent.Subtle}" />
                <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.Accent.Default}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource App.Brush.Interaction.Foreground.Selected}" />
            </DataTrigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource App.Brush.Interaction.Surface.Hover}" />
            </Trigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsSelectedForActiveCache}" Value="True" />
                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource App.Brush.Accent.Subtle.Hover}" />
                <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.Accent.Hover}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource App.Brush.Interaction.Foreground.Selected}" />
            </MultiDataTrigger>
            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                <Setter Property="Background" Value="{DynamicResource App.Brush.Accent.Subtle}" />
                <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.Accent.Default}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource App.Brush.Interaction.Foreground.Selected}" />
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsCurrent}" Value="True" />
                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource App.Brush.Accent.Subtle.Hover}" />
                <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.Accent.Hover}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource App.Brush.Interaction.Foreground.Selected}" />
            </MultiDataTrigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource App.Brush.Surface.Secondary}" />
                <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.Border.Subtle}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource App.Brush.Interaction.Foreground.Disabled}" />
                <Setter Property="Opacity" Value="{StaticResource App.Opacity.Disabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
        Content text styles are the companion owner for selection containers.
        They keep typography defaults for Rest and project every persistent
        selection fact to the actual TextBlock rather than relying on inherited
        foreground values that a local typography setter could mask.
    -->
    <Style x:Key="App.Selection.Content.Primary"
           TargetType="TextBlock"
           BasedOn="{StaticResource App.Typography.Body}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource App.Brush.Interaction.Foreground.Selected}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource App.Brush.Interaction.Foreground.Selected}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsSelectedForActiveCache}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource App.Brush.Interaction.Foreground.Selected}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource App.Brush.Interaction.Foreground.Selected}" />
            </DataTrigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource App.Brush.Interaction.Foreground.Disabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="App.Selection.Content.Secondary"
           TargetType="TextBlock"
           BasedOn="{StaticResource App.Typography.Secondary}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource App.Brush.Interaction.Foreground.Selected}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource App.Brush.Interaction.Foreground.Selected}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsSelectedForActiveCache}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource App.Brush.Interaction.Foreground.Selected}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource App.Brush.Interaction.Foreground.Selected}" />
            </DataTrigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource App.Brush.Interaction.Foreground.Disabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="App.Selection.Content.Title"
           TargetType="TextBlock"
           BasedOn="{StaticResource App.Selection.Content.Primary}">
        <Setter Property="FontSize" Value="{StaticResource App.Text.Size.ItemTitle}" />
        <Setter Property="FontWeight" Value="{StaticResource App.Text.Weight.SemiBold}" />
    </Style>

    <Style x:Key="App.Selection.Content.AccentSecondary"
           TargetType="TextBlock"
           BasedOn="{StaticResource App.Selection.Content.Secondary}">
        <Setter Property="Foreground" Value="{DynamicResource App.Brush.Accent.Default}" />
    </Style>

    <Style x:Key="App.Selection.Content.RuleTitle"
           TargetType="TextBlock"
           BasedOn="{StaticResource App.Typography.ItemTitle}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type rules:RuleListItemView}}}"
                         Value="True">
                <Setter Property="Foreground" Value="{DynamicResource App.Brush.Interaction.Foreground.Selected}" />
            </DataTrigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource App.Brush.Interaction.Foreground.Disabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="App.Selection.Content.RuleSecondary"
           TargetType="TextBlock"
           BasedOn="{StaticResource App.Typography.Secondary}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type rules:RuleListItemView}}}"
                         Value="True">
                <Setter Property="Foreground" Value="{DynamicResource App.Brush.Interaction.Foreground.Selected}" />
            </DataTrigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource App.Brush.Interaction.Foreground.Disabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
