<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <!--
        These are explicit, gallery-first variants. Wpf.Ui owns the Button
        templates through the Provider bridge; this dictionary only supplies
        stable semantic values and state setters.
    -->
    <Style x:Key="App.Button.Primary"
           TargetType="Button"
           BasedOn="{StaticResource Provider.Button}">
        <Setter Property="MinHeight" Value="{StaticResource App.Size.Control.Standard}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource App.Brush.Accent.Default}" />
        <Setter Property="Foreground" Value="{DynamicResource App.Brush.Accent.Text}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource App.Brush.Accent.Hover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource App.Brush.Accent.Pressed}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource App.Brush.Surface.Secondary}" />
                <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.Border.Subtle}" />
                <Setter Property="Foreground" Value="{DynamicResource App.Brush.Interaction.Foreground.Disabled}" />
                <Setter Property="Opacity" Value="{StaticResource App.Opacity.Disabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="App.Button.Secondary"
           TargetType="Button"
           BasedOn="{StaticResource Provider.Button}">
        <Setter Property="MinHeight" Value="{StaticResource App.Size.Control.Standard}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource App.Brush.Surface.Primary}" />
        <Setter Property="Foreground" Value="{DynamicResource App.Brush.Text.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.Border.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource App.Brush.Interaction.Surface.Hover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource App.Brush.Interaction.Surface.Pressed}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource App.Brush.Surface.Secondary}" />
                <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.Border.Subtle}" />
                <Setter Property="Foreground" Value="{DynamicResource App.Brush.Interaction.Foreground.Disabled}" />
                <Setter Property="Opacity" Value="{StaticResource App.Opacity.Disabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="App.Button.Subtle"
           TargetType="Button"
           BasedOn="{StaticResource Provider.Button}">
        <Setter Property="MinHeight" Value="{StaticResource App.Size.Control.Standard}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource App.Brush.Text.Primary}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource App.Brush.Interaction.Surface.Hover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource App.Brush.Interaction.Surface.Pressed}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource App.Brush.Surface.Secondary}" />
                <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.Border.Subtle}" />
                <Setter Property="Foreground" Value="{DynamicResource App.Brush.Interaction.Foreground.Disabled}" />
                <Setter Property="Opacity" Value="{StaticResource App.Opacity.Disabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="App.Button.Icon"
           TargetType="{x:Type ui:Button}"
           BasedOn="{StaticResource Provider.UiButton}">
        <Setter Property="Width" Value="{StaticResource App.Size.Icon.Touch}" />
        <Setter Property="Height" Value="{StaticResource App.Size.Icon.Touch}" />
        <Setter Property="MinWidth" Value="{StaticResource App.Size.Icon.Touch}" />
        <Setter Property="MinHeight" Value="{StaticResource App.Size.Icon.Touch}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="{StaticResource App.Size.Icon.Standard}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="MouseOverBackground" Value="{DynamicResource App.Brush.Interaction.Surface.Hover}" />
        <Setter Property="PressedBackground" Value="{DynamicResource App.Brush.Interaction.Surface.Pressed}" />
        <Setter Property="Foreground" Value="{DynamicResource App.Brush.Text.Primary}" />
        <Setter Property="PressedForeground" Value="{DynamicResource App.Brush.Interaction.Foreground.Pressed}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="MouseOverBorderBrush" Value="Transparent" />
        <Setter Property="PressedBorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource App.Brush.Interaction.Foreground.Hover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource App.Brush.Interaction.Foreground.Pressed}" />
                <Setter Property="PressedForeground" Value="{DynamicResource App.Brush.Interaction.Foreground.Pressed}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="MouseOverBackground" Value="Transparent" />
                <Setter Property="PressedBackground" Value="Transparent" />
                <Setter Property="MouseOverBorderBrush" Value="Transparent" />
                <Setter Property="PressedBorderBrush" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource App.Brush.Interaction.Foreground.Disabled}" />
                <Setter Property="Opacity" Value="{StaticResource App.Opacity.Disabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="App.Button.Danger"
           TargetType="Button"
           BasedOn="{StaticResource Provider.Button}">
        <Setter Property="MinHeight" Value="{StaticResource App.Size.Control.Standard}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource App.Brush.Danger}" />
        <Setter Property="Foreground" Value="{DynamicResource App.Brush.Danger.Text}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource App.Brush.Danger.Subtle}" />
                <Setter Property="Foreground" Value="{DynamicResource App.Brush.Text.Primary}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource App.Brush.Danger.Pressed}" />
                <Setter Property="Foreground" Value="{DynamicResource App.Brush.Danger.Pressed.Text}" />
                <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.Danger.Pressed}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource App.Brush.Surface.Secondary}" />
                <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.Border.Subtle}" />
                <Setter Property="Foreground" Value="{DynamicResource App.Brush.Interaction.Foreground.Disabled}" />
                <Setter Property="Opacity" Value="{StaticResource App.Opacity.Disabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="App.Button.DangerIcon"
           TargetType="{x:Type ui:Button}"
           BasedOn="{StaticResource Provider.UiButton}">
        <Setter Property="Width" Value="{StaticResource App.Size.Icon.Touch}" />
        <Setter Property="Height" Value="{StaticResource App.Size.Icon.Touch}" />
        <Setter Property="MinWidth" Value="{StaticResource App.Size.Icon.Touch}" />
        <Setter Property="MinHeight" Value="{StaticResource App.Size.Icon.Touch}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="{StaticResource App.Size.Icon.Standard}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource App.Brush.Text.Primary}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="MouseOverBackground" Value="{DynamicResource App.Brush.Danger}" />
        <Setter Property="MouseOverBorderBrush" Value="Transparent" />
        <Setter Property="PressedBackground" Value="{DynamicResource App.Brush.Danger.Pressed}" />
        <Setter Property="PressedBorderBrush" Value="Transparent" />
        <Setter Property="PressedForeground" Value="{DynamicResource App.Brush.Danger.Pressed.Text}" />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource App.Brush.Danger.Text}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource App.Brush.Danger.Pressed.Text}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="MouseOverBackground" Value="Transparent" />
                <Setter Property="PressedBackground" Value="Transparent" />
                <Setter Property="MouseOverBorderBrush" Value="Transparent" />
                <Setter Property="PressedBorderBrush" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource App.Brush.Interaction.Foreground.Disabled}" />
                <Setter Property="Opacity" Value="{StaticResource App.Opacity.Disabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="App.Button.ToolbarValue"
           TargetType="{x:Type ui:Button}"
           BasedOn="{StaticResource Provider.UiButton}">
        <Setter Property="MinHeight" Value="{StaticResource App.Size.Control.Compact}" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CornerRadius" Value="{StaticResource App.Radius.Medium}" />
        <Setter Property="Background" Value="{DynamicResource App.Brush.Surface.Secondary}" />
        <Setter Property="MouseOverBackground" Value="{DynamicResource App.Brush.Interaction.Surface.Hover}" />
        <Setter Property="PressedBackground" Value="{DynamicResource App.Brush.Interaction.Surface.Pressed}" />
        <Setter Property="Foreground" Value="{DynamicResource App.Brush.Text.Primary}" />
        <Setter Property="PressedForeground" Value="{DynamicResource App.Brush.Interaction.Foreground.Pressed}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.Border.Subtle}" />
        <Setter Property="MouseOverBorderBrush" Value="Transparent" />
        <Setter Property="PressedBorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource App.Brush.Interaction.Foreground.Hover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource App.Brush.Interaction.Foreground.Pressed}" />
                <Setter Property="PressedForeground" Value="{DynamicResource App.Brush.Interaction.Foreground.Pressed}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="MouseOverBackground" Value="Transparent" />
                <Setter Property="PressedBackground" Value="Transparent" />
                <Setter Property="MouseOverBorderBrush" Value="Transparent" />
                <Setter Property="PressedBorderBrush" Value="Transparent" />
                <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.Border.Subtle}" />
                <Setter Property="Foreground" Value="{DynamicResource App.Brush.Interaction.Foreground.Disabled}" />
                <Setter Property="Opacity" Value="{StaticResource App.Opacity.Disabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="App.Button.InteractionHost"
           TargetType="Button"
           BasedOn="{StaticResource Provider.Button}">
        <Setter Property="MinHeight" Value="{StaticResource App.Size.Control.Standard}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource App.Brush.Text.Primary}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <!--
                    This host owns hit testing, focus and command semantics.
                    Its template intentionally has no Border or Background
                    visual; the surrounding Selection surface is the only
                    visible row state owner.
                -->
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid Background="Transparent">
                        <!-- The transparent root remains the hit target when Content is empty. -->
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Margin="{TemplateBinding Padding}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                          ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                          RecognizesAccessKey="True"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource App.Brush.Interaction.Foreground.Disabled}" />
                <Setter Property="Opacity" Value="{StaticResource App.Opacity.Disabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="App.Button.FloatingIcon"
           TargetType="{x:Type ui:Button}"
           BasedOn="{StaticResource Provider.UiButton}">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="MinWidth" Value="44" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="{StaticResource App.Size.Icon.Standard}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Background" Value="{DynamicResource App.Brush.Surface.Raised}" />
        <Setter Property="MouseOverBackground" Value="{DynamicResource App.Brush.Interaction.Surface.Hover}" />
        <Setter Property="PressedBackground" Value="{DynamicResource App.Brush.Interaction.Surface.Pressed}" />
        <Setter Property="Foreground" Value="{DynamicResource App.Brush.Text.Primary}" />
        <Setter Property="PressedForeground" Value="{DynamicResource App.Brush.Interaction.Foreground.Pressed}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.Border.Subtle}" />
        <Setter Property="MouseOverBorderBrush" Value="{DynamicResource App.Brush.Border.Subtle}" />
        <Setter Property="PressedBorderBrush" Value="{DynamicResource App.Brush.Border.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Effect" Value="{StaticResource App.Elevation.Low}" />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        <Setter Property="FocusVisualStyle">
            <Setter.Value>
                <!-- WPF renders this adorner only for keyboard-visible focus. -->
                <Style TargetType="{x:Type Control}">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type Control}">
                                <Border Margin="-2"
                                        BorderBrush="{DynamicResource App.Brush.Focus}"
                                        BorderThickness="2"
                                        CornerRadius="999"
                                        IsHitTestVisible="False" />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource App.Brush.Interaction.Foreground.Hover}" />
                <!-- Keep the fixed Low elevation; Hover must not lift the button. -->
                <Setter Property="Effect" Value="{StaticResource App.Elevation.Low}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource App.Brush.Interaction.Foreground.Pressed}" />
                <Setter Property="PressedForeground" Value="{DynamicResource App.Brush.Interaction.Foreground.Pressed}" />
                <!-- Pressed is a normal interaction surface, not Accent.Subtle. -->
                <Setter Property="Effect" Value="{StaticResource App.Elevation.Low}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource App.Brush.Surface.Secondary}" />
                <Setter Property="MouseOverBackground" Value="{DynamicResource App.Brush.Surface.Secondary}" />
                <Setter Property="PressedBackground" Value="{DynamicResource App.Brush.Surface.Secondary}" />
                <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.Border.Subtle}" />
                <Setter Property="MouseOverBorderBrush" Value="{DynamicResource App.Brush.Border.Subtle}" />
                <Setter Property="PressedBorderBrush" Value="{DynamicResource App.Brush.Border.Subtle}" />
                <Setter Property="Foreground" Value="{DynamicResource App.Brush.Interaction.Foreground.Disabled}" />
                <Setter Property="PressedForeground" Value="{DynamicResource App.Brush.Interaction.Foreground.Disabled}" />
                <Setter Property="Effect" Value="{x:Null}" />
                <Setter Property="Opacity" Value="{StaticResource App.Opacity.Disabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
