<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Surface styles own only visual grouping: semantic background, boundary,
        corner radius, padding and elevation. Content, commands and page layout
        remain owned by the consuming view or component.
    -->
    <Style x:Key="App.Surface.Canvas" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource App.Brush.Canvas}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="App.Surface.Section" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource App.Brush.Surface.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.Border.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource App.Radius.Medium}" />
        <Setter Property="Padding" Value="20" />
    </Style>

    <Style x:Key="App.Surface.Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource App.Brush.Surface.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.Border.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource App.Radius.Medium}" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="App.Surface.Secondary" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource App.Brush.Surface.Secondary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.Border.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource App.Radius.Small}" />
        <Setter Property="Padding" Value="12" />
    </Style>

    <Style x:Key="App.Surface.Raised" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource App.Brush.Surface.Raised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.Border.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource App.Radius.Large}" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="Effect" Value="{StaticResource App.Elevation.Low}" />
    </Style>

    <Style x:Key="App.Surface.FloatingAction"
           TargetType="Border"
           BasedOn="{StaticResource App.Surface.Raised}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="999" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                         Value="True">
                <Setter Property="Background" Value="{DynamicResource App.Brush.Surface.Secondary}" />
                <Setter Property="Effect" Value="{StaticResource App.Elevation.Medium}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsPressed, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                         Value="True">
                <Setter Property="Background" Value="{DynamicResource App.Brush.Accent.Subtle}" />
                <Setter Property="Effect" Value="{StaticResource App.Elevation.Low}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="App.Surface.Popup" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource App.Brush.Surface.Raised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.Border.Strong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource App.Radius.Medium}" />
        <Setter Property="Padding" Value="16" />
        <!-- WPF Popup is a rectangular native window. A shadow on a rounded
             child is clipped by that window and leaves square corner residue. -->
        <Setter Property="Effect" Value="{x:Null}" />
    </Style>

</ResourceDictionary>
