<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <!--
        These are explicit input-family variants. The Provider.* aliases own the
        Wpf.Ui templates and interaction states; this dictionary only supplies
        stable density, palette, alignment and validation/read-only semantics.
        In particular, no ItemContainerStyle, Popup or Template is replaced here.
    -->
    <Style x:Key="App.Input.TextBox.Standard"
           TargetType="{x:Type TextBox}"
           BasedOn="{StaticResource Provider.TextBox}">
        <Setter Property="FontFamily" Value="{StaticResource App.Text.Family.Ui}" />
        <Setter Property="FontSize" Value="{StaticResource App.Text.Size.Body}" />
        <Setter Property="FontWeight" Value="{StaticResource App.Text.Weight.Regular}" />
        <Setter Property="Foreground" Value="{DynamicResource App.Brush.Text.Primary}" />
        <Setter Property="Background" Value="{DynamicResource App.Brush.Surface.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.Border.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="MinHeight" Value="{StaticResource App.Size.Control.Standard}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SelectionBrush" Value="{DynamicResource App.Brush.Accent}" />
        <Setter Property="SelectionTextBrush" Value="{DynamicResource App.Brush.Accent.Text}" />
        <Setter Property="CaretBrush" Value="{DynamicResource App.Brush.Accent}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.Border.Strong}" />
            </Trigger>
            <Trigger Property="IsReadOnly" Value="True">
                <Setter Property="Background" Value="{DynamicResource App.Brush.Surface.Secondary}" />
                <Setter Property="Foreground" Value="{DynamicResource App.Brush.Text.Secondary}" />
            </Trigger>
            <Trigger Property="Validation.HasError" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.Danger}" />
                <Setter Property="Background" Value="{DynamicResource App.Brush.Danger.Subtle}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource App.Brush.Surface.Secondary}" />
                <Setter Property="Foreground" Value="{DynamicResource App.Brush.Text.Tertiary}" />
                <Setter Property="Opacity" Value="{StaticResource App.Opacity.Disabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="App.Input.TextBox.Compact"
           TargetType="{x:Type TextBox}"
           BasedOn="{StaticResource App.Input.TextBox.Standard}">
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="MinHeight" Value="{StaticResource App.Size.Control.Compact}" />
    </Style>

    <!-- The short names in the visual design document remain the default TextBox
         entry points; type-specific keys make the other controls unambiguous. -->
    <Style x:Key="App.Input.Standard"
           TargetType="{x:Type TextBox}"
           BasedOn="{StaticResource App.Input.TextBox.Standard}" />
    <Style x:Key="App.Input.Compact"
           TargetType="{x:Type TextBox}"
           BasedOn="{StaticResource App.Input.TextBox.Compact}" />

    <Style x:Key="App.Input.PasswordBox.Standard"
           TargetType="{x:Type PasswordBox}"
           BasedOn="{StaticResource Provider.PasswordBox}">
        <Setter Property="FontFamily" Value="{StaticResource App.Text.Family.Ui}" />
        <Setter Property="FontSize" Value="{StaticResource App.Text.Size.Body}" />
        <Setter Property="FontWeight" Value="{StaticResource App.Text.Weight.Regular}" />
        <Setter Property="Foreground" Value="{DynamicResource App.Brush.Text.Primary}" />
        <Setter Property="Background" Value="{DynamicResource App.Brush.Surface.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.Border.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="MinHeight" Value="{StaticResource App.Size.Control.Standard}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.Border.Strong}" />
            </Trigger>
            <Trigger Property="Validation.HasError" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.Danger}" />
                <Setter Property="Background" Value="{DynamicResource App.Brush.Danger.Subtle}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource App.Brush.Surface.Secondary}" />
                <Setter Property="Foreground" Value="{DynamicResource App.Brush.Text.Tertiary}" />
                <Setter Property="Opacity" Value="{StaticResource App.Opacity.Disabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="App.Input.PasswordBox.Compact"
           TargetType="{x:Type PasswordBox}"
           BasedOn="{StaticResource App.Input.PasswordBox.Standard}">
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="MinHeight" Value="{StaticResource App.Size.Control.Compact}" />
    </Style>

    <Style x:Key="App.Input.ComboBox.Standard"
           TargetType="{x:Type ComboBox}"
           BasedOn="{StaticResource Provider.ComboBox}">
        <Setter Property="FontFamily" Value="{StaticResource App.Text.Family.Ui}" />
        <Setter Property="FontSize" Value="{StaticResource App.Text.Size.Body}" />
        <Setter Property="FontWeight" Value="{StaticResource App.Text.Weight.Regular}" />
        <Setter Property="Foreground" Value="{DynamicResource App.Brush.Text.Primary}" />
        <Setter Property="Background" Value="{DynamicResource App.Brush.Surface.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.Border.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="MinHeight" Value="{StaticResource App.Size.Control.Standard}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.Border.Strong}" />
            </Trigger>
            <Trigger Property="IsDropDownOpen" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.Focus}" />
            </Trigger>
            <Trigger Property="Validation.HasError" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.Danger}" />
                <Setter Property="Background" Value="{DynamicResource App.Brush.Danger.Subtle}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource App.Brush.Surface.Secondary}" />
                <Setter Property="Foreground" Value="{DynamicResource App.Brush.Text.Tertiary}" />
                <Setter Property="Opacity" Value="{StaticResource App.Opacity.Disabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="App.Input.ComboBox.Compact"
           TargetType="{x:Type ComboBox}"
           BasedOn="{StaticResource App.Input.ComboBox.Standard}">
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="MinHeight" Value="{StaticResource App.Size.Control.Compact}" />
    </Style>

    <Style x:Key="App.Input.CheckBox.Standard"
           TargetType="{x:Type CheckBox}"
           BasedOn="{StaticResource Provider.CheckBox}">
        <Setter Property="FontFamily" Value="{StaticResource App.Text.Family.Ui}" />
        <Setter Property="FontSize" Value="{StaticResource App.Text.Size.Body}" />
        <Setter Property="FontWeight" Value="{StaticResource App.Text.Weight.Regular}" />
        <Setter Property="Foreground" Value="{DynamicResource App.Brush.Text.Primary}" />
        <Setter Property="MinHeight" Value="{StaticResource App.Size.Control.Standard}" />
        <Setter Property="Padding" Value="0,2" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource App.Brush.Text.Primary}" />
            </Trigger>
            <Trigger Property="Validation.HasError" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource App.Brush.Danger}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource App.Brush.Text.Tertiary}" />
                <Setter Property="Opacity" Value="{StaticResource App.Opacity.Disabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="App.Input.CheckBox.Compact"
           TargetType="{x:Type CheckBox}"
           BasedOn="{StaticResource App.Input.CheckBox.Standard}">
        <Setter Property="MinHeight" Value="{StaticResource App.Size.Control.Compact}" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="App.Input.ToggleSwitch.Standard"
           TargetType="{x:Type ui:ToggleSwitch}"
           BasedOn="{StaticResource Provider.ToggleSwitch}">
        <Setter Property="FontFamily" Value="{StaticResource App.Text.Family.Ui}" />
        <Setter Property="FontSize" Value="{StaticResource App.Text.Size.Body}" />
        <Setter Property="FontWeight" Value="{StaticResource App.Text.Weight.Regular}" />
        <Setter Property="Foreground" Value="{DynamicResource App.Brush.Text.Primary}" />
        <Setter Property="Background" Value="{DynamicResource App.Brush.Surface.Secondary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.Border.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="MinHeight" Value="{StaticResource App.Size.Control.Standard}" />
        <Setter Property="MinWidth" Value="96" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource App.Brush.Accent.Default}" />
                <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.Accent.Default}" />
                <Setter Property="Foreground" Value="{DynamicResource App.Brush.Text.Primary}" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True" />
                    <Condition Property="IsChecked" Value="False" />
                </MultiTrigger.Conditions>
                <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.Border.Strong}" />
            </MultiTrigger>
            <Trigger Property="Validation.HasError" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.Danger}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource App.Brush.Text.Tertiary}" />
                <Setter Property="Opacity" Value="{StaticResource App.Opacity.Disabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="App.Input.ToggleSwitch.Compact"
           TargetType="{x:Type ui:ToggleSwitch}"
           BasedOn="{StaticResource App.Input.ToggleSwitch.Standard}">
        <Setter Property="MinHeight" Value="{StaticResource App.Size.Control.Compact}" />
        <Setter Property="MinWidth" Value="80" />
    </Style>
</ResourceDictionary>
