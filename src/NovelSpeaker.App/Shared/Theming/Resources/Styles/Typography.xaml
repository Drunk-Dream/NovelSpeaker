        <Setter Property="FontWeight" Value="{StaticResource App.Text.Weight.Regular}" />
        <Setter Property="Foreground" Value="{DynamicResource App.Brush.Text.Secondary}" />
        <Setter Property="LineHeight" Value="{StaticResource App.Text.LineHeight.Secondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Style.Triggers>
