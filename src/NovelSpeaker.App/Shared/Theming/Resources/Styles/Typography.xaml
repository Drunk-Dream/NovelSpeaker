        <Setter Property="Foreground" Value="{DynamicResource App.Brush.Text.Primary}" />
        <Setter Property="LineHeight" Value="{StaticResource App.Text.LineHeight.Body}" />
        <Setter Property="TextWrapping" Value="Wrap" />
