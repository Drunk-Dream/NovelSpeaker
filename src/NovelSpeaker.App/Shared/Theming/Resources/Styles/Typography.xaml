<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Stable typography variants owned by the shared explicit style layer. -->
    <Style x:Key="App.Typography.PageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource App.Text.Family.Ui}" />
        <Setter Property="FontSize" Value="{StaticResource App.Text.Size.PageTitle}" />
        <Setter Property="FontWeight" Value="{StaticResource App.Text.Weight.SemiBold}" />
        <Setter Property="Foreground" Value="{DynamicResource App.Brush.Text.Primary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="{StaticResource App.Opacity.Disabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="App.Typography.SectionTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource App.Text.Family.Ui}" />
        <Setter Property="FontSize" Value="{StaticResource App.Text.Size.SectionTitle}" />
