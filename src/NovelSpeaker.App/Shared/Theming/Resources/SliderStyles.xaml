<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Gallery-first slider variant. Wpf.Ui owns the standard template through
        the Provider bridge; this style only owns media progress geometry and
        interaction colors.
    -->
    <Style x:Key="App.Media.Slider"
           TargetType="Slider"
           BasedOn="{StaticResource Provider.Slider}">
        <Setter Property="Height" Value="24" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="MinWidth" Value="280" />
        <Setter Property="Background" Value="{DynamicResource SecondarySurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Focusable" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource AccentHoverBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="{StaticResource DisabledControlOpacity}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
