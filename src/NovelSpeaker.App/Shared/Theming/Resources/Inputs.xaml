<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <!--
        These are explicit input-family variants. The Provider.* aliases own the
        Wpf.Ui templates and interaction states; this dictionary only supplies
        stable density, palette, alignment and validation/read-only semantics.
        In particular, no ItemContainerStyle, Popup or Template is replaced here.
    -->
    <Style x:Key="App.Input.TextBox.Standard"
           TargetType="{x:Type TextBox}"
           BasedOn="{StaticResource Provider.TextBox}">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyUi}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightRegular}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="Background" Value="{DynamicResource PrimarySurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="MinHeight" Value="{StaticResource ControlMinHeightStandard}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="SelectionTextBrush" Value="{DynamicResource AccentTextBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource StrongBorderBrush}" />
            </Trigger>
            <Trigger Property="IsReadOnly" Value="True">
                <Setter Property="Background" Value="{DynamicResource SecondarySurfaceBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            </Trigger>
            <Trigger Property="Validation.HasError" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                <Setter Property="Background" Value="{DynamicResource DangerSubtleBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource SecondarySurfaceBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TertiaryTextBrush}" />
                <Setter Property="Opacity" Value="{StaticResource DisabledControlOpacity}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="App.Input.TextBox.Compact"
           TargetType="{x:Type TextBox}"
           BasedOn="{StaticResource App.Input.TextBox.Standard}">
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="MinHeight" Value="{StaticResource ControlMinHeightCompact}" />
    </Style>

    <!-- The short names in the visual design document remain the default TextBox
         entry points; type-specific keys make the other controls unambiguous. -->
    <Style x:Key="App.Input.Standard"
           TargetType="{x:Type TextBox}"
           BasedOn="{StaticResource App.Input.TextBox.Standard}" />
    <Style x:Key="App.Input.Compact"
           TargetType="{x:Type TextBox}"
           BasedOn="{StaticResource App.Input.TextBox.Compact}" />

    <Style x:Key="App.Input.PasswordBox.Standard"
           TargetType="{x:Type PasswordBox}"
           BasedOn="{StaticResource Provider.PasswordBox}">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyUi}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightRegular}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="Background" Value="{DynamicResource PrimarySurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="MinHeight" Value="{StaticResource ControlMinHeightStandard}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource StrongBorderBrush}" />
            </Trigger>
            <Trigger Property="Validation.HasError" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                <Setter Property="Background" Value="{DynamicResource DangerSubtleBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource SecondarySurfaceBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TertiaryTextBrush}" />
                <Setter Property="Opacity" Value="{StaticResource DisabledControlOpacity}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="App.Input.PasswordBox.Compact"
           TargetType="{x:Type PasswordBox}"
           BasedOn="{StaticResource App.Input.PasswordBox.Standard}">
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="MinHeight" Value="{StaticResource ControlMinHeightCompact}" />
    </Style>

    <Style x:Key="App.Input.ComboBox.Standard"
           TargetType="{x:Type ComboBox}"
           BasedOn="{StaticResource Provider.ComboBox}">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyUi}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightRegular}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="Background" Value="{DynamicResource PrimarySurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="MinHeight" Value="{StaticResource ControlMinHeightStandard}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource StrongBorderBrush}" />
            </Trigger>
            <Trigger Property="IsDropDownOpen" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource AccentFocusRingBrush}" />
            </Trigger>
            <Trigger Property="Validation.HasError" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                <Setter Property="Background" Value="{DynamicResource DangerSubtleBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource SecondarySurfaceBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TertiaryTextBrush}" />
                <Setter Property="Opacity" Value="{StaticResource DisabledControlOpacity}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="App.Input.ComboBox.Compact"
           TargetType="{x:Type ComboBox}"
           BasedOn="{StaticResource App.Input.ComboBox.Standard}">
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="MinHeight" Value="{StaticResource ControlMinHeightCompact}" />
    </Style>

    <Style x:Key="App.Input.CheckBox.Standard"
           TargetType="{x:Type CheckBox}"
           BasedOn="{StaticResource Provider.CheckBox}">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyUi}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightRegular}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="MinHeight" Value="{StaticResource ControlMinHeightStandard}" />
        <Setter Property="Padding" Value="0,2" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            </Trigger>
            <Trigger Property="Validation.HasError" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource TertiaryTextBrush}" />
                <Setter Property="Opacity" Value="{StaticResource DisabledControlOpacity}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="App.Input.CheckBox.Compact"
           TargetType="{x:Type CheckBox}"
           BasedOn="{StaticResource App.Input.CheckBox.Standard}">
        <Setter Property="MinHeight" Value="{StaticResource ControlMinHeightCompact}" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="App.Input.ToggleSwitch.Standard"
           TargetType="{x:Type ui:ToggleSwitch}"
           BasedOn="{StaticResource Provider.ToggleSwitch}">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyUi}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightRegular}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="Background" Value="{DynamicResource SecondarySurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="MinHeight" Value="{StaticResource ControlMinHeightStandard}" />
        <Setter Property="MinWidth" Value="96" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AccentDefaultBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource StrongBorderBrush}" />
            </Trigger>
            <Trigger Property="Validation.HasError" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource TertiaryTextBrush}" />
                <Setter Property="Opacity" Value="{StaticResource DisabledControlOpacity}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="App.Input.ToggleSwitch.Compact"
           TargetType="{x:Type ui:ToggleSwitch}"
           BasedOn="{StaticResource App.Input.ToggleSwitch.Standard}">
        <Setter Property="MinHeight" Value="{StaticResource ControlMinHeightCompact}" />
        <Setter Property="MinWidth" Value="80" />
    </Style>
</ResourceDictionary>
