<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="PageTitleTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource PageTitleFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    </Style>

    <Style x:Key="WindowTitleTextBlockStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource PageTitleTextBlockStyle}">
        <Setter Property="FontSize" Value="{StaticResource WindowTitleFontSize}" />
    </Style>

    <Style x:Key="SectionTitleTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource SectionTitleFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    </Style>

    <Style x:Key="BodyTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    </Style>

    <Style x:Key="PrimaryTextBlockStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource BodyTextBlockStyle}" />

    <Style x:Key="SecondaryTextBlockStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="FontSize" Value="{StaticResource SecondaryFontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    </Style>

    <Style x:Key="CaptionTextBlockStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource SecondaryTextBlockStyle}">
        <Setter Property="FontSize" Value="{StaticResource CaptionFontSize}" />
    </Style>

    <Style x:Key="StrongTextBlockStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource PrimaryTextBlockStyle}">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="CardTitleTextBlockStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource StrongTextBlockStyle}">
        <Setter Property="FontSize" Value="{StaticResource CardTitleFontSize}" />
    </Style>

    <Style x:Key="FormLabelTextBlockStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource PrimaryTextBlockStyle}">
    </Style>

    <Style x:Key="SettingsNavigationRowTitleTextBlockStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource StrongTextBlockStyle}">
        <Setter Property="FontSize" Value="{StaticResource ItemTitleFontSize}" />
    </Style>

    <Style x:Key="SettingsRowTitleTextBlockStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource StrongTextBlockStyle}">
        <Setter Property="FontSize" Value="{StaticResource ItemTitleFontSize}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SettingsRowDescriptionTextBlockStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource SecondaryTextBlockStyle}">
        <Setter Property="Margin" Value="{StaticResource ControlSpacing}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SettingsRowValueTextBlockStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource PrimaryTextBlockStyle}">
        <Setter Property="Width" Value="{StaticResource SettingsRowControlWidth}" />
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="DialogTitleTextBlockStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="FontSize" Value="{StaticResource DialogTitleFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    </Style>

    <Style x:Key="StatusTextBlockStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="FontSize" Value="{StaticResource CardTitleFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    </Style>

    <Style x:Key="ErrorTextBlockStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

</ResourceDictionary>
