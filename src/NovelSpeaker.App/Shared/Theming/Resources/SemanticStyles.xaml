<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theming="clr-namespace:NovelSpeaker.App.Shared.Theming"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <!--
        资源迁移分组（按语义目标，不表示当前可以机械替换）：

        1. 新样式：当前组件体系使用的 App.Typography.*。
        2. 已有替代、后续完成调用方迁移后可直接删除：旧排版、按钮、列表、
           设置行、卡片/弹层和媒体 Slider 等旧资源。
        3. 需要补充新通用样式：仍缺少稳定语义目标的启动/反馈文本、设置导航、
           媒体进度条、播放速度值按钮和拖放状态等旧资源。

        下面保持现有资源依赖顺序；各资源族前的标记说明其迁移类别。
    -->

    <!-- 2. 已有 App.Typography.PageTitle 替代；页面迁移完成后删除。 -->
    <Style x:Key="PageTitleTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <!-- 1. 新样式：稳定排版变体，供组件和已迁移页面使用。 -->
    <Style x:Key="App.Typography.PageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyUi}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizePageTitle}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightSemiBold}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="App.Typography.SectionTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyUi}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSectionTitle}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightSemiBold}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="App.Typography.ItemTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyUi}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeItemTitle}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightSemiBold}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="App.Typography.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyUi}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightRegular}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="LineHeight" Value="{StaticResource TextLineHeightBody}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="App.Typography.Secondary" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyUi}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSecondary}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightRegular}" />
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        <Setter Property="LineHeight" Value="{StaticResource TextLineHeightSecondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="App.Typography.Caption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyUi}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="FontWeight" Value="{StaticResource FontWeightRegular}" />
        <Setter Property="Foreground" Value="{DynamicResource TertiaryTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- 2. 已有 App.Typography.* 替代；旧页面迁移完成后删除。 -->
    <Style x:Key="SectionTitleTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="PrimaryTextBlockStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="SecondaryTextBlockStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <Style x:Key="StrongTextBlockStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource PrimaryTextBlockStyle}">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="FormLabelTextBlockStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource PrimaryTextBlockStyle}">
    </Style>

    <!-- 3. 需要补充 Settings Navigation 通用组件/样式后迁移。 -->
    <Style x:Key="SettingsNavigationRowTitleTextBlockStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource StrongTextBlockStyle}">
        <Setter Property="FontSize" Value="15" />
    </Style>

    <!-- 3. 需要补充 Settings Navigation 通用组件/样式后迁移。 -->
    <DataTemplate x:Key="SettingsNavigationRowContentTemplate">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:SymbolIcon Margin="0,0,14,0"
                           VerticalAlignment="Center">
                <ui:SymbolIcon.Style>
                    <Style TargetType="ui:SymbolIcon">
                        <Setter Property="Symbol" Value="Info24" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}"
                                         Value="{x:Static theming:SettingsNavigationIcon.Playback}">
                                <Setter Property="Symbol" Value="PlayCircle24" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}"
                                         Value="{x:Static theming:SettingsNavigationIcon.TtsRules}">
                                <Setter Property="Symbol" Value="Speaker124" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}"
                                         Value="{x:Static theming:SettingsNavigationIcon.ImportText}">
                                <Setter Property="Symbol" Value="DocumentText24" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}"
                                         Value="{x:Static theming:SettingsNavigationIcon.ChapterRules}">
                                <Setter Property="Symbol" Value="TextBulletListSquare24" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}"
                                         Value="{x:Static theming:SettingsNavigationIcon.CacheAndData}">
                                <Setter Property="Symbol" Value="Database24" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}"
                                         Value="{x:Static theming:SettingsNavigationIcon.General}">
                                <Setter Property="Symbol" Value="Settings24" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}"
                                         Value="{x:Static theming:SettingsNavigationIcon.Appearance}">
                                <Setter Property="Symbol" Value="DarkTheme24" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}"
                                         Value="{x:Static theming:SettingsNavigationIcon.RegexReplacement}">
                                <Setter Property="Symbol" Value="DocumentText24" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}"
                                         Value="{x:Static theming:SettingsNavigationIcon.CacheManagement}">
                                <Setter Property="Symbol" Value="Database24" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ui:SymbolIcon.Style>
            </ui:SymbolIcon>
            <TextBlock Grid.Column="1"
                       VerticalAlignment="Center"
                       Style="{StaticResource SettingsNavigationRowTitleTextBlockStyle}"
                       Text="{Binding}" />
            <ui:SymbolIcon Grid.Column="2"
                           Margin="16,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Symbol="ChevronRight24" />
        </Grid>
    </DataTemplate>

    <!-- 3. 需要补充 Settings 分组表面通用样式后迁移。 -->
    <Style x:Key="SettingsGroupBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource SettingsGroupPadding}" />
    </Style>

    <Style x:Key="SettingsRowsGroupBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
    </Style>

    <!-- 2. 已有 App.Component.SettingsRow 替代；设置页迁移完成后删除。 -->
    <Style x:Key="SettingsRowBorderStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="MinHeight" Value="{StaticResource SettingsRowMinHeight}" />
        <Setter Property="Padding" Value="{StaticResource SettingsRowPadding}" />
    </Style>

    <Style x:Key="SettingsLastRowBorderStyle"
           TargetType="Border"
           BasedOn="{StaticResource SettingsRowBorderStyle}">
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style x:Key="SettingsRowTitleTextBlockStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource StrongTextBlockStyle}">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SettingsRowDescriptionTextBlockStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource SecondaryTextBlockStyle}">
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SettingsRowValueTextBlockStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource PrimaryTextBlockStyle}">
        <Setter Property="Width" Value="{StaticResource SettingsRowControlWidth}" />
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 3. 需要补充通用 Dialog/Status/Error 文本样式或组件后迁移。 -->
    <Style x:Key="DialogTitleTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="StatusTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="ErrorTextBlockStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- 2. 已有 App.Component.* / App.Feedback.* 语义替代；页面结构迁移完成后删除。 -->
    <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
    </Style>

    <Style x:Key="PopupSurfaceBorderStyle"
           TargetType="Border"
           BasedOn="{StaticResource CardBorderStyle}">
        <!-- Keep transient panels fully opaque so their content remains legible over page content. -->
        <Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorBaseBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
    </Style>

    <!-- 3. 需要补充媒体进度条通用样式；不能复用任务反馈 ProgressBar。 -->
    <Style x:Key="PlaybackProgressBarStyle"
           TargetType="ProgressBar"
           BasedOn="{StaticResource {x:Type ProgressBar}}">
        <Setter Property="Height" Value="4" />
        <Setter Property="Foreground" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        <Setter Property="Background" Value="{DynamicResource LayerFillColorAltBrush}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- 2. 已有 App.Media.Slider 替代；播放器调用方迁移完成后删除。 -->
    <Style x:Key="PlaybackSliderTrackButtonStyle" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Height="4"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            CornerRadius="999" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 2. 上述媒体 Slider 的旧内部实现，随旧 Slider 样式一并删除。 -->
    <Style x:Key="PlaybackSliderThumbStyle" TargetType="Thumb">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="{DynamicResource AccentFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderThickness="2"
                            CornerRadius="999" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 2. 旧播放进度 Slider，已有 App.Media.Slider 语义替代。 -->
    <Style x:Key="PlaybackProgressSliderStyle"
           TargetType="Slider"
           BasedOn="{StaticResource Provider.Slider}">
        <Setter Property="Height" Value="20" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Height="{TemplateBinding Height}">
                        <Track x:Name="PART_Track"
                               Minimum="{TemplateBinding Minimum}"
                               Maximum="{TemplateBinding Maximum}"
                               Value="{TemplateBinding Value}"
                               Orientation="{TemplateBinding Orientation}"
                               IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge"
                                              Style="{StaticResource PlaybackSliderTrackButtonStyle}" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource PlaybackSliderThumbStyle}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge"
                                              Style="{StaticResource PlaybackSliderTrackButtonStyle}" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 2. 已有 App.Button.Icon 替代；旧页面迁移完成后删除模板覆盖。 -->
    <ControlTemplate x:Key="IconButtonControlTemplate" TargetType="Button">
        <Grid x:Name="RootGrid"
              Background="Transparent"
              SnapsToDevicePixels="True">
            <Border x:Name="StateLayer"
                    Background="{TemplateBinding Background}"
                    CornerRadius="{StaticResource IconButtonCornerRadius}" />
            <ContentPresenter Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              Content="{TemplateBinding Content}"
                              ContentStringFormat="{TemplateBinding ContentStringFormat}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              RecognizesAccessKey="True"
                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="StateLayer"
                        Property="Background"
                        Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="StateLayer"
                        Property="Background"
                        Value="{DynamicResource ControlFillColorTertiaryBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="RootGrid"
                        Property="Opacity"
                        Value="{StaticResource DisabledControlOpacity}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- 2. 已有 App.Button.Icon 替代；媒体控件迁移完成后删除。 -->
    <ControlTemplate x:Key="MediaIconButtonControlTemplate" TargetType="Button">
        <Grid x:Name="RootGrid"
              Background="Transparent"
              SnapsToDevicePixels="True">
            <Border x:Name="StateLayer"
                    Background="{TemplateBinding Background}"
                    CornerRadius="{StaticResource MediaControlCornerRadius}" />
            <ContentPresenter Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              Content="{TemplateBinding Content}"
                              ContentStringFormat="{TemplateBinding ContentStringFormat}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              RecognizesAccessKey="True"
                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="StateLayer"
                        Property="Background"
                        Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="StateLayer"
                        Property="Background"
                        Value="{DynamicResource ControlFillColorTertiaryBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="RootGrid"
                        Property="Opacity"
                        Value="{StaticResource DisabledControlOpacity}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- 2. 已有 App.Component.ListRow / SelectableRow / RuleListItem 替代。 -->
    <ControlTemplate x:Key="BorderlessListItemButtonControlTemplate" TargetType="Button">
        <Grid x:Name="RootGrid"
              Background="Transparent"
              SnapsToDevicePixels="True">
            <Border x:Name="StateLayer"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{StaticResource InteractiveSurfaceCornerRadius}">
                <ContentPresenter Margin="{TemplateBinding Padding}"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                  Content="{TemplateBinding Content}"
                                  ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  RecognizesAccessKey="True"
                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
            </Border>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="StateLayer"
                        Property="Background"
                        Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="StateLayer"
                        Property="Background"
                        Value="{DynamicResource ControlFillColorTertiaryBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="RootGrid"
                        Property="Opacity"
                        Value="{StaticResource DisabledControlOpacity}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- 2. 已有 App.Button.Icon 及其页面局部尺寸/对齐替代。 -->
    <Style x:Key="BorderlessIconButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource Provider.Button}">
        <Setter Property="Width" Value="{StaticResource IconButtonSize}" />
        <Setter Property="Height" Value="{StaticResource IconButtonSize}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template" Value="{StaticResource IconButtonControlTemplate}" />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
    </Style>

    <Style x:Key="BackIconButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource BorderlessIconButtonStyle}">
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style x:Key="SecondaryIconButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource BorderlessIconButtonStyle}">
        <Setter Property="Width" Value="{StaticResource SecondaryIconButtonSize}" />
        <Setter Property="Height" Value="{StaticResource SecondaryIconButtonSize}" />
    </Style>

    <!-- 2. 已有 App.Component.ListRow / SelectableRow / RuleListItem 替代。 -->
    <Style x:Key="BorderlessListItemButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource Provider.Button}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template" Value="{StaticResource BorderlessListItemButtonControlTemplate}" />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
    </Style>

    <!-- 3. 需要补充 Settings Navigation 通用组件/样式后迁移。 -->
    <Style x:Key="SettingsNavigationRowButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource BorderlessListItemButtonStyle}">
        <Setter Property="MinHeight" Value="{StaticResource SettingsRowMinHeight}" />
        <Setter Property="Padding" Value="{StaticResource SettingsRowPadding}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="ContentTemplate" Value="{StaticResource SettingsNavigationRowContentTemplate}" />
    </Style>

    <!-- 2. 已有 App.Component.SelectableRow / ListRow 状态替代。 -->
    <Style x:Key="SelectedCardContainerStyle"
           TargetType="Border"
           BasedOn="{StaticResource CardBorderStyle}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="0,0,0,2" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SelectableListItemContainerStyle"
           TargetType="Border"
           BasedOn="{StaticResource SelectedCardContainerStyle}">
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                <Setter Property="Opacity" Value="0.5" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SelectableCardListItemContainerStyle"
           TargetType="Border"
           BasedOn="{StaticResource SelectableListItemContainerStyle}">
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="CurrentListItemContainerStyle" TargetType="Border">
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="0,0,0,2" />
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsCurrent}" Value="True" />
                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="Transparent" />
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <!-- 3. 需要补充 RuleListItem 的 DropTarget 通用状态后迁移。 -->
    <Style x:Key="DropTargetListItemContainerStyle"
           TargetType="Border"
           BasedOn="{StaticResource SelectableCardListItemContainerStyle}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                <Setter Property="BorderBrush" Value="{x:Static SystemColors.HighlightBrush}" />
                <Setter Property="Background" Value="{x:Static SystemColors.HighlightBrush}" />
                <Setter Property="BorderThickness" Value="0,0,0,2" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- 3. 需要补充播放速度值/胶囊按钮通用样式后迁移。 -->
    <Style x:Key="PlaybackSpeedPillButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource Provider.Button}">
        <Setter Property="Height" Value="44" />
        <Setter Property="MinWidth" Value="80" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style x:Key="ToolbarValueButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource PlaybackSpeedPillButtonStyle}" />

    <!-- 2. 已有 App.Button.Icon 替代；播放器调用方迁移完成后删除。 -->
    <Style x:Key="MediaIconButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource BorderlessIconButtonStyle}">
        <Setter Property="Width" Value="{StaticResource MediaControlButtonSize}" />
        <Setter Property="Height" Value="{StaticResource MediaControlButtonSize}" />
        <Setter Property="Template" Value="{StaticResource MediaIconButtonControlTemplate}" />
    </Style>

    <Style x:Key="PrimaryPlaybackIconButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource MediaIconButtonStyle}">
        <Setter Property="Width" Value="{StaticResource PrimaryMediaControlButtonSize}" />
        <Setter Property="Height" Value="{StaticResource PrimaryMediaControlButtonSize}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="FloatingIconButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource BorderlessIconButtonStyle}">
        <Setter Property="Width" Value="{StaticResource SecondaryIconButtonSize}" />
        <Setter Property="Height" Value="{StaticResource SecondaryIconButtonSize}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
</ResourceDictionary>
