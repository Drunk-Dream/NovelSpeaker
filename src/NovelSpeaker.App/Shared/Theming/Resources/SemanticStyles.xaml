<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theming="clr-namespace:NovelSpeaker.App.Shared.Theming"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Style x:Key="PageTitleTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource PageTitleFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    </Style>

    <Style x:Key="WindowTitleTextBlockStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource PageTitleTextBlockStyle}">
        <Setter Property="FontSize" Value="{StaticResource WindowTitleFontSize}" />
    </Style>

    <Style x:Key="SectionTitleTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource SectionTitleFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    </Style>

    <Style x:Key="BodyTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    </Style>

    <Style x:Key="PrimaryTextBlockStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource BodyTextBlockStyle}" />

    <Style x:Key="SecondaryTextBlockStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="FontSize" Value="{StaticResource SecondaryFontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    </Style>

    <Style x:Key="CaptionTextBlockStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource SecondaryTextBlockStyle}">
        <Setter Property="FontSize" Value="{StaticResource CaptionFontSize}" />
    </Style>

    <Style x:Key="StrongTextBlockStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource PrimaryTextBlockStyle}">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="CardTitleTextBlockStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource StrongTextBlockStyle}">
        <Setter Property="FontSize" Value="{StaticResource CardTitleFontSize}" />
    </Style>

    <Style x:Key="FormLabelTextBlockStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource PrimaryTextBlockStyle}">
    </Style>

    <Style x:Key="SettingsNavigationRowTitleTextBlockStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource StrongTextBlockStyle}">
        <Setter Property="FontSize" Value="{StaticResource ItemTitleFontSize}" />
    </Style>

    <DataTemplate x:Key="SettingsNavigationRowContentTemplate">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:SymbolIcon Margin="0,0,8,0"
                           VerticalAlignment="Center">
                <ui:SymbolIcon.Style>
                    <Style TargetType="ui:SymbolIcon">
                        <Setter Property="Symbol" Value="Info24" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}"
                                         Value="{x:Static theming:SettingsNavigationIcon.Playback}">
                                <Setter Property="Symbol" Value="PlayCircle24" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}"
                                         Value="{x:Static theming:SettingsNavigationIcon.TtsRules}">
                                <Setter Property="Symbol" Value="Speaker124" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}"
                                         Value="{x:Static theming:SettingsNavigationIcon.ImportText}">
                                <Setter Property="Symbol" Value="DocumentText24" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}"
                                         Value="{x:Static theming:SettingsNavigationIcon.ChapterRules}">
                                <Setter Property="Symbol" Value="TextBulletListSquare24" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}"
                                         Value="{x:Static theming:SettingsNavigationIcon.CacheAndData}">
                                <Setter Property="Symbol" Value="Database24" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}"
                                         Value="{x:Static theming:SettingsNavigationIcon.General}">
                                <Setter Property="Symbol" Value="Settings24" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}"
                                         Value="{x:Static theming:SettingsNavigationIcon.Appearance}">
                                <Setter Property="Symbol" Value="DarkTheme24" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}"
                                         Value="{x:Static theming:SettingsNavigationIcon.RegexReplacement}">
                                <Setter Property="Symbol" Value="DocumentText24" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}"
                                         Value="{x:Static theming:SettingsNavigationIcon.CacheManagement}">
                                <Setter Property="Symbol" Value="Database24" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ui:SymbolIcon.Style>
            </ui:SymbolIcon>
            <TextBlock Grid.Column="1"
                       VerticalAlignment="Center"
                       Style="{StaticResource SettingsNavigationRowTitleTextBlockStyle}"
                       Text="{Binding}" />
            <ui:SymbolIcon Grid.Column="2"
                           Margin="{StaticResource TrailingIconMargin}"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Symbol="ChevronRight24" />
        </Grid>
    </DataTemplate>

    <Style x:Key="SettingsGroupBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PrimarySurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource StandardBorderThickness}" />
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource SettingsGroupPadding}" />
    </Style>

    <Style x:Key="SettingsRowsGroupBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PrimarySurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource StandardBorderThickness}" />
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
    </Style>

    <Style x:Key="SettingsRowBorderStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource SeparatorBorderThickness}" />
        <Setter Property="MinHeight" Value="{StaticResource SettingsRowMinHeight}" />
        <Setter Property="Padding" Value="{StaticResource SettingsRowPadding}" />
    </Style>

    <Style x:Key="SettingsLastRowBorderStyle"
           TargetType="Border"
           BasedOn="{StaticResource SettingsRowBorderStyle}">
        <Setter Property="BorderThickness" Value="{StaticResource NoBorderThickness}" />
    </Style>

    <Style x:Key="SettingsRowTitleTextBlockStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource StrongTextBlockStyle}">
        <Setter Property="FontSize" Value="{StaticResource ItemTitleFontSize}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SettingsRowDescriptionTextBlockStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource SecondaryTextBlockStyle}">
        <Setter Property="Margin" Value="{StaticResource ControlSpacing}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SettingsRowValueTextBlockStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource PrimaryTextBlockStyle}">
        <Setter Property="Width" Value="{StaticResource SettingsRowControlWidth}" />
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="DialogTitleTextBlockStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="FontSize" Value="{StaticResource DialogTitleFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    </Style>

    <Style x:Key="StatusTextBlockStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="FontSize" Value="{StaticResource CardTitleFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    </Style>

    <Style x:Key="ErrorTextBlockStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PrimarySurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource StandardBorderThickness}" />
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
    </Style>

    <Style x:Key="PopupSurfaceBorderStyle"
           TargetType="Border"
           BasedOn="{StaticResource CardBorderStyle}">
        <!-- Keep transient panels fully opaque so their content remains legible over page content. -->
        <Setter Property="Background" Value="{DynamicResource RaisedSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource DialogCornerRadius}" />
    </Style>

    <Style x:Key="PlaybackProgressBarStyle"
           TargetType="ProgressBar"
           BasedOn="{StaticResource {x:Type ProgressBar}}">
        <Setter Property="Height" Value="{StaticResource ProgressTrackHeight}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Background" Value="{DynamicResource SecondarySurfaceBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource NoBorderThickness}" />
    </Style>

    <Style x:Key="PlaybackSliderTrackButtonStyle" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Height="{StaticResource ProgressTrackHeight}"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            CornerRadius="{StaticResource PillCornerRadius}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PlaybackSliderThumbStyle" TargetType="Thumb">
        <Setter Property="Width" Value="{StaticResource ProgressThumbSize}" />
        <Setter Property="Height" Value="{StaticResource ProgressThumbSize}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="{DynamicResource AccentBrush}"
                            BorderBrush="{DynamicResource PrimarySurfaceBrush}"
                            BorderThickness="{StaticResource ProgressThumbBorderThickness}"
                            CornerRadius="{StaticResource PillCornerRadius}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PlaybackProgressSliderStyle"
           TargetType="Slider"
           BasedOn="{StaticResource {x:Type Slider}}">
        <Setter Property="Height" Value="{StaticResource ProgressSliderHeight}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Height="{TemplateBinding Height}">
                        <Track x:Name="PART_Track"
                               Minimum="{TemplateBinding Minimum}"
                               Maximum="{TemplateBinding Maximum}"
                               Value="{TemplateBinding Value}"
                               Orientation="{TemplateBinding Orientation}"
                               IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge"
                                              Style="{StaticResource PlaybackSliderTrackButtonStyle}" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource PlaybackSliderThumbStyle}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge"
                                              Style="{StaticResource PlaybackSliderTrackButtonStyle}" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SettingsNavigationRowButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource BorderlessListItemButtonStyle}">
        <Setter Property="MinHeight" Value="{StaticResource SettingsRowMinHeight}" />
        <Setter Property="Padding" Value="{StaticResource SettingsRowPadding}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="ContentTemplate" Value="{StaticResource SettingsNavigationRowContentTemplate}" />
    </Style>

    <Style x:Key="SelectedCardContainerStyle"
           TargetType="Border"
           BasedOn="{StaticResource CardBorderStyle}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter Property="Background" Value="{DynamicResource SecondarySurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                <Setter Property="BorderThickness" Value="{StaticResource SelectedIndicatorThickness}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SelectableListItemContainerStyle"
           TargetType="Border"
           BasedOn="{StaticResource SelectedCardContainerStyle}">
        <Setter Property="Margin" Value="{StaticResource ListRowSpacing}" />
        <Setter Property="Padding" Value="{StaticResource ListRowPadding}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="{StaticResource NoBorderThickness}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                <Setter Property="Opacity" Value="0.5" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SelectableCardListItemContainerStyle"
           TargetType="Border"
           BasedOn="{StaticResource SelectableListItemContainerStyle}">
        <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource StandardBorderThickness}" />
    </Style>

    <Style x:Key="CurrentListItemContainerStyle" TargetType="Border">
        <Setter Property="Margin" Value="{StaticResource ListRowSpacing}" />
        <Setter Property="Padding" Value="{StaticResource ListRowPadding}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="{StaticResource NoBorderThickness}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                <Setter Property="Background" Value="{DynamicResource SecondarySurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                <Setter Property="BorderThickness" Value="{StaticResource SelectedIndicatorThickness}" />
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsCurrent}" Value="True" />
                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="Transparent" />
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DropTargetListItemContainerStyle"
           TargetType="Border"
           BasedOn="{StaticResource SelectableCardListItemContainerStyle}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                <Setter Property="BorderThickness" Value="{StaticResource SelectedIndicatorThickness}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
