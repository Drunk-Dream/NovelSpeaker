<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theming="clr-namespace:NovelSpeaker.App.Shared.Theming"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Style x:Key="PageTitleTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    </Style>

    <Style x:Key="SectionTitleTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    </Style>

    <Style x:Key="PrimaryTextBlockStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    </Style>

    <Style x:Key="SecondaryTextBlockStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    </Style>

    <Style x:Key="StrongTextBlockStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource PrimaryTextBlockStyle}">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="FormLabelTextBlockStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource PrimaryTextBlockStyle}">
    </Style>

    <Style x:Key="SettingsNavigationRowTitleTextBlockStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource StrongTextBlockStyle}">
        <Setter Property="FontSize" Value="15" />
    </Style>

    <DataTemplate x:Key="SettingsNavigationRowContentTemplate">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:SymbolIcon Margin="0,0,14,0"
                           VerticalAlignment="Center">
                <ui:SymbolIcon.Style>
                    <Style TargetType="ui:SymbolIcon">
                        <Setter Property="Symbol" Value="Info24" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}"
                                         Value="{x:Static theming:SettingsNavigationIcon.Playback}">
                                <Setter Property="Symbol" Value="PlayCircle24" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}"
                                         Value="{x:Static theming:SettingsNavigationIcon.TtsRules}">
                                <Setter Property="Symbol" Value="Speaker124" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}"
                                         Value="{x:Static theming:SettingsNavigationIcon.ImportText}">
                                <Setter Property="Symbol" Value="DocumentText24" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}"
                                         Value="{x:Static theming:SettingsNavigationIcon.ChapterRules}">
                                <Setter Property="Symbol" Value="TextBulletListSquare24" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}"
                                         Value="{x:Static theming:SettingsNavigationIcon.CacheAndData}">
                                <Setter Property="Symbol" Value="Database24" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}"
                                         Value="{x:Static theming:SettingsNavigationIcon.General}">
                                <Setter Property="Symbol" Value="Settings24" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}"
                                         Value="{x:Static theming:SettingsNavigationIcon.Appearance}">
                                <Setter Property="Symbol" Value="DarkTheme24" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}"
                                         Value="{x:Static theming:SettingsNavigationIcon.RegexReplacement}">
                                <Setter Property="Symbol" Value="DocumentText24" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}"
                                         Value="{x:Static theming:SettingsNavigationIcon.CacheManagement}">
                                <Setter Property="Symbol" Value="Database24" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ui:SymbolIcon.Style>
            </ui:SymbolIcon>
            <TextBlock Grid.Column="1"
                       VerticalAlignment="Center"
                       Style="{StaticResource SettingsNavigationRowTitleTextBlockStyle}"
                       Text="{Binding}" />
            <ui:SymbolIcon Grid.Column="2"
                           Margin="16,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Symbol="ChevronRight24" />
        </Grid>
    </DataTemplate>

    <Style x:Key="SettingsGroupBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PrimarySurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource SettingsGroupPadding}" />
    </Style>

    <Style x:Key="SettingsRowsGroupBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PrimarySurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
    </Style>

    <Style x:Key="SettingsRowBorderStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="MinHeight" Value="{StaticResource SettingsRowMinHeight}" />
        <Setter Property="Padding" Value="{StaticResource SettingsRowPadding}" />
    </Style>

    <Style x:Key="SettingsLastRowBorderStyle"
           TargetType="Border"
           BasedOn="{StaticResource SettingsRowBorderStyle}">
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style x:Key="SettingsRowTitleTextBlockStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource StrongTextBlockStyle}">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SettingsRowDescriptionTextBlockStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource SecondaryTextBlockStyle}">
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SettingsRowValueTextBlockStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource PrimaryTextBlockStyle}">
        <Setter Property="Width" Value="{StaticResource SettingsRowControlWidth}" />
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="DialogTitleTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    </Style>

    <Style x:Key="StatusTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    </Style>

    <Style x:Key="ErrorTextBlockStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PrimarySurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
    </Style>

    <Style x:Key="PopupSurfaceBorderStyle"
           TargetType="Border"
           BasedOn="{StaticResource CardBorderStyle}">
        <!-- Keep transient panels fully opaque so their content remains legible over page content. -->
        <Setter Property="Background" Value="{DynamicResource RaisedSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
    </Style>

    <Style x:Key="PlaybackProgressBarStyle"
           TargetType="ProgressBar"
           BasedOn="{StaticResource {x:Type ProgressBar}}">
        <Setter Property="Height" Value="4" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Background" Value="{DynamicResource SecondarySurfaceBrush}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style x:Key="PlaybackSliderTrackButtonStyle" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Height="4"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            CornerRadius="999" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PlaybackSliderThumbStyle" TargetType="Thumb">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="{DynamicResource AccentBrush}"
                            BorderBrush="{DynamicResource PrimarySurfaceBrush}"
                            BorderThickness="2"
                            CornerRadius="999" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PlaybackProgressSliderStyle"
           TargetType="Slider"
           BasedOn="{StaticResource {x:Type Slider}}">
        <Setter Property="Height" Value="20" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Height="{TemplateBinding Height}">
                        <Track x:Name="PART_Track"
                               Minimum="{TemplateBinding Minimum}"
                               Maximum="{TemplateBinding Maximum}"
                               Value="{TemplateBinding Value}"
                               Orientation="{TemplateBinding Orientation}"
                               IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge"
                                              Style="{StaticResource PlaybackSliderTrackButtonStyle}" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource PlaybackSliderThumbStyle}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge"
                                              Style="{StaticResource PlaybackSliderTrackButtonStyle}" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="IconButtonControlTemplate" TargetType="Button">
        <Grid x:Name="RootGrid"
              Background="Transparent"
              SnapsToDevicePixels="True">
            <Border x:Name="StateLayer"
                    Background="{TemplateBinding Background}"
                    CornerRadius="{StaticResource IconButtonCornerRadius}" />
            <ContentPresenter Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              Content="{TemplateBinding Content}"
                              ContentStringFormat="{TemplateBinding ContentStringFormat}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              RecognizesAccessKey="True"
                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
            <Border x:Name="KeyboardFocusRing"
                    BorderBrush="{DynamicResource AccentFocusRingBrush}"
                    BorderThickness="{StaticResource KeyboardFocusRingThickness}"
                    CornerRadius="{StaticResource IconButtonCornerRadius}"
                    IsHitTestVisible="False"
                    Visibility="Collapsed" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="StateLayer"
                        Property="Background"
                        Value="{DynamicResource SecondarySurfaceBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="StateLayer"
                        Property="Background"
                        Value="{DynamicResource RaisedSurfaceBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="KeyboardFocusRing" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="RootGrid"
                        Property="Opacity"
                        Value="{StaticResource DisabledControlOpacity}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="MediaIconButtonControlTemplate" TargetType="Button">
        <Grid x:Name="RootGrid"
              Background="Transparent"
              SnapsToDevicePixels="True">
            <Border x:Name="StateLayer"
                    Background="{TemplateBinding Background}"
                    CornerRadius="{StaticResource MediaControlCornerRadius}" />
            <ContentPresenter Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              Content="{TemplateBinding Content}"
                              ContentStringFormat="{TemplateBinding ContentStringFormat}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              RecognizesAccessKey="True"
                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
            <Border x:Name="KeyboardFocusRing"
                    BorderBrush="{DynamicResource AccentFocusRingBrush}"
                    BorderThickness="{StaticResource KeyboardFocusRingThickness}"
                    CornerRadius="{StaticResource MediaControlCornerRadius}"
                    IsHitTestVisible="False"
                    Visibility="Collapsed" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="StateLayer"
                        Property="Background"
                        Value="{DynamicResource SecondarySurfaceBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="StateLayer"
                        Property="Background"
                        Value="{DynamicResource RaisedSurfaceBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="KeyboardFocusRing" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="RootGrid"
                        Property="Opacity"
                        Value="{StaticResource DisabledControlOpacity}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="BorderlessListItemButtonControlTemplate" TargetType="Button">
        <Grid x:Name="RootGrid"
              Background="Transparent"
              SnapsToDevicePixels="True">
            <Border x:Name="StateLayer"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{StaticResource InteractiveSurfaceCornerRadius}">
                <ContentPresenter Margin="{TemplateBinding Padding}"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                  Content="{TemplateBinding Content}"
                                  ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  RecognizesAccessKey="True"
                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
            </Border>
            <Border x:Name="KeyboardFocusRing"
                    BorderBrush="{DynamicResource AccentFocusRingBrush}"
                    BorderThickness="{StaticResource KeyboardFocusRingThickness}"
                    CornerRadius="{StaticResource InteractiveSurfaceCornerRadius}"
                    IsHitTestVisible="False"
                    Visibility="Collapsed" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="StateLayer"
                        Property="Background"
                        Value="{DynamicResource SecondarySurfaceBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="StateLayer"
                        Property="Background"
                        Value="{DynamicResource RaisedSurfaceBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="KeyboardFocusRing" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="RootGrid"
                        Property="Opacity"
                        Value="{StaticResource DisabledControlOpacity}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="BorderlessIconButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Width" Value="{StaticResource IconButtonSize}" />
        <Setter Property="Height" Value="{StaticResource IconButtonSize}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template" Value="{StaticResource IconButtonControlTemplate}" />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
    </Style>

    <Style x:Key="BackIconButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource BorderlessIconButtonStyle}">
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style x:Key="SecondaryIconButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource BorderlessIconButtonStyle}">
        <Setter Property="Width" Value="{StaticResource SecondaryIconButtonSize}" />
        <Setter Property="Height" Value="{StaticResource SecondaryIconButtonSize}" />
    </Style>

    <Style x:Key="BorderlessListItemButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template" Value="{StaticResource BorderlessListItemButtonControlTemplate}" />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
    </Style>

    <Style x:Key="SettingsNavigationRowButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource BorderlessListItemButtonStyle}">
        <Setter Property="MinHeight" Value="{StaticResource SettingsRowMinHeight}" />
        <Setter Property="Padding" Value="{StaticResource SettingsRowPadding}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="ContentTemplate" Value="{StaticResource SettingsNavigationRowContentTemplate}" />
    </Style>

    <Style x:Key="SelectedCardContainerStyle"
           TargetType="Border"
           BasedOn="{StaticResource CardBorderStyle}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter Property="Background" Value="{DynamicResource SecondarySurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                <Setter Property="BorderThickness" Value="0,0,0,2" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SelectableListItemContainerStyle"
           TargetType="Border"
           BasedOn="{StaticResource SelectedCardContainerStyle}">
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                <Setter Property="Opacity" Value="0.5" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SelectableCardListItemContainerStyle"
           TargetType="Border"
           BasedOn="{StaticResource SelectableListItemContainerStyle}">
        <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="CurrentListItemContainerStyle" TargetType="Border">
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                <Setter Property="Background" Value="{DynamicResource SecondarySurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                <Setter Property="BorderThickness" Value="0,0,0,2" />
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsCurrent}" Value="True" />
                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="Transparent" />
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DropTargetListItemContainerStyle"
           TargetType="Border"
           BasedOn="{StaticResource SelectableCardListItemContainerStyle}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                <Setter Property="BorderThickness" Value="0,0,0,2" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PlaybackSpeedPillButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Height" Value="44" />
        <Setter Property="MinWidth" Value="80" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style x:Key="ToolbarValueButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource PlaybackSpeedPillButtonStyle}" />

    <Style x:Key="MediaIconButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource BorderlessIconButtonStyle}">
        <Setter Property="Width" Value="{StaticResource MediaControlButtonSize}" />
        <Setter Property="Height" Value="{StaticResource MediaControlButtonSize}" />
        <Setter Property="Template" Value="{StaticResource MediaIconButtonControlTemplate}" />
    </Style>

    <Style x:Key="PrimaryPlaybackIconButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource MediaIconButtonStyle}">
        <Setter Property="Width" Value="{StaticResource PrimaryMediaControlButtonSize}" />
        <Setter Property="Height" Value="{StaticResource PrimaryMediaControlButtonSize}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="FloatingIconButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource BorderlessIconButtonStyle}">
        <Setter Property="Width" Value="{StaticResource SecondaryIconButtonSize}" />
        <Setter Property="Height" Value="{StaticResource SecondaryIconButtonSize}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
</ResourceDictionary>
