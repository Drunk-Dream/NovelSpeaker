<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theming="clr-namespace:NovelSpeaker.App.Shared.Theming"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ControlTemplate x:Key="ButtonControlTemplate" TargetType="Button">
        <Grid x:Name="RootGrid"
              Background="Transparent"
              SnapsToDevicePixels="True">
            <Border x:Name="StateLayer"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{StaticResource SmallControlCornerRadius}">
                <ContentPresenter Margin="{TemplateBinding Padding}"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                  Content="{TemplateBinding Content}"
                                  ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  RecognizesAccessKey="True"
                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
            </Border>
            <Border x:Name="KeyboardFocusRing"
                    BorderBrush="{DynamicResource AccentFocusRingBrush}"
                    BorderThickness="{StaticResource KeyboardFocusRingThickness}"
                    CornerRadius="{StaticResource SmallControlCornerRadius}"
                    IsHitTestVisible="False"
                    Visibility="Collapsed" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="StateLayer"
                        Property="Background"
                        Value="{DynamicResource SecondarySurfaceBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="StateLayer"
                        Property="Background"
                        Value="{DynamicResource RaisedSurfaceBrush}" />
            </Trigger>
            <Trigger Property="Selector.IsSelected" Value="True">
                <Setter TargetName="StateLayer"
                        Property="Background"
                        Value="{DynamicResource AccentSubtleBrush}" />
                <Setter TargetName="StateLayer"
                        Property="BorderBrush"
                        Value="{DynamicResource AccentBrush}" />
            </Trigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}"
                               Value="True" />
                    <Condition Binding="{Binding (theming:SemanticButtonState.IsAccent), RelativeSource={RelativeSource TemplatedParent}}"
                               Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="StateLayer"
                        Property="Background"
                        Value="{DynamicResource AccentHoverBrush}" />
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource TemplatedParent}}"
                               Value="True" />
                    <Condition Binding="{Binding (theming:SemanticButtonState.IsAccent), RelativeSource={RelativeSource TemplatedParent}}"
                               Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="StateLayer"
                        Property="Background"
                        Value="{DynamicResource AccentPressedBrush}" />
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}"
                               Value="True" />
                    <Condition Binding="{Binding (theming:SemanticButtonState.IsDanger), RelativeSource={RelativeSource TemplatedParent}}"
                               Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="StateLayer"
                        Property="Background"
                        Value="{DynamicResource DangerSubtleBrush}" />
            </MultiDataTrigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="KeyboardFocusRing" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="RootGrid"
                        Property="Opacity"
                        Value="{StaticResource DisabledControlOpacity}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="IconButtonControlTemplate" TargetType="Button">
        <Grid x:Name="RootGrid"
              Background="Transparent"
              SnapsToDevicePixels="True">
            <Border x:Name="StateLayer"
                    Background="{TemplateBinding Background}"
                    CornerRadius="{StaticResource IconButtonCornerRadius}" />
            <ContentPresenter Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              Content="{TemplateBinding Content}"
                              ContentStringFormat="{TemplateBinding ContentStringFormat}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              RecognizesAccessKey="True"
                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
            <Border x:Name="KeyboardFocusRing"
                    BorderBrush="{DynamicResource AccentFocusRingBrush}"
                    BorderThickness="{StaticResource KeyboardFocusRingThickness}"
                    CornerRadius="{StaticResource IconButtonCornerRadius}"
                    IsHitTestVisible="False"
                    Visibility="Collapsed" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="StateLayer"
                        Property="Background"
                        Value="{DynamicResource SecondarySurfaceBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="StateLayer"
                        Property="Background"
                        Value="{DynamicResource RaisedSurfaceBrush}" />
            </Trigger>
            <Trigger Property="Selector.IsSelected" Value="True">
                <Setter TargetName="StateLayer"
                        Property="Background"
                        Value="{DynamicResource AccentSubtleBrush}" />
            </Trigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}"
                               Value="True" />
                    <Condition Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                               Value="WindowClose" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="StateLayer"
                        Property="Background"
                        Value="{DynamicResource DangerSubtleBrush}" />
            </MultiDataTrigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="KeyboardFocusRing" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="RootGrid"
                        Property="Opacity"
                        Value="{StaticResource DisabledControlOpacity}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="BorderlessListItemButtonControlTemplate" TargetType="Button">
        <Grid x:Name="RootGrid"
              Background="Transparent"
              SnapsToDevicePixels="True">
            <Border x:Name="StateLayer"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{StaticResource InteractiveSurfaceCornerRadius}">
                <ContentPresenter Margin="{TemplateBinding Padding}"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                  Content="{TemplateBinding Content}"
                                  ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  RecognizesAccessKey="True"
                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
            </Border>
            <Border x:Name="KeyboardFocusRing"
                    BorderBrush="{DynamicResource AccentFocusRingBrush}"
                    BorderThickness="{StaticResource KeyboardFocusRingThickness}"
                    CornerRadius="{StaticResource InteractiveSurfaceCornerRadius}"
                    IsHitTestVisible="False"
                    Visibility="Collapsed" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="StateLayer"
                        Property="Background"
                        Value="{DynamicResource SecondarySurfaceBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="StateLayer"
                        Property="Background"
                        Value="{DynamicResource RaisedSurfaceBrush}" />
            </Trigger>
            <Trigger Property="Selector.IsSelected" Value="True">
                <Setter TargetName="StateLayer"
                        Property="Background"
                        Value="{DynamicResource AccentSubtleBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="KeyboardFocusRing" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="RootGrid"
                        Property="Opacity"
                        Value="{StaticResource DisabledControlOpacity}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="MinHeight" Value="{StaticResource TextControlHeight}" />
        <Setter Property="Padding" Value="{StaticResource ButtonPadding}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource StandardBorderThickness}" />
        <Setter Property="theming:SemanticButtonState.IsAccent" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template" Value="{StaticResource ButtonControlTemplate}" />
    </Style>

    <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="MinHeight" Value="{StaticResource TextControlHeight}" />
        <Setter Property="Padding" Value="{StaticResource SecondaryActionPadding}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource PrimarySurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource StandardBorderThickness}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template" Value="{StaticResource ButtonControlTemplate}" />
    </Style>

    <Style x:Key="SubtleButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="MinHeight" Value="{StaticResource TextControlHeight}" />
        <Setter Property="Padding" Value="{StaticResource CompactButtonPadding}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="{StaticResource NoBorderThickness}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template" Value="{StaticResource ButtonControlTemplate}" />
    </Style>

    <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="MinHeight" Value="{StaticResource TextControlHeight}" />
        <Setter Property="Padding" Value="{StaticResource ButtonPadding}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource StandardBorderThickness}" />
        <Setter Property="theming:SemanticButtonState.IsDanger" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template" Value="{StaticResource ButtonControlTemplate}" />
    </Style>

    <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Width" Value="{StaticResource IconButtonSize}" />
        <Setter Property="Height" Value="{StaticResource IconButtonSize}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="{StaticResource NoBorderThickness}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template" Value="{StaticResource IconButtonControlTemplate}" />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
    </Style>

    <Style x:Key="BorderlessIconButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource IconButtonStyle}" />

    <Style x:Key="BackIconButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource IconButtonStyle}">
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style x:Key="SecondaryIconButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource IconButtonStyle}">
        <Setter Property="Width" Value="{StaticResource SecondaryIconButtonSize}" />
        <Setter Property="Height" Value="{StaticResource SecondaryIconButtonSize}" />
    </Style>

    <Style x:Key="FloatingIconButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource IconButtonStyle}">
        <Setter Property="Width" Value="{StaticResource SecondaryIconButtonSize}" />
        <Setter Property="Height" Value="{StaticResource SecondaryIconButtonSize}" />
    </Style>

    <Style x:Key="WindowOperationButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource IconButtonStyle}">
        <Setter Property="Width" Value="{StaticResource CompactIconButtonSize}" />
        <Setter Property="Height" Value="{StaticResource CompactIconButtonSize}" />
    </Style>

    <Style x:Key="WindowCloseButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource WindowOperationButtonStyle}">
        <Setter Property="Tag" Value="WindowClose" />
    </Style>

    <Style x:Key="WindowChromeButtonStyle"
           TargetType="ui:TitleBarButton"
           BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="{StaticResource NoBorderThickness}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource SecondarySurfaceBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource RaisedSurfaceBrush}" />
            </Trigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}"
                               Value="True" />
                    <Condition Property="ButtonType" Value="Close" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource DangerSubtleBrush}" />
            </MultiDataTrigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="{StaticResource DisabledControlOpacity}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="BorderlessListItemButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="{StaticResource NoBorderThickness}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template" Value="{StaticResource BorderlessListItemButtonControlTemplate}" />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
    </Style>

    <Style x:Key="WindowChromeTitleBarStyle"
           TargetType="ui:TitleBar"
           BasedOn="{StaticResource {x:Type ui:TitleBar}}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="ButtonsForeground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="Height" Value="{StaticResource TextControlHeight}" />
    </Style>
</ResourceDictionary>
