<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PrimarySurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource StandardBorderThickness}" />
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
    </Style>

    <Style x:Key="PopupSurfaceBorderStyle"
           TargetType="Border"
           BasedOn="{StaticResource CardBorderStyle}">
        <Setter Property="Background" Value="{DynamicResource RaisedSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource DialogCornerRadius}" />
    </Style>

    <Style x:Key="ListRowBorderStyle"
           TargetType="Border"
           BasedOn="{StaticResource CardBorderStyle}">
        <Setter Property="CornerRadius" Value="{StaticResource ListRowCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource ListRowPadding}" />
    </Style>

    <Style x:Key="SettingsGroupBorderStyle"
           TargetType="Border"
           BasedOn="{StaticResource CardBorderStyle}">
        <Setter Property="Padding" Value="{StaticResource SettingsGroupPadding}" />
    </Style>

    <Style x:Key="SettingsRowsGroupBorderStyle"
           TargetType="Border"
           BasedOn="{StaticResource CardBorderStyle}">
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
    </Style>

    <Style x:Key="SettingsRowBorderStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource SeparatorBorderThickness}" />
        <Setter Property="MinHeight" Value="{StaticResource SettingsRowMinHeight}" />
        <Setter Property="Padding" Value="{StaticResource SettingsRowPadding}" />
    </Style>

    <Style x:Key="SettingsLastRowBorderStyle"
           TargetType="Border"
           BasedOn="{StaticResource SettingsRowBorderStyle}">
        <Setter Property="BorderThickness" Value="{StaticResource NoBorderThickness}" />
    </Style>

    <Style x:Key="SelectedCardContainerStyle"
           TargetType="Border"
           BasedOn="{StaticResource CardBorderStyle}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                <Setter Property="BorderThickness" Value="{StaticResource SelectedIndicatorThickness}" />
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                    <Condition Binding="{Binding IsSelected}" Value="False" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource SecondarySurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                    <Condition Binding="{Binding IsSelected}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource AccentSubtleHoverBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                <Setter Property="BorderThickness" Value="{StaticResource SelectedIndicatorThickness}" />
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SelectableListItemContainerStyle"
           TargetType="Border"
           BasedOn="{StaticResource SelectedCardContainerStyle}">
        <Setter Property="Margin" Value="{StaticResource ListRowSpacing}" />
        <Setter Property="Padding" Value="{StaticResource ListRowPadding}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="{StaticResource NoBorderThickness}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                <Setter Property="Opacity" Value="{StaticResource DisabledControlOpacity}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SelectableCardListItemContainerStyle"
           TargetType="Border"
           BasedOn="{StaticResource SelectableListItemContainerStyle}">
        <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource StandardBorderThickness}" />
    </Style>

    <Style x:Key="CurrentListItemContainerStyle" TargetType="Border">
        <Setter Property="Margin" Value="{StaticResource ListRowSpacing}" />
        <Setter Property="Padding" Value="{StaticResource ListRowPadding}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="{StaticResource NoBorderThickness}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                <Setter Property="BorderThickness" Value="{StaticResource SelectedIndicatorThickness}" />
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsCurrent}" Value="True" />
                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource AccentSubtleHoverBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DropTargetListItemContainerStyle"
           TargetType="Border"
           BasedOn="{StaticResource SelectableCardListItemContainerStyle}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                <Setter Property="BorderThickness" Value="{StaticResource SelectedIndicatorThickness}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <ControlTemplate x:Key="VirtualizedListItemControlTemplate" TargetType="ListBoxItem">
        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                          Content="{TemplateBinding Content}"
                          ContentTemplate="{TemplateBinding ContentTemplate}" />
    </ControlTemplate>

    <Style x:Key="VirtualizedListItemContainerStyle" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="{StaticResource NoBorderThickness}" />
        <Setter Property="Margin" Value="{StaticResource NoBorderThickness}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="{StaticResource NoBorderThickness}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template" Value="{StaticResource VirtualizedListItemControlTemplate}" />
    </Style>

    <Style x:Key="RuleWorkbenchListItemContainerStyle"
           TargetType="ListBoxItem"
           BasedOn="{StaticResource VirtualizedListItemContainerStyle}" />

    <Style x:Key="ExtendedSelectionListItemContainerStyle"
           TargetType="ListBoxItem"
           BasedOn="{StaticResource VirtualizedListItemContainerStyle}">
        <Setter Property="IsTabStop" Value="False" />
    </Style>

    <Style x:Key="PlaybackChapterListItemContainerStyle"
           TargetType="ListBoxItem"
           BasedOn="{StaticResource VirtualizedListItemContainerStyle}">
        <Setter Property="Margin" Value="{StaticResource ListItemSpacing}" />
    </Style>

    <Style x:Key="PlaybackSegmentListItemContainerStyle"
           TargetType="ListBoxItem"
           BasedOn="{StaticResource VirtualizedListItemContainerStyle}">
        <Setter Property="Margin" Value="{StaticResource ListItemSpacing}" />
    </Style>

    <Style x:Key="ActiveCacheListItemContainerStyle"
           TargetType="ListBoxItem"
           BasedOn="{StaticResource VirtualizedListItemContainerStyle}">
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Margin" Value="{StaticResource ListItemSpacing}" />
    </Style>

    <Style x:Key="PlaybackChapterCurrentIndicatorStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Opacity" Value="0" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                <Setter Property="Opacity" Value="1" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PlaybackChapterStateBorderStyle" TargetType="Border">
        <Setter Property="Padding" Value="{StaticResource ListRowPadding}" />
        <Setter Property="CornerRadius" Value="{StaticResource ListRowCornerRadius}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="{StaticResource StandardBorderThickness}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                <Setter Property="Background" Value="{DynamicResource SecondarySurfaceBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsSelectedForActiveCache}" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsCurrent}" Value="True" />
                    <Condition Binding="{Binding IsSelectedForActiveCache}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource AccentSubtleHoverBrush}" />
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PlaybackSegmentStateBorderStyle" TargetType="Border">
        <Setter Property="Padding" Value="{StaticResource ListRowPadding}" />
        <Setter Property="CornerRadius" Value="{StaticResource ListRowCornerRadius}" />
        <Setter Property="Background" Value="Transparent" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ActiveCacheStatusBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                <Setter Property="Background" Value="{DynamicResource SecondarySurfaceBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsFailed}" Value="True">
                <Setter Property="Background" Value="{DynamicResource DangerSubtleBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
