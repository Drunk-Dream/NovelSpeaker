<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ControlTemplate x:Key="InputTextBoxControlTemplate"
                     TargetType="TextBox">
        <Grid SnapsToDevicePixels="True">
            <Border x:Name="InputSurface"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{StaticResource InputCornerRadius}">
                <ScrollViewer x:Name="PART_ContentHost"
                              Margin="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                              HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                              VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                              Focusable="False" />
            </Border>
            <Border x:Name="KeyboardFocusRing"
                    BorderBrush="{DynamicResource AccentFocusRingBrush}"
                    BorderThickness="{StaticResource KeyboardFocusRingThickness}"
                    CornerRadius="{StaticResource InputCornerRadius}"
                    IsHitTestVisible="False"
                    Visibility="Collapsed" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="KeyboardFocusRing" Property="Visibility" Value="Visible" />
                <Setter TargetName="InputSurface" Property="BorderBrush" Value="{DynamicResource AccentFocusRingBrush}" />
            </Trigger>
            <Trigger Property="IsReadOnly" Value="True">
                <Setter TargetName="InputSurface" Property="Background" Value="{DynamicResource SecondarySurfaceBrush}" />
                <Setter TargetName="InputSurface" Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
            </Trigger>
            <Trigger Property="Validation.HasError" Value="True">
                <Setter TargetName="InputSurface" Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="InputSurface" Property="Background" Value="{DynamicResource SecondarySurfaceBrush}" />
                <Setter TargetName="InputSurface" Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
                <Setter TargetName="InputSurface" Property="Opacity" Value="{StaticResource DisabledControlOpacity}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="InputPasswordBoxControlTemplate"
                     TargetType="PasswordBox">
        <Grid SnapsToDevicePixels="True">
            <Border x:Name="InputSurface"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{StaticResource InputCornerRadius}">
                <ScrollViewer x:Name="PART_ContentHost"
                              Margin="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Hidden"
                              Focusable="False" />
            </Border>
            <Border x:Name="KeyboardFocusRing"
                    BorderBrush="{DynamicResource AccentFocusRingBrush}"
                    BorderThickness="{StaticResource KeyboardFocusRingThickness}"
                    CornerRadius="{StaticResource InputCornerRadius}"
                    IsHitTestVisible="False"
                    Visibility="Collapsed" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="KeyboardFocusRing" Property="Visibility" Value="Visible" />
                <Setter TargetName="InputSurface" Property="BorderBrush" Value="{DynamicResource AccentFocusRingBrush}" />
            </Trigger>
            <Trigger Property="Validation.HasError" Value="True">
                <Setter TargetName="InputSurface" Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="InputSurface" Property="Background" Value="{DynamicResource SecondarySurfaceBrush}" />
                <Setter TargetName="InputSurface" Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
                <Setter TargetName="InputSurface" Property="Opacity" Value="{StaticResource DisabledControlOpacity}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="InputValidationErrorTemplate" TargetType="Control">
        <DockPanel LastChildFill="True"
                   Margin="0,4,0,0">
            <TextBlock DockPanel.Dock="Left"
                       Margin="0,0,4,0"
                       Foreground="{DynamicResource DangerBrush}"
                       FontWeight="SemiBold"
                       Text="!"
                       AutomationProperties.Name="字段错误" />
            <TextBlock x:Name="ErrorMessage"
                       Foreground="{DynamicResource DangerBrush}"
                       TextWrapping="Wrap"
                       Text="{Binding ElementName=ErrorPlaceholder, Path=AdornedElement.(Validation.Errors)[0].ErrorContent}" />
            <AdornedElementPlaceholder x:Name="ErrorPlaceholder" />
        </DockPanel>
    </ControlTemplate>

    <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
        <Setter Property="Height" Value="{StaticResource TextControlHeight}" />
        <Setter Property="MinHeight" Value="{StaticResource TextControlHeight}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="{StaticResource InputControlPadding}" />
        <Setter Property="Background" Value="{DynamicResource PrimarySurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StrongBorderBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource StandardBorderThickness}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Validation.ErrorTemplate" Value="{StaticResource InputValidationErrorTemplate}" />
        <Setter Property="Template" Value="{StaticResource InputTextBoxControlTemplate}" />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
    </Style>

    <Style TargetType="TextBox" BasedOn="{StaticResource InputTextBoxStyle}" />

    <Style x:Key="NumberInputTextBoxStyle"
           TargetType="TextBox"
           BasedOn="{StaticResource InputTextBoxStyle}">
        <Setter Property="MinWidth" Value="96" />
        <Setter Property="HorizontalContentAlignment" Value="Right" />
    </Style>

    <Style x:Key="InputPasswordBoxStyle" TargetType="PasswordBox">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
        <Setter Property="Height" Value="{StaticResource TextControlHeight}" />
        <Setter Property="MinHeight" Value="{StaticResource TextControlHeight}" />
        <Setter Property="Padding" Value="{StaticResource InputControlPadding}" />
        <Setter Property="Background" Value="{DynamicResource PrimarySurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StrongBorderBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource StandardBorderThickness}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Validation.ErrorTemplate" Value="{StaticResource InputValidationErrorTemplate}" />
        <Setter Property="Template" Value="{StaticResource InputPasswordBoxControlTemplate}" />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
    </Style>

    <Style TargetType="PasswordBox" BasedOn="{StaticResource InputPasswordBoxStyle}" />

    <Style x:Key="InputComboBoxStyle"
           TargetType="ComboBox"
           BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
        <Setter Property="Height" Value="{StaticResource TextControlHeight}" />
        <Setter Property="MinHeight" Value="{StaticResource TextControlHeight}" />
        <Setter Property="Padding" Value="{StaticResource InputControlPadding}" />
        <Setter Property="Background" Value="{DynamicResource PrimarySurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StrongBorderBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource StandardBorderThickness}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Validation.ErrorTemplate" Value="{StaticResource InputValidationErrorTemplate}" />
        <Setter Property="ItemContainerStyle" Value="{DynamicResource InputComboBoxItemStyle}" />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
    </Style>

    <Style TargetType="ComboBox" BasedOn="{StaticResource InputComboBoxStyle}" />

    <Style x:Key="InputComboBoxItemStyle" TargetType="ComboBoxItem">
        <Setter Property="MinHeight" Value="{StaticResource ListRowMinHeight}" />
        <Setter Property="Padding" Value="{StaticResource ListRowPadding}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Style.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentSubtleHoverBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="{StaticResource DisabledControlOpacity}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource InputComboBoxItemStyle}" />

    <Style x:Key="InputCheckBoxStyle"
           TargetType="CheckBox"
           BasedOn="{StaticResource {x:Type CheckBox}}">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
        <Setter Property="MinHeight" Value="{StaticResource InputControlHeight}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Validation.ErrorTemplate" Value="{StaticResource InputValidationErrorTemplate}" />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
    </Style>

    <Style TargetType="CheckBox" BasedOn="{StaticResource InputCheckBoxStyle}" />

    <Style x:Key="InputToggleSwitchStyle"
           TargetType="ui:ToggleSwitch"
           BasedOn="{StaticResource {x:Type ui:ToggleSwitch}}">
        <Setter Property="Width" Value="{StaticResource ToggleSwitchWidth}" />
        <Setter Property="MinWidth" Value="{StaticResource ToggleSwitchWidth}" />
        <Setter Property="MinHeight" Value="{StaticResource SettingsRowMinHeight}" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Validation.ErrorTemplate" Value="{StaticResource InputValidationErrorTemplate}" />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
    </Style>

    <Style TargetType="ui:ToggleSwitch" BasedOn="{StaticResource InputToggleSwitchStyle}" />

    <Style x:Key="InputHelpTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource SecondaryTextBlockStyle}">
        <Setter Property="Margin" Value="{StaticResource FieldDescriptionSpacing}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="InputErrorTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="Margin" Value="{StaticResource FieldDescriptionSpacing}" />
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
</ResourceDictionary>
