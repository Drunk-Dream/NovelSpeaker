<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:rules="clr-namespace:NovelSpeaker.App.Shared.Presentation.Rules">
    <Style TargetType="{x:Type rules:RuleListItemView}">
        <Setter Property="MinHeight" Value="72" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type rules:RuleListItemView}">
                    <Grid Margin="0,0,0,8"
                          Background="Transparent">
                        <Border x:Name="Surface"
                                Style="{StaticResource App.Selection.RuleCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Button x:Name="PART_SelectButton"
                                        Grid.ColumnSpan="2"
                                        Grid.RowSpan="2"
                                        Margin="-14,-12"
                                        Padding="0"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Command="{Binding SelectCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                        CommandParameter="{Binding CommandParameter, RelativeSource={RelativeSource TemplatedParent}}"
                                        Focusable="True"
                                        AutomationProperties.Name="{TemplateBinding Title}" />

                                <StackPanel Grid.Column="0"
                                            Margin="0,0,16,0"
                                            VerticalAlignment="Center"
                                            IsHitTestVisible="False">
                                    <TextBlock Style="{StaticResource App.Typography.ItemTitle}"
                                               Text="{TemplateBinding Title}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Margin="0,4,0,0"
                                               Style="{StaticResource App.Typography.Secondary}"
                                               Text="{TemplateBinding Summary}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <rules:RuleToggleSwitch x:Name="PART_ToggleButton"
                                                        Grid.Column="1"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center"
                                                        Style="{StaticResource App.Input.ToggleSwitch.Compact}"
                                                        Command="{Binding ToggleEnabledCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                                        CommandParameter="{Binding CommandParameter, RelativeSource={RelativeSource TemplatedParent}}"
                                                        IsEnabled="{Binding CanToggle, RelativeSource={RelativeSource TemplatedParent}}"
                                                        IsChecked="{Binding IsRuleEnabled, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" />

                                <Border Grid.Row="1"
                                        Grid.ColumnSpan="2"
                                        Margin="0,10,0,0"
                                        IsHitTestVisible="False"
                                        AutomationProperties.LiveSetting="Assertive"
                                        AutomationProperties.Name="规则错误">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource App.Feedback.InlineMessage}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasError, RelativeSource={RelativeSource TemplatedParent}}"
                                                             Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Style="{StaticResource App.Typography.Validation}"
                                               Text="{Binding ErrorMessage, RelativeSource={RelativeSource TemplatedParent}}"
                                               TextWrapping="Wrap" />
                                </Border>
                            </Grid>
                        </Border>

                        <Border x:Name="InsertBeforeLine"
                                Height="2"
                                Margin="8,-1,8,0"
                                VerticalAlignment="Top"
                                Background="{DynamicResource App.Brush.Accent.Default}"
                                CornerRadius="1"
                                IsHitTestVisible="False"
                                Visibility="Collapsed" />
                        <Border x:Name="InsertAfterLine"
                                Height="2"
                                Margin="8,0,8,7"
                                VerticalAlignment="Bottom"
                                Background="{DynamicResource App.Brush.Accent.Default}"
                                CornerRadius="1"
                                IsHitTestVisible="False"
                                Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Surface" Property="Opacity" Value="0.72" />
                            <Setter TargetName="Surface"
                                    Property="BorderBrush"
                                    Value="{DynamicResource App.Brush.Focus}" />
                            <Setter Property="Cursor" Value="SizeAll" />
                        </Trigger>
                        <Trigger Property="DropPlacement" Value="Before">
                            <Setter TargetName="InsertBeforeLine" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="DropPlacement" Value="After">
                            <Setter TargetName="InsertAfterLine" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ContextMenu">
            <Setter.Value>
                <ContextMenu Style="{StaticResource App.Menu.ContextSurface}"
                             AutomationProperties.Name="规则操作">
                    <MenuItem Header="导出到文件"
                              Style="{StaticResource App.Menu.Item}"
                              Command="{Binding PlacementTarget.ExportCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              CommandParameter="{Binding PlacementTarget.CommandParameter, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              IsEnabled="{Binding PlacementTarget.CanExport, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    <MenuItem Header="复制到剪切板"
                              Style="{StaticResource App.Menu.Item}"
                              Command="{Binding PlacementTarget.CopyCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              CommandParameter="{Binding PlacementTarget.CommandParameter, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              IsEnabled="{Binding PlacementTarget.CanCopy, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    <Separator>
                        <Separator.Style>
                            <Style TargetType="Separator">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PlacementTarget.IsSortable, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                 Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Separator.Style>
                    </Separator>
                    <MenuItem x:Name="MoveUpMenuItem"
                              Header="上移"
                              Command="{Binding PlacementTarget.MoveUpCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              CommandParameter="{Binding PlacementTarget.CommandParameter, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              IsEnabled="{Binding PlacementTarget.CanMoveUp, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                        <MenuItem.Style>
                            <Style TargetType="MenuItem" BasedOn="{StaticResource App.Menu.Item}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PlacementTarget.IsSortable, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                 Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </MenuItem.Style>
                    </MenuItem>
                    <MenuItem x:Name="MoveDownMenuItem"
                              Header="下移"
                              Command="{Binding PlacementTarget.MoveDownCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              CommandParameter="{Binding PlacementTarget.CommandParameter, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              IsEnabled="{Binding PlacementTarget.CanMoveDown, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                        <MenuItem.Style>
                            <Style TargetType="MenuItem" BasedOn="{StaticResource App.Menu.Item}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PlacementTarget.IsSortable, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                 Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </MenuItem.Style>
                    </MenuItem>
                    <Separator x:Name="MoveSeparator">
                        <Separator.Style>
                            <Style TargetType="Separator">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PlacementTarget.IsSortable, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                 Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Separator.Style>
                    </Separator>
                    <MenuItem Header="删除"
                              Style="{StaticResource App.Menu.DangerItem}"
                              Command="{Binding PlacementTarget.DeleteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              CommandParameter="{Binding PlacementTarget.CommandParameter, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              IsEnabled="{Binding PlacementTarget.CanDelete, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                </ContextMenu>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
