<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:NovelSpeaker.App.Shared.Presentation.Controls.Feedback"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Style TargetType="{x:Type controls:AppStatusView}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:AppStatusView}">
                    <Border x:Name="Surface" Style="{StaticResource App.Surface.Section}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="IconSurface"
                                    Grid.Column="0"
                                    Width="40"
                                    Height="40"
                                    Margin="0,0,12,0"
                                    Padding="8"
                                    Background="{DynamicResource App.Brush.Accent.Subtle}"
                                    CornerRadius="{StaticResource App.Radius.Small}"
                                    VerticalAlignment="Center">
                                <ui:SymbolIcon x:Name="IconPresenter"
                                               Style="{StaticResource App.Icon.Accent}"
                                               Symbol="{TemplateBinding Icon}"
                                               Width="24"
                                               Height="24" />
                            </Border>
                            <StackPanel x:Name="CopyPresenter"
                                        Grid.Column="1"
                                        VerticalAlignment="Center">
                                <TextBlock x:Name="TitlePresenter"
                                           Text="{TemplateBinding Title}"
                                           Style="{StaticResource App.Typography.ItemTitle}"
                                           AutomationProperties.Name="{TemplateBinding Title}" />
                                <TextBlock x:Name="DescriptionPresenter"
                                           Margin="0,4,0,0"
                                           Text="{TemplateBinding Description}"
                                           Style="{StaticResource App.Typography.Secondary}"
                                           AutomationProperties.Name="{TemplateBinding Description}" />
                                <StackPanel x:Name="ActionPanel"
                                            Orientation="Horizontal"
                                            Margin="0,12,0,0">
                                    <ContentPresenter x:Name="PrimaryActionPresenter"
                                                      Content="{TemplateBinding PrimaryAction}"
                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                      ContentStringFormat="{TemplateBinding ContentStringFormat}" />
                                    <ContentPresenter x:Name="SecondaryActionPresenter"
                                                      Margin="8,0,0,0"
                                                      Content="{TemplateBinding SecondaryAction}"
                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                      ContentStringFormat="{TemplateBinding ContentStringFormat}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEmbedded" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="Transparent" />
                            <Setter TargetName="Surface" Property="BorderBrush" Value="Transparent" />
                            <Setter TargetName="Surface" Property="BorderThickness" Value="0" />
                            <Setter TargetName="Surface" Property="CornerRadius" Value="0" />
                            <Setter TargetName="Surface" Property="Padding" Value="0" />
                            <Setter TargetName="Surface" Property="Effect" Value="{x:Null}" />
                        </Trigger>
                        <Trigger Property="Description" Value="{x:Null}">
                            <Setter TargetName="DescriptionPresenter" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Description" Value="">
                            <Setter TargetName="DescriptionPresenter" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="PrimaryAction" Value="{x:Null}">
                            <Setter TargetName="PrimaryActionPresenter" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="SecondaryAction" Value="{x:Null}">
                            <Setter TargetName="SecondaryActionPresenter" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="PrimaryAction" Value="{x:Null}" />
                                <Condition Property="SecondaryAction" Value="{x:Null}" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="ActionPanel" Property="Visibility" Value="Collapsed" />
                        </MultiTrigger>
                        <Trigger Property="Status" Value="{x:Static controls:AppStatusKind.Loading}">
                            <Setter TargetName="IconSurface" Property="Background" Value="{DynamicResource App.Brush.Accent.Subtle}" />
                            <Setter TargetName="IconPresenter" Property="Foreground" Value="{DynamicResource App.Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="Status" Value="{x:Static controls:AppStatusKind.Empty}">
                            <Setter TargetName="IconSurface" Property="Background" Value="{DynamicResource App.Brush.Surface.Secondary}" />
                            <Setter TargetName="IconPresenter" Property="Foreground" Value="{DynamicResource App.Brush.Text.Secondary}" />
                        </Trigger>
                        <Trigger Property="Status" Value="{x:Static controls:AppStatusKind.NoResult}">
                            <Setter TargetName="IconSurface" Property="Background" Value="{DynamicResource App.Brush.Warning.Subtle}" />
                            <Setter TargetName="IconPresenter" Property="Foreground" Value="{DynamicResource App.Brush.Warning}" />
                        </Trigger>
                        <Trigger Property="Status" Value="{x:Static controls:AppStatusKind.Error}">
                            <Setter TargetName="IconSurface" Property="Background" Value="{DynamicResource App.Brush.Danger.Subtle}" />
                            <Setter TargetName="IconPresenter" Property="Foreground" Value="{DynamicResource App.Brush.Danger}" />
                        </Trigger>
                        <Trigger Property="Status" Value="{x:Static controls:AppStatusKind.Success}">
                            <Setter TargetName="IconSurface" Property="Background" Value="{DynamicResource App.Brush.Success.Subtle}" />
                            <Setter TargetName="IconPresenter" Property="Foreground" Value="{DynamicResource App.Brush.Success}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
