<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:component="clr-namespace:NovelSpeaker.App.Shared.Theming.Components">
    <!--
        Shared component templates own the internal structure and state markers
        of the six list-family components, but do not own page columns or a
        virtualized container's selection model.
    -->
    <Style x:Key="App.Component.Base"
           TargetType="{x:Type component:AppComponentBase}">
        <Setter Property="Background" Value="{DynamicResource App.Brush.Surface.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.Border.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource App.Brush.Text.Primary}" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type component:AppComponentBase}">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Surface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <Border x:Name="SelectedMarker"
                                Width="3"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Stretch"
                                Background="{DynamicResource App.Brush.Accent}"
                                CornerRadius="2"
                                Visibility="Collapsed"
                                IsHitTestVisible="False" />
                        <Border x:Name="HoverMarker"
                                BorderBrush="{DynamicResource App.Brush.Border.Strong}"
                                BorderThickness="1"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Visibility="Collapsed"
                                IsHitTestVisible="False" />
                        <Border x:Name="PlaybackMarker"
                                Width="3"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Stretch"
                                Background="{DynamicResource App.Brush.Success}"
                                CornerRadius="2"
                                Visibility="Collapsed"
                                IsHitTestVisible="False" />
                        <Border x:Name="FocusMarker"
                                BorderBrush="{DynamicResource App.Brush.Focus}"
                                BorderThickness="2"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Visibility="Collapsed"
                                IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource App.Brush.Surface.Secondary}" />
                            <Setter TargetName="HoverMarker" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsHoverPreview" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource App.Brush.Surface.Secondary}" />
                            <Setter TargetName="HoverMarker" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource App.Brush.Accent.Subtle}" />
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource App.Brush.Accent}" />
                            <Setter TargetName="SelectedMarker" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsCurrentPlayback" Value="True">
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource App.Brush.Accent}" />
                            <Setter TargetName="PlaybackMarker" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="FocusMarker" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsFocusPreview" Value="True">
                            <Setter TargetName="FocusMarker" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{DynamicResource App.Opacity.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="App.Component.BookCard"
           TargetType="{x:Type component:BookCard}"
           BasedOn="{StaticResource App.Component.Base}">
        <Setter Property="MinWidth" Value="280" />
        <Setter Property="MinHeight" Value="120" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="App.Component.ListRow"
           TargetType="{x:Type component:ListRow}"
           BasedOn="{StaticResource App.Component.Base}">
        <Setter Property="MinWidth" Value="280" />
        <Setter Property="MinHeight" Value="52" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="12,8" />
    </Style>

    <Style x:Key="App.Component.SelectableRow"
           TargetType="{x:Type component:SelectableRow}"
           BasedOn="{StaticResource App.Component.Base}">
        <Setter Property="MinWidth" Value="280" />
        <Setter Property="MinHeight" Value="52" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="12,8" />
    </Style>

    <Style x:Key="App.Component.SettingsRow"
           TargetType="{x:Type component:SettingsRow}"
           BasedOn="{StaticResource App.Component.Base}">
        <Setter Property="MinWidth" Value="320" />
        <Setter Property="MinHeight" Value="60" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="12,10" />
    </Style>

    <Style x:Key="App.Component.RuleListItem"
           TargetType="{x:Type component:RuleListItem}"
           BasedOn="{StaticResource App.Component.Base}">
        <Setter Property="MinWidth" Value="280" />
        <Setter Property="MinHeight" Value="64" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="12,10" />
    </Style>

    <Style x:Key="App.Component.EmptyState"
           TargetType="{x:Type component:EmptyState}"
           BasedOn="{StaticResource App.Component.Base}">
        <Setter Property="MinWidth" Value="320" />
        <Setter Property="MinHeight" Value="160" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="24" />
    </Style>
</ResourceDictionary>
