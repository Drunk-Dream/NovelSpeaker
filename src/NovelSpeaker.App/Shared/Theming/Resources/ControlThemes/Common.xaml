<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:NovelSpeaker.App.Shared.Presentation.Controls.Common">
    <Style TargetType="{x:Type controls:AppPageHeader}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:AppPageHeader}">
                    <Grid SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="BackColumn" Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition x:Name="ActionsColumn" Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button x:Name="BackButton"
                                Grid.Column="0"
                                Margin="0,0,12,0"
                                Style="{StaticResource App.Button.Icon}"
                                Command="{TemplateBinding BackCommand}"
                                ToolTip="返回"
                                AutomationProperties.Name="返回">
                            <ui:SymbolIcon xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                                           Symbol="ChevronLeft24" />
                        </Button>

                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="TitlePresenter"
                                       Text="{TemplateBinding Title}"
                                       Style="{StaticResource App.Typography.PageTitle}"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{TemplateBinding Title}"
                                       AutomationProperties.Name="{TemplateBinding Title}" />
                            <TextBlock x:Name="DescriptionPresenter"
                                       Grid.Row="1"
                                       Margin="0,4,0,0"
                                       Text="{TemplateBinding Description}"
                                       Style="{StaticResource App.Typography.Secondary}"
                                       AutomationProperties.Name="{TemplateBinding Description}" />
                        </Grid>

                        <ContentPresenter x:Name="ActionsPresenter"
                                          Grid.Column="2"
                                          Margin="16,0,0,0"
                                          VerticalAlignment="Top"
                                          Content="{TemplateBinding Actions}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          ContentStringFormat="{TemplateBinding ContentStringFormat}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Description" Value="{x:Null}">
                            <Setter TargetName="DescriptionPresenter" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Description" Value="">
                            <Setter TargetName="DescriptionPresenter" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="BackCommand" Value="{x:Null}">
                            <Setter TargetName="BackButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Actions" Value="{x:Null}">
                            <Setter TargetName="ActionsPresenter" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type controls:AppSectionSurface}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:AppSectionSurface}">
                    <Border x:Name="Surface" Style="{StaticResource App.Surface.Section}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="HeaderPresenter"
                                       Text="{TemplateBinding Header}"
                                       Style="{StaticResource App.Typography.SectionTitle}"
                                       AutomationProperties.Name="{TemplateBinding Header}" />
                            <TextBlock x:Name="DescriptionPresenter"
                                       Grid.Row="1"
                                       Margin="0,4,0,0"
                                       Text="{TemplateBinding Description}"
                                       Style="{StaticResource App.Typography.Secondary}"
                                       AutomationProperties.Name="{TemplateBinding Description}" />
                            <ContentPresenter x:Name="ContentPresenter"
                                              Grid.Row="2"
                                              Margin="0,16,0,0"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              ContentStringFormat="{TemplateBinding ContentStringFormat}" />
                            <ContentPresenter x:Name="FooterPresenter"
                                              Grid.Row="3"
                                              Margin="0,16,0,0"
                                              HorizontalAlignment="Right"
                                              Content="{TemplateBinding Footer}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              ContentStringFormat="{TemplateBinding ContentStringFormat}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Header" Value="{x:Null}">
                            <Setter TargetName="HeaderPresenter" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Description" Value="{x:Null}">
                            <Setter TargetName="DescriptionPresenter" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Description" Value="">
                            <Setter TargetName="DescriptionPresenter" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Header" Value="">
                            <Setter TargetName="HeaderPresenter" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Footer" Value="{x:Null}">
                            <Setter TargetName="FooterPresenter" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
