<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:component="clr-namespace:NovelSpeaker.App.Shared.Theming.Components"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <!-- Shared named styles. Provider templates remain the owner of standard controls. -->
    <Style x:Key="App.Navigation.Entry"
           TargetType="{x:Type ui:NavigationViewItem}"
           BasedOn="{StaticResource Provider.NavigationViewItem}">
        <Setter Property="Margin" Value="4,2" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Foreground" Value="{DynamicResource App.Brush.Text.Primary}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource App.Brush.Surface.Secondary}" />
            </Trigger>
            <Trigger Property="IsActive" Value="True">
                <Setter Property="Background" Value="{DynamicResource App.Brush.Accent.Subtle}" />
                <Setter Property="Foreground" Value="{DynamicResource App.Brush.Accent.Text}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.Focus}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="{DynamicResource App.Opacity.Disabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- MenuItem has no Wpf.Ui provider bridge; this explicit alias keeps its base style stable. -->
    <Style x:Key="Provider.MenuItem"
           TargetType="{x:Type MenuItem}"
           BasedOn="{StaticResource {x:Type MenuItem}}" />

    <Style x:Key="App.Menu.Item"
           TargetType="{x:Type MenuItem}"
           BasedOn="{StaticResource Provider.MenuItem}">
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="Foreground" Value="{DynamicResource App.Brush.Text.Primary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>

    <Style x:Key="App.Menu.DangerItem"
           TargetType="{x:Type MenuItem}"
           BasedOn="{StaticResource App.Menu.Item}">
        <Setter Property="Foreground" Value="{DynamicResource App.Brush.Danger}" />
        <Setter Property="Tag" Value="Danger" />
    </Style>

    <Style x:Key="App.Menu.GroupHeader"
           TargetType="{x:Type MenuItem}"
           BasedOn="{StaticResource App.Menu.Item}">
        <Setter Property="IsEnabled" Value="False" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource App.Brush.Text.Secondary}" />
    </Style>

    <Style x:Key="App.Feedback.ProgressBar"
           TargetType="{x:Type ProgressBar}"
           BasedOn="{StaticResource {x:Type ProgressBar}}">
        <Setter Property="Height" Value="6" />
        <Setter Property="MinHeight" Value="6" />
        <Setter Property="MinWidth" Value="280" />
        <Setter Property="Foreground" Value="{DynamicResource App.Brush.Accent}" />
        <Setter Property="Background" Value="{DynamicResource App.Brush.Surface.Secondary}" />
    </Style>

    <Style x:Key="App.Feedback.SurfaceBase"
           TargetType="{x:Type component:FeedbackSurfaceBase}">
        <Setter Property="Background" Value="{DynamicResource App.Brush.Surface.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.Border.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource App.Brush.Text.Primary}" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type component:FeedbackSurfaceBase}">
                    <Grid>
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <Border x:Name="FocusRing"
                                BorderBrush="{DynamicResource App.Brush.Focus}"
                                BorderThickness="2"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Visibility="Collapsed"
                                IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.Focus}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="{DynamicResource App.Opacity.Disabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="App.Feedback.FlyoutSurface"
           TargetType="{x:Type component:FlyoutSurface}"
           BasedOn="{StaticResource App.Feedback.SurfaceBase}">
        <Setter Property="MinWidth" Value="240" />
        <Setter Property="Width" Value="260" />
        <Setter Property="MinHeight" Value="130" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Background" Value="{DynamicResource App.Brush.Surface.Raised}" />
        <Setter Property="Effect" Value="{DynamicResource App.Elevation.Medium}" />
    </Style>

    <Style x:Key="App.Feedback.DialogShell"
           TargetType="{x:Type component:DialogShell}"
           BasedOn="{StaticResource App.Feedback.SurfaceBase}">
        <Setter Property="MinWidth" Value="280" />
        <Setter Property="Width" Value="300" />
        <Setter Property="MinHeight" Value="160" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Background" Value="{DynamicResource App.Brush.Surface.Raised}" />
        <Setter Property="Effect" Value="{DynamicResource App.Elevation.High}" />
    </Style>

    <Style x:Key="App.Menu.Surface" TargetType="{x:Type Menu}">
        <Setter Property="Background" Value="{DynamicResource App.Brush.Surface.Raised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.Border.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Effect" Value="{DynamicResource App.Elevation.Medium}" />
    </Style>

    <Style x:Key="App.Menu.ContextSurface" TargetType="{x:Type ContextMenu}">
        <Setter Property="Background" Value="{DynamicResource App.Brush.Surface.Raised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.Border.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Effect" Value="{DynamicResource App.Elevation.Medium}" />
    </Style>

    <Style x:Key="App.Feedback.SnackbarContent"
           TargetType="{x:Type component:SnackbarContent}"
           BasedOn="{StaticResource App.Feedback.SurfaceBase}">
        <Setter Property="MinWidth" Value="520" />
        <Setter Property="MinHeight" Value="52" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Background" Value="{DynamicResource App.Brush.Surface.Primary}" />
    </Style>

    <Style x:Key="App.Feedback.StatusBase"
           TargetType="{x:Type component:FeedbackStatusBase}"
           BasedOn="{StaticResource App.Feedback.SurfaceBase}">
        <Setter Property="MinWidth" Value="160" />
        <Setter Property="MinHeight" Value="88" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>

    <Style x:Key="App.Feedback.Loading"
           TargetType="{x:Type component:LoadingState}"
           BasedOn="{StaticResource App.Feedback.StatusBase}">
        <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.Accent}" />
    </Style>

    <Style x:Key="App.Feedback.Error"
           TargetType="{x:Type component:ErrorState}"
           BasedOn="{StaticResource App.Feedback.StatusBase}">
        <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.Danger}" />
    </Style>

    <Style x:Key="App.Feedback.NoResult"
           TargetType="{x:Type component:NoResultState}"
           BasedOn="{StaticResource App.Feedback.StatusBase}">
        <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.Border.Subtle}" />
    </Style>
</ResourceDictionary>
