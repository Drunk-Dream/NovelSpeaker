<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:NovelSpeaker.App.Shared.Presentation.Controls.Forms">
    <Style TargetType="{x:Type controls:AppFormField}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:AppFormField}">
                    <StackPanel>
                        <Grid x:Name="LabelPresenter">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{TemplateBinding Label}"
                                       Style="{StaticResource App.Typography.FormLabel}"
                                       AutomationProperties.Name="{TemplateBinding Label}" />
                            <TextBlock x:Name="RequiredPresenter"
                                       Grid.Column="1"
                                       Margin="4,0,0,0"
                                       Text="*"
                                       Foreground="{DynamicResource App.Brush.Danger}"
                                       Style="{StaticResource App.Typography.FormLabel}"
                                       AutomationProperties.Name="必填" />
                        </Grid>
                        <TextBlock x:Name="DescriptionPresenter"
                                   Margin="0,4,0,0"
                                   Text="{TemplateBinding Description}"
                                   Style="{StaticResource App.Typography.Secondary}"
                                   AutomationProperties.Name="{TemplateBinding Description}" />
                        <ContentPresenter x:Name="ContentPresenter"
                                          Margin="0,8,0,0"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          ContentStringFormat="{TemplateBinding ContentStringFormat}" />
                        <TextBlock x:Name="ErrorPresenter"
                                   Margin="0,4,0,0"
                                   Text="{TemplateBinding Error}"
                                   Style="{StaticResource App.Typography.Validation}"
                                   AutomationProperties.Name="{TemplateBinding Error}" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Label" Value="{x:Null}">
                            <Setter TargetName="LabelPresenter" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Label" Value="">
                            <Setter TargetName="LabelPresenter" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Required" Value="False">
                            <Setter TargetName="RequiredPresenter" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Description" Value="{x:Null}">
                            <Setter TargetName="DescriptionPresenter" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Description" Value="">
                            <Setter TargetName="DescriptionPresenter" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="ContentPresenter" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Error" Value="{x:Null}">
                            <Setter TargetName="ErrorPresenter" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Error" Value="">
                            <Setter TargetName="ErrorPresenter" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
