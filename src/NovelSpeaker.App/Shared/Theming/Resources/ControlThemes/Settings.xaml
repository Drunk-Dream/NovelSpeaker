<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:NovelSpeaker.App.Shared.Presentation.Controls.Settings"
                    xmlns:theming="clr-namespace:NovelSpeaker.App.Shared.Theming"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <DataTemplate DataType="{x:Type theming:SettingsNavigationIcon}">
        <ui:SymbolIcon>
            <ui:SymbolIcon.Style>
                <Style TargetType="ui:SymbolIcon">
                    <Setter Property="Symbol" Value="Info24" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding}"
                                     Value="{x:Static theming:SettingsNavigationIcon.Playback}">
                            <Setter Property="Symbol" Value="PlayCircle24" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding}"
                                     Value="{x:Static theming:SettingsNavigationIcon.TtsRules}">
                            <Setter Property="Symbol" Value="Speaker124" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding}"
                                     Value="{x:Static theming:SettingsNavigationIcon.ImportText}">
                            <Setter Property="Symbol" Value="DocumentText24" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding}"
                                     Value="{x:Static theming:SettingsNavigationIcon.ChapterRules}">
                            <Setter Property="Symbol" Value="TextBulletListSquare24" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding}"
                                     Value="{x:Static theming:SettingsNavigationIcon.CacheAndData}">
                            <Setter Property="Symbol" Value="Database24" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding}"
                                     Value="{x:Static theming:SettingsNavigationIcon.General}">
                            <Setter Property="Symbol" Value="Settings24" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding}"
                                     Value="{x:Static theming:SettingsNavigationIcon.Appearance}">
                            <Setter Property="Symbol" Value="DarkTheme24" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding}"
                                     Value="{x:Static theming:SettingsNavigationIcon.Diagnostics}">
                            <Setter Property="Symbol" Value="Info24" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding}"
                                     Value="{x:Static theming:SettingsNavigationIcon.RegexReplacement}">
                            <Setter Property="Symbol" Value="DocumentText24" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding}"
                                     Value="{x:Static theming:SettingsNavigationIcon.CacheManagement}">
                            <Setter Property="Symbol" Value="Database24" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ui:SymbolIcon.Style>
        </ui:SymbolIcon>
    </DataTemplate>

    <Style x:Key="App.Settings.ListSurface"
           TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource App.Brush.Surface.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.Border.Subtle}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource App.Radius.Medium}" />
        <Setter Property="Padding" Value="20" />
    </Style>

    <Style TargetType="{x:Type controls:AppSettingsList}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ContentControl">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="IsTabStop" Value="False" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ContentControl">
                                <Border x:Name="ItemSurface"
                                        BorderBrush="{DynamicResource App.Brush.Border.Subtle}"
                                        BorderThickness="0,0,0,1">
                                    <ContentPresenter Content="{TemplateBinding Content}"
                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                      ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="controls:AppSettingsList.IsLastItem" Value="True">
                                        <Setter TargetName="ItemSurface" Property="BorderThickness" Value="0" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:AppSettingsList}">
                    <Border Style="{StaticResource App.Settings.ListSurface}">
                        <ItemsPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type controls:AppSettingsGroup}"
           BasedOn="{StaticResource {x:Type controls:AppSettingsList}}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:AppSettingsGroup}">
                    <Border Style="{StaticResource App.Settings.ListSurface}">
                        <Grid SnapsToDevicePixels="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock x:Name="HeaderPresenter"
                                       Text="{TemplateBinding Header}"
                                       Style="{StaticResource App.Typography.GroupTitle}"
                                       AutomationProperties.Name="{TemplateBinding Header}" />
                            <TextBlock x:Name="DescriptionPresenter"
                                       Grid.Row="1"
                                       Margin="0,4,0,0"
                                       Text="{TemplateBinding Description}"
                                       Style="{StaticResource App.Typography.Secondary}"
                                       AutomationProperties.Name="{TemplateBinding Description}" />
                            <ItemsPresenter x:Name="ItemsPresenter"
                                            Grid.Row="2"
                                            Margin="0,12,0,0" />
                            <ContentPresenter x:Name="FooterPresenter"
                                              Grid.Row="3"
                                              Margin="0,16,0,0"
                                              Content="{TemplateBinding Footer}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Header" Value="{x:Null}">
                            <Setter TargetName="HeaderPresenter" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Header" Value="">
                            <Setter TargetName="HeaderPresenter" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Description" Value="{x:Null}">
                            <Setter TargetName="DescriptionPresenter" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Description" Value="">
                            <Setter TargetName="DescriptionPresenter" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Footer" Value="{x:Null}">
                            <Setter TargetName="FooterPresenter" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type controls:AppSettingsRow}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="MinHeight" Value="60" />
        <Setter Property="Padding" Value="0,10" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:AppSettingsRow}">
                    <Border x:Name="InlineLayoutBorder"
                            Padding="{TemplateBinding Padding}">
                        <Grid x:Name="InlineLayout"
                              MinWidth="0"
                              VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel x:Name="CopyPresenter"
                                        VerticalAlignment="Center">
                                <TextBlock x:Name="TitlePresenter"
                                           Text="{TemplateBinding Title}"
                                           Style="{StaticResource App.Typography.ItemTitle}"
                                           AutomationProperties.Name="{TemplateBinding Title}" />
                                <TextBlock x:Name="DescriptionPresenter"
                                           Margin="0,4,0,0"
                                           Text="{TemplateBinding Description}"
                                           Style="{StaticResource App.Typography.Secondary}"
                                           AutomationProperties.Name="{TemplateBinding Description}" />
                            </StackPanel>
                            <ContentPresenter x:Name="ValuePresenter"
                                              Grid.Column="1"
                                              Margin="16,0,0,0"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              ContentStringFormat="{TemplateBinding ContentStringFormat}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Description" Value="{x:Null}">
                            <Setter TargetName="DescriptionPresenter" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Description" Value="">
                            <Setter TargetName="DescriptionPresenter" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="ValuePresenter" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsNarrowLayout" Value="True">
                            <Setter TargetName="ValuePresenter" Property="Grid.Row" Value="1" />
                            <Setter TargetName="ValuePresenter" Property="Grid.Column" Value="0" />
                            <Setter TargetName="ValuePresenter" Property="Margin" Value="0,12,0,0" />
                            <Setter TargetName="ValuePresenter" Property="HorizontalAlignment" Value="Stretch" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type controls:AppSettingsNavigationRow}">
        <Setter Property="MinHeight" Value="60" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource App.Brush.Text.Primary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:AppSettingsNavigationRow}">
                    <Border x:Name="Surface"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource App.Radius.Small}"
                            Padding="{TemplateBinding Padding}">
                        <Grid MinWidth="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0"
                                              Margin="0,0,12,0"
                                              Width="{StaticResource App.Size.Icon.Large}"
                                              Height="{StaticResource App.Size.Icon.Large}"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding Icon}" />
                            <StackPanel x:Name="CopyPresenter"
                                        Grid.Column="1"
                                        VerticalAlignment="Center">
                                <TextBlock x:Name="TitlePresenter"
                                           Text="{TemplateBinding Title}"
                                           Style="{StaticResource App.Typography.ItemTitle}"
                                           AutomationProperties.Name="{TemplateBinding Title}" />
                                <TextBlock x:Name="DescriptionPresenter"
                                           Margin="0,4,0,0"
                                           Text="{TemplateBinding Description}"
                                           Style="{StaticResource App.Typography.Secondary}"
                                           AutomationProperties.Name="{TemplateBinding Description}" />
                            </StackPanel>
                            <ui:SymbolIcon Grid.Column="2"
                                           Margin="16,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource App.Brush.Text.Secondary}"
                                           Symbol="ChevronRight24" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Description" Value="{x:Null}">
                            <Setter TargetName="DescriptionPresenter" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Description" Value="">
                            <Setter TargetName="DescriptionPresenter" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource App.Brush.Surface.Secondary}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource App.Brush.Accent.Subtle}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource App.Brush.Focus}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{StaticResource App.Opacity.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
