<UserControl x:Class="NovelSpeaker.App.Views.PlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Padding="20"
                Background="#FFF8F1E4"
                BorderBrush="#FFE2D2B6"
                BorderThickness="1"
                CornerRadius="10">
            <StackPanel>
                <TextBlock FontSize="28"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           Text="{Binding Headline}" />
                <TextBlock Margin="0,16,0,0"
                           FontWeight="SemiBold"
                           Text="选择书籍" />
                <ComboBox Margin="0,8,0,0"
                          DisplayMemberPath="Title"
                          ItemsSource="{Binding Books}"
                          SelectedItem="{Binding SelectedBook}" />

                <TextBlock Margin="0,16,0,0"
                           FontWeight="SemiBold"
                           Text="选择规则" />
                <ComboBox Margin="0,8,0,0"
                          DisplayMemberPath="Name"
                          ItemsSource="{Binding Rules}"
                          SelectedItem="{Binding SelectedRule}" />
                <Button Margin="0,10,0,0"
                        Padding="14,8"
                        Command="{Binding ApplySelectedRuleCommand}"
                        Content="应用当前规则" />

                <TextBlock Margin="0,16,0,0"
                           FontWeight="SemiBold"
                           Text="语速" />
                <StackPanel Margin="0,8,0,0"
                            Orientation="Horizontal">
                    <TextBox Width="80"
                             Text="{Binding SpeakSpeed, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Margin="12,0,0,0"
                            Padding="14,8"
                            Command="{Binding ApplySpeakSpeedCommand}"
                            Content="应用语速" />
                </StackPanel>

                <Button Margin="0,20,0,0"
                        Padding="18,10"
                        Command="{Binding StartSelectedBookCommand}"
                        Content="开始播放所选书籍" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Column="2">
            <TextBlock FontSize="26"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       Text="{Binding CurrentTitle}" />
            <TextBlock Margin="0,10,0,0"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="#FF1D3557"
                       TextWrapping="Wrap"
                       Text="{Binding CurrentChapterTitle}" />
            <TextBlock Margin="0,8,0,0"
                       FontSize="16"
                       Foreground="#FF415A77"
                       TextWrapping="Wrap"
                       Text="{Binding CurrentRuleText}" />
            <TextBlock Margin="0,8,0,0"
                       FontSize="16"
                       Foreground="#FF1D3557"
                       Text="{Binding StatusText}" />
            <TextBlock Margin="0,6,0,0"
                       Foreground="#FF4A5568"
                       TextWrapping="Wrap"
                       Text="{Binding DetailText}" />
            <TextBlock Margin="0,8,0,0"
                       Foreground="#FFB3261E"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       Text="{Binding ErrorText}" />

            <WrapPanel Margin="0,28,0,0">
                <Button Margin="0,0,12,12"
                        Padding="20,10"
                        Command="{Binding TogglePlayPauseCommand}"
                        Content="{Binding PrimaryActionText}" />
                <Button Margin="0,0,12,12"
                        Padding="20,10"
                        Command="{Binding StopCommand}"
                        Content="停止" />
                <Button Margin="0,0,12,12"
                        Padding="20,10"
                        Command="{Binding RetryCurrentSegmentCommand}"
                        Content="重试当前段" />
                <Button Margin="0,0,12,12"
                        Padding="20,10"
                        Command="{Binding SkipCurrentSegmentCommand}"
                        Content="跳过当前段" />
            </WrapPanel>

            <WrapPanel Margin="0,12,0,0">
                <Button Margin="0,0,12,12"
                        Padding="18,10"
                        Command="{Binding PreviousChapterCommand}"
                        Content="上一章" />
                <Button Margin="0,0,12,12"
                        Padding="18,10"
                        Command="{Binding PreviousSegmentCommand}"
                        Content="上一段" />
                <Button Margin="0,0,12,12"
                        Padding="18,10"
                        Command="{Binding NextSegmentCommand}"
                        Content="下一段" />
                <Button Margin="0,0,12,12"
                        Padding="18,10"
                        Command="{Binding NextChapterCommand}"
                        Content="下一章" />
            </WrapPanel>
        </StackPanel>
    </Grid>
</UserControl>
