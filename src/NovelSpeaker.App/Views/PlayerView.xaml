<UserControl x:Class="NovelSpeaker.App.Views.PlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="ChapterListButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="{StaticResource PagePadding}"
          MinHeight="0"
          ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Padding="14,8"
                        Command="{Binding BackCommand}"
                        Content="返回" />
                <TextBlock Grid.Column="1"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Style="{StaticResource SectionTitleTextBlockStyle}"
                           Text="{Binding CurrentTitle}"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap" />
            </Grid>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <Button x:Name="RuleMenuButton"
                        Padding="14,8"
                        Command="{Binding ToggleRuleMenuCommand}"
                        Content="规则" />
                <Button x:Name="SpeedMenuButton"
                        Margin="12,0,0,0"
                        Padding="14,8"
                        Command="{Binding ToggleSpeedMenuCommand}"
                        Content="{Binding SpeakSpeedButtonText}" />
            </StackPanel>

            <Popup PlacementTarget="{Binding ElementName=RuleMenuButton}"
                   Placement="Bottom"
                   HorizontalOffset="0"
                   VerticalOffset="8"
                   AllowsTransparency="True"
                   PopupAnimation="Fade"
                   StaysOpen="False"
                   IsOpen="{Binding IsRuleMenuOpen, Mode=TwoWay}">
                <Border Width="320"
                        Padding="{StaticResource CardPadding}"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleTextBlockStyle}"
                                   Text="切换规则" />
                        <TextBlock Margin="0,8,0,0"
                                   Style="{StaticResource SecondaryTextBlockStyle}"
                                   Text="当前规则仅在菜单中显示勾选。" />
                        <ItemsControl Margin="0,16,0,0"
                                      ItemsSource="{Binding Rules}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Margin="0,0,0,8"
                                            Padding="12,8"
                                            HorizontalContentAlignment="Stretch"
                                            IsEnabled="{Binding IsEnabled}"
                                            Command="{Binding DataContext.SelectRuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource PrimaryTextBlockStyle}"
                                                       Text="{Binding Name}" />
                                            <TextBlock Grid.Column="1"
                                                       Margin="12,0,0,0"
                                                       Text="当前">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock"
                                                           BasedOn="{StaticResource SecondaryTextBlockStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Margin="0,12,0,0"
                                   Text="尚无可用规则。">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock"
                                       BasedOn="{StaticResource SecondaryTextBlockStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasRules}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button Margin="0,12,0,0"
                                Padding="14,8"
                                HorizontalAlignment="Left"
                                Command="{Binding OpenRulesManagementCommand}"
                                Content="前往规则管理" />
                    </StackPanel>
                </Border>
            </Popup>

            <Popup PlacementTarget="{Binding ElementName=SpeedMenuButton}"
                   Placement="Bottom"
                   HorizontalOffset="0"
                   VerticalOffset="8"
                   AllowsTransparency="True"
                   PopupAnimation="Fade"
                   StaysOpen="False"
                   IsOpen="{Binding IsSpeedMenuOpen, Mode=TwoWay}">
                <Border Width="280"
                        Padding="{StaticResource CardPadding}"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleTextBlockStyle}"
                                   Text="调整语速" />
                        <TextBlock Margin="0,8,0,0"
                                   Style="{StaticResource SecondaryTextBlockStyle}"
                                   Text="输入后端实际使用的原始整数值。" />
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="DecreaseSpeedButton"
                                    Grid.Column="0"
                                    Width="40"
                                    Height="36"
                                    Margin="0,0,8,0"
                                    Command="{Binding DecreaseSpeakSpeedCommand}"
                                    Content="-"
                                    IsEnabled="{Binding CanDecreaseSpeakSpeed}"
                                    ToolTip="降低语速"
                                    AutomationProperties.Name="降低语速" />
                            <TextBox x:Name="SpeedEditorTextBox"
                                     Grid.Column="1"
                                     Height="36"
                                     VerticalContentAlignment="Center"
                                     HorizontalContentAlignment="Center"
                                     PreviewKeyDown="SpeedEditorTextBox_OnPreviewKeyDown"
                                     LostKeyboardFocus="SpeedEditorTextBox_OnLostKeyboardFocus"
                                     Text="{Binding SpeedEditorText, UpdateSourceTrigger=PropertyChanged}" />
                            <Button x:Name="IncreaseSpeedButton"
                                    Grid.Column="2"
                                    Width="40"
                                    Height="36"
                                    Margin="8,0,0,0"
                                    Command="{Binding IncreaseSpeakSpeedCommand}"
                                    Content="+"
                                    IsEnabled="{Binding CanIncreaseSpeakSpeed}"
                                    ToolTip="提高语速"
                                    AutomationProperties.Name="提高语速" />
                        </Grid>
                        <TextBlock Margin="0,8,0,0"
                                   Text="{Binding SpeedEditorErrorText}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock"
                                       BasedOn="{StaticResource ErrorTextBlockStyle}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SpeedEditorErrorText}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>

        <Grid Grid.Row="1"
              Margin="0,20,0,0"
              MinHeight="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="CatalogPanelBorder"
                    MinHeight="0"
                    Padding="{StaticResource CardPaddingLarge}"
                    Style="{StaticResource CardBorderStyle}">
                    <DockPanel LastChildFill="True"
                               MinHeight="0">
                    <TextBlock DockPanel.Dock="Top"
                               Margin="0,0,0,14"
                               Style="{StaticResource SectionTitleTextBlockStyle}"
                               Text="目录" />
                    <ListBox x:Name="WideChaptersListBox"
                             MinHeight="0"
                             ItemsSource="{Binding Chapters}"
                             SelectedItem="{Binding CurrentChapterItem, Mode=OneWay}"
                             BorderThickness="0"
                             Background="Transparent"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.CanContentScroll="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,6" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource ChapterListButtonStyle}"
                                        Command="{Binding DataContext.SelectChapterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Background="{DynamicResource AccentFillColorDefaultBrush}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Opacity" Value="0" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                            <Setter Property="Opacity" Value="1" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>

                                        <Border Grid.Column="1"
                                                Padding="12,8"
                                                CornerRadius="10"
                                                Background="Transparent">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource PrimaryTextBlockStyle}"
                                                           Text="{Binding Title}"
                                                           TextWrapping="NoWrap"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" />
                                                <Border Grid.Column="1"
                                                        Margin="10,0,0,0"
                                                        Padding="8,2"
                                                        CornerRadius="999"
                                                        Background="{DynamicResource LayerFillColorAltBrush}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Style="{StaticResource SecondaryTextBlockStyle}"
                                                               FontWeight="SemiBold"
                                                               Text="当前" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Grid Grid.Column="2"
                  MinHeight="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Padding="{StaticResource CardPadding}"
                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowPlaybackErrorBar}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource ErrorTextBlockStyle}"
                                   Text="{Binding ErrorText}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                        <WrapPanel Grid.Column="1"
                                   Margin="16,0,0,0"
                                   VerticalAlignment="Center">
                            <Button Margin="0,0,8,0"
                                    Padding="14,8"
                                    Command="{Binding RetryCurrentSegmentCommand}"
                                    Content="再次尝试"
                                    ToolTip="再次尝试"
                                    AutomationProperties.Name="再次尝试" />
                            <Button Padding="14,8"
                                    Command="{Binding OpenRuleMenuCommand}"
                                    Content="切换规则"
                                    ToolTip="切换规则"
                                    AutomationProperties.Name="切换规则" />
                        </WrapPanel>
                    </Grid>
                </Border>

                <Border x:Name="PreviewPanelBorder"
                        Grid.Row="1"
                        MinHeight="0"
                        Padding="{StaticResource CardPaddingLarge}">
                    <Border.Style>
                        <Style TargetType="Border"
                               BasedOn="{StaticResource CardBorderStyle}">
                            <Setter Property="Margin" Value="0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowPlaybackErrorBar}" Value="True">
                                    <Setter Property="Margin" Value="0,16,0,0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid MinHeight="0"
                          ClipToBounds="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource SectionTitleTextBlockStyle}"
                                       Text="{Binding CurrentChapterTitle}"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap" />

                            <TextBlock Grid.Column="1"
                                       Text="{Binding DisplayedSegmentCounterText}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock"
                                           BasedOn="{StaticResource SecondaryTextBlockStyle}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowInlineLoadingState}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowInlineLoadingState}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <ProgressBar Width="52"
                                             Height="4"
                                             Margin="0,0,10,0"
                                             VerticalAlignment="Center"
                                             IsIndeterminate="True" />
                                <TextBlock Style="{StaticResource SecondaryTextBlockStyle}"
                                           Text="{Binding InlineLoadingText}" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1"
                              Margin="0,14,0,0"
                              MinHeight="0">
                            <ListBox x:Name="SegmentListBox"
                                     PreviewMouseWheel="SegmentListBox_OnPreviewMouseWheel"
                                     PreviewKeyDown="SegmentListBox_OnPreviewKeyDown"
                                     MinHeight="0"
                                     ItemsSource="{Binding Segments}"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     HorizontalContentAlignment="Stretch"
                                     ScrollViewer.CanContentScroll="True"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.ScrollUnit="Pixel"
                                     VirtualizingPanel.VirtualizationMode="Recycling">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0,0,0,8" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Button Padding="0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                HorizontalContentAlignment="Stretch"
                                                Command="{Binding DataContext.SelectSegmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding IsInteractive}">
                                            <Border Padding="14,6,14,10"
                                                    Background="Transparent"
                                                    CornerRadius="10">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Style="{StaticResource PrimaryTextBlockStyle}"
                                                           Text="{Binding Text}"
                                                           TextWrapping="Wrap"
                                                           Opacity="{Binding VisualOpacity}"
                                                           FontWeight="{Binding FontWeight}"
                                                           LineHeight="28" />
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Button HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Margin="0,0,12,12"
                                    Padding="14,8"
                                    Panel.ZIndex="2"
                                    Command="{Binding ReturnToCurrentSegmentCommand}"
                                    Content="回到当前段">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowReturnToCurrentSegment}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Grid Grid.Row="2"
              Margin="0,20,0,0"
              MinHeight="0">
            <Border x:Name="PlaybackFooterBorder"
                    Padding="{StaticResource CardPadding}">
                <Border.Style>
                    <Style TargetType="Border"
                           BasedOn="{StaticResource CardBorderStyle}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowPlaybackControls}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <WrapPanel HorizontalAlignment="Center">
                        <Button Margin="0,0,12,0"
                                Padding="18,10"
                                IsEnabled="{Binding CanGoToPreviousChapter}"
                                Command="{Binding PreviousChapterCommand}"
                                Content="上一章"
                                ToolTip="上一章"
                                AutomationProperties.Name="上一章" />
                        <Button Margin="0,0,12,0"
                                Padding="18,10"
                                IsEnabled="{Binding CanGoToPreviousSegment}"
                                Command="{Binding PreviousSegmentCommand}"
                                Content="上一段"
                                ToolTip="上一段"
                                AutomationProperties.Name="上一段" />
                        <Button x:Name="PrimaryPlaybackButton"
                                Margin="0,0,12,0"
                                Padding="24,10"
                                IsEnabled="{Binding CanTogglePlayPause}"
                                Command="{Binding TogglePlayPauseCommand}"
                                Content="{Binding PrimaryActionText}"
                                ToolTip="{Binding PrimaryActionText}"
                                AutomationProperties.Name="{Binding PrimaryActionText}" />
                        <Button Margin="0,0,12,0"
                                Padding="18,10"
                                IsEnabled="{Binding CanGoToNextSegment}"
                                Command="{Binding NextSegmentCommand}"
                                Content="下一段"
                                ToolTip="下一段"
                                AutomationProperties.Name="下一段" />
                        <Button Padding="18,10"
                                IsEnabled="{Binding CanGoToNextChapter}"
                                Command="{Binding NextChapterCommand}"
                                Content="下一章"
                                ToolTip="下一章"
                                AutomationProperties.Name="下一章" />
                    </WrapPanel>

                    <Slider x:Name="SegmentProgressSlider"
                            Margin="0,16,0,0"
                            Minimum="0"
                            Maximum="{Binding SegmentProgressMaximum}"
                            Value="{Binding SegmentProgressValue, Mode=OneWay}"
                            IsSnapToTickEnabled="True"
                            TickFrequency="1"
                            ValueChanged="SegmentProgressSlider_OnValueChanged"
                            PreviewMouseLeftButtonDown="SegmentProgressSlider_OnPreviewMouseLeftButtonDown"
                            PreviewMouseLeftButtonUp="SegmentProgressSlider_OnPreviewMouseLeftButtonUp"
                            PreviewKeyDown="SegmentProgressSlider_OnPreviewKeyDown"
                            PreviewKeyUp="SegmentProgressSlider_OnPreviewKeyUp"
                            LostMouseCapture="SegmentProgressSlider_OnLostMouseCapture" />
                </StackPanel>
            </Border>

            <Border x:Name="NoRuleFooterBorder"
                    Padding="{StaticResource CardPaddingLarge}">
                <Border.Style>
                    <Style TargetType="Border"
                           BasedOn="{StaticResource CardBorderStyle}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowNoRuleState}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource SectionTitleTextBlockStyle}"
                               Text="尚无可用的朗读规则" />
                    <TextBlock Margin="0,8,0,0"
                               Style="{StaticResource SecondaryTextBlockStyle}"
                               Text="先前往 TTS 规则页选择或导入一条可用规则，再回到当前书籍位置继续准备播放。"
                               TextWrapping="Wrap" />
                    <Button Margin="0,16,0,0"
                            Padding="14,8"
                            HorizontalAlignment="Left"
                            Command="{Binding OpenRulesManagementCommand}"
                            Content="前往 TTS 规则" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
