<UserControl x:Class="NovelSpeaker.App.Views.PlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             SizeChanged="PlayerView_OnSizeChanged">
    <Grid Margin="{StaticResource PagePadding}"
          ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <WrapPanel>
                    <Button Padding="14,8"
                            Command="{Binding BackCommand}"
                            Content="返回" />
                    <Button Margin="12,0,0,0"
                            Padding="14,8"
                            Command="{Binding ToggleCatalogDrawerCommand}"
                            Content="目录">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCompactLayout}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </WrapPanel>

                <TextBlock Margin="0,16,0,0"
                           Style="{StaticResource PageTitleTextBlockStyle}"
                           Text="{Binding CurrentTitle}"
                           TextWrapping="Wrap" />
                <TextBlock Margin="0,8,0,0"
                           Style="{StaticResource SecondaryTextBlockStyle}"
                           Text="{Binding CurrentAuthor}"
                           TextWrapping="Wrap" />
                <TextBlock Margin="0,8,0,0"
                           Style="{StaticResource StrongTextBlockStyle}"
                           Text="{Binding CurrentChapterTitle}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top">
                <Button x:Name="RuleMenuButton"
                        Padding="14,8"
                        Command="{Binding ToggleRuleMenuCommand}"
                        Content="规则" />
                <Button x:Name="SpeedMenuButton"
                        Margin="12,0,0,0"
                        Padding="14,8"
                        Command="{Binding ToggleSpeedMenuCommand}"
                        Content="{Binding SpeakSpeedButtonText}" />
            </StackPanel>

            <Popup PlacementTarget="{Binding ElementName=RuleMenuButton}"
                   Placement="Bottom"
                   HorizontalOffset="0"
                   VerticalOffset="8"
                   AllowsTransparency="True"
                   PopupAnimation="Fade"
                   StaysOpen="False"
                   IsOpen="{Binding IsRuleMenuOpen, Mode=TwoWay}">
                <Border Width="320"
                        Padding="{StaticResource CardPadding}"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleTextBlockStyle}"
                                   Text="切换规则" />
                        <TextBlock Margin="0,8,0,0"
                                   Style="{StaticResource SecondaryTextBlockStyle}"
                                   Text="当前规则仅在菜单中显示勾选。" />
                        <ItemsControl Margin="0,16,0,0"
                                      ItemsSource="{Binding Rules}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Margin="0,0,0,8"
                                            Padding="12,8"
                                            HorizontalContentAlignment="Stretch"
                                            IsEnabled="{Binding IsEnabled}"
                                            Command="{Binding DataContext.SelectRuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource PrimaryTextBlockStyle}"
                                                       Text="{Binding Name}" />
                                            <TextBlock Grid.Column="1"
                                                       Margin="12,0,0,0"
                                                       Text="当前">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock"
                                                           BasedOn="{StaticResource SecondaryTextBlockStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Margin="0,12,0,0"
                                   Text="尚无可用规则。">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock"
                                       BasedOn="{StaticResource SecondaryTextBlockStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasRules}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button Margin="0,12,0,0"
                                Padding="14,8"
                                HorizontalAlignment="Left"
                                Command="{Binding OpenRulesManagementCommand}"
                                Content="前往规则管理" />
                    </StackPanel>
                </Border>
            </Popup>

            <Popup PlacementTarget="{Binding ElementName=SpeedMenuButton}"
                   Placement="Bottom"
                   HorizontalOffset="0"
                   VerticalOffset="8"
                   AllowsTransparency="True"
                   PopupAnimation="Fade"
                   StaysOpen="False"
                   IsOpen="{Binding IsSpeedMenuOpen, Mode=TwoWay}">
                <Border Width="280"
                        Padding="{StaticResource CardPadding}"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleTextBlockStyle}"
                                   Text="调整语速" />
                        <TextBlock Margin="0,8,0,0"
                                   Style="{StaticResource SecondaryTextBlockStyle}"
                                   Text="输入后端实际使用的原始整数值。" />
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="DecreaseSpeedButton"
                                    Grid.Column="0"
                                    Width="40"
                                    Height="36"
                                    Margin="0,0,8,0"
                                    Command="{Binding DecreaseSpeakSpeedCommand}"
                                    Content="-"
                                    IsEnabled="{Binding CanDecreaseSpeakSpeed}"
                                    ToolTip="降低语速"
                                    AutomationProperties.Name="降低语速" />
                            <TextBox x:Name="SpeedEditorTextBox"
                                     Grid.Column="1"
                                     Height="36"
                                     VerticalContentAlignment="Center"
                                     HorizontalContentAlignment="Center"
                                     PreviewKeyDown="SpeedEditorTextBox_OnPreviewKeyDown"
                                     LostKeyboardFocus="SpeedEditorTextBox_OnLostKeyboardFocus"
                                     Text="{Binding SpeedEditorText, UpdateSourceTrigger=PropertyChanged}" />
                            <Button x:Name="IncreaseSpeedButton"
                                    Grid.Column="2"
                                    Width="40"
                                    Height="36"
                                    Margin="8,0,0,0"
                                    Command="{Binding IncreaseSpeakSpeedCommand}"
                                    Content="+"
                                    IsEnabled="{Binding CanIncreaseSpeakSpeed}"
                                    ToolTip="提高语速"
                                    AutomationProperties.Name="提高语速" />
                        </Grid>
                        <TextBlock Margin="0,8,0,0"
                                   Text="{Binding SpeedEditorErrorText}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock"
                                       BasedOn="{StaticResource ErrorTextBlockStyle}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SpeedEditorErrorText}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>

        <Grid Grid.Row="1"
              Margin="0,20,0,0"
              MinHeight="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Width="300"
                    MinHeight="0"
                    Padding="{StaticResource CardPaddingLarge}">
                <Border.Style>
                    <Style TargetType="Border"
                           BasedOn="{StaticResource CardBorderStyle}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCompactLayout}" Value="True">
                                <Setter Property="Width" Value="0" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Margin="0,0,0,16"
                               Style="{StaticResource SectionTitleTextBlockStyle}"
                               Text="章节目录" />
                    <ListBox x:Name="WideChaptersListBox"
                             ItemsSource="{Binding Chapters}"
                             SelectedItem="{Binding CurrentChapterItem, Mode=OneWay}"
                             BorderThickness="0"
                             Background="Transparent"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.CanContentScroll="True"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="0,0,0,8"
                                        Padding="12,10"
                                        HorizontalContentAlignment="Stretch"
                                        Command="{Binding DataContext.SelectChapterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource PrimaryTextBlockStyle}"
                                                   Text="{Binding Title}"
                                                   TextWrapping="Wrap" />
                                        <Border Grid.Column="1"
                                                Margin="12,0,0,0"
                                                Padding="8,2"
                                                CornerRadius="999"
                                                Background="{DynamicResource AccentFillColorDefaultBrush}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Style="{StaticResource SecondaryTextBlockStyle}"
                                                       Text="当前" />
                                        </Border>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="1"
                    Width="24"
                    Background="Transparent">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCompactLayout}" Value="True">
                                <Setter Property="Width" Value="0" />
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>

            <Grid Grid.Column="2"
                  MinHeight="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Padding="{StaticResource CardPadding}"
                        Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource StatusTextBlockStyle}"
                                   Text="{Binding StatusText}" />
                        <TextBlock Margin="0,8,0,0"
                                   Style="{StaticResource SecondaryTextBlockStyle}"
                                   Text="{Binding DetailText}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1"
                        Margin="0,16,0,0"
                        Padding="{StaticResource CardPadding}"
                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowPlaybackErrorBar}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource ErrorTextBlockStyle}"
                                   Text="{Binding ErrorText}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                        <WrapPanel Grid.Column="1"
                                   Margin="16,0,0,0"
                                   VerticalAlignment="Center">
                            <Button Margin="0,0,8,0"
                                    Padding="14,8"
                                    Command="{Binding RetryCurrentSegmentCommand}"
                                    Content="再次尝试"
                                    ToolTip="再次尝试"
                                    AutomationProperties.Name="再次尝试" />
                            <Button Padding="14,8"
                                    Command="{Binding OpenRuleMenuCommand}"
                                    Content="切换规则"
                                    ToolTip="切换规则"
                                    AutomationProperties.Name="切换规则" />
                        </WrapPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="2"
                        Margin="0,20,0,0"
                        MinHeight="0"
                        Padding="{StaticResource CardPaddingLarge}"
                        Style="{StaticResource CardBorderStyle}">
                    <Grid ClipToBounds="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource SectionTitleTextBlockStyle}"
                                       Text="正文预览" />
                            <TextBlock Grid.Column="1"
                                       Style="{StaticResource SecondaryTextBlockStyle}"
                                       Text="{Binding DisplayedSegmentCounterText}" />
                        </Grid>

                        <Grid Grid.Row="1"
                              Margin="0,16,0,0"
                              MinHeight="0">
                            <ListBox x:Name="SegmentListBox"
                                     PreviewMouseWheel="SegmentListBox_OnPreviewMouseWheel"
                                     PreviewKeyDown="SegmentListBox_OnPreviewKeyDown"
                                     MinHeight="0"
                                     ItemsSource="{Binding Segments}"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     HorizontalContentAlignment="Stretch"
                                     ScrollViewer.CanContentScroll="True"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Button Margin="0,0,0,14"
                                                Padding="0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                HorizontalContentAlignment="Stretch"
                                                Command="{Binding DataContext.SelectSegmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding IsInteractive}">
                                            <Border Padding="16,8,16,12"
                                                    Background="Transparent"
                                                    CornerRadius="10">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Style="{StaticResource PrimaryTextBlockStyle}"
                                                           Text="{Binding Text}"
                                                           TextWrapping="Wrap"
                                                           Opacity="{Binding VisualOpacity}"
                                                           FontWeight="{Binding FontWeight}"
                                                           LineHeight="30" />
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Button HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Margin="0,0,12,12"
                                    Padding="14,8"
                                    Panel.ZIndex="2"
                                    Command="{Binding ReturnToCurrentSegmentCommand}"
                                    Content="回到当前段">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowReturnToCurrentSegment}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="3"
                        Margin="0,20,0,0"
                        Padding="{StaticResource CardPadding}">
                    <Border.Style>
                        <Style TargetType="Border"
                               BasedOn="{StaticResource CardBorderStyle}">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowPlaybackControls}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <WrapPanel HorizontalAlignment="Center">
                        <Button Margin="0,0,12,0"
                                Padding="18,10"
                                IsEnabled="{Binding CanGoToPreviousChapter}"
                                Command="{Binding PreviousChapterCommand}"
                                Content="上一章"
                                ToolTip="上一章"
                                AutomationProperties.Name="上一章" />
                        <Button Margin="0,0,12,0"
                                Padding="18,10"
                                IsEnabled="{Binding CanGoToPreviousSegment}"
                                Command="{Binding PreviousSegmentCommand}"
                                Content="上一段"
                                ToolTip="上一段"
                                AutomationProperties.Name="上一段" />
                        <Button Margin="0,0,12,0"
                                Padding="24,10"
                                IsEnabled="{Binding CanTogglePlayPause}"
                                Command="{Binding TogglePlayPauseCommand}"
                                Content="{Binding PrimaryActionText}"
                                ToolTip="{Binding PrimaryActionText}"
                                AutomationProperties.Name="{Binding PrimaryActionText}" />
                        <Button Margin="0,0,12,0"
                                Padding="18,10"
                                IsEnabled="{Binding CanGoToNextSegment}"
                                Command="{Binding NextSegmentCommand}"
                                Content="下一段"
                                ToolTip="下一段"
                                AutomationProperties.Name="下一段" />
                        <Button Padding="18,10"
                                IsEnabled="{Binding CanGoToNextChapter}"
                                Command="{Binding NextChapterCommand}"
                                Content="下一章"
                                ToolTip="下一章"
                                AutomationProperties.Name="下一章" />
                    </WrapPanel>
                </Border>

                <Border Grid.Row="4"
                        Margin="0,16,0,0"
                        Padding="{StaticResource CardPadding}">
                    <Border.Style>
                        <Style TargetType="Border"
                               BasedOn="{StaticResource CardBorderStyle}">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowPlaybackControls}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <Slider x:Name="SegmentProgressSlider"
                                Minimum="0"
                                Maximum="{Binding SegmentProgressMaximum}"
                                Value="{Binding SegmentProgressValue, Mode=OneWay}"
                                IsSnapToTickEnabled="True"
                                TickFrequency="1"
                                ValueChanged="SegmentProgressSlider_OnValueChanged"
                                PreviewMouseLeftButtonDown="SegmentProgressSlider_OnPreviewMouseLeftButtonDown"
                                PreviewMouseLeftButtonUp="SegmentProgressSlider_OnPreviewMouseLeftButtonUp"
                                PreviewKeyDown="SegmentProgressSlider_OnPreviewKeyDown"
                                PreviewKeyUp="SegmentProgressSlider_OnPreviewKeyUp"
                                LostMouseCapture="SegmentProgressSlider_OnLostMouseCapture" />
                        <TextBlock Margin="0,10,0,0"
                                   HorizontalAlignment="Center"
                                   Style="{StaticResource SecondaryTextBlockStyle}"
                                   Text="{Binding DisplayedSegmentCounterText}" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="3"
                        Grid.RowSpan="2"
                        Margin="0,20,0,0"
                        Padding="{StaticResource CardPaddingLarge}">
                    <Border.Style>
                        <Style TargetType="Border"
                               BasedOn="{StaticResource CardBorderStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowNoRuleState}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource SectionTitleTextBlockStyle}"
                                   Text="尚无可用的朗读规则" />
                        <TextBlock Margin="0,8,0,0"
                                   Style="{StaticResource SecondaryTextBlockStyle}"
                                   Text="先前往 TTS 规则页选择或导入一条可用规则，再回到当前书籍位置继续准备播放。"
                                   TextWrapping="Wrap" />
                        <Button Margin="0,16,0,0"
                                Padding="14,8"
                                HorizontalAlignment="Left"
                                Command="{Binding OpenRulesManagementCommand}"
                                Content="前往 TTS 规则" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.ColumnSpan="3"
                    Background="{DynamicResource LayerFillColorAltBrush}"
                    Panel.ZIndex="5">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsCompactLayout}" Value="True" />
                                    <Condition Binding="{Binding IsCatalogDrawerOpen}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border Width="320"
                        Padding="{StaticResource CardPaddingLarge}"
                        HorizontalAlignment="Left"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top"
                              Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource SectionTitleTextBlockStyle}"
                                       Text="章节目录" />
                            <Button Grid.Column="1"
                                    Padding="12,6"
                                    Command="{Binding ToggleCatalogDrawerCommand}"
                                    Content="关闭" />
                        </Grid>
                        <ListBox x:Name="DrawerChaptersListBox"
                                 ItemsSource="{Binding Chapters}"
                                 SelectedItem="{Binding CurrentChapterItem, Mode=OneWay}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.CanContentScroll="True"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Button Margin="0,0,0,8"
                                            Padding="12,10"
                                            HorizontalContentAlignment="Stretch"
                                            Command="{Binding DataContext.SelectChapterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource PrimaryTextBlockStyle}"
                                                       Text="{Binding Title}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="1"
                                                       Margin="12,0,0,0"
                                                       Text="当前">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock"
                                                           BasedOn="{StaticResource SecondaryTextBlockStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Border>
        </Grid>
    </Grid>
</UserControl>
