<UserControl x:Class="NovelSpeaker.App.Views.RegexReplacementRulesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal"><Button Style="{StaticResource BackIconButtonStyle}" Command="{Binding BackCommand}" ToolTip="返回" AutomationProperties.Name="返回"><ui:SymbolIcon Symbol="ChevronLeft24"/></Button><TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource PageTitleTextBlockStyle}" Text="正则替换"/></StackPanel>
            <Button Grid.Column="1" Padding="16,8" Command="{Binding NewRuleCommand}" Content="新建规则" />
        </Grid>
        <Grid Grid.Row="1" Margin="0,20,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="320"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}"><DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="16"><TextBlock Style="{StaticResource SectionTitleTextBlockStyle}" Text="规则列表"/><TextBlock Margin="0,6,0,0" Style="{StaticResource SecondaryTextBlockStyle}" Text="{Binding Rules.Count, StringFormat=共 {0} 条规则}"/></StackPanel>
                <ListBox Margin="8,0,8,8" BorderThickness="0" ItemsSource="{Binding Rules}" SelectedValuePath="Id" SelectedValue="{Binding SelectedRuleId}"><ListBox.ItemTemplate><DataTemplate><Grid Margin="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button HorizontalContentAlignment="Stretch" Command="{Binding DataContext.SelectRuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding AutomationName}"><StackPanel><TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="{Binding Name}"/><TextBlock Style="{StaticResource SecondaryTextBlockStyle}" Text="{Binding PatternSummary}" TextTrimming="CharacterEllipsis"/><TextBlock Style="{StaticResource SecondaryTextBlockStyle}" Text="{Binding Scope}"/><TextBlock Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}" Text="{Binding ErrorMessage}" Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}"/></StackPanel></Button><StackPanel Grid.Column="1"><Button Style="{StaticResource SecondaryIconButtonStyle}" Command="{Binding DataContext.ToggleEnabledCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ToolTip="启用或禁用" AutomationProperties.Name="启用或禁用"><ui:SymbolIcon Symbol="CheckmarkCircle24"/></Button><Button Style="{StaticResource SecondaryIconButtonStyle}" Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ToolTip="上移" AutomationProperties.Name="上移"><ui:SymbolIcon Symbol="ArrowUp24"/></Button><Button Style="{StaticResource SecondaryIconButtonStyle}" Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ToolTip="下移" AutomationProperties.Name="下移"><ui:SymbolIcon Symbol="ArrowDown24"/></Button></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
            </DockPanel></Border>
            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="24"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Style="{StaticResource SectionTitleTextBlockStyle}" Text="规则编辑"/><TextBlock Margin="0,20,0,0" Style="{StaticResource BodyTextBlockStyle}" Text="名称"/><TextBox Text="{Binding DraftName, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Margin="0,16,0,0" Style="{StaticResource BodyTextBlockStyle}" Text="正则表达式"/><TextBox AcceptsReturn="True" MinHeight="72" Text="{Binding DraftPattern, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Margin="0,16,0,0" Style="{StaticResource BodyTextBlockStyle}" Text="替换文本"/><TextBox AcceptsReturn="True" MinHeight="72" Text="{Binding DraftReplacement, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Margin="0,16,0,0" Style="{StaticResource BodyTextBlockStyle}" Text="作用范围"/><ComboBox ItemsSource="{Binding Scopes}" SelectedItem="{Binding DraftScope}"/><TextBlock Margin="0,8,0,0" Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}" Text="{Binding ValidationMessage}"/><StackPanel Margin="0,24,0,0" Orientation="Horizontal"><Button Margin="0,0,8,0" Command="{Binding DeleteCommand}" Content="删除"/><Button Margin="0,0,8,0" Command="{Binding CancelCommand}" Content="取消"/><Button Command="{Binding SaveCommand}" Content="保存"/></StackPanel></StackPanel></ScrollViewer></Border>
        </Grid>
    </Grid>
</UserControl>
