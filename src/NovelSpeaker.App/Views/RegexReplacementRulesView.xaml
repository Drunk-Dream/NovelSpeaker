<UserControl x:Class="NovelSpeaker.App.Views.RegexReplacementRulesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="{StaticResource PagePadding}"
          MinHeight="0"
          ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource BackIconButtonStyle}"
                        Command="{Binding BackCommand}"
                        ToolTip="返回"
                        AutomationProperties.Name="返回">
                    <ui:SymbolIcon Symbol="ChevronLeft24" />
                </Button>
                <TextBlock Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Style="{StaticResource PageTitleTextBlockStyle}"
                           Text="正则替换" />
            </StackPanel>

            <Button Grid.Column="1"
                    Padding="16,8"
                    Command="{Binding NewRuleCommand}"
                    Content="新建规则" />
        </Grid>

        <Grid Grid.Row="1"
              Margin="0,20,0,0"
              MinHeight="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource CardBorderStyle}">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top"
                                Margin="16,16,16,12">
                        <TextBlock Style="{StaticResource SectionTitleTextBlockStyle}"
                                   Text="规则列表" />
                        <TextBlock Margin="0,6,0,0"
                                   Style="{StaticResource SecondaryTextBlockStyle}"
                                   Text="{Binding Rules.Count, StringFormat=共 {0} 条规则}" />
                    </StackPanel>

                    <TextBlock Margin="16,0,16,16"
                               Text="还没有替换规则，使用右上角按钮新建一条。">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock"
                                   BasedOn="{StaticResource SecondaryTextBlockStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Rules.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ScrollViewer Margin="12,0,12,12"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Rules}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource SelectableListItemContainerStyle}"
                                            AutomationProperties.Name="{Binding AutomationName}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Button Style="{StaticResource BorderlessListItemButtonStyle}"
                                                    Command="{Binding DataContext.SelectRuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource StrongTextBlockStyle}"
                                                               Text="{Binding Name}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Margin="0,8,0,0"
                                                               Style="{StaticResource SecondaryTextBlockStyle}"
                                                               Text="{Binding PatternSummary}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Button>

                                            <Grid Grid.Row="1"
                                                  Margin="0,12,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <CheckBox Grid.Column="0"
                                                          VerticalAlignment="Center"
                                                          IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                                          Command="{Binding DataContext.ToggleEnabledCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="{Binding}"
                                                          Content="{Binding EnabledStateText}"
                                                          ToolTip="切换规则启用状态"
                                                          AutomationProperties.Name="{Binding EnabledStateText, StringFormat=规则状态：{0}}" />

                                                <Button Grid.Column="2"
                                                        Style="{StaticResource SecondaryIconButtonStyle}"
                                                        Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="上移"
                                                        AutomationProperties.Name="上移">
                                                    <ui:SymbolIcon Symbol="ArrowUp24" />
                                                </Button>

                                                <Button Grid.Column="4"
                                                        Style="{StaticResource SecondaryIconButtonStyle}"
                                                        Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="下移"
                                                        AutomationProperties.Name="下移">
                                                    <ui:SymbolIcon Symbol="ArrowDown24" />
                                                </Button>
                                            </Grid>

                                            <TextBlock Grid.Row="2"
                                                       Margin="0,10,0,0"
                                                       Text="{Binding ErrorMessage}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock"
                                                           BasedOn="{StaticResource ErrorTextBlockStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border Grid.Column="2"
                    Style="{StaticResource CardBorderStyle}">
                <ScrollViewer Margin="24"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleTextBlockStyle}"
                                   Text="规则编辑" />

                        <TextBlock Margin="0,20,0,0"
                                   Style="{StaticResource FormLabelTextBlockStyle}"
                                   Text="名称" />
                        <TextBox Text="{Binding DraftName, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Margin="0,16,0,0"
                                   Style="{StaticResource FormLabelTextBlockStyle}"
                                   Text="正则表达式" />
                        <TextBox AcceptsReturn="True"
                                 MinHeight="72"
                                 Text="{Binding DraftPattern, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Margin="0,16,0,0"
                                   Style="{StaticResource FormLabelTextBlockStyle}"
                                   Text="替换文本" />
                        <TextBox AcceptsReturn="True"
                                 MinHeight="72"
                                 Text="{Binding DraftReplacement, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Margin="0,16,0,0"
                                   Style="{StaticResource FormLabelTextBlockStyle}"
                                   Text="作用范围" />
                        <ComboBox ItemsSource="{Binding Scopes}"
                                  SelectedItem="{Binding DraftScope}" />

                        <TextBlock Margin="0,8,0,0"
                                   Style="{StaticResource ErrorTextBlockStyle}"
                                   Text="{Binding ValidationMessage}" />

                        <StackPanel Margin="0,24,0,0"
                                    Orientation="Horizontal">
                            <Button Margin="0,0,8,0"
                                    Command="{Binding DeleteCommand}"
                                    Content="删除" />
                            <Button Margin="0,0,8,0"
                                    Command="{Binding CancelCommand}"
                                    Content="取消" />
                            <Button Command="{Binding SaveCommand}"
                                    Content="保存" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
