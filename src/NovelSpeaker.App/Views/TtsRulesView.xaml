<UserControl x:Class="NovelSpeaker.App.Views.TtsRulesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False">
        <StackPanel>
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitleTextBlockStyle}" Text="TTS 规则" />
                <TextBlock Margin="0,8,0,0"
                           Style="{StaticResource SecondaryTextBlockStyle}"
                           Text="{Binding StatusMessage}" />
                <TextBlock Margin="0,8,0,0"
                           Style="{StaticResource StrongTextBlockStyle}"
                           Text="{Binding CurrentRuleDisplayText}" />
                <WrapPanel Margin="0,12,0,0">
                    <Button Margin="0,0,12,12" Padding="18,10" Content="从文件导入" Click="ImportFromFileButton_OnClick" />
                    <Button Margin="0,0,12,12" Padding="18,10" Content="从剪贴板导入" Click="ImportFromClipboardButton_OnClick" />
                    <Button Margin="0,0,12,12" Padding="18,10" Content="导出所选规则" Click="ExportSelectedRuleButton_OnClick" />
                </WrapPanel>
            </StackPanel>

            <Border Margin="0,12,0,16"
                    Padding="16"
                    Style="{StaticResource CardBorderStyle}"
                    Visibility="{Binding IsPreviewVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleTextBlockStyle}"
                               Text="导入预览" />
                    <TextBlock Margin="0,8,0,0"
                               Style="{StaticResource SecondaryTextBlockStyle}"
                               Text="{Binding PreviewSourceDescription}" />
                    <TextBlock Margin="0,8,0,0"
                               Style="{StaticResource PrimaryTextBlockStyle}"
                               TextWrapping="Wrap"
                               Text="{Binding PreviewStatusMessage}" />
                    <DataGrid Margin="0,12,0,0"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              MaxHeight="260"
                              ItemsSource="{Binding PreviewItems}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="180" />
                            <DataGridTextColumn Header="URL" Binding="{Binding Url}" Width="*" />
                            <DataGridTextColumn Header="兼容性" Binding="{Binding CompatibilityStatus}" Width="160" />
                            <DataGridTextColumn Header="未支持字段" Binding="{Binding UnsupportedFieldsSummary}" Width="220" />
                            <DataGridTextColumn Header="状态" Binding="{Binding StatusMessage}" Width="280" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <WrapPanel Margin="0,12,0,0">
                        <Button Margin="0,0,12,0"
                                Padding="18,10"
                                Command="{Binding ConfirmImportCommand}"
                                Content="确认导入" />
                        <Button Padding="18,10"
                                Command="{Binding CancelPreviewCommand}"
                                Content="取消预览" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Margin="0,0,0,16"
                    Padding="16"
                    Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleTextBlockStyle}"
                               Text="规则试听" />
                    <TextBlock Margin="0,8,0,0"
                               Style="{StaticResource SecondaryTextBlockStyle}"
                               Text="{Binding TestStatusMessage}" />

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource StrongTextBlockStyle}" Text="试听文本" />
                            <TextBox Margin="0,6,0,0"
                                     MinHeight="90"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Text="{Binding TestSpeakText, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Margin="0,12,0,0"
                                       Style="{StaticResource StrongTextBlockStyle}"
                                       Text="临时登录信息" />
                            <TextBlock Margin="0,6,0,0"
                                       Style="{StaticResource SecondaryTextBlockStyle}"
                                       Text="每行一个 key=value，仅用于当前规则页测试，不会持久化。" />
                            <TextBox Margin="0,6,0,0"
                                     MinHeight="90"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Text="{Binding LoginInfoText, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource StrongTextBlockStyle}" Text="试听语速" />
                            <TextBox Margin="0,6,0,0"
                                     Width="120"
                                     Text="{Binding TestSpeakSpeed, UpdateSourceTrigger=PropertyChanged}" />

                            <WrapPanel Margin="0,18,0,0">
                                <Button Margin="0,0,12,8"
                                        Padding="18,10"
                                        Command="{Binding GeneratePreviewCommand}"
                                        Content="生成预览" />
                                <Button Margin="0,0,12,8"
                                        Padding="18,10"
                                        Command="{Binding TestSelectedRuleCommand}"
                                        Content="开始试听" />
                                <Button Margin="0,0,12,8"
                                        Padding="18,10"
                                        Command="{Binding CancelTestCommand}"
                                        Content="取消" />
                                <Button Margin="0,0,12,8"
                                        Padding="18,10"
                                        Command="{Binding ClearRuleCookiesCommand}"
                                        Content="清除 Cookie" />
                            </WrapPanel>

                            <TextBlock Margin="0,10,0,0"
                                       Style="{StaticResource StrongTextBlockStyle}"
                                       Text="{Binding LastResponseStatusText}" />
                            <TextBox Margin="0,6,0,0"
                                     MinHeight="90"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     Text="{Binding LastResponseDetailText}" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Style="{StaticResource StrongTextBlockStyle}" Text="方法" />
                        <TextBox Grid.Column="1"
                                 Margin="12,0,0,8"
                                 IsReadOnly="True"
                                 Text="{Binding PreviewMethodText}" />

                        <TextBlock Grid.Row="1"
                                   Style="{StaticResource StrongTextBlockStyle}"
                                   Text="URL" />
                        <TextBox Grid.Row="1"
                                 Grid.Column="1"
                                 Margin="12,0,0,8"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 Text="{Binding PreviewUrlText}" />

                        <TextBlock Grid.Row="2"
                                   Style="{StaticResource StrongTextBlockStyle}"
                                   Text="Headers" />
                        <TextBox Grid.Row="2"
                                 Grid.Column="1"
                                 Margin="12,0,0,8"
                                 MinHeight="72"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 Text="{Binding PreviewHeadersText}" />

                        <TextBlock Grid.Row="3"
                                   Style="{StaticResource StrongTextBlockStyle}"
                                   Text="Body" />
                        <TextBox Grid.Row="3"
                                 Grid.Column="1"
                                 Margin="12,0,0,8"
                                 MinHeight="72"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 Text="{Binding PreviewBodyText}" />

                        <StackPanel Grid.Row="4"
                                    Grid.ColumnSpan="2"
                                    Margin="0,4,0,0">
                            <TextBlock Style="{StaticResource StrongTextBlockStyle}"
                                       Text="{Binding PreviewDeclaredContentTypeText, StringFormat=声明 Content-Type：{0}}" />
                            <TextBox Margin="0,8,0,0"
                                     MinHeight="52"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     Text="{Binding PreviewWarningsText, StringFormat=编译告警：{0}}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <DataGrid AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      MaxHeight="360"
                      ItemsSource="{Binding Rules}"
                      SelectedItem="{Binding SelectedRule, Mode=TwoWay}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="180" />
                    <DataGridCheckBoxColumn Header="启用" Binding="{Binding IsEnabled}" Width="70" />
                    <DataGridCheckBoxColumn Header="当前" Binding="{Binding IsSelected}" Width="70" />
                    <DataGridTextColumn Header="最近使用" Binding="{Binding LastUsedAt}" Width="190" />
                    <DataGridTextColumn Header="兼容状态" Binding="{Binding CompatibilityStatus}" Width="150" />
                    <DataGridTextColumn Header="未支持字段" Binding="{Binding UnsupportedFieldsSummary}" Width="200" />
                    <DataGridTemplateColumn Header="操作" Width="260">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <WrapPanel>
                                    <Button Margin="0,0,8,4"
                                            Padding="10,4"
                                            Command="{Binding DataContext.SetCurrentRuleCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Content="设为当前" />
                                    <Button Margin="0,0,8,4"
                                            Padding="10,4"
                                            Command="{Binding DataContext.ToggleRuleEnabledCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Content="启用/禁用" />
                                    <Button Margin="0,0,8,4"
                                            Padding="10,4"
                                            Command="{Binding DataContext.DeleteRuleCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Content="删除" />
                                </WrapPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
