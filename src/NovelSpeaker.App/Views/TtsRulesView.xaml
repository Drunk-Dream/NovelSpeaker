<UserControl x:Class="NovelSpeaker.App.Views.TtsRulesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

    </UserControl.Resources>

    <Grid Margin="{StaticResource PagePadding}"
          MinHeight="0"
          ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button x:Name="BackButton"
                        Style="{StaticResource BackIconButtonStyle}"
                        Command="{Binding BackCommand}"
                        ToolTip="返回"
                        AutomationProperties.Name="返回">
                    <ui:SymbolIcon Symbol="ChevronLeft24" />
                </Button>

                <TextBlock Grid.Column="1"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Style="{StaticResource PageTitleTextBlockStyle}"
                           Text="TTS 规则" />
            </Grid>

            <WrapPanel Grid.Column="1"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center">
                <Button Margin="0,0,12,0"
                        Padding="16,8"
                        Command="{Binding NewRuleCommand}"
                        Content="新建规则" />
                <Button Margin="0,0,12,0"
                        Padding="16,8"
                        Click="ImportFromFileButton_OnClick"
                        Content="导入文件" />
                <Button Margin="0,0,12,0"
                        Padding="16,8"
                        Click="ImportFromClipboardButton_OnClick"
                        Content="从剪贴板" />
                <Button Style="{StaticResource SecondaryIconButtonStyle}"
                        Command="{Binding OpenHelpCommand}"
                        ToolTip="规则编写帮助"
                        AutomationProperties.Name="规则编写帮助">
                    <ui:SymbolIcon Symbol="QuestionCircle24" />
                </Button>
            </WrapPanel>
        </Grid>

        <Grid Grid.Row="1"
              Margin="0,20,0,0"
              MinHeight="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="0"
                    Style="{StaticResource CardBorderStyle}">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top"
                                Margin="16,16,16,12">
                        <TextBlock Style="{StaticResource SectionTitleTextBlockStyle}"
                                   Text="规则列表" />
                        <TextBlock Margin="0,6,0,0"
                                   Style="{StaticResource SecondaryTextBlockStyle}"
                                   Text="{Binding Rules.Count, StringFormat=共 {0} 条规则}" />
                    </StackPanel>

                    <TextBlock Margin="16,0,16,16"
                               Text="还没有规则，先新建或导入一条。">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock"
                                   BasedOn="{StaticResource SecondaryTextBlockStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Rules.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ScrollViewer x:Name="RulesListScrollViewer"
                                  Margin="12,0,12,12"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Rules}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource SelectableListItemButtonStyle}"
                                            Command="{Binding DataContext.SelectRuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            AutomationProperties.Name="{Binding AutomationName}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Style="{StaticResource StrongTextBlockStyle}"
                                                       Text="{Binding Name}"
                                                       TextTrimming="CharacterEllipsis" />

                                            <TextBlock Grid.Column="1"
                                                       Margin="12,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Text="当前">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock"
                                                           BasedOn="{StaticResource StrongTextBlockStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Setter Property="Foreground" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <TextBlock Grid.Row="1"
                                                       Grid.ColumnSpan="2"
                                                       Margin="0,8,0,0"
                                                       Text="{Binding IsEnabled, StringFormat=状态：{0}}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock"
                                                           BasedOn="{StaticResource SecondaryTextBlockStyle}">
                                                        <Setter Property="Text" Value="状态：已启用" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                                <Setter Property="Text" Value="状态：已禁用" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border Grid.Column="2"
                    Style="{StaticResource CardBorderStyle}">
                <Grid MinHeight="0">
                    <Border Margin="20"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            MaxWidth="420">
                        <Border.Style>
                            <Style TargetType="Border"
                                   BasedOn="{StaticResource CardBorderStyle}">
                                <Setter Property="Padding" Value="20" />
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasEditor}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock HorizontalAlignment="Center"
                                       Style="{StaticResource SectionTitleTextBlockStyle}"
                                       Text="选择一条规则" />
                            <TextBlock Margin="0,10,0,0"
                                       HorizontalAlignment="Center"
                                       Style="{StaticResource SecondaryTextBlockStyle}"
                                       Text="左侧选择已有规则，或使用顶部按钮新建、导入规则。"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <ScrollViewer x:Name="RuleEditorScrollViewer"
                                  Margin="20"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasEditor}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>

                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitleTextBlockStyle}"
                                       Text="规则编辑" />

                            <Grid Margin="0,20,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource StrongTextBlockStyle}"
                                               Text="名称" />
                                    <TextBox Margin="0,6,0,0"
                                             Text="{Binding DraftName, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource StrongTextBlockStyle}"
                                               Text="启用" />
                                    <CheckBox Margin="0,8,0,0"
                                              IsChecked="{Binding DraftIsEnabled}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Margin="0,18,0,0"
                                       Style="{StaticResource StrongTextBlockStyle}"
                                       Text="请求 URL / 模板" />
                            <TextBox Margin="0,6,0,0"
                                     AcceptsReturn="True"
                                     MinHeight="74"
                                     TextWrapping="Wrap"
                                     Text="{Binding DraftUrl, UpdateSourceTrigger=PropertyChanged}" />

                            <Grid Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource StrongTextBlockStyle}"
                                               Text="请求方法" />
                                    <ComboBox Margin="0,6,0,0"
                                              SelectedValue="{Binding DraftRequestMethod}"
                                              SelectedValuePath="Content">
                                        <ComboBoxItem Content="GET" />
                                        <ComboBoxItem Content="POST" />
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource StrongTextBlockStyle}"
                                               Text="Content-Type" />
                                    <TextBox Margin="0,6,0,0"
                                             Text="{Binding DraftContentType, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Margin="0,22,0,0"
                                       Style="{StaticResource StrongTextBlockStyle}"
                                       Text="Header" />
                            <ItemsControl Margin="0,8,0,0"
                                          ItemsSource="{Binding HeaderEntries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="180" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0"
                                                     Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBox Grid.Column="2"
                                                     Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button Grid.Column="4"
                                                    Style="{StaticResource BorderlessIconButtonStyle}"
                                                    Command="{Binding DataContext.RemoveHeaderEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="删除 Header"
                                                    AutomationProperties.Name="删除 Header">
                                                <ui:SymbolIcon Symbol="Delete24" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button HorizontalAlignment="Left"
                                    Padding="14,8"
                                    Command="{Binding AddHeaderEntryCommand}"
                                    Content="添加 Header" />

                            <StackPanel Margin="0,22,0,0">
                                <TextBlock Style="{StaticResource StrongTextBlockStyle}"
                                           Text="并发限制" />
                                <TextBox Margin="0,6,0,0"
                                         Text="{Binding DraftConcurrentRate, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="格式：次数/毫秒，例如 2/1000" />
                            </StackPanel>

                            <StackPanel Margin="0,22,0,0"
                                        Visibility="{Binding IsPostMethod, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Style="{StaticResource StrongTextBlockStyle}"
                                           Text="请求体" />
                                <TextBox Margin="0,6,0,0"
                                         AcceptsReturn="True"
                                         MinHeight="90"
                                         TextWrapping="Wrap"
                                         Text="{Binding DraftRequestBody, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <WrapPanel Margin="0,24,0,0">
                                <Button Margin="0,0,12,12"
                                        Padding="16,8"
                                        Command="{Binding SetCurrentRuleCommand}"
                                        Content="设为当前"
                                        IsEnabled="{Binding CanSetCurrentRule}" />
                                <Button Margin="0,0,12,12"
                                        Padding="16,8"
                                        Command="{Binding TestDraftCommand}"
                                        Content="试听"
                                        IsEnabled="{Binding CanTestDraft}" />
                                <Button Margin="0,0,12,12"
                                        Padding="16,8"
                                        Click="ExportDraftButton_OnClick"
                                        Content="导出"
                                        IsEnabled="{Binding CanExportDraft}" />
                                <Button Margin="0,0,12,12"
                                        Padding="16,8"
                                        Command="{Binding DeleteRuleCommand}"
                                        Content="删除"
                                        IsEnabled="{Binding CanDeleteCurrentRule}" />
                                <Button Margin="0,0,12,12"
                                        Padding="16,8"
                                        Command="{Binding CancelEditingCommand}"
                                        Content="取消"
                                        IsEnabled="{Binding CanCancelEditing}" />
                                <Button Margin="0,0,12,12"
                                        Padding="16,8"
                                        Command="{Binding SaveDraftCommand}"
                                        Content="保存"
                                        IsEnabled="{Binding CanSaveDraft}" />
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Grid Grid.ColumnSpan="3"
                  Panel.ZIndex="10"
                  Visibility="{Binding IsHelpDrawerOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="380" />
                </Grid.ColumnDefinitions>

                <Button x:Name="HelpDrawerDismissOverlay"
                        Grid.Column="0"
                        AutomationProperties.Name="关闭规则帮助"
                        ToolTip="关闭规则帮助"
                        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                        BorderThickness="0"
                        Command="{Binding CloseHelpCommand}" />

                <Border x:Name="HelpDrawerBorder"
                        Grid.Column="1"
                        Padding="20"
                        Style="{StaticResource PopupSurfaceBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource SectionTitleTextBlockStyle}"
                                       Text="规则编写帮助" />
                            <Button Grid.Column="1"
                                    Style="{StaticResource SecondaryIconButtonStyle}"
                                    Command="{Binding CloseHelpCommand}"
                                    ToolTip="关闭帮助"
                                    AutomationProperties.Name="关闭帮助">
                                <ui:SymbolIcon Symbol="Dismiss24" />
                            </Button>
                        </Grid>

                        <ScrollViewer Grid.Row="1"
                                      Margin="0,16,0,0"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock Style="{StaticResource StrongTextBlockStyle}" Text="从零开始" />
                                <TextBlock Margin="0,8,0,0"
                                           Style="{StaticResource SecondaryTextBlockStyle}"
                                           Text="先新建规则，填写名称和服务商提供的完整 HTTP/HTTPS 地址；再选择 GET 或 POST，填入服务要求的参数，保存后点击“试听”。试听成功后再设为当前规则。"
                                           TextWrapping="Wrap" />

                                <TextBlock Margin="0,18,0,0"
                                           Style="{StaticResource StrongTextBlockStyle}"
                                           Text="GET 示例" />
                                <TextBlock Margin="0,8,0,0"
                                           Style="{StaticResource SecondaryTextBlockStyle}"
                                           Text="适用于服务把文本和语速放在 URL 查询参数中的情况。将地址替换为你的服务地址，保留模板部分。"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,8,0,0"
                                           FontFamily="Consolas"
                                           Style="{StaticResource SecondaryTextBlockStyle}"
                                           TextWrapping="Wrap">https://example.com/tts?text={{encodeURIComponent(speakText)}}&amp;speed={{speakSpeed}}</TextBlock>

                                <TextBlock Margin="0,18,0,0"
                                           Style="{StaticResource StrongTextBlockStyle}"
                                           Text="POST JSON 示例" />
                                <TextBlock Margin="0,8,0,0"
                                           Style="{StaticResource SecondaryTextBlockStyle}"
                                           Text="请求方法选择 POST；Header 添加 Content-Type：application/json；请求体填写以下内容。JSON.stringify 会正确处理文本中的引号和换行。"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,8,0,0"
                                           FontFamily="Consolas"
                                           Style="{StaticResource SecondaryTextBlockStyle}"
                                           TextWrapping="Wrap">{{&quot;text&quot;:{{JSON.stringify(speakText)}},&quot;speed&quot;:{{speakSpeed}}}}</TextBlock>

                                <TextBlock Margin="0,18,0,0"
                                           Style="{StaticResource StrongTextBlockStyle}"
                                           Text="字段怎么填" />
                                <TextBlock Margin="0,8,0,0"
                                           Style="{StaticResource SecondaryTextBlockStyle}"
                                           Text="名称和 URL 必填，URL 必须是绝对地址。Content-Type 用来声明期望返回的音频类型，例如 audio/mpeg；它不是请求体格式。Header 可填写鉴权信息，但不要在截图、导出内容或日志中泄露密钥。请求体只用于 POST。"
                                           TextWrapping="Wrap" />

                                <TextBlock Margin="0,18,0,0"
                                           Style="{StaticResource StrongTextBlockStyle}"
                                           Text="Header、请求体与限流" />
                                <TextBlock Margin="0,8,0,0"
                                           Style="{StaticResource SecondaryTextBlockStyle}"
                                           Text="请求体格式由 Header 中的 Content-Type 决定：application/json 发送 JSON，application/x-www-form-urlencoded 发送表单，其它类型按原始文本发送。GET 不能携带请求体。并发限制可留空；1000 表示两次请求至少间隔 1000 毫秒，2/1000 表示 1000 毫秒内最多 2 次请求。"
                                           TextWrapping="Wrap" />

                                <TextBlock Margin="0,18,0,0"
                                           Style="{StaticResource StrongTextBlockStyle}"
                                           Text="模板表达式" />
                                <TextBlock Margin="0,8,0,0"
                                           Style="{StaticResource SecondaryTextBlockStyle}"
                                           Text="URL、Header 和请求体都可使用 {{ JavaScript 表达式 }}。可用值有 speakText、speakSpeed，以及只读的 source.name、source.url、source.contentType、source.concurrentRate。可使用 JSON、Math、Date、encodeURI、encodeURIComponent，也兼容 java.encodeURI 和 java.encodeURIComponent。模板只能写表达式，不能写多条语句。"
                                           TextWrapping="Wrap" />

                                <TextBlock Margin="0,18,0,0"
                                           Style="{StaticResource StrongTextBlockStyle}"
                                           Text="不支持的模板能力" />
                                <TextBlock Margin="0,8,0,0"
                                           Style="{StaticResource SecondaryTextBlockStyle}"
                                           Text="不支持 Cookie、source.get/put、其它 java.* 辅助函数，也不能访问 CLR、文件、进程或网络。包含这些能力的导入规则需要改写，或无法导入。"
                                           TextWrapping="Wrap" />

                                <TextBlock Margin="0,18,0,0"
                                           Style="{StaticResource StrongTextBlockStyle}"
                                           Text="试听与导入" />
                                <TextBlock Margin="0,8,0,0"
                                           Style="{StaticResource SecondaryTextBlockStyle}"
                                           Text="试听固定使用“你好，欢迎试听。”和当前默认语速。未保存的草稿可以直接试听，不会自动保存；再次试听会取消上一次请求。导入支持单个 JSON 对象或数组，只保留名称、URL、Content-Type、并发限制、Header、启用状态和请求方法/请求体；未知字段会丢弃。"
                                           TextWrapping="Wrap" />

                                <TextBlock Margin="0,18,0,0"
                                           Style="{StaticResource StrongTextBlockStyle}"
                                           Text="失败时按这个顺序检查" />
                                <TextBlock Margin="0,8,0,0"
                                           Style="{StaticResource SecondaryTextBlockStyle}"
                                           Text="先确认 URL 是完整地址和请求方法正确；再检查 {{ }} 是否闭合、Header 名称是否重复、GET 是否误填请求体，以及并发限制是否为 1000 或 2/1000 这类格式。若服务返回鉴权错误，请核对 Header 的值，但不要把密钥发到日志或反馈中。"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
