<UserControl x:Class="NovelSpeaker.App.Views.TtsRulesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="26" FontWeight="SemiBold" Text="TTS 规则" />
            <TextBlock Margin="0,8,0,0" Text="{Binding StatusMessage}" />
            <TextBlock Margin="0,8,0,0"
                       FontWeight="SemiBold"
                       Foreground="#FF1D3557"
                       Text="{Binding CurrentRuleDisplayText}" />
            <WrapPanel Margin="0,12,0,0">
                <Button Margin="0,0,12,12" Padding="18,10" Content="从文件导入" Click="ImportFromFileButton_OnClick" />
                <Button Margin="0,0,12,12" Padding="18,10" Content="从剪贴板导入" Click="ImportFromClipboardButton_OnClick" />
                <Button Margin="0,0,12,12" Padding="18,10" Content="导出所选规则" Click="ExportSelectedRuleButton_OnClick" />
            </WrapPanel>
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,12,0,16"
                Padding="16"
                Background="#FFF7F3E8"
                CornerRadius="8"
                Visibility="{Binding IsPreviewVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <TextBlock FontSize="18"
                           FontWeight="SemiBold"
                           Text="导入预览" />
                <TextBlock Margin="0,8,0,0"
                           Foreground="#FF4A5568"
                           Text="{Binding PreviewSourceDescription}" />
                <TextBlock Margin="0,8,0,0"
                           TextWrapping="Wrap"
                           Text="{Binding PreviewStatusMessage}" />
                <DataGrid Margin="0,12,0,0"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          ItemsSource="{Binding PreviewItems}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="180" />
                        <DataGridTextColumn Header="URL" Binding="{Binding Url}" Width="*" />
                        <DataGridTextColumn Header="兼容性" Binding="{Binding CompatibilityStatus}" Width="160" />
                        <DataGridTextColumn Header="未支持字段" Binding="{Binding UnsupportedFieldsSummary}" Width="220" />
                        <DataGridTextColumn Header="状态" Binding="{Binding StatusMessage}" Width="280" />
                    </DataGrid.Columns>
                </DataGrid>
                <WrapPanel Margin="0,12,0,0">
                    <Button Margin="0,0,12,0"
                            Padding="18,10"
                            Command="{Binding ConfirmImportCommand}"
                            Content="确认导入" />
                    <Button Padding="18,10"
                            Command="{Binding CancelPreviewCommand}"
                            Content="取消预览" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="3"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  ItemsSource="{Binding Rules}"
                  SelectedItem="{Binding SelectedRule, Mode=TwoWay}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="180" />
                <DataGridCheckBoxColumn Header="启用" Binding="{Binding IsEnabled}" Width="70" />
                <DataGridCheckBoxColumn Header="当前" Binding="{Binding IsSelected}" Width="70" />
                <DataGridTextColumn Header="最近使用" Binding="{Binding LastUsedAt}" Width="190" />
                <DataGridTextColumn Header="兼容状态" Binding="{Binding CompatibilityStatus}" Width="150" />
                <DataGridTextColumn Header="未支持字段" Binding="{Binding UnsupportedFieldsSummary}" Width="200" />
                <DataGridTemplateColumn Header="操作" Width="260">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <WrapPanel>
                                <Button Margin="0,0,8,4"
                                        Padding="10,4"
                                        Command="{Binding DataContext.SetCurrentRuleCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Content="设为当前" />
                                <Button Margin="0,0,8,4"
                                        Padding="10,4"
                                        Command="{Binding DataContext.ToggleRuleEnabledCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Content="启用/禁用" />
                                <Button Margin="0,0,8,4"
                                        Padding="10,4"
                                        Command="{Binding DataContext.DeleteRuleCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Content="删除" />
                            </WrapPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
