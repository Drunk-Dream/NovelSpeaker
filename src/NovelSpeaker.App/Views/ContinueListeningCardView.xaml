<UserControl x:Class="NovelSpeaker.App.Views.ContinueListeningCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:NovelSpeaker.App.Views"
             x:Name="Root">
    <Grid>
        <Button Padding="0"
                Background="Transparent"
                BorderThickness="0"
                Command="{Binding OpenCommand, ElementName=Root}"
                CommandParameter="{Binding Item, ElementName=Root}"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch">
            <Border Padding="{StaticResource CardPaddingLarge}"
                    Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <local:BookCoverView Width="{StaticResource CoverMediumWidth}"
                                         Height="{StaticResource CoverMediumHeight}"
                                         Cover="{Binding Item.Cover, ElementName=Root}" />

                    <StackPanel Grid.Column="1"
                                Margin="16,0,160,0"
                                VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource SectionTitleTextBlockStyle}"
                                   Text="继续收听" />
                        <TextBlock Margin="0,8,0,0"
                                   Style="{StaticResource StrongTextBlockStyle}"
                                   FontSize="18"
                                   Text="{Binding Item.Title, ElementName=Root}"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,8,0,0"
                                   Style="{StaticResource PrimaryTextBlockStyle}"
                                   Text="{Binding Item.CurrentChapterTitle, ElementName=Root}"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,6,0,0"
                                   Style="{StaticResource SecondaryTextBlockStyle}"
                                   Text="{Binding Item.RemainingChapterText, ElementName=Root}" />
                        <ProgressBar Margin="0,12,0,0"
                                     Height="8"
                                     Maximum="1"
                                     Value="{Binding Item.ProgressRatio, ElementName=Root, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Button>

        <Button Margin="0,0,20,20"
                Padding="16,8"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Command="{Binding OpenCommand, ElementName=Root}"
                CommandParameter="{Binding Item, ElementName=Root}"
                Content="继续收听" />
    </Grid>
</UserControl>
