<UserControl x:Class="NovelSpeaker.App.Views.ImportBookDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid MinWidth="640"
          MaxWidth="760">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Style="{StaticResource FormLabelTextBlockStyle}"
                       Text="文件" />
            <TextBlock Grid.Row="0"
                       Grid.Column="1"
                       Style="{StaticResource StrongTextBlockStyle}"
                       Text="{Binding FileName}" />

            <TextBlock Grid.Row="1"
                       Margin="0,8,0,0"
                       Style="{StaticResource FormLabelTextBlockStyle}"
                       Text="大小" />
            <TextBlock Grid.Row="1"
                       Grid.Column="1"
                       Margin="0,8,0,0"
                       Style="{StaticResource SecondaryTextBlockStyle}"
                       Text="{Binding FileSizeText}" />

            <TextBlock Grid.Row="2"
                       Margin="0,8,0,0"
                       Style="{StaticResource FormLabelTextBlockStyle}"
                       Text="检测编码" />
            <TextBlock Grid.Row="2"
                       Grid.Column="1"
                       Margin="0,8,0,0"
                       Style="{StaticResource SecondaryTextBlockStyle}"
                       Text="{Binding DetectedEncodingText}" />

            <TextBlock Grid.Row="3"
                       Grid.ColumnSpan="2"
                       Margin="0,12,0,0"
                       Style="{StaticResource SecondaryTextBlockStyle}"
                       Text="{Binding StatusMessage}"
                       TextWrapping="Wrap" />
        </Grid>

        <ScrollViewer Grid.Row="1"
                      Margin="0,20,0,0"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Padding="{StaticResource CardPadding}"
                        Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource StrongTextBlockStyle}"
                                   Text="导入预览" />
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Style="{StaticResource FormLabelTextBlockStyle}"
                                       VerticalAlignment="Center"
                                       Text="书名" />
                            <TextBox Grid.Row="0"
                                     Grid.Column="1"
                                     IsReadOnly="True"
                                     Text="{Binding SuggestedTitle}" />

                            <TextBlock Grid.Row="1"
                                       Margin="0,8,0,0"
                                       Style="{StaticResource FormLabelTextBlockStyle}"
                                       VerticalAlignment="Center"
                                       Text="作者" />
                            <TextBox Grid.Row="1"
                                     Grid.Column="1"
                                     Margin="0,8,0,0"
                                     IsReadOnly="True"
                                     Text="{Binding SuggestedAuthor}" />

                            <TextBlock Grid.Row="2"
                                       Grid.ColumnSpan="2"
                                       Margin="0,8,0,0"
                                       Text="未匹配文件名模板，已回退为文件名书名。">
                                    <TextBlock.Style>
                                        <Style BasedOn="{StaticResource SecondaryTextBlockStyle}" TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFileNameTemplateMatched}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <TextBox Margin="0,12,0,0"
                                 MinHeight="220"
                                 AcceptsReturn="True"
                                 IsReadOnly="True"
                                 Text="{Binding PreviewText}"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" />

                        <WrapPanel Margin="0,12,0,0"
                                   VerticalAlignment="Center">
                            <ComboBox Width="160"
                                      SelectedValue="{Binding SelectedEncoding}"
                                      SelectedValuePath="Content">
                                <ComboBoxItem Content="utf-8" />
                                <ComboBoxItem Content="utf-16le" />
                                <ComboBoxItem Content="utf-16be" />
                                <ComboBoxItem Content="gb18030" />
                            </ComboBox>
                            <Button Margin="12,0,0,0"
                                    Command="{Binding RetryPreviewCommand}"
                                    Content="重新预览" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <StackPanel Margin="0,16,0,0">
                    <TextBlock Style="{StaticResource PrimaryTextBlockStyle}"
                               Text="{Binding ImportProgressText}" />
                    <ProgressBar Margin="0,8,0,0"
                                 Height="10"
                                 Minimum="0"
                                 Maximum="100"
                                 IsIndeterminate="{Binding IsProgressIndeterminate}"
                                 Value="{Binding ImportProgressPercent}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2"
              Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Margin="12,0,0,0"
                    Command="{Binding CancelDialogCommand}"
                    Content="取消" />
            <Button Grid.Column="1"
                    Margin="12,0,0,0"
                    Command="{Binding ConfirmImportCommand}"
                    Content="确认导入"
                    IsEnabled="{Binding CanConfirmImport}" />
        </Grid>
    </Grid>
</UserControl>
