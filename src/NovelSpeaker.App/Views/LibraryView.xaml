<UserControl x:Class="NovelSpeaker.App.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:library="clr-namespace:NovelSpeaker.App.Library"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:views="clr-namespace:NovelSpeaker.App.Views">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False"
                  Margin="{StaticResource PagePadding}"
                  AllowDrop="True"
                  DragEnter="RootScrollViewer_OnDragEnter"
                  Drop="RootScrollViewer_OnDrop"
                  library:LibraryScrollViewerStateBehavior.ItemsControl="{Binding ElementName=BooksItemsControl}"
                  library:LibraryScrollViewerStateBehavior.State="{Binding ScrollState}">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock VerticalAlignment="Center"
                           Style="{StaticResource PageTitleTextBlockStyle}"
                           Text="书库" />

                <WrapPanel Grid.Column="1"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center">
                    <TextBox Width="240"
                             Margin="0,0,12,0"
                             VerticalContentAlignment="Center"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Margin="0,0,12,0"
                            Command="{Binding ClearSearchCommand}"
                            Content="清空" />
                    <ComboBox Width="140"
                              Margin="0,0,12,0"
                              DisplayMemberPath="DisplayName"
                              ItemsSource="{Binding AvailableSortOptions}"
                              SelectedValue="{Binding SelectedSortMode}"
                              SelectedValuePath="Mode" />
                    <Button Width="120"
                            Click="ImportButton_OnClick"
                            Content="导入小说" />
                </WrapPanel>
            </Grid>

            <Border Margin="0,20,0,0"
                    Padding="{StaticResource CardPaddingLarge}"
                    Style="{StaticResource CardBorderStyle}"
                    Visibility="{Binding IsImportPanelVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleTextBlockStyle}"
                               Text="导入 TXT 小说" />
                    <TextBlock Margin="0,8,0,0"
                               Style="{StaticResource SecondaryTextBlockStyle}"
                               Text="将 TXT 文件拖到书库页面，或使用导入按钮选择文件。" />
                    <TextBlock Margin="0,10,0,0"
                               Style="{StaticResource SecondaryTextBlockStyle}"
                               Text="{Binding StatusMessage}" />

                    <StackPanel Margin="0,16,0,0"
                                Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Style="{StaticResource PrimaryTextBlockStyle}"
                                   Text="{Binding ImportProgressText}" />
                        <ProgressBar Margin="0,8,0,0"
                                     Height="10"
                                     Minimum="0"
                                     Maximum="100"
                                     IsIndeterminate="{Binding IsProgressIndeterminate}"
                                     Value="{Binding ImportProgressPercent}" />
                    </StackPanel>

                    <Border Margin="0,16,0,0"
                            Padding="{StaticResource CardPadding}"
                            Style="{StaticResource CardBorderStyle}"
                            Visibility="{Binding IsEncodingPreviewVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource StrongTextBlockStyle}"
                                       Text="导入预览" />
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Style="{StaticResource FormLabelTextBlockStyle}"
                                           VerticalAlignment="Center"
                                           Text="书名" />
                                <TextBox Grid.Row="0"
                                         Grid.Column="1"
                                         IsReadOnly="True"
                                         Text="{Binding SuggestedTitle}" />

                                <TextBlock Grid.Row="1"
                                           Grid.Column="0"
                                           Margin="0,8,0,0"
                                           Style="{StaticResource FormLabelTextBlockStyle}"
                                           VerticalAlignment="Center"
                                           Text="作者" />
                                <TextBox Grid.Row="1"
                                         Grid.Column="1"
                                         Margin="0,8,0,0"
                                         IsReadOnly="True"
                                         Text="{Binding SuggestedAuthor}" />

                                <TextBlock Grid.Row="2"
                                           Grid.ColumnSpan="2"
                                           Margin="0,8,0,0"
                                           Text="未匹配文件名模板，已回退为文件名书名。">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock"
                                               BasedOn="{StaticResource SecondaryTextBlockStyle}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFileNameTemplateMatched}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <TextBox Margin="0,12,0,12"
                                     Height="160"
                                     AcceptsReturn="True"
                                     IsReadOnly="True"
                                     Text="{Binding PreviewText}"
                                     TextWrapping="Wrap" />

                            <WrapPanel>
                                <ComboBox Width="160"
                                          SelectedValue="{Binding SelectedEncoding}"
                                          SelectedValuePath="Content">
                                    <ComboBoxItem Content="utf-8" />
                                    <ComboBoxItem Content="utf-16le" />
                                    <ComboBoxItem Content="utf-16be" />
                                    <ComboBoxItem Content="gb18030" />
                                </ComboBox>
                                <Button Margin="12,0,0,0"
                                        Click="RetryEncodingButton_OnClick"
                                        Content="刷新预览" />
                                <Button Margin="12,0,0,0"
                                        Click="ConfirmImportButton_OnClick"
                                        Content="确认导入"
                                        Visibility="{Binding CanConfirmImport, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <Button Margin="12,0,0,0"
                                        Click="CancelImportButton_OnClick"
                                        Content="取消"
                                        Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Border Margin="0,20,0,0"
                    Padding="{StaticResource CardPaddingLarge}"
                    Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleTextBlockStyle}"
                               Text="书架" />

                    <StackPanel Margin="0,20,0,0"
                                HorizontalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasBooks}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <ui:SymbolIcon HorizontalAlignment="Center"
                                       FontSize="48"
                                       Symbol="BookOpen24" />
                        <TextBlock Margin="0,12,0,0"
                                   HorizontalAlignment="Center"
                                   Style="{StaticResource StrongTextBlockStyle}"
                                   Text="尚未导入小说" />
                        <TextBlock Margin="0,8,0,0"
                                   HorizontalAlignment="Center"
                                   Style="{StaticResource SecondaryTextBlockStyle}"
                                   Text="将 TXT 拖到这里，或使用右上角导入按钮。" />
                    </StackPanel>

                    <StackPanel Margin="0,20,0,0"
                                HorizontalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding HasBooks}" Value="True" />
                                            <Condition Binding="{Binding HasVisibleBooks}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock HorizontalAlignment="Center"
                                   Style="{StaticResource StrongTextBlockStyle}"
                                   Text="没有找到匹配的书籍" />
                        <TextBlock Margin="0,8,0,0"
                                   HorizontalAlignment="Center"
                                   Style="{StaticResource SecondaryTextBlockStyle}"
                                   Text="试试修改关键词，或清空搜索条件。" />
                    </StackPanel>

                    <ItemsControl x:Name="BooksItemsControl"
                                  Margin="0,20,0,0"
                                  ItemsSource="{Binding Books}"
                                  Visibility="{Binding HasVisibleBooks, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel ItemWidth="340" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Margin" Value="0,0,16,16" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <views:BookCardView Item="{Binding}"
                                                    DeleteBookCommand="{Binding DataContext.DeleteBookCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    OpenBookCommand="{Binding DataContext.OpenBookCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    OpenBookDetailsCommand="{Binding DataContext.OpenBookDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
