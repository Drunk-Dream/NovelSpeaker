<UserControl x:Class="NovelSpeaker.App.Views.ChapterRulesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

    </UserControl.Resources>

    <Grid Margin="{StaticResource PagePadding}"
          MinHeight="0"
          ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Style="{StaticResource BackIconButtonStyle}"
                        Command="{Binding BackCommand}"
                        ToolTip="返回"
                        AutomationProperties.Name="返回">
                    <ui:SymbolIcon Symbol="ChevronLeft24" />
                </Button>

                <TextBlock Grid.Column="1"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Style="{StaticResource PageTitleTextBlockStyle}"
                           Text="章节规则" />
            </Grid>

            <WrapPanel Grid.Column="1"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center">
                <Button Margin="0,0,12,0"
                        Padding="16,8"
                        Command="{Binding NewRuleCommand}"
                        Content="新建规则" />
                <Button Margin="0,0,12,0"
                        Padding="16,8"
                        Command="{Binding ImportDefaultsCommand}"
                        Content="导入默认" />
                <Button Margin="0,0,12,0"
                        Padding="16,8"
                        Command="{Binding RestoreDefaultsCommand}"
                        Content="恢复默认" />
                <Button Style="{StaticResource SecondaryIconButtonStyle}"
                        Command="{Binding OpenHelpCommand}"
                        ToolTip="章节规则帮助"
                        AutomationProperties.Name="章节规则帮助">
                    <ui:SymbolIcon Symbol="QuestionCircle24" />
                </Button>
            </WrapPanel>
        </Grid>

        <Grid Grid.Row="1"
              Margin="0,20,0,0"
              MinHeight="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource CardBorderStyle}">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top"
                                Margin="16,16,16,12">
                        <TextBlock Style="{StaticResource SectionTitleTextBlockStyle}"
                                   Text="规则列表" />
                        <TextBlock Margin="0,6,0,0"
                                   Style="{StaticResource SecondaryTextBlockStyle}"
                                   Text="{Binding Rules.Count, StringFormat=共 {0} 条规则}" />
                    </StackPanel>

                    <TextBlock Margin="16,0,16,16"
                               Text="还没有章节规则，先新建一条或导入默认规则。">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock"
                                   BasedOn="{StaticResource SecondaryTextBlockStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Rules.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ScrollViewer x:Name="RulesListScrollViewer"
                                  Margin="12,0,12,12"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Rules}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource DropTargetListItemContainerStyle}"
                                            AllowDrop="True"
                                            DragEnter="RuleItem_OnDragEnter"
                                            DragLeave="RuleItem_OnDragLeave"
                                            DragOver="RuleItem_OnDragOver"
                                            Drop="RuleItem_OnDrop"
                                            AutomationProperties.Name="{Binding AutomationName}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Button Style="{StaticResource BorderlessListItemButtonStyle}"
                                                    Command="{Binding DataContext.SelectRuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource StrongTextBlockStyle}"
                                                               Text="{Binding Name}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Margin="0,8,0,0"
                                                               Style="{StaticResource SecondaryTextBlockStyle}"
                                                               Text="{Binding PatternSummary}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Button>

                                            <Grid Grid.Row="1"
                                                  Margin="0,12,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <CheckBox Grid.Column="0"
                                                          VerticalAlignment="Center"
                                                          IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                                          IsEnabled="{Binding CanQuickActions}"
                                                          Command="{Binding DataContext.ToggleRuleEnabledCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="{Binding}"
                                                          Content="启用" />

                                                <Button Grid.Column="2"
                                                        Style="{StaticResource SecondaryIconButtonStyle}"
                                                        ToolTip="拖动排序"
                                                        AutomationProperties.Name="拖动排序"
                                                        IsEnabled="{Binding CanQuickActions}"
                                                        PreviewMouseLeftButtonDown="DragHandle_OnPreviewMouseLeftButtonDown"
                                                        PreviewMouseMove="DragHandle_OnPreviewMouseMove"
                                                        Tag="{Binding}">
                                                    <ui:SymbolIcon Symbol="ReOrder24" />
                                                </Button>

                                                <Button Grid.Column="4"
                                                        Style="{StaticResource SecondaryIconButtonStyle}"
                                                        Command="{Binding DataContext.MoveRuleUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        IsEnabled="{Binding CanMoveUp}"
                                                        ToolTip="上移"
                                                        AutomationProperties.Name="上移">
                                                    <ui:SymbolIcon Symbol="ArrowUp24" />
                                                </Button>

                                                <Button Grid.Column="6"
                                                        Style="{StaticResource SecondaryIconButtonStyle}"
                                                        Command="{Binding DataContext.MoveRuleDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        IsEnabled="{Binding CanMoveDown}"
                                                        ToolTip="下移"
                                                        AutomationProperties.Name="下移">
                                                    <ui:SymbolIcon Symbol="ArrowDown24" />
                                                </Button>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border Grid.Column="2"
                    Style="{StaticResource CardBorderStyle}">
                <Grid MinHeight="0">
                    <Border Margin="20"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            MaxWidth="420">
                        <Border.Style>
                            <Style TargetType="Border"
                                   BasedOn="{StaticResource CardBorderStyle}">
                                <Setter Property="Padding" Value="20" />
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasEditor}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock HorizontalAlignment="Center"
                                       Style="{StaticResource SectionTitleTextBlockStyle}"
                                       Text="选择一条规则" />
                            <TextBlock Margin="0,10,0,0"
                                       HorizontalAlignment="Center"
                                       Style="{StaticResource SecondaryTextBlockStyle}"
                                       Text="左侧选择已有规则，或使用顶部按钮新建规则、导入默认规则。"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <ScrollViewer x:Name="RuleEditorScrollViewer"
                                  Margin="20"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasEditor}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>

                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitleTextBlockStyle}"
                                       Text="规则编辑" />

                            <StackPanel Margin="0,20,0,0">
                                <TextBlock Style="{StaticResource StrongTextBlockStyle}"
                                           Text="名称" />
                                <TextBox Margin="0,6,0,0"
                                         Text="{Binding DraftName, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Margin="0,6,0,0"
                                           Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                           Text="{Binding NameValidationMessage}"
                                           TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock"
                                               BasedOn="{StaticResource SecondaryTextBlockStyle}">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding NameValidationMessage}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <TextBlock Margin="0,18,0,0"
                                       Style="{StaticResource StrongTextBlockStyle}"
                                       Text="正则表达式" />
                            <TextBox Margin="0,6,0,0"
                                     AcceptsReturn="True"
                                     MinHeight="88"
                                     TextWrapping="Wrap"
                                     Text="{Binding DraftPattern, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="0,6,0,0"
                                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                       Text="{Binding PatternValidationMessage}"
                                       TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock"
                                           BasedOn="{StaticResource SecondaryTextBlockStyle}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PatternValidationMessage}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBlock Margin="0,18,0,0"
                                       Style="{StaticResource SecondaryTextBlockStyle}"
                                       Text="{Binding DeleteRestrictionMessage}"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding ShowDeleteRestrictionMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />

                            <Grid Margin="0,24,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="1"
                                        Padding="16,8"
                                        Command="{Binding DeleteRuleCommand}"
                                        IsEnabled="{Binding CanDeleteCurrentRule}"
                                        Content="删除" />
                                <Button Grid.Column="3"
                                        Padding="16,8"
                                        Command="{Binding CancelEditingCommand}"
                                        IsEnabled="{Binding CanCancelEditing}"
                                        Content="取消" />
                                <Button Grid.Column="5"
                                        Padding="16,8"
                                        Command="{Binding SaveDraftCommand}"
                                        IsEnabled="{Binding CanSaveDraft}"
                                        Content="保存" />
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Grid Grid.ColumnSpan="3"
                  Panel.ZIndex="10"
                  Visibility="{Binding IsHelpDrawerOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="380" />
                </Grid.ColumnDefinitions>

                <Button x:Name="HelpDrawerDismissOverlay"
                        Grid.Column="0"
                        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                        BorderThickness="0"
                        Command="{Binding CloseHelpCommand}" />

                <Border x:Name="HelpDrawerBorder"
                        Grid.Column="1"
                        Padding="20"
                        Style="{StaticResource PopupSurfaceBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource SectionTitleTextBlockStyle}"
                                       Text="章节规则帮助" />
                            <Button Grid.Column="1"
                                    Style="{StaticResource SecondaryIconButtonStyle}"
                                    Command="{Binding CloseHelpCommand}"
                                    ToolTip="关闭帮助"
                                    AutomationProperties.Name="关闭帮助">
                                <ui:SymbolIcon Symbol="Dismiss24" />
                            </Button>
                        </Grid>

                        <ScrollViewer Grid.Row="1"
                                      Margin="0,16,0,0"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock Style="{StaticResource StrongTextBlockStyle}" Text="作用范围" />
                                <TextBlock Margin="0,8,0,0"
                                           Style="{StaticResource SecondaryTextBlockStyle}"
                                           Text="章节规则只用于识别章节标题，不参与正文正则替换，也不会直接修改已导入的 content.txt。"
                                           TextWrapping="Wrap" />

                                <TextBlock Margin="0,18,0,0"
                                           Style="{StaticResource StrongTextBlockStyle}"
                                           Text="正则基本写法" />
                                <TextBlock Margin="0,8,0,0"
                                           Style="{StaticResource SecondaryTextBlockStyle}"
                                           Text="建议使用 ^ 和 $ 约束整行，避免误匹配正文。保存前会按 CultureInvariant 规则即时校验。"
                                           TextWrapping="Wrap" />

                                <TextBlock Margin="0,18,0,0"
                                           Style="{StaticResource StrongTextBlockStyle}"
                                           Text="标题示例" />
                                <TextBlock Margin="0,8,0,0"
                                           Style="{StaticResource SecondaryTextBlockStyle}"
                                           Text="常见标题包括“第一章 初见”“第十卷 风起”“序章”“后记”“番外 特别篇”等。"
                                           TextWrapping="Wrap" />

                                <TextBlock Margin="0,18,0,0"
                                           Style="{StaticResource StrongTextBlockStyle}"
                                           Text="排序优先级" />
                                <TextBlock Margin="0,8,0,0"
                                           Style="{StaticResource SecondaryTextBlockStyle}"
                                           Text="规则按排序从前到后依次尝试；越具体的规则应放在越前面，避免被宽泛规则提前命中。"
                                           TextWrapping="Wrap" />

                                <TextBlock Margin="0,18,0,0"
                                           Style="{StaticResource StrongTextBlockStyle}"
                                           Text="内置规则限制" />
                                <TextBlock Margin="0,8,0,0"
                                           Style="{StaticResource SecondaryTextBlockStyle}"
                                           Text="内置规则可以编辑、启用和排序，但不能删除；如需回到初始配置，请使用“恢复默认”。"
                                           TextWrapping="Wrap" />

                                <TextBlock Margin="0,18,0,0"
                                           Style="{StaticResource StrongTextBlockStyle}"
                                           Text="误识别处理" />
                                <TextBlock Margin="0,8,0,0"
                                           Style="{StaticResource SecondaryTextBlockStyle}"
                                           Text="若章节被误判，可先收紧正则条件，再把更具体的规则上移；恢复默认不会删除你的自定义规则。"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
