<Page x:Class="NovelSpeaker.App.Pages.PlayerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:views="clr-namespace:NovelSpeaker.App.Views">
    <Grid MinHeight="0"
          ClipToBounds="True">
        <views:PlayerView x:Name="PlayerView"
                          Height="{Binding RelativeSource={RelativeSource AncestorType=Page}, Path=ActualHeight}"
                          VerticalAlignment="Stretch"
                          HorizontalAlignment="Stretch" />
    </Grid>
</Page>
