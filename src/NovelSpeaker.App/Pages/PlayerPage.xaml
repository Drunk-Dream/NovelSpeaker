<Page x:Class="NovelSpeaker.App.Pages.PlayerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:navigation="clr-namespace:NovelSpeaker.App.Navigation"
      xmlns:views="clr-namespace:NovelSpeaker.App.Views">
    <Grid x:Name="RootViewport"
          MinHeight="0"
          navigation:NavigationViewportHeightBehavior.IsEnabled="True"
          ClipToBounds="True">
        <views:PlayerView x:Name="PlayerView"
                          VerticalAlignment="Stretch"
                          HorizontalAlignment="Stretch" />
    </Grid>
</Page>
