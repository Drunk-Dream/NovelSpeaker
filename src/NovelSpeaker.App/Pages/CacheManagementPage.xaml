<Page x:Class="NovelSpeaker.App.Pages.CacheManagementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="{StaticResource PagePadding}">
        <StackPanel>
            <Button Padding="12,8"
                    HorizontalAlignment="Left"
                    Click="BackButton_OnClick"
                    Content="返回" />

            <TextBlock Margin="{StaticResource SectionSpacing}"
                       Style="{StaticResource PageTitleTextBlockStyle}"
                       Text="缓存管理" />
            <TextBlock Margin="{StaticResource ItemSpacing}"
                       Style="{StaticResource SecondaryTextBlockStyle}"
                       Text="当前版本仅建立缓存管理页导航壳，详细能力将在后续任务实现。" />
        </StackPanel>
    </Grid>
</Page>
