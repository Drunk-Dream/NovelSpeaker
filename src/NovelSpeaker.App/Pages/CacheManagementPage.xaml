<Page x:Class="NovelSpeaker.App.Pages.CacheManagementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="{StaticResource PagePadding}">
        <StackPanel>
            <Button Style="{StaticResource BackIconButtonStyle}"
                    Click="BackButton_OnClick"
                    ToolTip="返回"
                    AutomationProperties.Name="返回">
                <ui:SymbolIcon Symbol="ChevronLeft24" />
            </Button>

            <TextBlock Margin="{StaticResource SectionSpacing}"
                       Style="{StaticResource PageTitleTextBlockStyle}"
                       Text="缓存管理" />
            <TextBlock Margin="{StaticResource ItemSpacing}"
                       Style="{StaticResource SecondaryTextBlockStyle}"
                       Text="当前版本仅建立缓存管理页导航壳，详细能力将在后续任务实现。" />
        </StackPanel>
    </Grid>
</Page>
