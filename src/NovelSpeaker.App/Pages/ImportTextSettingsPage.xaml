<Page x:Class="NovelSpeaker.App.Pages.ImportTextSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Button Style="{StaticResource BackIconButtonStyle}"
                Command="{Binding BackCommand}"
                ToolTip="返回"
                AutomationProperties.Name="返回">
            <ui:SymbolIcon Symbol="ChevronLeft24" />
        </Button>

        <ScrollViewer Grid.Row="1"
                      Margin="0,20,0,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitleTextBlockStyle}"
                           Text="导入与文本" />

                <StackPanel Margin="{StaticResource SectionSpacing}">
                    <Border x:Name="BookFileNameTemplateItemBorder"
                            Style="{StaticResource SettingsSubpageItemBorderStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SettingsSubpageItemTitleTextBlockStyle}"
                                       Text="文件名模板" />
                            <TextBox x:Name="BookFileNameTemplateTextBox"
                                     Margin="0,10,0,0"
                                     Width="360"
                                     HorizontalAlignment="Left"
                                     PreviewKeyDown="BookFileNameTemplateTextBox_OnPreviewKeyDown"
                                     LostKeyboardFocus="BookFileNameTemplateTextBox_OnLostKeyboardFocus"
                                     Text="{Binding BookFileNameTemplateText, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="0,6,0,0"
                                       Style="{StaticResource SecondaryTextBlockStyle}"
                                       Text="{}示例：{{name}} 作者：{{author}}；留空则禁用模板解析。" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="EnableLongParagraphSplittingItemBorder"
                            Style="{StaticResource SettingsSubpageItemBorderStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SettingsSubpageItemTitleTextBlockStyle}"
                                       Text="启用超长段落拆分" />
                            <ui:ToggleSwitch Margin="0,10,0,0"
                                             HorizontalAlignment="Left"
                                             OffContent="关闭"
                                             OnContent="开启"
                                             IsChecked="{Binding EnableLongParagraphSplitting}" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="LongParagraphThresholdItemBorder"
                            Style="{StaticResource SettingsSubpageItemBorderStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SettingsSubpageItemTitleTextBlockStyle}"
                                       Text="长段拆分阈值" />
                            <TextBox x:Name="LongParagraphThresholdTextBox"
                                     Margin="0,10,0,0"
                                     Width="260"
                                     HorizontalAlignment="Left"
                                     PreviewKeyDown="LongParagraphThresholdTextBox_OnPreviewKeyDown"
                                     LostKeyboardFocus="LongParagraphThresholdTextBox_OnLostKeyboardFocus"
                                     Text="{Binding LongParagraphThresholdText, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="0,6,0,0"
                                       Text="{Binding LongParagraphThresholdErrorText}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock"
                                           BasedOn="{StaticResource ErrorTextBlockStyle}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LongParagraphThresholdErrorText}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingsSubpageItemBorderStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SettingsSubpageItemTitleTextBlockStyle}"
                                       Text="正则替换" />
                            <Button Margin="0,10,0,0"
                                    HorizontalAlignment="Left"
                                    Command="{Binding OpenRegexReplacementRulesCommand}"
                                    Content="管理正则替换规则" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
