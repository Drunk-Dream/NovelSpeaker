<Page x:Class="NovelSpeaker.App.Pages.PlaybackSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Button Style="{StaticResource BackIconButtonStyle}"
                Command="{Binding BackCommand}"
                ToolTip="返回"
                AutomationProperties.Name="返回">
            <ui:SymbolIcon Symbol="ChevronLeft24" />
        </Button>

        <ScrollViewer Grid.Row="1"
                      Margin="0,20,0,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitleTextBlockStyle}"
                           Text="播放设置" />

                <StackPanel Margin="{StaticResource SectionSpacing}">
                    <Border x:Name="DefaultSpeakSpeedItemBorder"
                            Style="{StaticResource SettingsSubpageItemBorderStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SettingsSubpageItemTitleTextBlockStyle}"
                                       Text="默认语速" />
                            <TextBox x:Name="DefaultSpeakSpeedTextBox"
                                     Margin="0,10,0,0"
                                     Width="260"
                                     HorizontalAlignment="Left"
                                     PreviewKeyDown="DefaultSpeakSpeedTextBox_OnPreviewKeyDown"
                                     LostKeyboardFocus="DefaultSpeakSpeedTextBox_OnLostKeyboardFocus"
                                     Text="{Binding DefaultSpeakSpeedText, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="0,6,0,0"
                                       Text="{Binding DefaultSpeakSpeedErrorText}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock"
                                           BasedOn="{StaticResource ErrorTextBlockStyle}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DefaultSpeakSpeedErrorText}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border x:Name="PrefetchCountItemBorder"
                            Style="{StaticResource SettingsSubpageItemBorderStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SettingsSubpageItemTitleTextBlockStyle}"
                                       Text="预取段落数量" />
                            <TextBox x:Name="PrefetchCountTextBox"
                                     Margin="0,10,0,0"
                                     Width="260"
                                     HorizontalAlignment="Left"
                                     PreviewKeyDown="PrefetchCountTextBox_OnPreviewKeyDown"
                                     LostKeyboardFocus="PrefetchCountTextBox_OnLostKeyboardFocus"
                                     Text="{Binding PrefetchCountText, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="0,6,0,0"
                                       Text="{Binding PrefetchCountErrorText}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock"
                                           BasedOn="{StaticResource ErrorTextBlockStyle}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PrefetchCountErrorText}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border x:Name="CurrentTtsRuleItemBorder"
                            Style="{StaticResource SettingsSubpageItemBorderStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SettingsSubpageItemTitleTextBlockStyle}"
                                       Text="当前 TTS 规则" />
                            <Button Margin="0,10,0,0"
                                    Width="180"
                                    HorizontalAlignment="Left"
                                    Command="{Binding OpenTtsRulesCommand}"
                                    Content="前往 TTS 规则" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
