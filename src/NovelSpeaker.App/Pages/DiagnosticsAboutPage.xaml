<Page x:Class="NovelSpeaker.App.Pages.DiagnosticsAboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Button Style="{StaticResource BackIconButtonStyle}"
                Command="{Binding BackCommand}"
                ToolTip="返回"
                AutomationProperties.Name="返回">
            <ui:SymbolIcon Symbol="ChevronLeft24" />
        </Button>

        <ScrollViewer Grid.Row="1"
                      Margin="0,20,0,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitleTextBlockStyle}"
                           Text="诊断与关于" />

                <Grid Margin="{StaticResource SectionSpacing}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Style="{StaticResource FormLabelTextBlockStyle}" Text="应用名称" />
                    <TextBlock Grid.Column="1" Style="{StaticResource PrimaryTextBlockStyle}" Text="{Binding AppName}" />

                    <TextBlock Grid.Row="1" Style="{StaticResource FormLabelTextBlockStyle}" Text="应用版本" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource PrimaryTextBlockStyle}" Text="{Binding AppVersion}" />

                    <TextBlock Grid.Row="2" Style="{StaticResource FormLabelTextBlockStyle}" Text="项目说明" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource PrimaryTextBlockStyle}" Text="{Binding Description}" TextWrapping="Wrap" />

                    <TextBlock Grid.Row="3" Style="{StaticResource FormLabelTextBlockStyle}" Text="数据库版本" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource PrimaryTextBlockStyle}" Text="{Binding DatabaseSchemaVersionText}" />

                    <TextBlock Grid.Row="4" Style="{StaticResource FormLabelTextBlockStyle}" Text="应用数据目录" />
                    <TextBox Grid.Row="4"
                             Grid.Column="1"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             Text="{Binding AppDataDirectoryPath}" />

                    <TextBlock Grid.Row="5" Style="{StaticResource FormLabelTextBlockStyle}" Text="日志级别" />
                    <ComboBox Grid.Row="5"
                              Grid.Column="1"
                              Width="180"
                              HorizontalAlignment="Left"
                              ItemsSource="{Binding AvailableLogLevels}"
                              SelectedItem="{Binding SelectedLogLevel}" />
                </Grid>

                <StackPanel Margin="{StaticResource SectionSpacing}">
                    <TextBlock Style="{StaticResource FormLabelTextBlockStyle}"
                               Text="日志目录" />
                    <TextBox Margin="0,8,0,0"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             Text="{Binding LogsDirectoryPath}" />
                    <Button Margin="0,8,0,0"
                            Width="180"
                            HorizontalAlignment="Left"
                            Command="{Binding OpenLogsDirectoryCommand}"
                            Content="打开日志目录" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
