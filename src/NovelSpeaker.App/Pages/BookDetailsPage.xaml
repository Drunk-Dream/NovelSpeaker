<Page x:Class="NovelSpeaker.App.Pages.BookDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="{StaticResource PagePadding}">
        <StackPanel>
            <Button Padding="12,8"
                    HorizontalAlignment="Left"
                    Click="BackButton_OnClick"
                    Content="返回" />

            <TextBlock Margin="{StaticResource SectionSpacing}"
                       Style="{StaticResource PageTitleTextBlockStyle}"
                       Text="书籍详情" />
            <TextBlock Margin="{StaticResource ItemSpacing}"
                       Style="{StaticResource SecondaryTextBlockStyle}"
                       Text="{Binding PlaceholderText}" />
        </StackPanel>
    </Grid>
</Page>
